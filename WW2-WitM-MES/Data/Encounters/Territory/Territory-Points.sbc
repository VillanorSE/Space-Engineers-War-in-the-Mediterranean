<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Territory point awards - all 6 anchors. Companion to Triggers-Zone-Change.sbc (which turns the {Anchor}_Points
     counters into zone radius changes). GENERATED: values come from the Territory-WarLevel-Design.md event table.
     Grid types: Carrier 100, Battleship 80, HeavyCruiser 50, Cruiser 40, Destroyer 20, Submarine 15, Corvette 10, UtilityNaval 10, UtilityAir 5, Bomber 5, Attacker 4, Fighter 3, Factory 10, Hangar 2. -->

<!-- ==================== KILLS / LOSSES ====================
     Losing a grid of type T (value b, Territory-WarLevel-Design.md 1.6/1.7): the victim faction loses b at every
     one of its 3 anchors and the rival faction gains b at every one of ITS 3 anchors - flat, no distance factor.
     Fires from a [Type:Compromised] trigger (once, when the grid Remote Control stops working) gated by the
     per-grid Retired boolean, so a clean despawn / completed delivery is never scored as a kill.
     One trigger + one action per (faction, grid type); attached to behaviors via WW2-Points-Group-{Faction}-{Type}
     (Points-TriggerGroups.sbc). Counters floor at 0 / cap at 4170 via Triggers-Zone-Change.sbc. -->

<!-- ========== Gray grid destroyed ========== -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-Kill-Gray-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Compromised]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-Territory-Action-Loss-Gray-Carrier]
			[Conditions:WW2-Points-Condition-NotRetired]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-Loss-Gray-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[DecreaseSandboxCounters:LaSpezia_Points]
			[DecreaseSandboxCounters:Tripoli_Points]
			[DecreaseSandboxCounters:Rome_Points]
			[DecreaseSandboxCountersAmount:100]
			[IncreaseSandboxCounters:Toulon_Points]
			[IncreaseSandboxCounters:Oran_Points]
			[IncreaseSandboxCounters:Alexandria_Points]
			[IncreaseSandboxCountersAmount:100]

			</Description>
		</EntityComponent>
