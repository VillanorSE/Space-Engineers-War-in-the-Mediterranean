<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Nautical Path Cargo Ships
     One SpawnGroup per direction, each pairing the Golo prefab (Italian=Gray, French=Green)
     with its matching direction-specific Behavior from Paths-Nautical.sbc. These are spawned
     exclusively via [RivalAI Spawn] CustomSpawn calls from each Port's own Behavior (see
     Behaviors-Port.sbc / Triggers-CargoSpawn-Port.sbc) - not through MES's normal ambient
     ship-spawning system. Each group still needs a SpawnConditions profile with a RivalAi spawn
     flag, or MES reports No Eligible SpawnGroups for type OtherNPC (see
     SpawnConditions-CargoShips.sbc).

     2026-09-22: added [IgnoreCleanupRules:true] to each group below, per the user's ask that these
     ships only leave the world by reaching their destination, not generic cleanup. Confirmed via
     source (ImprovedSpawnGroup.cs/NpcData.cs/Watchers/Cleaning.cs): this is a SpawnGroup-level tag,
     not a SpawnConditions one - it sets Attributes.IgnoreCleanup, which makes
     Cleaning.BasicCleanupChecks exempt the grid entirely from the generic distance/timer cleanup
     sweep. A same-named [IgnoreCleanupRules:true] already sits in
     SpawnConditions-CargoShips.sbc, added earlier this session by mistake - SpawnConditionsProfile.cs
     has no parser for that tag at all, so it was always a silent no-op there and did nothing to
     prevent the cleanup despawns actually observed. Left it in that file, now corrected with its
     own note, rather than deleting on the chance something else reads it later. -->

<!-- La Spezia -> Tripoli -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-CargoShip-LaSpezia-Tripoli</SubtypeId>
		</Id>
		<Description>
		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-CargoShips-Nautical]

		[IgnoreCleanupRules:true]

		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-Loot-Medium-Cargo]
		[ManipulationProfiles:WW2-Manipulation-ShipsBasicLoot]
		[FactionOverride:GRAY]

		</Description>
		<Icon>Textures\GUI\Icons\Fake.dds</Icon>
		<Frequency>10.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Golo_Italian">
				<Position>
					<X>0.0</X>
					<Y>13.75</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-CargoShip-Gray-LaSpezia-Tripoli</Behaviour>
				<Speed>5.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

