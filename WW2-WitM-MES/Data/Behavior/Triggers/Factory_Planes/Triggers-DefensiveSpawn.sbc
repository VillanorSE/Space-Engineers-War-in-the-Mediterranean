<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Defensive Gray Factory Spawn sequence -->	

	<!-- Triggers when a hostile player is within 1500m with a 10-30 minute cooldown -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DefenseSpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:1200]

			[MinCooldownMs:600000]
			[MaxCooldownMs:1800000]
			[StartsReady:true]
			
			[MaxPlayerReputation:-500]
			
            [Actions:WW2-Action-DefenseSpawn-Factory-Plane-Gray]

			</Description>
        </EntityComponent>

	<!-- Calls a chat notice and fighter spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DefenseSpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-DefenseSpawn-Factory-Plane]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DefenseSpawn-Factory-Plane-Gray]
			
			</Description>
        </EntityComponent>

	<!-- Spawns a random Gray fighter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DefenseSpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]
			
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]

			[SpawnGroups:NPC-WW2-Re2000]
			[SpawnGroups:NPC-WW2-Re2001]
			[SpawnGroups:NPC-WW2-FC20]
			
			[MinDistance:800]
			[MaxDistance:2000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Defensive Gray Factory Spawn sequence -->

<!-- Defensive Green Factory Spawn sequence -->
	<!-- Triggers when a hostile player is within 1500m with a 10-30 minute cooldown -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DefenseSpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:1200]

			[MinCooldownMs:600000]
			[MaxCooldownMs:1800000]
			[StartsReady:true]
			
			[MaxPlayerReputation:-500]
			
            [Actions:WW2-Action-DefenseSpawn-Factory-Plane-Green]

			</Description>
        </EntityComponent>

	<!-- Calls a chat notice and fighter spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DefenseSpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
						
			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-DefenseSpawn-Factory-Plane]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DefenseSpawn-Factory-Plane-Green]
			
			</Description>
        </EntityComponent>

<!-- Spawns a random Green fighter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DefenseSpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Spawn]
			
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]

			[SpawnGroups:NPC-WW2-MS406]
			[SpawnGroups:NPC-WW2-F4F]
			[SpawnGroups:NPC-WW2-Potez630]
			
			[MinDistance:800]
			[MaxDistance:2000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Defensive Green Factory Spawn sequence -->

<!-- Shared Chat messages -->
	<!-- Broadcasts a random chat notice to 2,500m range -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Chat-DefenseSpawn-Factory-Plane</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Chat]
			
			[UseChat:true]
            [StartsReady:true]
            [BroadcastRandomly:true]
			[Author:Dispatch]
			[Color:Red]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:2500]

            [ChatMessages:Scrambling air support.]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Both]
			
			[ChatMessages:Reinforcements on their way.]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Both]
			
			[ChatMessages:Hostile contact detected.]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Both]
			
			[ChatMessages:Coming in hot!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Both]
			
			</Description>
        </EntityComponent>
<!-- End Shared Chat Messages-->

	</EntityComponents>
</Definitions>