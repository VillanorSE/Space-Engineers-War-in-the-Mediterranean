<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>
        <!--
             WW2 Encounters: Ship Core blocks.
             Design confirmed in chat: components and model reused from vanilla Remote
             Control (grid-size-matched), full 6-side mount points and IsAirTight
             reused from vanilla armor block.
             TypeId is FunctionalBlock (xsi:type MyObjectBuilder_FunctionalBlockDefinition),
             matching Arcane Cores' proven working pattern : required because a block
             containing a Computer component needs a terminal-capable TypeId for
             ownership to be reassignable via the terminal, confirmed by an actual
             MOD_ERROR from a real load-test log. FunctionalBlock carries no RC-style
             autopilot/EnableShipControl functionality on its own.
             Component lists are the vanilla RC baseline as a starting point only;
             higher-tier cores still need Industrial/Military/Advanced Military
             Components layered in per the Roadmap's unlock-economy design, once
             those numbers are worked out (SDX2-referenced, not finalized yet).
             Icon, model, and BuildProgressModels are placeholder reuse of vanilla
             RC assets pending final custom art.
        -->
        <Definition xsi:type="MyObjectBuilder_FunctionalBlockDefinition">
            <Id>
                <TypeId>FunctionalBlock</TypeId>
                <SubtypeId>WW2-Core-Naval-Civilian</SubtypeId>
            </Id>
            <DisplayName>Civilian Naval Core</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\RemoteControl.dds</Icon>
            <Description>WW2 Encounters Ship Core: Civilian Naval Core. For cargo and utility ships.</Description>
            <CubeSize>Large</CubeSize>
            <GuiVisible>false</GuiVisible>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="1" y="1" z="1" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\Large\RemoteControl.mwm</Model>
            <Components>
                <Component Subtype="InteriorPlate" Count="5" />
                <Component Subtype="Construction" Count="10" />
                <Component Subtype="Motor" Count="5" />
                <Component Subtype="Computer" Count="15" />
                <Component Subtype="InteriorPlate" Count="5" />
				<Component Subtype="SteelPlate" Count="20" />
            </Components>
            <CriticalComponent Subtype="Computer" Index="0" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="1" EndY="1" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="1" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.50" File="Models\Cubes\Large\RemoteControlConstruction_1.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\Large\RemoteControlConstruction_2.mwm" />
            </BuildProgressModels>
            <BlockPairName>WW2-Core-Naval-Civilian</BlockPairName>
            <EdgeType>Light</EdgeType>
            <BuildTimeSeconds>30</BuildTimeSeconds>
            <MirroringY>Z</MirroringY>
            <Public>true</Public>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>
            <ResourceSinkGroup>Utility</ResourceSinkGroup>
            <EmissiveColorPreset>Extended</EmissiveColorPreset>
            <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
            <DestroySound>WepSmallWarheadExpl</DestroySound>
            <PCU>25</PCU>
            <IsAirTight>true</IsAirTight>
        </Definition>
