<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Airfield side of Air Cargo (plane flow: Triggers-AirCargo.sbc). All start disabled; the ownership
     flip actions (Triggers-Airfield-Ownership.sbc) enable the owning faction's pair and reset the spawn timer.
       Spawn: 45-60 min timer -> Ju52 (Gray) / F222 (Green).
       Destination: answers AirCargo-RequestDest-{GRAY|GREEN} with a waypoint over this airfield. -->

<!-- Gray -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-AirCargoSpawn-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:Timer]

			[MinCooldownMs:2700000]
			[MaxCooldownMs:3600000]
			[StartsReady:true]

			[MaxActions:-1]
			[Actions:WW2-Action-Airfield-AirCargoSpawn-Gray]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Airfield-AirCargoSpawn-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-Airfield-AirCargo-Gray]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-Airfield-AirCargo-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:WW2-AirCargo-Gray]

			[UseRelativeSpawnPosition:false]
			[MinDistance:400]
			[MaxDistance:800]
			[MinAltitude:300]
			[MaxAltitude:400]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-AirCargoDest-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:CommandReceived]
			[CommandReceiveCode:AirCargo-RequestDest-GRAY]
			[StartsReady:true]
			[MaxActions:-1]

			[Actions:WW2-Action-Airfield-AirCargoDest]

			</Description>
        </EntityComponent>
<!-- End Gray -->

<!-- Green -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-AirCargoSpawn-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:Timer]

			[MinCooldownMs:2700000]
			[MaxCooldownMs:3600000]
			[StartsReady:false]

			[MaxActions:-1]
			[Actions:WW2-Action-Airfield-AirCargoSpawn-Green]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Airfield-AirCargoSpawn-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-Airfield-AirCargo-Green]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-Airfield-AirCargo-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:WW2-AirCargo-Green]

			[UseRelativeSpawnPosition:false]
			[MinDistance:400]
			[MaxDistance:800]
			[MinAltitude:300]
			[MaxAltitude:400]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-AirCargoDest-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:CommandReceived]
			[CommandReceiveCode:AirCargo-RequestDest-GREEN]
			[StartsReady:true]
			[MaxActions:-1]

			[Actions:WW2-Action-Airfield-AirCargoDest]

			</Description>
        </EntityComponent>
<!-- End Green -->

<!-- Shared destination reply, back to the requesting plane only -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Airfield-AirCargoDest</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Command-Airfield-AirCargoDest]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Command-Airfield-AirCargoDest</SubtypeId>
            </Id>
            <Description>

			[RivalAI Command]
			[CommandCode:AirCargo-DestAssigned]
			[ReturnToSender:true]
			[SendWaypoint:true]
			[Waypoint:WW2-Waypoint-AirCargo-OverAirfield]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:1000000]

			</Description>
        </EntityComponent>

	</EntityComponents>
</Definitions>
