	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Airfield-Foggia</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

