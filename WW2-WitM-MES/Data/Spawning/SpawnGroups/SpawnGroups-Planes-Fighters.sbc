<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<SpawnGroups>

<!-- Green Fighter Planes -->
<SpawnGroup>
	<Id>
		<TypeId>SpawnGroupDefinition</TypeId>
		<SubtypeId>NPC-WW2-MS406</SubtypeId>
	</Id>
	<Description>
	  
	[Modular Encounters SpawnGroup]

	[SpawnConditionsProfiles:WW2-SpawnConditions-Fighters]
	[ManipulationProfiles:MES-Manipulation-RivalAi]
	[ManipulationProfiles:WW2-Manipulation-Tech-Military-VeryReliable]
	[ManipulationProfiles:WW2-Manipulation-CombatPlanes]
	[FactionOverride:GREEN]
	  
	</Description>
	<Frequency>1.0</Frequency>
	<IsPirate>true</IsPirate>
	<Prefabs>
		<Prefab SubtypeId="NPC-WW2-MS406">
			<Position>
				<X>0.0</X>
				<Y>0.0</Y>
				<Z>0.0</Z>
			</Position>
			<Behaviour>WW2-Behavior-Fighter-Green</Behaviour>
			<Speed>55.0</Speed>
		</Prefab>
	</Prefabs>
</SpawnGroup>
<!-- End Green Fighter Planes -->

