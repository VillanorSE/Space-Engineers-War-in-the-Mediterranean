<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Port Cargo Ship Spawns
     One Timer Trigger -> Action -> Spawn chain per leg, each spawning that leg's own
     direction-specific cargo ship (see Paths-Nautical.sbc / SpawnGroups-CargoShips-Nautical.sbc).
     60-90 min per leg. Toulon runs two independent chains (Oran leg + Alexandria leg) since it's
     the hub port for both Green routes - every other port here only runs one.
     Always-on timer (not gated behind player proximity) - ports run continuous background
     shipping traffic regardless of whether a player has visited. -->

<!-- La Spezia Cargo Spawn (-> Tripoli) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoSpawn-Port-LaSpezia</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:Timer]

			[MinCooldownMs:3600000]
			[MaxCooldownMs:5400000]
			[StartsReady:false]

			[MaxActions:-1]
            [Actions:WW2-Action-CargoSpawn-Port-LaSpezia]

			</Description>
        </EntityComponent>

			<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoSpawn-Port-LaSpezia</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-CargoSpawn-Port-LaSpezia]

			</Description>
        </EntityComponent>

			<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-CargoSpawn-Port-LaSpezia</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:WW2-CargoShip-LaSpezia-Tripoli]

			[UseRelativeSpawnPosition:true]
			[RelativeSpawnOffset:{X:100 Y:0 Z:120}]
			[IgnoreSafetyChecks:false]

			</Description>
        </EntityComponent>
<!-- End La Spezia Cargo Spawn -->

