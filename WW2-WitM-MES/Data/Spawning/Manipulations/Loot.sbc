<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Default MES Basic Container Profile with Ammo container types swapped out -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-Loot-BasicContainers</SubtypeId>
		</Id>
		<Description>

        [MES Loot]

        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]

        [ContainerTypes:WW2-ContainerTypes-BasicAmmo-1]
        [ContainerTypes:WW2-ContainerTypes-BasicAmmo-1]
        [ContainerTypes:WW2-ContainerTypes-BasicAmmo-2]

        [ContainerTypes:MES-ContainerTypes-BasicComponents-1]
        [ContainerTypes:MES-ContainerTypes-BasicComponents-1]
        [ContainerTypes:MES-ContainerTypes-BasicComponents-2]

        [ContainerTypes:MES-ContainerTypes-BasicIngots-1]
        [ContainerTypes:MES-ContainerTypes-BasicIngots-1]
        [ContainerTypes:MES-ContainerTypes-BasicIngots-2]

        [ContainerTypes:MES-ContainerTypes-BasicOres-1]
        [ContainerTypes:MES-ContainerTypes-BasicOres-1]
        [ContainerTypes:MES-ContainerTypes-BasicOres-2]

        [ContainerTypes:MES-ContainerTypes-Credits-1]
        [ContainerTypes:MES-ContainerTypes-Credits-2]

        [MinBlocks:8]
        [MaxBlocks:12]
			
		</Description>
	</EntityComponent>
	
<!-- Ammo container Profile -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-Loot-AmmoDepot</SubtypeId>
		</Id>
		<Description>

        [MES Loot]

        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]

        [ContainerTypes:WW2-ContainerTypes-BasicAmmo-2]
        [ContainerTypes:WW2-ContainerTypes-BasicAmmo-2]
        [ContainerTypes:WW2-ContainerTypes-BasicAmmo-3]

        [MinBlocks:6]
        [MaxBlocks:10]
			
		</Description>
	</EntityComponent>

<!-- Loot Profile that puts AWG hand weapons in weapon racks -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-Loot-WeaponRacks</SubtypeId>
		</Id>
		<Description>

        [MES Loot]

        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockWeaponRack]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockWeaponRack]

        [ContainerTypes:WW2-ContainerTypes-BasicWeapons-1]

        [MinBlocks:5]
        [MaxBlocks:10]
			
		</Description>
	</EntityComponent>

<!-- Loot Profile that puts consumables, tools, credits, and AWG hand weapons in lockers -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-Loot-Lockers</SubtypeId>
		</Id>
		<Description>

        [MES Loot]

        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLockerRoom]
        [ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLockerRoomCorner]
		[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLockers]
		
		[ContainerTypes:MES-ContainerTypes-Consumables-1]
        [ContainerTypes:MES-ContainerTypes-Consumables-2]

        [ContainerTypes:MES-ContainerTypes-Credits-1]

        [ContainerTypes:MES-ContainerTypes-BasicTools-1]
        [ContainerTypes:MES-ContainerTypes-MixedTools-1]
		
        [ContainerTypes:WW2-ContainerTypes-BasicWeapons-1]

        [MinBlocks:5]
        [MaxBlocks:10]
			
		</Description>
	</EntityComponent>

	</EntityComponents>
</Definitions>

