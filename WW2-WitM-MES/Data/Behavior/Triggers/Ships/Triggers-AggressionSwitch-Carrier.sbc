<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Trigger to engage target -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-AggressionSwitch-Carrier</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:5000]
			
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-AggressionSwitch-Carrier]
			
			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-AggressionSwitch-Carrier</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-AggressionSwitch-Carrier]

			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]

			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-AggressionSwitch-Carrier]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-PassiveSwitch-Carrier]
			[EnableTriggerNames:WW2-Trigger-PassiveSwitchNoTarget-Carrier]

			</Description>
        </EntityComponent>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-AggressionSwitch-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[MinTime:120]
			[MaxTime:121]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			[BroadcastRandomly:true]
			[Author:{GridName}]
			[Color:Red]

			[ChatMessages:Someone dares approach! Engaging!]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			[ChatMessages:Contact sighted, combat stations everyone!]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

      </Description>
    </EntityComponent>
<!-- End Trigger to engage target -->

<!-- Trigger to disengage from target -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-PassiveSwitch-Carrier</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:TargetFar]
			[TargetDistance:9000]
			
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-PassiveSwitch-Carrier]
			
			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-PassiveSwitchNoTarget-Carrier</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:NoTarget]
			
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-PassiveSwitch-Carrier]
			
			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-PassiveSwitch-Carrier</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-PassiveSwitch-Carrier]

			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]

			[ChangeAutopilotSpeed:true]
			[NewAutopilotSpeed:-1]

			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-PassiveSwitch-Carrier]
			[DisableTriggerNames:WW2-Trigger-PassiveSwitchNoTarget-Carrier]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-AggressionSwitch-Carrier]

			</Description>
        </EntityComponent>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-PassiveSwitch-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]

			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[MinTime:120]
			[MaxTime:121]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:10000]
			[BroadcastRandomly:true]
			[Author:{GridName}]
			[Color:Red]

			[ChatMessages: Hostile no longer a threat.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			[ChatMessages:Area secured.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

      </Description>
    </EntityComponent>
<!-- End Trigger to disengage from target -->

	</EntityComponents>
</Definitions>