<!-- ==================== CARGO PLANE DELIVERIES ====================
     A cargo plane destination is a factory/hangar/airfield, not an anchor, so the +20 goes to all 3 anchors of the
     delivering faction (flat, like combat). Enabled by WW2-Action-CargoPlane-Destination when the plane is given its
     destination; fires on BehaviorTriggerA (arrival), the same event that starts the loiter. One-sided. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-Delivery-CargoPlane-Gray</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:BehaviorTriggerA]
			[StartsReady:true]
			[MaxActions:1]
