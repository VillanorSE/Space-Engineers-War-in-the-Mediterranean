<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Supply truck convoy routes (production repo design/war-layer-phase2-supply-convoys.md). Per route: the road as [CustomWaypoints:{X:1 Y:2 Z:3},{X:4 Y:5 Z:6}] (one line, no spaces after the commas: MES skips such points) (same list in Lead and Follow, port to destination) and 5 start slots (1 = lead, front of the column). A route stays off until the C# finds all of it filled in. -->
<!-- Civitavecchia port -> Foggia airfield (Gray) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Behavior-Convoy-Civitavecchia-Foggia-Lead</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[UsePlayerDistanceTimer:false]
			[AutopilotData:WW2-Autopilot-ConvoyTruck]
			[TriggerGroups:WW2-Convoy-TriggerGroup-TruckLead-Gray]
			[TriggerGroups:WW2-Points-Group-Gray-UtilityNaval]
			[CustomWaypoints:]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Behavior-Convoy-Civitavecchia-Foggia-Follow</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[UsePlayerDistanceTimer:false]
			[AutopilotData:WW2-Autopilot-ConvoyTruck]
			[TriggerGroups:WW2-Convoy-TriggerGroup-TruckFollow-Gray]
			[TriggerGroups:WW2-Points-Group-Gray-UtilityNaval]
			[CustomWaypoints:]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Start-Civitavecchia-Foggia-1</SubtypeId>
			</Id>
			<Description>
			[RivalAI Waypoint]
			[Waypoint:Static]
			[Coordinates:{X:0 Y:0 Z:0}]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
