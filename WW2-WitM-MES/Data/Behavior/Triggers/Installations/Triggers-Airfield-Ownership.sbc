		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-Airfield-Unowned-BecomeGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RecolorGrid:true]
			[OldBlockColors:{X:0 Y:0 Z:0.9}]
			[NewBlockColors:{X:0 Y:-0.75 Z:0}]
			[ChangeBlockOwnership:true]
			[OwnershipBlockNames:Airfield Block]
			[OwnershipBlockFactions:GRAY]
			[OwnershipBlockNames:Store-Airport-Vehicles]
			[OwnershipBlockFactions:GRAY]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Trigger-Airfield-AirCargoSpawn-Gray]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gray-CheckGreen]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gray-CheckUnowned]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-DefenseSpawn-Gray]
			[EnableTriggerNames:WW2-Trigger-OffenseSpawn-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-RequestCargoPlane-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-AirCargoSpawn-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-AirCargoDest-Gray]
						[EnableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Clear]
			[EnableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier2]
			[EnableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier3]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-BotCrew-3]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-Airfield-Unowned-CheckGreen]
			[DisableTriggerNames:WW2-Trigger-Airfield-Unowned-CheckGray]
			[SetCustomStrings:true]
			[CustomStrings:NewOwner,The Gray]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Airfield-Captured]
			</Description>
		</EntityComponent>
