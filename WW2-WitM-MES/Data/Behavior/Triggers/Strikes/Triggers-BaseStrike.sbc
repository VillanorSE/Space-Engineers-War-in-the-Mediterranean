			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Event-BaseStrike-CooldownEnd-Gray</SubtypeId>
			</Id>
			<Description>
			[MES Event]
			[UseEvent:true]
			[UniqueEvent:false]
			[StartsReady:false]
			[MinCooldownMs:3600000]
			[MaxCooldownMs:5400000]
			[OnFailResetCooldown:true]
			[ConditionIds:WW2-EventCondition-BaseStrike-Cooldown-Gray]
			[ActionIds:WW2-EventAction-BaseStrike-CooldownEnd-Gray]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-EventCondition-BaseStrike-Cooldown-Gray</SubtypeId>
			</Id>
			<Description>
