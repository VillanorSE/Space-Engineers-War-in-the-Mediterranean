<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Spawn Conditions for Fighters to be Rival AI only spawns -->
<!-- SkipVoxelSpawnChecks: the spawn point is random open air; a non-planet voxel map (wreck, asteroid) bounding box around it would fail OtherNPC placement ("Path/Placement Invalid"). -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Fighters</SubtypeId>
		</Id>
		<Description>
		
			[MES Spawn Conditions]
			
			[RivalAiSpawn:true]
			
			[RotateFirstCockpitToForward:true]
			[ReplenishSystems:true]
			
			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
				[SkipVoxelSpawnChecks:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			
			[IgnoreCombatPhase:true]
			[IgnoreShieldProviderMod:true]
			[IgnoreWeaponRandomizerMod:true]

		</Description>
	</EntityComponent>
<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Fighters-WL3</SubtypeId>
		</Id>
		<Description>
		
			[MES Spawn Conditions]
			
			[RivalAiSpawn:true]
			
			[RotateFirstCockpitToForward:true]
			[ReplenishSystems:true]
			
			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
				[SkipVoxelSpawnChecks:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			
			[IgnoreCombatPhase:true]
			[IgnoreShieldProviderMod:true]
			[IgnoreWeaponRandomizerMod:true]

					[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:3]
			[SandboxCounterCompareTypes:GreaterOrEqual]
</Description>
	</EntityComponent>
<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Fighters-WL2</SubtypeId>
		</Id>
		<Description>
		
			[MES Spawn Conditions]
			
			[RivalAiSpawn:true]
			
			[RotateFirstCockpitToForward:true]
			[ReplenishSystems:true]
			
			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
				[SkipVoxelSpawnChecks:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			
			[IgnoreCombatPhase:true]
			[IgnoreShieldProviderMod:true]
			[IgnoreWeaponRandomizerMod:true]

					[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:2]
			[SandboxCounterCompareTypes:GreaterOrEqual]
</Description>
	</EntityComponent>

	</EntityComponents>
</Definitions>

