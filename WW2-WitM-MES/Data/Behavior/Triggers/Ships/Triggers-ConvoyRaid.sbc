<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Convoy raids: enemy attackers spawned only while a friendly player (rep >= 500) escorts the convoy (PlayerNear 3km).
     Add [TriggerGroups:WW2-TriggerGroup-ConvoyRaid-{Gray|Green}] (convoy's own faction) to a cargo ship behavior.
     Wave trigger -> ManuallyActivateTrigger tag -> one war-level tier passes its condition.
     WarLevel is unset at level 1, so WL1 runs as the ElseActions of an AtLeast2 check.
     18-25 min cooldown: one wave on the shortest leg with StartsReady:false; MaxActions = safety cap: longest leg / 18 min + 1 (Gray La Spezia-Tripoli 6, Green Toulon-Alexandria 11). -->

<!-- Gray convoy (Green raiders) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-TriggerGroup-ConvoyRaid-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI TriggerGroup]

			[Triggers:WW2-Trigger-ConvoyRaid-Wave-Gray]
			[Triggers:WW2-Trigger-ConvoyRaid-WL1-Gray]
			[Triggers:WW2-Trigger-ConvoyRaid-WL2-Gray]
			[Triggers:WW2-Trigger-ConvoyRaid-WL3-Gray]
			[Triggers:WW2-Trigger-ConvoyRaid-WL4-Gray]
			[Triggers:WW2-Trigger-ConvoyRaid-WL5-Gray]

			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-ConvoyRaid-Wave-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:3000]
			[MinPlayerReputation:500]

			[MinCooldownMs:1080000]
			[MaxCooldownMs:1500000]
			[StartsReady:true]

			[MaxActions:6]
			[Actions:WW2-Action-ConvoyRaid-Wave-Gray]

			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-ConvoyRaid-Wave-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:ConvoyRaid-Gray]
			[ForceManualTriggerActivation:false]

			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-ConvoyRaid]

			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-ConvoyRaid-WL1-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:Manual]
			[Tags:ConvoyRaid-Gray]
			[StartsReady:true]
			[MaxActions:-1]

			[Conditions:WW2-WarLevel-Condition-AtLeast2]
			[UseElseActions:true]
			[ElseActions:WW2-Action-ConvoyRaid-WL1-Gray]

			</Description>
        </EntityComponent>
