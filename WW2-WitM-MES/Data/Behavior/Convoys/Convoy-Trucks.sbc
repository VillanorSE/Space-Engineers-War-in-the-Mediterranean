			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[Conditions:WW2-Convoy-Condition-Tilted]
			[ConditionCheckResetsTimer:true]
			[Actions:WW2-Convoy-Action-Tilted]
