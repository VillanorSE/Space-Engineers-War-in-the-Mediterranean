<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<SpawnGroups>

<!-- Player-base strikes and retaliation (D-036), spawned by MES as planetary cargo ships. The lead plane has the strike behavior
     (cooldown, radio, news); wingmen use the normal fighter behaviors. Retaliation is not territory-gated. WL1 retaliation stays in the
     pool at every War Level (an unset WarLevel can not be tested), so it has a low Frequency. -->

<!-- Ba.65 -->
<SpawnGroup>
	<Id>
		<TypeId>SpawnGroupDefinition</TypeId>
		<SubtypeId>NPC-WW2-Strike-Gray-Small-WL2</SubtypeId>
	</Id>
	<Description>

	[Modular Encounters SpawnGroup]

	[SpawnConditionsProfiles:WW2-SpawnConditions-BaseStrike-Gray-Small-WL2]
	[PersistentConditions:WW2-SpawnConditions-Territory-Gray]
	[ReplenishSystems:true]
	[ManipulationProfiles:MES-Manipulation-RivalAi]
	[ManipulationProfiles:WW2-Manipulation-Loot-Medium]
	[ManipulationProfiles:WW2-Manipulation-CombatPlanes]
	[FactionOverride:GRAY]

	</Description>
	<Frequency>1.0</Frequency>
	<IsPirate>true</IsPirate>
	<Prefabs>
		<Prefab SubtypeId="NPC-WW2-Ba65">
			<Position>
				<X>0.0</X>
				<Y>0.0</Y>
				<Z>0.0</Z>
			</Position>
			<Behaviour>WW2-Behavior-Strike-Gray</Behaviour>
			<Speed>55.0</Speed>
		</Prefab>
	</Prefabs>
</SpawnGroup>

