<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- One profile per Factory plane, each forcing exactly its own plane as the store's only offer
     (MinOfferItems=MaxOfferItems=1, RequiredOffers matching that plane's own StoreItemId).
     Applied to an actual Store block via WW2-Store-Behavior-FactoryPlaneSales.sbc, referenced
     from each Factory's own existing Behavior. -->
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Re2000</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-Re2000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Re2001</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-Re2001]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-FC20</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-FC20]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-SM79Bomber</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-SM79Bomber]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-SM79Torpedo</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-SM79Torpedo]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-V156FBomber</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-V156FBomber]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-V156FTorpedo</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-V156FTorpedo]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-MS406</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-MS406]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Potez630</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-Potez630]
			</Description>
		</EntityComponent>

<!-- Each of the 7 Port locations (4 faction Ports + Valencia) runs TWO Store blocks: one named
     "Store-Port-Goods" (all 7 locations run the SAME shared profile below,
     WW2-Store-Profile-PortGoods - goods aren't faction-specific) and one named
     "Store-Port-Vehicles" (one of 3 faction-specific profiles: -Gray/-Green/-Valencia). Aircraft
     are not sold here - planes are a Factory-only offer, see WW2-Store-Profile-Port-Re2000 etc.
     above.
     FileSource is WW2-Store-StoreItems-PortCatalog.xml for all of these - see that file for the
     full catalog and pricing. MinOfferItems=MaxOfferItems=total RequiredOffers count so nothing
     rotates out. Applied via WW2-Store-Behavior-PortSales.sbc, referenced from each location's
     Behaviors-Port.sbc entry. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-PortGoods</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-PortCatalog.xml]
			[MinOfferItems:21]
			[MaxOfferItems:21]
			[ItemsRequireInventory:false]

			[RequiredOffers:WW2-Goods-Ice]
			[RequiredOffers:WW2-Goods-Iron]
			[RequiredOrders:WW2-Goods-Iron]
			[RequiredOffers:WW2-Goods-Nickel]
			[RequiredOrders:WW2-Goods-Nickel]
			[RequiredOffers:WW2-Goods-Silicon]
			[RequiredOrders:WW2-Goods-Silicon]
			[RequiredOffers:WW2-Goods-Cobalt]
			[RequiredOrders:WW2-Goods-Cobalt]
			[RequiredOffers:WW2-Goods-Silver]
			[RequiredOrders:WW2-Goods-Silver]
			[RequiredOffers:WW2-Goods-Gold]
			[RequiredOrders:WW2-Goods-Gold]
			[RequiredOffers:WW2-Goods-Platinum]
			[RequiredOrders:WW2-Goods-Platinum]
			[RequiredOffers:WW2-Goods-Uranium]
			[RequiredOrders:WW2-Goods-Uranium]
			[RequiredOffers:WW2-Goods-SalvageAlloy]
			[RequiredOrders:WW2-Goods-SalvageAlloy]
			[RequiredOffers:WW2-Goods-SalvagedOrdnance]
			[RequiredOrders:WW2-Goods-SalvagedOrdnance]
			[RequiredOffers:WW2-Goods-Welder2]
			[RequiredOffers:WW2-Goods-Welder3]
			[RequiredOffers:WW2-Goods-Grinder2]
			[RequiredOffers:WW2-Goods-Grinder3]
			[RequiredOffers:WW2-Goods-Drill2]
			[RequiredOffers:WW2-Goods-Drill3]
			[RequiredOffers:WW2-Goods-Medkit]
			[RequiredOffers:WW2-Goods-Powerkit]
			[RequiredOffers:WW2-Goods-HydrogenBottle]
			[RequiredOffers:WW2-Goods-OxygenBottle]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Vehicles-Gray</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-PortCatalog.xml]
			[MinOfferItems:4]
			[MaxOfferItems:4]
			[ItemsRequireInventory:false]

			[RequiredOffers:WW2-Vehicle-Fiat626]
			[RequiredOffers:WW2-Vehicle-Gabbiano]
			[RequiredOffers:WW2-Vehicle-GoloItalian]
			[RequiredOffers:WW2-Vehicle-FrancescoCrispi]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Vehicles-Green</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-PortCatalog.xml]
			[MinOfferItems:4]
			[MaxOfferItems:4]
			[ItemsRequireInventory:false]

			[RequiredOffers:WW2-Vehicle-RenaultAHN]
			[RequiredOffers:WW2-Vehicle-LaMalouine]
			[RequiredOffers:WW2-Vehicle-GoloFrench]
			[RequiredOffers:WW2-Vehicle-Bougainville]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Vehicles-Valencia</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-PortCatalog.xml]
			[MinOfferItems:8]
			[MaxOfferItems:8]
			[ItemsRequireInventory:false]

			[RequiredOffers:WW2-Vehicle-Fiat626]
			[RequiredOffers:WW2-Vehicle-RenaultAHN]
			[RequiredOffers:WW2-Vehicle-Gabbiano]
			[RequiredOffers:WW2-Vehicle-LaMalouine]
			[RequiredOffers:WW2-Vehicle-GoloItalian]
			[RequiredOffers:WW2-Vehicle-GoloFrench]
			[RequiredOffers:WW2-Vehicle-Ju52]
			[RequiredOffers:WW2-Vehicle-F222]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
