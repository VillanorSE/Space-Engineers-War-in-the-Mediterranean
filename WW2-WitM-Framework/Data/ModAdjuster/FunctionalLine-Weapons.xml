  <CubeBlocks>

    <!-- Source: workshop 2844434226, Data/CubeBlocks/AA/37mm50MLE.sbc (original CriticalComponent: SteelPlate) -->
    <Definition xsi:type="ConveyorSorterDefinition">
      <Id Type="MyObjectBuilder_ConveyorSorter" Subtype="37mm50MLE" />
      <Components>
        <Component Subtype="SteelPlate" Count="10" />
        <Component Subtype="MetalGrid" Count="5" />
        <Component Subtype="LargeTube" Count="6" />
        <Component Subtype="Motor" Count="5" />
        <Component Subtype="Computer" Count="2" />
        <Component Subtype="Construction" Count="20" />
        <Component Subtype="MetalGrid" Count="10" />
        <Component Subtype="SteelPlate" Count="25" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
    </Definition>

