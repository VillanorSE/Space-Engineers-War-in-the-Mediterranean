<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
<!-- Vehicle depots (D-049): one static encounter per depot, all on the shared prefab NPC-WW2-Depot and WW2-Behavior-Depot. The C# opens a depot (WitM-DepotOpen-*) once its position and the prefab exist. -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Depot-Benghazi</SubtypeId>
		</Id>
		<Description>
		[Modular Encounters SpawnGroup]
		[SpawnConditionsProfiles:WW2-SpawnConditions-Depot-Benghazi]
		[GridsAreEditable:false]
		[GridsAreDestructable:false]
		[IgnoreCleanupRules:true]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[FactionOverride:UNOWNED]
		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>false</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Depot">
				<Position>
					<X>0.0</X>
					<Y>0.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Depot</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>
