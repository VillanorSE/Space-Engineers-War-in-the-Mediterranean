<?xml version="1.0"?>
<!-- Twin Breda 38 hull ball mount (M13/40), 2 wide x 2 tall x 1 deep: plain plate and Housing variant (leaning ball
     plate, top plate, angled side plates). Model from se-mod-production tools/breda-ballmount.
     WeaponCore part WitM_Breda38_Twin (Scripts/WW2-WitM/WeaponCore); aiming limits match its HardWare. -->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_LargeTurretBaseDefinition">
      <Id>
        <TypeId>LargeGatlingTurret</TypeId>
        <SubtypeId>WitM_Breda38_BallMount</SubtypeId>
      </Id>
      <DisplayName>Breda 38 Twin MG [Ball Mounted]</DisplayName>
      <Icon>Textures\GUI\Icons\WitM\WitM_Breda38_BallMount.png</Icon>
      <Description>Twin 8 mm Breda 38 machine guns in a hull ball mount, as on the M13/40. The ball sits in the upper 1.5 cells; the guns and grips reach about 0.3 m into the space behind the block.</Description>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="2" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\WitM\Breda38\WitM_Breda38_BallMount.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="8" />
        <Component Subtype="Construction" Count="6" />
        <Component Subtype="Computer" Count="2" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="SmallTube" Count="4" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\WitM\Breda38\WitM_Breda38_BallMount_BS1.mwm" />
        <Model BuildPercentUpperBound="0.80" File="Models\WitM\Breda38\WitM_Breda38_BallMount_BS2.mwm" />
      </BuildProgressModels>
      <OverlayTexture>Textures\GUI\Screens\turret_overlay.dds</OverlayTexture>
      <WeaponDefinitionId Subtype="SmallGatlingTurret" />
      <AiEnabled>false</AiEnabled>
      <CameraDummyName>camera</CameraDummyName>
      <MinElevationDegrees>-10</MinElevationDegrees>
      <MaxElevationDegrees>20</MaxElevationDegrees>
      <MinAzimuthDegrees>-20</MinAzimuthDegrees>
      <MaxAzimuthDegrees>20</MaxAzimuthDegrees>
      <IdleRotation>false</IdleRotation>
      <MaxRangeMeters>0</MaxRangeMeters>
      <RotationSpeed>0.0015</RotationSpeed>
      <ElevationSpeed>0.0015</ElevationSpeed>
      <TargetingGroups>
        <string>Weapons</string>
      </TargetingGroups>
      <IsAirTight>false</IsAirTight>
      <InventoryMaxVolume>0.15</InventoryMaxVolume>
      <DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
      <DamagedSound>ParticleWeapExpl</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <ResourceSinkGroup>Defense</ResourceSinkGroup>
      <BuildTimeSeconds>15</BuildTimeSeconds>
      <PCU>100</PCU>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_LargeTurretBaseDefinition">
      <Id>
        <TypeId>LargeGatlingTurret</TypeId>
        <SubtypeId>WitM_Breda38_BallMount_Housing</SubtypeId>
      </Id>
      <DisplayName>Breda 38 Twin MG [Ball Mounted, Housing]</DisplayName>
      <Icon>Textures\GUI\Icons\WitM\WitM_Breda38_BallMount_Housing.png</Icon>
      <Description>Twin 8 mm Breda 38 machine guns in the M13/40 hull MG housing: a low box with a ledge, then the ball plate leaning back under a top plate, with angled side plates filling the 2 x 2 front. The guns and grips reach about 0.55 m into the space behind the block.</Description>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="2" y="2" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\WitM\Breda38\WitM_Breda38_BallMount_Housing.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="16" />
        <Component Subtype="Construction" Count="6" />
        <Component Subtype="Computer" Count="2" />
        <Component Subtype="Motor" Count="1" />
        <Component Subtype="SmallTube" Count="4" />
        <Component Subtype="Construction" Count="2" />
        <Component Subtype="SteelPlate" Count="4" />
      </Components>
      <CriticalComponent Subtype="Motor" Index="0" />
      <BuildProgressModels>
        <Model BuildPercentUpperBound="0.50" File="Models\WitM\Breda38\WitM_Breda38_BallMount_Housing_BS1.mwm" />
        <Model BuildPercentUpperBound="0.80" File="Models\WitM\Breda38\WitM_Breda38_BallMount_Housing_BS2.mwm" />
      </BuildProgressModels>
      <OverlayTexture>Textures\GUI\Screens\turret_overlay.dds</OverlayTexture>
      <WeaponDefinitionId Subtype="SmallGatlingTurret" />
      <AiEnabled>false</AiEnabled>
      <CameraDummyName>camera</CameraDummyName>
      <MinElevationDegrees>-10</MinElevationDegrees>
      <MaxElevationDegrees>20</MaxElevationDegrees>
      <MinAzimuthDegrees>-20</MinAzimuthDegrees>
      <MaxAzimuthDegrees>20</MaxAzimuthDegrees>
      <IdleRotation>false</IdleRotation>
      <MaxRangeMeters>0</MaxRangeMeters>
      <RotationSpeed>0.0015</RotationSpeed>
      <ElevationSpeed>0.0015</ElevationSpeed>
      <TargetingGroups>
        <string>Weapons</string>
      </TargetingGroups>
      <IsAirTight>false</IsAirTight>
      <InventoryMaxVolume>0.15</InventoryMaxVolume>
      <DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
      <DamagedSound>ParticleWeapExpl</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Small</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <ResourceSinkGroup>Defense</ResourceSinkGroup>
      <BuildTimeSeconds>15</BuildTimeSeconds>
      <PCU>100</PCU>
    </Definition>
  </CubeBlocks>
</Definitions>
