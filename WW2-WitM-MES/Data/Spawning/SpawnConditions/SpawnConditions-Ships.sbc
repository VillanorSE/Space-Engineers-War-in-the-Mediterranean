<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Spawn Conditions for ships. They utilize a minimum water depth and a minimum water coverage. Minimum water coverage is what ratio of an area around the spawn must be water. -->

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Ships-Utility</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[PlanetaryInstallation:true]
			[RivalAiPlanetaryInstallation:true]
			[InstallationSpawnsOnWaterSurface:true]
			[InstallationSpawnsOnDryLand:false]
			[MinWaterDepth:10]
			[MinWaterCoverage:0.4]

			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[ReplenishSystems:true]

			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]

		</Description>
	</EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Ships-Corvettes</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[PlanetaryInstallation:true]
			[RivalAiPlanetaryInstallation:true]
			[InstallationSpawnsOnWaterSurface:true]
			[InstallationSpawnsOnDryLand:false]
			[MinWaterDepth:15]
			[MinWaterCoverage:0.45]

			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[ReplenishSystems:true]

			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]

		</Description>
	</EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
