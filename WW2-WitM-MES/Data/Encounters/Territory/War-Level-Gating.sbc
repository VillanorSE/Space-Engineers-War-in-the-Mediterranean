<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- War Level gating - RivalAI Condition profiles for [Conditions:] tags (Triggers/store actions),
     distinct from the SpawnConditions-embedded [CheckCustomSandboxCounters:] gate used directly on
     combat/wreck/factory/hangar SpawnGroups (see SpawnConditions-*.sbc's *-WL{N} clones).

     These test the WarLevel counter itself (1-5), NOT WarActivity (War-Level-Points.sbc tests
     WarActivity to decide when WarLevel changes). Gate anything on level N (N>=2) with
     WW2-WarLevel-Condition-AtLeastN; level 1 needs no gate (nothing to check - it's always true).
     Kept in a separate file from the generated War-Level-Points.sbc so re-running that script's
     generator never wipes these. -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Condition-AtLeast2</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:2]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Condition-AtLeast3</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:3]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Condition-AtLeast4</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:4]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Condition-AtLeast5</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:5]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>

	</EntityComponents>
</Definitions>
