<!-- Unowned state: check Green first, then Gray -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Unowned-CheckGreen</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:1]
			[Conditions:WW2-Condition-Airfield-InGreenTerritory]
			[MatchAnyCondition:false]
			[Actions:WW2-Action-Airfield-Unowned-BecomeGreen]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Unowned-CheckGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:1]
			[Conditions:WW2-Condition-Airfield-InGrayTerritory]
			[Conditions:WW2-Condition-Airfield-NotInGreenTerritory]
			[MatchAnyCondition:false]
			[Actions:WW2-Action-Airfield-Unowned-BecomeGray]
			</Description>
		</EntityComponent>

<!-- Gray state: stay if still in gray zone, else check green, else revert to unowned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Gray-CheckGreen</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:1]
