<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Depot positions (owner). Placeholders stay closed: fill StaticEncounterCoords = TriggerCoords (Build World grid position), Forward and Up, THEN set [StaticEncounter:true]. To move one: false, reload, true, reload. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-Depot-Benghazi</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]

			[StaticEncounter:true]
			[StaticEncounterUsePlanetDirectionAndAltitude:false]
			[StaticEncounterCoords:{X:-18394.026 Y:23504.637 Z:3944.233}]
			[TriggerCoords:{X:-18394.026 Y:23504.637 Z:3944.233}]
			[StaticEncounterPlanet:WW2WitM_Mediterranean]
			[StaticEncounterForward:{X:0.282892 Y:0.062231 Z:0.957131}]
			[StaticEncounterUp:{X:-0.610796 Y:0.781086 Z:0.129743}]
			[ForceExactPositionAndOrientation:true]
			[PlanetWhitelist:WW2WitM_Mediterranean]

			[FactionOwner:UNOWNED]

			[TriggerRadius:20000]

			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[SandboxVariables:WitM-DepotOpen-{SpawnGroupName}]
			</Description>
		</EntityComponent>
