<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Hangar Spawns -->

<!-- Green MS406 Hangar -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Hangar-Green-MS406</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations]
		[PersistentConditions:WW2-SpawnConditions-Territory-Green]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[FactionOverride:GREEN]
		[SpawnRandomCargo:true]

		[UseContainerTypeAssignment:true]
		[ContainerTypeAssignBlockName:Small Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-SmallCargo]

		[ContainerTypeAssignBlockName:Medium Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-MediumCargo]

		</Description>
		<Frequency>1.5</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Hangar">
				<Position>
					<X>-5.0</X>
					<Y>3.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-HangarGarage-Green</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-MS406">
				<Position>
					<X>-7.5</X>
					<Y>5.0</Y>
					<Z>10.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-HangarPlane-MS406</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

