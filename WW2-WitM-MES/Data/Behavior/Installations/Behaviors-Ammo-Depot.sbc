            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Ammo-Depot-Green</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Trigger-ReputationDamageLight-Green]
			
			[Triggers:WW2-Trigger-BotCrew-5]

			</Description>
        </EntityComponent>
		
<!-- End Green Ammo Depot Behaviors -->

	</EntityComponents>
</Definitions>