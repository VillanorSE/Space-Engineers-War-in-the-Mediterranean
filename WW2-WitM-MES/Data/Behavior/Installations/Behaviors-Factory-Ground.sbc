<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>
<!-- Ground vehicle factories (NPC-WW2-Factory-Ground shell). One Behavior per variant, like the plane
     factories: the shell is shared, the spawn group picks the vehicles on display and this Behavior picks
     what the store sells. Same set as the plane factory minus cargo planes, delivery, recirculation and the
     projector build (this shell has no projector). The store block is named "Store-FactoryVehicle". -->
<!-- Gray Factory Behaviors -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Factory-Ground-M1340</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[TriggerGroups:WW2-Points-Group-Gray-Factory]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[TriggerGroups:WW2-TriggerGroup-Retaliation-Tag-Gray]
			[Triggers:WW2-Trigger-Activation-Factory-Plane-Gray]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-DefenseSpawn-Gray]
			[Triggers:WW2-Store-Trigger-UpdateSales-FactoryGround-M1340]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Factory-Ground-AB41</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[TriggerGroups:WW2-Points-Group-Gray-Factory]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[TriggerGroups:WW2-TriggerGroup-Retaliation-Tag-Gray]
			[Triggers:WW2-Trigger-Activation-Factory-Plane-Gray]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-DefenseSpawn-Gray]
			[Triggers:WW2-Store-Trigger-UpdateSales-FactoryGround-AB41]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Factory-Ground-AB43</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[TriggerGroups:WW2-Points-Group-Gray-Factory]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[TriggerGroups:WW2-TriggerGroup-Retaliation-Tag-Gray]
			[Triggers:WW2-Trigger-Activation-Factory-Plane-Gray]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-DefenseSpawn-Gray]
			[Triggers:WW2-Store-Trigger-UpdateSales-FactoryGround-AB43]
			</Description>
        </EntityComponent>
<!-- End Gray Factory Behaviors -->

	</EntityComponents>
</Definitions>
