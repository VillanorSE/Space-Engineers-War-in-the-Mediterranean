<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- Industrial/Military/Advanced Military Components: a DisplayName-only relabel of vanilla's
     PrototechMachinery/Frame/Circuitry, not new items - Size/Mass/Volume/Model/Icon/
     MaxIntegrity/Health stay identical to the underlying vanilla definition, matching how GVK
     (Deserts of Kharak) relabels its own "[Tech]" component tier the same way.
     Craftable via a small amount of Battle Wreckage-derived Salvage Alloy plus ordinary ingots
     (see Blueprints-Salvage.sbc); no longer drop directly as loot (see
     WW2-WitM-MES/Data/ContainerTypes-TechComponents.sbc, which drops Battle Wreckage ore
     instead).
     Economy fields (MinimumOfferAmount/MaximumOfferAmount/MinimumOrderAmount/MaximumOrderAmount/
     CanPlayerOffer/MinimumAcquisitionAmount/MaximumAcquisitionAmount, plus MinimalPricePerUnit
     on PrototechFrame) are the full companion set vanilla requires whenever CanPlayerOrder is
     true - values copied verbatim from vanilla's own PrototechMachinery/Frame/Circuitry
     entries; see WW2-Reference-ModFileDebug.md for why this set is mandatory. -->

	<Components>

		<Component>
			<Id>
				<TypeId>Component</TypeId>
				<SubtypeId>PrototechMachinery</SubtypeId>
			</Id>
			<DisplayName>Industrial Components</DisplayName>
			<Icon>Textures\GUI\Icons\component\PrototechMachinery_Icon.dds</Icon>
			<IconSymbol>S.Cal</IconSymbol>
			<Size>
				<X>1.0</X>
				<Y>1.0</Y>
				<Z>0.03</Z>
			</Size>
			<Mass>80</Mass>
			<Volume>3.5</Volume>
			<Model>Models\Components\PrototechMachinery_Component.mwm</Model>
			<PhysicalMaterial>Metal</PhysicalMaterial>
			<MaxIntegrity>1</MaxIntegrity>
			<Health>20</Health>
			<MinimumOfferAmount>250</MinimumOfferAmount>
			<MaximumOfferAmount>2500</MaximumOfferAmount>
			<MinimumOrderAmount>0</MinimumOrderAmount>
			<MaximumOrderAmount>0</MaximumOrderAmount>
			<CanPlayerOrder>true</CanPlayerOrder>
			<CanPlayerOffer>true</CanPlayerOffer>
			<MinimumAcquisitionAmount>1</MinimumAcquisitionAmount>
			<MaximumAcquisitionAmount>1000</MaximumAcquisitionAmount>
		</Component>

		<Component>
			<Id>
				<TypeId>Component</TypeId>
				<SubtypeId>PrototechFrame</SubtypeId>
			</Id>
			<DisplayName>Military Components</DisplayName>
			<Icon>Textures\GUI\Icons\component\PrototechFrame.dds</Icon>
			<IconSymbol>L.Cal</IconSymbol>
			<Size>
				<X>1.0</X>
				<Y>1.0</Y>
				<Z>0.03</Z>
			</Size>
			<Mass>100</Mass>
			<Volume>5.0</Volume>
			<Model>Models\Components\PrototechFrame.mwm</Model>
			<PhysicalMaterial>Metal</PhysicalMaterial>
			<MaxIntegrity>1</MaxIntegrity>
			<Health>20</Health>
			<MinimalPricePerUnit>100000</MinimalPricePerUnit>
			<MinimumOfferAmount>250</MinimumOfferAmount>
			<MaximumOfferAmount>2500</MaximumOfferAmount>
			<MinimumOrderAmount>0</MinimumOrderAmount>
			<MaximumOrderAmount>0</MaximumOrderAmount>
			<CanPlayerOrder>true</CanPlayerOrder>
			<CanPlayerOffer>true</CanPlayerOffer>
			<MinimumAcquisitionAmount>1</MinimumAcquisitionAmount>
			<MaximumAcquisitionAmount>1000</MaximumAcquisitionAmount>
		</Component>

		<Component>
			<Id>
				<TypeId>Component</TypeId>
				<SubtypeId>PrototechCircuitry</SubtypeId>
			</Id>
			<DisplayName>Advanced Military Components</DisplayName>
			<Icon>Textures\GUI\Icons\component\prototech_circuitry_component.dds</Icon>
			<IconSymbol>Data</IconSymbol>
			<Size>
				<X>1.0</X>
				<Y>1.0</Y>
				<Z>0.03</Z>
			</Size>
			<Mass>60</Mass>
			<Volume>2.0</Volume>
			<Model>Models\Components\prototech_circuitry_component.mwm</Model>
			<PhysicalMaterial>Metal</PhysicalMaterial>
			<MaxIntegrity>1</MaxIntegrity>
			<Health>50</Health>
			<MinimumOfferAmount>250</MinimumOfferAmount>
			<MaximumOfferAmount>2500</MaximumOfferAmount>
			<MinimumOrderAmount>0</MinimumOrderAmount>
			<MaximumOrderAmount>0</MaximumOrderAmount>
			<CanPlayerOrder>true</CanPlayerOrder>
			<CanPlayerOffer>true</CanPlayerOffer>
			<MinimumAcquisitionAmount>1</MinimumAcquisitionAmount>
			<MaximumAcquisitionAmount>1000</MaximumAcquisitionAmount>
		</Component>

	</Components>
</Definitions>
