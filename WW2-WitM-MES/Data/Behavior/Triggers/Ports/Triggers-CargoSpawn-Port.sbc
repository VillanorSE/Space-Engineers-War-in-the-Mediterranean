<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Port Cargo Ship Spawns
     One Timer Trigger -> Action -> Spawn chain per leg, each spawning that leg's own
     direction-specific cargo ship (see Paths-Nautical.sbc / SpawnGroups-CargoShips-Nautical.sbc).
     60-90 min per leg. Toulon runs two independent chains (Oran leg + Alexandria leg) since it's
     the hub port for both Green routes - every other port here only runs one.
     Always-on timer (not gated behind player proximity) - ports run continuous background
     shipping traffic regardless of whether a player has visited. -->

<!-- La Spezia Cargo Spawn (-> Tripoli) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoSpawn-Port-LaSpezia</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:Timer]

			[MinCooldownMs:3600000]
			[MaxCooldownMs:5400000]
			[StartsReady:true]

			[MaxActions:-1]
            [Actions:WW2-Action-CargoSpawn-Port-LaSpezia]

			</Description>
        </EntityComponent>

			<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoSpawn-Port-LaSpezia</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-CargoSpawn-Port-LaSpezia]

			</Description>
        </EntityComponent>

			<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-CargoSpawn-Port-LaSpezia</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:WW2-CargoShip-LaSpezia-Tripoli]

			[UseRelativeSpawnPosition:true]
			[RelativeSpawnOffset:{X:-100 Y:0 Z:-75}]
			[IgnoreSafetyChecks:true]

			</Description>
        </EntityComponent>
<!-- End La Spezia Cargo Spawn -->
<!-- SWITCHED TO FIXED RELATIVE OFFSET: MinDistance/MaxDistance/MinAltitude/MaxAltitude was a
     dead end - confirmed via MES source (Helpers/VectorHelper.cs, GetPlanetRandomSpawnMatrix)
     that altitude there is measured from the TERRAIN/SEAFLOOR voxel surface with zero water
     awareness anywhere in the call chain, so it was placing the ship underwater/inside terrain
     near any harbor deeper than a couple meters and failing the safety check silently.

     RelativeSpawnOffset (confirmed via Spawning/BehaviorSpawnHelper.cs) is a direct
     Vector3D.Transform of {X Y Z} by the spawner's own WorldMatrix - X:Right Y:Up Z:Forward
     relative to however the port's spawner block is actually facing, no terrain/altitude
     lookup at all. Fully deterministic single point every time, no randomness.

     This offset was computed from a user-placed GPS point (GPS:Cargo Spawn - La
     Spezia:7203.84:-27145.87:10823.93) confirmed as a good water spot, projected into La
     Spezia's local frame using SpawnConditions-Ports.sbc's exact StaticEncounterForward/
     StaticEncounterUp vectors and the direction*30101.5 position formula (both verified to
     reproduce this anchor's known Territory-Zones.sbc coordinates exactly). The X (Right)
     component's sign has a small residual uncertainty since it's a derived cross-product axis,
     not given directly in the file - the Y/Z components come straight from file data with no
     such ambiguity. If the ship spawns mirrored to the wrong side, flip X's sign only.
     IgnoreSafetyChecks left true until this offset is confirmed working. -->

<!-- Tripoli Cargo Spawn (-> La Spezia) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoSpawn-Port-Tripoli</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:Timer]

			[MinCooldownMs:3600000]
			[MaxCooldownMs:5400000]
			[StartsReady:true]

			[MaxActions:-1]
            [Actions:WW2-Action-CargoSpawn-Port-Tripoli]

			</Description>
        </EntityComponent>

			<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CargoSpawn-Port-Tripoli</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-CargoSpawn-Port-Tripoli]

			</Description>
        </EntityComponent>

			<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-CargoSpawn-Port-Tripoli</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:WW2-CargoShip-Tripoli-LaSpezia]

			[UseRelativeSpawnPosition:true]
			[RelativeSpawnOffset:{X:150 Y:12 Z:-150}]
			[IgnoreSafetyChecks:true]

			</Description>
        </EntityComponent>
<!-- End Tripoli Cargo Spawn -->
<!-- SWITCHED TO FIXED RELATIVE OFFSET (see La Spezia's comment block earlier in this file for
     the full explanation). Computed from GPS:Cargo Spawn - Tripoli:-3013.74:20577.59:21759.54,
     projected into Tripoli's local frame using SpawnConditions-Ports.sbc's Forward/Up vectors.
     StaticEncounterUp is directly aligned with true planetary "up" for this port (standard
     case, like Alexandria/Toulon/Oran - unlike La Spezia). -->

