			[EscortOffsets:{X:4 Y:0 Z:12}]
			[Triggers:WW2-Convoy-Trigger-AssignSlot-Civitavecchia-Foggia-3]
			[Triggers:WW2-Convoy-Trigger-Request-Civitavecchia-Foggia-2]
			[Triggers:WW2-Convoy-Trigger-HaltReceived-Civitavecchia-Foggia]
			[CustomWaypoints:]
			</Description>
		</EntityComponent>
