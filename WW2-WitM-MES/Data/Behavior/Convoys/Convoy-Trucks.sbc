<!-- Arrival: BehaviorTriggerD fires once when the lead's CargoShip waypoint list runs out (CargoShip.cs), as for the cargo ships. Escorts arrive by the lead's halt command (WW2-Convoy-Action-Halt below). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-Arrived-Lead</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:BehaviorTriggerD]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-Convoy-Action-Arrived-Lead]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Action-Arrived-Lead</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[StopAllRotation:true]
			[ChangeAutopilotSpeed:true]
			[NewAutopilotSpeed:0]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:true]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-EscortPay]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-Delivered]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-Leave]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Convoy-Trigger-Delivered]
			[EnableTriggerNames:WW2-Convoy-Trigger-Leave]
			[EnableTriggerNames:WW2-Convoy-Trigger-EscortPay]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-ParkSettle]
			[EnableTriggerNames:WW2-Convoy-Trigger-ParkSettle]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Convoy-Trigger-EscortTick]
			[DisableTriggerNames:WW2-Convoy-Trigger-Tilt]
			[UseChatBroadcast:true]
			[ChatData:WW2-Convoy-Chat-Arrived]
			</Description>
		</EntityComponent>
<!-- Yard parking (Convoy-Routes.sbc park routes): ask the depot for a spot, follow it slowly, stop for good 50 s later and unload. The depot side is WW2-Depot-Trigger-ConvoyParkAssign (Triggers-Depot-Forces.sbc). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Action-ParkRequest</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeAutopilotSpeed:true]
			[NewAutopilotSpeed:-1]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Convoy-Command-Park]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-ParkStop]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Convoy-Trigger-ParkStop]
			[EnableTriggerTags:WW2-Convoy-ParkedTag]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Command-Park</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:WW2_Convoy_Park]
			[RequestEscortSlot:true]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:300]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-ParkStop</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:50000]
			[MaxCooldownMs:50001]
			[StartsReady:false]
			[MaxActions:1]
			[Actions:WW2-Convoy-Action-ParkStop]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Action-ParkStop</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[LeaveEscortSlot:true]
			[StopAllRotation:true]
			[ChangeAutopilotSpeed:true]
			[NewAutopilotSpeed:0]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:true]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-Delivered]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-Leave]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Convoy-Trigger-Delivered]
			[EnableTriggerNames:WW2-Convoy-Trigger-Leave]
			[ResetTriggerCooldownNames:WW2-Convoy-Trigger-ParkSettle]
			[EnableTriggerNames:WW2-Convoy-Trigger-ParkSettle]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Convoy-Trigger-ParkStop]
			[DisableTriggerTags:WW2-Convoy-ParkedTag]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-ParkSettle</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[StartsReady:false]
			[MaxActions:1]
			[Actions:WW2-Convoy-Action-ParkSettle]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Action-ParkSettle</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ChangeInertiaDampeners:true]
			[InertiaDampenersEnable:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Chat-Arrived</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:1]
			[BroadcastRandomly:true]
			[Author:Convoy]
			[Color:Red]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:3000]

			[ChatMessages:{GridName} has arrived. Unloading.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]

			[ChatMessages:Convoy in. Get those crates off the trucks.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-Delivered</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:false]
			[MaxActions:1]
			[Actions:WW2-Convoy-Action-Delivered]
			</Description>
		</EntityComponent>
<!-- Read by the WW2-WarNews C# (SupplyHooks): the truck's spawn group names its route. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Action-Delivered</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[StopAllRotation:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-Leave</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
