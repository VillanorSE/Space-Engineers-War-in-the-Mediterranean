<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<SpawnGroups>

<!-- Green Attacker Planes -->
<SpawnGroup>
	<Id>
		<TypeId>SpawnGroupDefinition</TypeId>
		<SubtypeId>NPC-WW2-Potez630</SubtypeId>
	</Id>
	<Description>

	[Modular Encounters SpawnGroup]

	[SpawnConditionsProfiles:WW2-SpawnConditions-Fighters]
	[ManipulationProfiles:MES-Manipulation-RivalAi]
	[ManipulationProfiles:WW2-Manipulation-Tech-Military-VeryReliable]
	[ManipulationProfiles:WW2-Manipulation-Tech-AdvancedMilitary-ElitePlane]
	[ManipulationProfiles:WW2-Manipulation-CombatPlanes]
	[FactionOverride:GREEN]
	  
	</Description>
	<Frequency>1.0</Frequency>
	<IsPirate>true</IsPirate>
	<Prefabs>
		<Prefab SubtypeId="NPC-WW2-Potez630">
			<Position>
				<X>0.0</X>
				<Y>0.0</Y>
				<Z>0.0</Z>
			</Position>
			<Behaviour>WW2-Behavior-Fighter-Green</Behaviour>
			<Speed>55.0</Speed>
		</Prefab>
	</Prefabs>
</SpawnGroup>

<!-- 2026-08-28: split into Bomber/Torpedo variants - the bare NPC-WW2-V-156-F prefab (and its
     SpawnGroup) is retired in favor of the two real variant prefabs, same split already done
     for SM79. -->
<SpawnGroup>
	<Id>
		<TypeId>SpawnGroupDefinition</TypeId>
		<SubtypeId>NPC-WW2-V-156-F_Bomber</SubtypeId>
	</Id>
