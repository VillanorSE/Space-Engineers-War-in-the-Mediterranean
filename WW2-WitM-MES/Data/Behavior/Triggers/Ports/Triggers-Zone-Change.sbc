<!-- Shared Grow/Shrink actions + chats -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusGrow-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:LaSpezia_Zone]
			[ZoneRadiusChangeType:Add]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Grow-LaSpezia]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusShrink-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:LaSpezia_Zone]
			[ZoneRadiusChangeType:Subtract]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Shrink-LaSpezia]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Grow-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:La Spezia Command]
			[Color:Blue]
			[ChatMessages:La Spezia territory has expanded.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Shrink-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:La Spezia Command]
			[Color:Blue]
			[ChatMessages:La Spezia territory has contracted.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>

