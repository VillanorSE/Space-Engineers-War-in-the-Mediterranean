			[Tags:DepotGarageBay-Green]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-WarLevel-Condition-Exactly2]
			[Actions:WW2-Depot-Action-GarageBay-WL2-Green]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-GarageBay-WL2-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SpawnEncounter:true]
			[Spawner:WW2-Depot-Spawn-GarageBay-WL2-Green]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Spawn-GarageBay-WL2-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[SpawnGroups:WW2-DepotGarageBay-WL2-Green]
			[UseRelativeSpawnPosition:true]
			[RelativeSpawnOffset:{X:20 Y:3.75 Z:22.5}]
			[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBay-WL3-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:DepotGarageBay-Green]
			[StartsReady:true]
