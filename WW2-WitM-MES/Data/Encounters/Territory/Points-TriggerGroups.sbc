<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Territory / War Level points trigger groups. GENERATED. -->

<!-- Points trigger groups. Add ONE line to a behavior to make that NPC score:
       [TriggerGroups:WW2-Points-Group-{Gray|Green}-{Type}]
     Types: Carrier, Battleship, HeavyCruiser, Cruiser, Destroyer, Submarine, Corvette, UtilityNaval, UtilityAir, Bomber, Attacker, Fighter, Factory, Hangar.
     Each group = the faction+type territory kill trigger, the type War Activity triggers (first attack, kill,
     a one-way War Activity increase), and the shared Retire triggers. Cargo ships and
     planes additionally get their delivery triggers listed directly on their behaviors. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Points-Group-Gray-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI TriggerGroup]

			[Triggers:WW2-Territory-Trigger-Kill-Gray-Carrier]
			[Triggers:WW2-WarLevel-Trigger-Attacked-Carrier]
			[Triggers:WW2-WarLevel-Trigger-Kill-Carrier]
			[Triggers:WW2-Points-Trigger-Retire-Despawn]
			[Triggers:WW2-Points-Trigger-Retire-DespawnMES]

			</Description>
		</EntityComponent>
