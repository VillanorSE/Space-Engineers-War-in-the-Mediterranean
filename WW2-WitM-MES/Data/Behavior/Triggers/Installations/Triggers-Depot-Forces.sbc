		</EntityComponent>
<!-- Convoy parking: an escort truck past the gate halt asks with WW2_Convoy_Park (Convoy-Trucks.sbc); the depot assigns it its closest free spot (the depot's EscortOffsets) with the convoy's shared WW2-Convoy-Action-AssignSlot. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-ConvoyParkAssign</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:WW2_Convoy_Park]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Convoy-Action-AssignSlot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Condition-GarageBayEmpty</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:GarageBayOccupied]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBayOccupied</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:WitM-GarageBayOccupied]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Depot-Action-GarageBayOccupied]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-GarageBayOccupied</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetBooleansTrue:GarageBayOccupied]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBayPing</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Depot-Action-GarageBayPing]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-GarageBayPing</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Command-GarageBayPing]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Command-GarageBayPing</SubtypeId>
			</Id>
			<Description>
			[RivalAI Command]
			[CommandCode:WitM-GarageBayOccupied]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:150]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
