<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>
<!-- Swaps autopilot profiles when a run starts and at breakaway. -->

	<!-- Run starts: switch to the Run autopilot. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-FighterRunStart</SubtypeId>
            </Id>
            <Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:BehaviorTriggerB]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-FighterRunStart]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-FighterRunStart</SubtypeId>
            </Id>
            <Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Tertiary]
			</Description>
        </EntityComponent>

	<!-- Breakaway: switch back to the Approach autopilot. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-FighterRunEnd</SubtypeId>
            </Id>
            <Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:BehaviorTriggerA]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-FighterRunEnd]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-FighterRunEnd</SubtypeId>
            </Id>
            <Description>
			[RivalAI Action]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			</Description>
        </EntityComponent>

	</EntityComponents>
</Definitions>
