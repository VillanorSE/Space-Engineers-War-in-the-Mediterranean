<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Spawn sequence for a Gray cargo plane -->
	<!-- Triggers Every 30-45 Minutes -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DeliverySpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			
			[MaxActions:-1]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:2700000]
			
            [Actions:WW2-Action-DeliverySpawn-Factory-Plane-Gray]
			
			</Description>
        </EntityComponent>

	<!-- Broadcasts a request for the nearest owned airfield to spawn the cargo plane instead
	     of spawning it here directly (see Triggers-AirfieldCargoRequest.sbc) - the plane then
	     navigates to this factory exactly as before via the existing WW2-Trigger-CallCargoPlane
	     broadcast, unchanged. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DeliverySpawn-Factory-Plane-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Command-RequestCargoPlane-Gray]

			</Description>
        </EntityComponent>
<!-- End Spawn sequence for a Gray cargo plane -->

<!-- Spawn sequence for a Green cargo plane -->
	<!-- Triggers Every 30-45 Minutes -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DeliverySpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Timer]
			[StartsReady:false]
			
			[MaxActions:-1]
			[MinCooldownMs:1800000]
			[MaxCooldownMs:2700000]
			
            [Actions:WW2-Action-DeliverySpawn-Factory-Plane-Green]
			
			</Description>
        </EntityComponent>

	<!-- Broadcasts a request for the nearest owned airfield to spawn the cargo plane instead
	     of spawning it here directly (see Triggers-AirfieldCargoRequest.sbc) - the plane then
	     navigates to this factory exactly as before via the existing WW2-Trigger-CallCargoPlane
	     broadcast, unchanged. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DeliverySpawn-Factory-Plane-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[BroadcastCommandProfiles:true]
			[CommandProfileIds:WW2-Command-RequestCargoPlane-Green]

			</Description>
        </EntityComponent>
<!-- End Spawn sequence for a Green cargo plane -->

	<!-- Cargo-plane spawn requests, one per faction. [SingleRecipient:true] picks the closest
	     matching receiver (approximates "nearest airfield" - MES doesn't expose true
	     nearest-of-N routing, single-recipient proximity selection is the closest confirmed
	     primitive). [MatchSenderReceiverOwners:true] ensures a Gray factory only ever wakes a
	     Gray-owned airfield, never a Green or Unowned one - see Triggers-AirfieldCargoRequest.sbc
	     for the receiving side. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Command-RequestCargoPlane-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Command]

			[CommandCode:RequestCargoPlane-Gray]
			[SingleRecipient:true]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:50000]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Command-RequestCargoPlane-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Command]

			[CommandCode:RequestCargoPlane-Green]
			[SingleRecipient:true]
			[MatchSenderReceiverOwners:true]
			[IgnoreAntennaRequirement:true]
			[IgnoreReceiverAntennaRequirement:true]
			[Radius:50000]

			</Description>
        </EntityComponent>

	</EntityComponents>
</Definitions>