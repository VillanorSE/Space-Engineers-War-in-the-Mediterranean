<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Friendly Player Near Actions -->
	<!-- Player within 800m with standing >=-499 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-FriendlyNear-Cargo</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:800]
			[StartsReady:true]
			
			[MaxActions:1]

			[MinPlayerReputation:-499]

            [Actions:WW2-Action-FriendlyNear-Cargo]

			</Description>
        </EntityComponent>

	<!-- Takes Chat Action -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-FriendlyNear-Cargo</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-FriendlyNear-Cargo]

			</Description>
        </EntityComponent>
		
	<!-- Broadcasts a random friendly chat -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Chat-FriendlyNear-Cargo</SubtypeId>
            </Id>
            <Description>

			[RivalAI Chat]
			
			[UseChat:true]
            [StartsReady:true]
            [BroadcastRandomly:true]
			[Author:{GridName}]
			[Color:Green]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:2000]

			[MaxChats:1]

            [ChatMessages:An actual escort? Things are looking up!]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]

            [ChatMessages:Did you come to admire our paint job?]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]
			
			[ChatMessages:If you're willing to escort us to our destination we would appreciate it.]
            [ChatAudio:ArcHudGPSNotification2]
            [BroadcastChatType:Chat]

			</Description>
        </EntityComponent>
<!-- End Friendly Player Near Actions -->

	</EntityComponents>
</Definitions>