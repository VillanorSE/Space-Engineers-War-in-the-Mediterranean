<?xml version="1.0"?>
<WaterConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!--
    Water Mod config for this planet; radius confirmed working at 1.029
    (matches this planet's own confirmed empirical value from in-game
    testing; the /wexport-produced value below was 1.02995, rounded to
    1.029 per direct request). Buoyancy, waves, and the rest of
    WaterSettings below were captured via /wexport after tuning in-game and
    are treated as final, not a template needing further in-game steps.
  -->

  <PlanetConfigs>
    <PlanetConfig TypeId="MyObjectBuilder_PlanetGeneratorDefinition" SubtypeId="WW2WitM_Mediterranean">
      <WaterSettings>
        <Radius>1.02862</Radius>
		<WaveHeight>2</WaveHeight>
		<WaveSpeed>0.08</WaveSpeed>
		<Buoyancy>1</Buoyancy>
		<WaveScale>1</WaveScale>
		<EnableFish>true</EnableFish>
		<EnableSeagulls>true</EnableSeagulls>
		<Texture>
			<String>JWater2</String>
		</Texture>
		<Transparent>true</Transparent>
		<Lit>true</Lit>
		<FogColor>
			<X>0.1</X>
			<Y>0.3</Y>
			<Z>0.5</Z>
		</FogColor>
		<CollectionRate>1</CollectionRate>
		<TideHeight>2</TideHeight>
		<TideSpeed>0.05</TideSpeed>
		<EnableFoam>true</EnableFoam>
		<CrushDamage>0.5</CrushDamage>
		<PlayerDrag>true</PlayerDrag>
		<CurrentSpeed>0.5</CurrentSpeed>
		<CurrentScale>0.005</CurrentScale>
		<MaterialId>Water</MaterialId>
      </WaterSettings>
      <ColorIntensity>1</ColorIntensity>
      <Specularity>8</Specularity>
      <SpecularIntensity>2</SpecularIntensity>
      <AmbientColorIntensity>0.2</AmbientColorIntensity>
	  <DistantRadiusOffset>0.021</DistantRadiusOffset>
	<DistantRadiusScaler>2</DistantRadiusScaler>
	<DistantSoftnessOffset>0.003</DistantSoftnessOffset>
	<DistantSoftnessScaler>2</DistantSoftnessScaler>
	<DistantSoftnessMultiplier>5</DistantSoftnessMultiplier>
    </PlanetConfig>
  </PlanetConfigs>

  <CharacterConfigs>
    <CharacterConfig SubtypeId="Default_Astronaut" Volume="0.1" SwimForce="40" CanBreathUnderwater="false" MaximumPressure="2940" />
  </CharacterConfigs>

  <WaterTextures>
    <Texture>JWater2</Texture>
  </WaterTextures>

</WaterConfig>
