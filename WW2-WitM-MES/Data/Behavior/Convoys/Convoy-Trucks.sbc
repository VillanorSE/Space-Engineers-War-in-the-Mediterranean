<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Supply truck behavior pieces shared by every route (Convoy-Routes.sbc). Trucks drive the route's waypoints on MES thrust (no wheel steering in MES), stop at the last one, deliver after 60 s (the C# credits the destination on WW2-Convoy-Action-Delivered) and despawn 5 s later. GiveUp despawns a stuck truck after 2 h (C# refunds its port). Ground handling copied from Mike Dude's Land Escorts (2653133286): dampeners off while driving and an AltitudeTolerance far above IdealPlanetAltitude, so MES never fires the up/down thrusters and gravity keeps the wheels down (with dampeners on, the thrusters held the grid up and it flew off downhill slopes). MES only applies DisableInertiaDampeners at spawn, not on profile switches, so stops turn them on with an action. Dampeners go on at arrival. The lead (IdealMaxSpeed 10, no slow-down before each waypoint) drives the route; slots 2-5 are MES escorts in a staggered line behind it (see the escort block below and Convoy-Routes.sbc). Pitched more than 16 deg, a truck switches to the Tilted profile (level with gravity, no surface hover) until it is back under 16 deg, as Mike's transports do. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-ConvoyTruck</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:true]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:true]
			[IdealMaxSpeed:10]
			[IdealMinSpeed:5]
			[MaxSpeedTolerance:2]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:6]
			[WaypointWaitTimeTrigger:0]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[UseVelocityCollisionEvasion:false]
			[HoverUpAngle:30]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-ConvoyTruck-Tilted</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:false]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:true]
			[IdealMaxSpeed:10]
			[IdealMinSpeed:5]
			[MaxSpeedTolerance:2]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:6]
			[WaypointWaitTimeTrigger:0]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[UseVelocityCollisionEvasion:false]
			[HoverUpAngle:30]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-ConvoyEscort</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:true]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:false]
			[IdealMaxSpeed:12]
			[IdealMinSpeed:5]
			[MaxSpeedTolerance:1]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:2]
			[WaypointWaitTimeTrigger:120]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[UseVelocityCollisionEvasion:false]
			[HoverUpAngle:30]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[EscortSpeedMatchMaxDistance:15]
			[EscortUsesRelativeDampening:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-ConvoyEscort-Tilted</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:false]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:false]
			[IdealMaxSpeed:12]
			[IdealMinSpeed:5]
			[MaxSpeedTolerance:1]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:2]
			[WaypointWaitTimeTrigger:120]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[UseVelocityCollisionEvasion:false]
			[HoverUpAngle:30]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[EscortSpeedMatchMaxDistance:15]
			[EscortUsesRelativeDampening:false]
			</Description>
		</EntityComponent>
<!-- Yard parking (Secondary on park routes): the escort profile, slow, matching the (still) depot from 2 m so the truck stops on its spot. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-ConvoyEscortPark</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:true]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:false]
			[IdealMaxSpeed:4]
			[IdealMinSpeed:2]
			[MaxSpeedTolerance:1]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:2]
			[WaypointWaitTimeTrigger:120]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[UseVelocityCollisionEvasion:false]
			[HoverUpAngle:30]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			[EscortSpeedMatchMaxDistance:2]
			[EscortUsesRelativeDampening:false]
			</Description>
		</EntityComponent>
