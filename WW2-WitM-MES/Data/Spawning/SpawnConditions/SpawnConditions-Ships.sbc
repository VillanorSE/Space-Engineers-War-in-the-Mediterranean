<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Ships</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]
			
			[PlanetaryInstallation:true]
			[RivalAiPlanetaryInstallation:true]
			[InstallationSpawnsOnWaterSurface:true]
			[InstallationSpawnsOnDryLand:false]
			[MinWaterDepth:15]

			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[ReplenishSystems:true]

			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]

		</Description>
	</EntityComponent>

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Ships-Carriers</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[PlanetaryInstallation:true]
			[RivalAiPlanetaryInstallation:true]
			[InstallationSpawnsOnWaterSurface:true]
			[InstallationSpawnsOnDryLand:false]
			[MinWaterDepth:25]

			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[ReplenishSystems:true]

			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]

			[UseThreatLevelCheck:true]
			[ThreatLevelCheckRange:10000]
			[ThreatScoreMinimum:350]
		
		</Description>
	</EntityComponent>

	</EntityComponents>
</Definitions>