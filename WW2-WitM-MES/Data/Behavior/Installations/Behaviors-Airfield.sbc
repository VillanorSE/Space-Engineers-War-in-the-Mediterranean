<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Airfield Behavior - UNIVERSAL, shared by every secondary airfield installation. ONE always-on
     Behavior: the Unowned/Gray/Green state is not a Behavior switch (MES's [SwitchToBehavior] never
     starts the new Behavior, see Triggers-Airfield-Ownership.sbc) but which triggers are enabled.

     Always running: the 12 zone-detector triggers (all 3 anchors per faction) and the Unowned decision
     pair. Everything else is listed here but starts [UseTrigger:false] and is enabled/disabled by the
     flip actions (Triggers-Airfield-Ownership.sbc):
       - Gray/Green decision triggers (stay / change owner / revert to unowned)
       - store sales (Store-Airport-Vehicles, every plane of the owning faction)
       - offensive spawns (moved here from the plane factories)
       - cargo-plane request listener (Triggers-Airfield-CargoRequest.sbc)
       - reputation damage, bot crew and defensive spawn (airfield-owned "Gated" copies)

     A new airfield anywhere just needs its own SpawnGroup + Prefab + SpawnConditions pointing at this
     SAME Behavior - no new trigger/condition/behavior authoring per installation.
     The prefab's owner-capable blocks are named "Airfield Block" (stores keep "Store-Airport-Vehicles")
     because the flip uses [ChangeBlockOwnership], which matches blocks by exact CustomName. -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Airfield</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Trigger-Airfield-ZoneCheckIn-Gray-LaSpezia]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckOut-Gray-LaSpezia]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckIn-Gray-Tripoli]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckOut-Gray-Tripoli]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckIn-Gray-Rome]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckOut-Gray-Rome]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckIn-Green-Toulon]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckOut-Green-Toulon]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckIn-Green-Oran]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckOut-Green-Oran]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckIn-Green-Alexandria]
			[Triggers:WW2-Trigger-Airfield-ZoneCheckOut-Green-Alexandria]

			[Triggers:WW2-Trigger-Airfield-Unowned-CheckGreen]
			[Triggers:WW2-Trigger-Airfield-Unowned-CheckGray]
			[Triggers:WW2-Trigger-Airfield-Gray-CheckGreen]
			[Triggers:WW2-Trigger-Airfield-Gray-CheckUnowned]
			[Triggers:WW2-Trigger-Airfield-Green-CheckGray]
			[Triggers:WW2-Trigger-Airfield-Green-CheckUnowned]

			[Triggers:WW2-Trigger-Airfield-Gated-BotCrew-3]

			[Triggers:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Gray]
			[Triggers:WW2-Trigger-Airfield-Gated-DefenseSpawn-Gray]
			[Triggers:WW2-Trigger-OffenseSpawn-Gray]
			[Triggers:WW2-Trigger-Airfield-RequestCargoPlane-Gray]
			[Triggers:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray]

			[Triggers:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Green]
			[Triggers:WW2-Trigger-Airfield-Gated-DefenseSpawn-Green]
			[Triggers:WW2-Trigger-OffenseSpawn-Green]
			[Triggers:WW2-Trigger-Airfield-RequestCargoPlane-Green]
			[Triggers:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Green]

			</Description>
        </EntityComponent>

	</EntityComponents>
</Definitions>
