<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

	<!-- Ship Targeting -->
	<!-- Name exclusions below guard against Relation-based targeting alone not being reliably
	     safe for a Neutral-default faction living alongside Enemies-default factions (GVK's own
	     combat targeting uses the identical belt-and-suspenders pattern for their neutral
	     trader). "NPC Trader" is the naming convention for any future roving TRADER-faction
	     grid - give it that prefix to keep it excluded here too. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Targeting-ShipMain</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Target]

			[UseCustomTargeting:true]
			[Target:PlayerAndGrid]

			[MaxDistance:10000]

			[TimeUntilTargetAcquisition:10]
			[TimeUntilNextEvaluation:3]

			[UseTargetRefresh:true]
			[TimeUntilNextRefresh:60]

			[MatchAllFilters:OutsideOfSafezone]
			[MatchAllFilters:Owner]
			[MatchAllFilters:Relation]
			[MatchAllFilters:Powered]

			[MatchNoneFilters:Underwater]
			[MinUnderWaterDepth:150]

			[MatchNoneFilters:Name]
			[UsePartialNameMatching:true]
			[Names:La Spezia]
			[Names:Port of Toulon]
			[Names:Port of Oran]
			[Names:Port of Tripoli]
			[Names:Port of Valencia]
			[Names:NPC Trader]

			[Owners:Player]
			[Owners:NPC]
			[Relations:Enemy]

			[GetTargetBy:ClosestDistance]
			
			</Description>
        </EntityComponent>
	<!-- End Ship Targeting -->

	</EntityComponents>
</Definitions>