<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Depot defense and patrols (D-049). Defense: hostile player (rep <= -500) within 2000 m, 10-30 min; patrol: any player within 10 km, every 45-60 min. Both need the depot not Low (WitM-SupplyOffense-{SpawnGroupName}); the C# charges each unit at spawn by its prefab and refunds intact patrol units. War Level picks the column (WL1 = else of AtLeast2). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-Defense-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:PlayerNear]
			[TargetDistance:2000]
			[MinCooldownMs:600000]
			[MaxCooldownMs:1800000]
			[StartsReady:true]
			[MaxActions:-1]
			[MaxPlayerReputation:-500]
			[Conditions:WW2-Supply-Condition-Offense]
			[Actions:WW2-Depot-Action-Defense-Gray]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-Defense-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:DepotDefense-Gray]
			[ForceManualTriggerActivation:false]
			[UseChatBroadcast:true]
			[ChatData:WW2-Depot-Chat-Defense-Gray]
			</Description>
		</EntityComponent>
