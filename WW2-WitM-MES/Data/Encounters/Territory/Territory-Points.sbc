<!-- ==================== CARGO SHIP DELIVERIES ====================
     Fixed-route ships (Paths-Nautical.sbc): at the END of the 5-min unload (timer enabled by
     WW2-Territory-Action-CargoShip-BeginUnload) the DESTINATION anchor of the route gets +100, one-sided (no loss to the rival). Retired is set
     only at the final despawn (Triggers-CargoShip-RouteArrival.sbc), so sinking it while unloading still scores a kill. Civitavecchia scores for the Rome anchor. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-Delivery-Gray-LaSpezia-Tripoli</SubtypeId>
