	<!-- End Carrier Autopilots -->

	<!-- Weapon Profile, Carrier -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Weapons-Carrier</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Weapons]
			
            [UseStaticGuns:true]
			[UseTurrets:true]
			
			[MaxStaticWeaponRange:4000]
			[WeaponMaxAngleFromTarget:6]
			[WeaponMaxBaseDistanceTarget:100]
			
			[UseBarrageFire:true]
			[MaxFireRateForBarrageWeapons:2]
			
			[UseAmmoReplenish:true]
            
			</Description>
		</EntityComponent>
<!-- End Weapon Profile -->

	</EntityComponents>
</Definitions>