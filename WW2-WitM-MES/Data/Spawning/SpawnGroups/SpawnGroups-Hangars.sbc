<!-- Gray SM79 Bomber Hangar - Medium hangar (11 large-grid doors, 27.5m) since
     the SM79's real wingspan (~21.2m) doesn't fit the small hangar's 12.5m
     door span. Plane offset kept identical to the small-hangar version since
     the medium prefab's own door-center reference isn't documented - adjust
     in-game if the SM79 doesn't sit centered. -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Hangar-Gray-SM79Bomber</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[PlanetaryInstallationType:Medium]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[FactionOverride:GRAY]
		[SpawnRandomCargo:true]

		[UseContainerTypeAssignment:true]
		[ContainerTypeAssignBlockName:Small Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-SmallCargo]

		[ContainerTypeAssignBlockName:Medium Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-MediumCargo]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Hangar-Medium">
				<Position>
					<X>0.0</X>
					<Y>-9.0</Y>
					<Z>7.5</Z>
				</Position>
				<Behaviour>WW2-Behavior-Hangar-Gray</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-SM79_Bomber">
				<Position>
					<X>-5.0</X>
					<Y>6.2</Y>
					<Z>10.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-HangarPlane-SM79Bomber</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

