<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

	<!-- Cargo Ship Behaviors -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-CargoShip-Gray</SubtypeId>
            </Id>
			<!-- Basic Gray Cargo Ship Behavior -->
            <Description>
			
			[RivalAI Behavior]
			[BehaviorName:Nautical]
			[TriggerGroups:WW2-Points-Group-Gray-UtilityNaval]
			
			[AutopilotData:WW2-Autopilot-CargoShip]
			[TargetData:WW2-Targeting-ShipMain]
			
			[WeaponSystem:WW2-Weapons-CargoShip]
			
			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-CargoDamage]
			[Triggers:WW2-Trigger-CargoShip-Destination]
			[Triggers:WW2-Trigger-CargoShip-DestinationReached]
			[Triggers:WW2-Trigger-FriendlyNear-Cargo]
			[Triggers:WW2-Trigger-HostileNear-Cargo]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-Ship-Gray]

			</Description>
        </EntityComponent>

        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-CargoShip-Green</SubtypeId>
            </Id>
			<!-- Basic Green Cargo Ship Behavior -->
            <Description>
			
			[RivalAI Behavior]
			[BehaviorName:Nautical]
			[TriggerGroups:WW2-Points-Group-Green-UtilityNaval]
			
			[AutopilotData:WW2-Autopilot-CargoShip]
			[TargetData:WW2-Targeting-ShipMain]
			
			[WeaponSystem:WW2-Weapons-CargoShip]
			
			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-CargoDamage]
			[Triggers:WW2-Trigger-CargoShip-Destination]
			[Triggers:WW2-Trigger-CargoShip-DestinationReached]
			[Triggers:WW2-Trigger-FriendlyNear-Cargo]
			[Triggers:WW2-Trigger-HostileNear-Cargo]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-ReputationDamageLight-Green]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-Ship-Green]

			</Description>
        </EntityComponent>
	<!-- End Cargo Ship Behaviors -->

	<!-- Cargo Ship Autopilot -->
	<!-- 2026-09-22: UseVelocityCollisionEvasion disabled. A ship on a live route showed its
	     AutoPilot "Current Waypoint" (204m out, 76 degrees off heading) fighting its real
	     "Initial Waypoint" (1154m out, 1.2 degrees off heading) - AutoPilotSystem.cs generates that
	     evasion waypoint whenever Collision.VelocityResult.CollisionImminent() trips within
	     CollisionEvasionWaypointDistance (100m), independent of the separate CollisionAvoidance
	     flag (which is already off). Likely cause, not confirmed via a live CollisionType log
	     capture: the seafloor/water voxel reading as an imminent collision for a surface ship at
	     ordinary depths, since 100m is a large trigger radius at sea level. These ships already sail
	     a route we've verified is clear water, so the safety net wasn't earning its keep here.
	     CollisionEvasionWaypointDistance left in place, inert while the flag above is false, in case
	     evasion is ever turned back on.

	     Same day, follow-up: disabling evasion did NOT fix the 1 m/s crawl - proved it wasn't the
	     (sole) cause. Root cause found in ThrustSystem.cs/AutoPilotSystem.cs: MaxSpeed is
	     IdealMaxSpeed (10 here) unless overridden, and the ONLY branch that commands active forward
	     thrust is "velocityAmount < MaxSpeed - MaxSpeedTolerance". This profile never set
	     MaxSpeedTolerance, so it sat at the class default of 15 - making that check
	     "velocityAmount < 10 - 15", i.e. "< -5", which a non-negative speed can never satisfy. The
	     ship was NEVER commanded to accelerate; the "Drifting At Desired Speed" label in the earlier
	     debug dump was misleading, since a 15-wide tolerance calls anything from about -5 to 25 m/s
	     "close enough". Added [MaxSpeedTolerance:1] below so the accelerate branch actually
	     triggers below ~9 m/s. Not yet confirmed in-game. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-CargoShip</SubtypeId>
			</Id>
			<Description>

			[RivalAI Autopilot]

			[DisableInertiaDampeners:false]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:0]
			[FlyLevelWithGravity:true]
			[LevelWithGravityWhenIdle:true]
			[AllowStrafing:false]
			[WaypointTolerance:50]
			[IdealMinSpeed:10]
			[IdealMaxSpeed:10]
			[MaxSpeedTolerance:1]

			[RotationMultiplier:0.3]
			[AngleAllowedForForwardThrust:180]

			[UseVelocityCollisionEvasion:false]
			[CollisionEvasionWaypointDistance:100]
			[WaypointWaitTimeTrigger:0]

			</Description>
		</EntityComponent>
	<!-- End Cargo Ship Autopilot -->

	<!-- Weapon Profile, CargoShip -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Weapons-CargoShip</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Weapons]
			
			[UseTurrets:true]
			
			[WeaponMaxAngleFromTarget:6]
			[WeaponMaxBaseDistanceTarget:100]
			
			[UseBarrageFire:false]
			
			[UseAmmoReplenish:true]
            
			</Description>
		</EntityComponent>
<!-- End Weapon Profile -->

	</EntityComponents>
</Definitions>