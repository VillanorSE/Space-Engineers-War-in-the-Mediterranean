<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- Overrides vanilla DefaultReputationSettings. All damage multipliers 0 so welding/grinding, damaging,
     stealing and killing never change reputation by themselves; the MES trigger system does it instead.
     Needed because GRAY/GREEN are no longer StaticReputation (WW2-WitM-MES Factions.sbc). -->
    <Definition xsi:type="MyObjectBuilder_ReputationSettingsDefinition">
        <Id Type="MyObjectBuilder_ReputationSettingsDefinition" Subtype="DefaultReputationSettings" />
        <MaxReputationGainInTime>100</MaxReputationGainInTime>
        <ResetTimeMinForRepGain>30</ResetTimeMinForRepGain>
        <DamageSettings>
            <ReputationLossDamage>200</ReputationLossDamage>
            <GrindingWelding>0</GrindingWelding>
            <Damaging>0</Damaging>
            <Stealing>0</Stealing>
            <Killing>0</Killing>
        </DamageSettings>
        <PirateDamageSettings>
            <ReputationLossDamage>200</ReputationLossDamage>
            <GrindingWelding>0</GrindingWelding>
            <Damaging>0</Damaging>
            <Stealing>0</Stealing>
            <Killing>0</Killing>
        </PirateDamageSettings>
    </Definition>
</Definitions>
