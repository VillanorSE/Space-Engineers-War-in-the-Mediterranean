<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Depot ownership (D-049): same rules and territory conditions as Triggers-Airfield-Ownership.sbc. Owner-capable blocks are named 'Depot Block', the store 'Store-Depot-Vehicles'. The C# reads WW2-Action-Depot-{From}-Become{To}. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-Depot-Unowned-BecomeGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RecolorGrid:true]
			[OldBlockColors:{X:0 Y:0 Z:0.9}]
			[NewBlockColors:{X:0 Y:-0.75 Z:0}]
			[ChangeBlockOwnership:true]
			[OwnershipBlockNames:Depot Block]
			[OwnershipBlockFactions:GRAY]
			[OwnershipBlockNames:Store-Depot-Vehicles]
			[OwnershipBlockFactions:GRAY]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Depot-Trigger-Patrol-Gray]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Depot-Trigger-Gray-CheckGreen]
			[EnableTriggerNames:WW2-Depot-Trigger-Gray-CheckUnowned]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Gray]
			[EnableTriggerNames:WW2-Depot-Trigger-Defense-Gray]
			[EnableTriggerNames:WW2-Depot-Trigger-Patrol-Gray]
			[EnableTriggerNames:WW2-Depot-Trigger-GarageBay-Gray]
			[EnableTriggerNames:WW2-Store-Trigger-UpdateSales-Depot-Vehicles-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-BotCrew-3]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Depot-Trigger-Unowned-CheckGreen]
			[DisableTriggerNames:WW2-Depot-Trigger-Unowned-CheckGray]
			[DisableTriggerNames:WW2-Depot-Trigger-Unowned-CommandGray]
			[DisableTriggerNames:WW2-Depot-Trigger-Unowned-CommandGreen]
			[SetCustomStrings:true]
			[CustomStrings:NewOwner,Gray]
			[UseChatBroadcast:true]
			[ChatData:WW2-Depot-Chat-Captured-Gray]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-Depot-Unowned-BecomeGreen</SubtypeId>
			</Id>
