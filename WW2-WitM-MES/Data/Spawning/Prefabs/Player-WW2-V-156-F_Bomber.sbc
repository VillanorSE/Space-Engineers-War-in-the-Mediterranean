              <Enabled>true</Enabled>
              <Program>
/*
/ //// / Villanor's Plane Control Script / //// /
War in the Mediterranean (WW2-WitM). Questions and bug reports: Villanor.

Subgrid wheel control: wheels on subgrids (landing gear) steer, drive and brake with the
cockpit's WASD and handbrake. Wheels left of the seat in use count as left wheels.
The wheel control is based on Whiplash141's Subgrid Wheel Control Script (v11.7.3), modified
for WitM; do not contact Whiplash141 about this version.

Landing gear:
1.) Put every landing-gear hinge and rotor in one block group named "Landing Gear", or ending in it
    (e.g. "Re2000 - Landing Gear")
    (change the name in Custom Data, [WitM Landing Gear] section).
2.) Set each hinge/rotor's limits to the deployed and stowed angles. A limit set past where
    the gear physically jams is fine: the first time the gear stops short of a limit, the
    script moves that limit to just shy of the jam point (3 degrees; Custom Data).
    Stowed wheels are pulled up their suspension so they don't rub on the airframe.
3.) Hotbar arguments:
      gear              deploy or stow (toggle)
      gear_down         deploy
      gear_up           stow
      gear_set_down     run once with the gear DOWN if the script has the directions backwards
      gear_reset_limits restore the limits the script changed
The gear is unlocked to move and locked again when it stops. Braking torque is raised to at
least the motor torque, and suspension AirShock is turned off (both on every setup scan).

Flight assist is not in this script any more: the WW2-WitM Framework mod flies every plane with
an air Ship Core (Fighter, Attacker, Bomber, Utility Air) through its gyro. Chat: /assist on, off
or status. WitM planes ship without control surfaces and steer with their gyro; this script never
touches it (it only clears a gyro override left by an older version, once, when nobody is flying).

Handbrake when no wheels are on the main grid: brake_toggle, brake_on, brake_off
These notes also appear at the top of each section in the block's Custom Data.
*/


const string VERSION = "1.7";
const string DATE = "2026/10/11";

const string INI_SECTION_SWCS = "Plane Wheels";
const string INI_KEY_IGNORE_TAG = "Wheel ignore name tag";
const string INI_KEY_BRAKING_CONST = "Braking constant";
const string INI_KEY_SCAN_CONNECTORS = "Detect blocks over connectors";
const string INI_KEY_TITLE_SCREEN = "Draw title screen";

string wheelIgnoreNameTag = "Ignore";
float brakingConstant = 0.1f; //Increase this if your brakes are not strong enough!
bool detectBlocksOverConnectors = false;

bool drawTitleScreen = true;
bool canReadHandbrake = false;
bool handbrakeOverride = false;
bool isSetup = false;
IMyShipController lastControlledSeat = null;
RuntimeTracker runtimeTracker;
Scheduler scheduler;
ScheduledAction setupAction;
StringBuilder echoBuilder = new StringBuilder();
StringBuilder finalEchoBuilder = new StringBuilder();
string echoText = ""; // WitM: echoed on every run so the info panel doesn't flicker between refreshes

List&lt;IMyMotorSuspension&gt; subgridWheels = new List&lt;IMyMotorSuspension&gt;();
List&lt;IMyMotorSuspension&gt; ignoredWheels = new List&lt;IMyMotorSuspension&gt;();
List&lt;IMyMotorSuspension&gt; wheels = new List&lt;IMyMotorSuspension&gt;();
List&lt;IMyShipController&gt; shipControllers = new List&lt;IMyShipController&gt;();
StringBuilder setupBuilder = new StringBuilder();
WitmTitleCard titleScreen;
readonly MyIni _ini = new MyIni();

void ParseIni()
{
    _ini.Clear();
    string customData = Me.CustomData;
    if (_ini.TryParse(customData))
    {
        // Read
        wheelIgnoreNameTag = _ini.Get(INI_SECTION_SWCS, INI_KEY_IGNORE_TAG).ToString(wheelIgnoreNameTag);
        brakingConstant = _ini.Get(INI_SECTION_SWCS, INI_KEY_BRAKING_CONST).ToSingle(brakingConstant);
        detectBlocksOverConnectors = _ini.Get(INI_SECTION_SWCS, INI_KEY_SCAN_CONNECTORS).ToBoolean(detectBlocksOverConnectors);
        drawTitleScreen = _ini.Get(INI_SECTION_SWCS, INI_KEY_TITLE_SCREEN).ToBoolean(drawTitleScreen);
        gearGroupName = _ini.Get(INI_SECTION_GEAR, INI_KEY_GEAR_GROUP).ToString(gearGroupName);
        gearDefaultRpm = _ini.Get(INI_SECTION_GEAR, INI_KEY_GEAR_RPM).ToSingle(gearDefaultRpm);
        gearMarginDeg = _ini.Get(INI_SECTION_GEAR, INI_KEY_GEAR_MARGIN).ToSingle(gearMarginDeg);
        gearDisableAirShock = _ini.Get(INI_SECTION_GEAR, INI_KEY_GEAR_AIRSHOCK).ToBoolean(gearDisableAirShock);
        gearTuckWheels = _ini.Get(INI_SECTION_GEAR, INI_KEY_GEAR_TUCK).ToBoolean(gearTuckWheels);
    }
    else if (!string.IsNullOrWhiteSpace(Me.CustomData))
    {
        _ini.EndContent = Me.CustomData;
    }
    
    // Write
    _ini.Set(INI_SECTION_SWCS, INI_KEY_IGNORE_TAG, wheelIgnoreNameTag);
    _ini.Set(INI_SECTION_SWCS, INI_KEY_BRAKING_CONST, brakingConstant);
    _ini.Set(INI_SECTION_SWCS, INI_KEY_SCAN_CONNECTORS, detectBlocksOverConnectors);
    _ini.Set(INI_SECTION_SWCS, INI_KEY_TITLE_SCREEN, drawTitleScreen);
    _ini.Set(INI_SECTION_GEAR, INI_KEY_GEAR_GROUP, gearGroupName);
    _ini.Set(INI_SECTION_GEAR, INI_KEY_GEAR_RPM, gearDefaultRpm);
    _ini.Set(INI_SECTION_GEAR, INI_KEY_GEAR_MARGIN, gearMarginDeg);
    _ini.Set(INI_SECTION_GEAR, INI_KEY_GEAR_AIRSHOCK, gearDisableAirShock);
    _ini.Set(INI_SECTION_GEAR, INI_KEY_GEAR_TUCK, gearTuckWheels);

    _ini.DeleteSection(INI_SECTION_FLIGHT_OLD); // up to 1.6; flight assist is in the Framework mod now
    _ini.SetSectionComment(INI_SECTION_SWCS,
        " Villanor's Plane Control Script. Run arguments:\n" +
        "   gear, gear_down, gear_up        landing gear (group \"Landing Gear\")\n" +
        "   brake_toggle, brake_on, brake_off   handbrake when no wheels are on the main grid\n" +
        " Wheels on subgrids steer and drive with WASD.");
    _ini.SetSectionComment(INI_SECTION_GEAR,
        " Hinges/rotors in the gear group stop short of anything they jam against and lock when done.\n" +
        " gear_set_down: run with the gear down if up/down are backwards. gear_reset_limits: undo limit changes.");
    string output = _ini.ToString();
    if (!string.Equals(output, customData))
        Me.CustomData = output;
}

Program()
{
    Runtime.UpdateFrequency = UpdateFrequency.Update10;
    titleScreen = new WitmTitleCard(VERSION, this);
    runtimeTracker = new RuntimeTracker(this);
    scheduler = new Scheduler(this);
    setupAction = new ScheduledAction(GetBlocks, 0.1);

    scheduler.AddScheduledAction(setupAction);
    scheduler.AddScheduledAction(ControlSubgridWheels, 10);
    scheduler.AddScheduledAction(DrawTitleScreen, 0.2);
    scheduler.AddScheduledAction(PrintEcho, 1);
    scheduler.AddScheduledAction(UpdateGear, GearUpdateHz);

    LoadGearState();
    GetBlocks();
    ClearLeftoverGyroOverride();

    // A pasted or projected plane comes in with its hinges and rotors at odd angles (half deployed), so on
    // start the gear is driven to the state the script last knew (down for a plane saved on the ground) and locked.
    if (gearMotors.Count &gt; 0)
        MoveGear(gearDown);
}

void Save()
{
    SaveGearState();
}

void DrawTitleScreen()
{
    if (drawTitleScreen)
    {
        titleScreen.Draw();
    }
}

/*
 * Hiding default echo implementation so that we can display precisely when we want.
 */
new void Echo(string text)
{
    echoBuilder.AppendLine(text);
}

void PrintEcho()
{
    finalEchoBuilder.Clear();
    finalEchoBuilder.AppendLine($"Villanor's Plane Control Script\n(Version {VERSION} - {DATE})\n");

    finalEchoBuilder.Append(echoBuilder);
    finalEchoBuilder.AppendLine($"&gt; Landing gear: {gearStatus}");
    finalEchoBuilder.AppendLine("&gt; Flight assist: WW2-WitM Framework mod (chat /assist)");

    finalEchoBuilder.AppendLine($"\nNext refresh in {Math.Ceiling(Math.Max(setupAction.RunInterval - setupAction.TimeSinceLastRun, 0))} seconds\n");
    finalEchoBuilder.AppendLine($"Last setup results:\n{setupBuilder}{(isSetup ? "&gt; Setup Successful!" : "&gt; Setup Failed!")}\n");
    finalEchoBuilder.AppendLine(runtimeTracker.Write());

    echoText = finalEchoBuilder.ToString();
}

void ClearEcho()
{
    echoBuilder.Clear();
}

void Main(string arg, UpdateType updateSource)
{
    try
    {
        runtimeTracker.AddRuntime();

        if (!string.IsNullOrWhiteSpace(arg))
        {
            switch (arg.ToLowerInvariant())
            {
                case "brake_toggle":
                    handbrakeOverride = !handbrakeOverride;
                    break;
                case "brake_on":
                    handbrakeOverride = true;
                    break;
                case "brake_off":
                    handbrakeOverride = false;
                    break;
                case "gear":
                case "gear_toggle":
                    MoveGear(!gearDown);
                    break;
                case "gear_down":
                    MoveGear(true);
                    break;
                case "gear_up":
                    MoveGear(false);
                    break;
                case "gear_set_down":
                    RecordGearDown();
                    break;
                case "gear_reset_limits":
                    ResetGearLimits();
                    break;
            }
        }
    
        scheduler.Update();
        base.Echo(echoText);
        runtimeTracker.AddInstructions();
    }
    catch (Exception e)
    {
        BlueScreenOfDeath.Show(Me.GetSurface(0), "Plane Control", VERSION, e);
    }
}

void ControlSubgridWheels()
{
    if (!isSetup)
        return;

    ClearEcho();

    var referenceController = GetControlledShipController(shipControllers);
    if (referenceController == null)
    {
        Echo("&gt; No driver detected");

        if (lastControlledSeat != null)
            referenceController = lastControlledSeat;
        else
            referenceController = shipControllers[0];
    }
    else
    {
        Echo("&gt; Wheels are being controlled");
        lastControlledSeat = referenceController;
    }

    var avgWheelPosition = GetSubgridWheels(referenceController);
    canReadHandbrake = ignoredWheels.Count + wheels.Count - subgridWheels.Count &gt; 0;
    SynchronizeHandBrakes(referenceController);

    if (subgridWheels.Count == 0)
    {
        Echo("&gt; No subgrid wheels found\n&gt; Pausing execution...");
        return;
    }

    var wasdInput = referenceController.MoveIndicator;
    bool brakes = wasdInput.Y &gt; 0 || (canReadHandbrake ? referenceController.HandBrake : handbrakeOverride);
    var velocity = Vector3D.TransformNormal(referenceController.GetShipVelocities().LinearVelocity, MatrixD.Transpose(referenceController.WorldMatrix)) * brakingConstant;

    if (!canReadHandbrake)
    {
        Echo($"&gt; No wheels on main grid.\n    To enable handbrake, use the\n    arguments:\n      brake_toggle\n      brake_on\n      brake_off");
    }
    else
    {
        Echo($"&gt; Found wheels on main grid.\n    To enable handbrake, use the [P] key");
    }
    Echo($"&gt; Brakes enabled: {brakes}");
    Echo($"&gt; Reference controller: {referenceController.CustomName}");

    foreach (var wheel in subgridWheels)
    {
        if (!GridTerminalSystem.CanAccess(wheel)) { continue; }
        var steerMult = Math.Sign(Math.Round(Vector3D.Dot(wheel.WorldMatrix.Forward, referenceController.WorldMatrix.Up), 2)) * Math.Sign(Vector3D.Dot(wheel.GetPosition() - avgWheelPosition, referenceController.WorldMatrix.Forward));
        var propulsionMult = -Math.Sign(Math.Round(Vector3D.Dot(wheel.WorldMatrix.Up, referenceController.WorldMatrix.Right), 2));
        var steerValue = steerMult * wasdInput.X;
        var power = wheel.Power * 0.01f;
        var propulsionValue = 0f;
        if (brakes &amp;&amp; wheel.Brake)
        {
            propulsionValue = propulsionMult * (float)velocity.Z;  
        }
        else
        {
            //steer + is right if up == up
            //steer + is left if up == down
            propulsionValue = propulsionMult * power * -wasdInput.Z;
        }
        wheel.PropulsionOverride = propulsionValue;
        wheel.SteeringOverride = steerValue;
    }
}

void SynchronizeHandBrakes(IMyShipController controller)
{
    bool handbrake = canReadHandbrake ? controller.HandBrake : handbrakeOverride;
    foreach (var block in shipControllers)
    {
        if (block.HandBrake != handbrake)
            block.HandBrake = handbrake;
    }
}

IMyShipController GetControlledShipController(List&lt;IMyShipController&gt; controllers)
{
    IMyShipController firstControlled = null;
    foreach (IMyShipController thisController in controllers)
    {
        // Main controller takes priority
        if (thisController.IsMainCockpit)
        {
            return thisController;
        }
        
        if (firstControlled == null &amp;&amp; thisController.ControlWheels &amp;&amp; thisController.IsUnderControl &amp;&amp; thisController.CanControlShip)
        {
            firstControlled = thisController;
        }
    }

    return firstControlled;
}

Vector3D GetSubgridWheels(IMyTerminalBlock reference)
{
    var summedWheelPosition = Vector3D.Zero;
    subgridWheels.Clear();
    
    foreach (IMyMotorSuspension block in ignoredWheels)
    {
        summedWheelPosition += block.GetPosition();
    }
    
    foreach (IMyMotorSuspension block in wheels)
    {
        if (!GridTerminalSystem.CanAccess(block))
        {
            continue;
        }
        
        summedWheelPosition += block.GetPosition();

        if (reference.CubeGrid != block.CubeGrid)
        {
            subgridWheels.Add(block);
        }
        else
        {
            block.PropulsionOverride = 0f;
            block.SteeringOverride = 0f;
        }
    }

    return summedWheelPosition / (wheels.Count + ignoredWheels.Count);
}

bool BlockCollect(IMyTerminalBlock block)
{
    if (!detectBlocksOverConnectors &amp;&amp; !Me.IsSameConstructAs(block))
    {
        return false;
    }

    if (block is IMyMotorSuspension)
    {
        var wheel = (IMyMotorSuspension)block;
        if (StringExtensions.Contains(block.CustomName, wheelIgnoreNameTag))
        {
            ignoredWheels.Add(wheel);
        }
        else
        {
            wheels.Add(wheel);
        }
    }
    else if (block is IMyShipController)
    {
        shipControllers.Add((IMyShipController)block);
    }

    return false;
}

void GetBlocks()
{
    wheels.Clear();
    ignoredWheels.Clear();
    shipControllers.Clear();

    setupBuilder.Clear();
    
    ParseIni();

    GridTerminalSystem.GetBlocksOfType&lt;IMyTerminalBlock&gt;(null, BlockCollect);
    GetGearBlocks();

    if (shipControllers.Count == 0)
    {
        setupBuilder.AppendLine($"&gt;&gt; Error: No ship controllers");
        isSetup = false;
        return;
    }

    if (wheels.Count == 0)
    {
        setupBuilder.AppendLine("&gt;&gt; Error: No wheels");
        isSetup = false;
        return;
    }

    isSetup = true;
}

#region WitM landing gear
const string INI_SECTION_GEAR = "WitM Landing Gear";
const string INI_KEY_GEAR_GROUP = "Gear group name";
const string INI_KEY_GEAR_RPM = "Gear speed if a motor is set to 0 (RPM)";
const string INI_KEY_GEAR_MARGIN = "Stop short of a jam by (degrees)";
const string INI_KEY_GEAR_AIRSHOCK = "Turn off suspension AirShock";
const string INI_KEY_GEAR_TUCK = "Pull subgrid wheels in when stowed";

const string STORAGE_SECTION_GEAR = "Gear";
const double GearUpdateHz = 6;
const double GearDoneToleranceRad = 0.0175; // about 1 degree from the target limit counts as arrived
const double GearStallMinRad = 0.002;       // a motor counts as stopped below 10% of its commanded movement, and never below this
const int GearStallUpdates = 4;             // stopped this many updates in a row (about 0.7 s) = jammed
const double GearMinSeconds = 1.0;          // give the motors time to start before judging a jam
const double GearTimeoutSeconds = 20.0;

string gearGroupName = "Landing Gear";
readonly List&lt;IMyBlockGroup&gt; gearGroups = new List&lt;IMyBlockGroup&gt;();
float gearDefaultRpm = 18f;
float gearMarginDeg = 3f;
bool gearDisableAirShock = true;
bool gearTuckWheels = true;

class GearMotor
{
    public IMyMotorStator Block;
    public int DownSide;   // +1: the upper limit is the deployed position; -1: the lower limit; 0: unusable
    public int TargetSide;
    public float LastAngle;
    public int StalledUpdates;
    public bool Done;
}

readonly List&lt;GearMotor&gt; gearMotors = new List&lt;GearMotor&gt;();
readonly List&lt;IMyMotorStator&gt; gearScratch = new List&lt;IMyMotorStator&gt;();
readonly Dictionary&lt;long, GearMotor&gt; gearMotorCache = new Dictionary&lt;long, GearMotor&gt;();
Func&lt;IMyMotorStator, bool&gt; gearSameConstruct;
readonly Dictionary&lt;long, int&gt; gearDownSides = new Dictionary&lt;long, int&gt;();
readonly Dictionary&lt;long, Vector2D&gt; gearOriginalLimits = new Dictionary&lt;long, Vector2D&gt;(); // X lower, Y upper (rad)
readonly Dictionary&lt;long, float&gt; gearWheelHeights = new Dictionary&lt;long, float&gt;();        // suspension height before tucking
ITerminalProperty&lt;float&gt; suspensionHeightProp;
readonly MyIni gearStorageIni = new MyIni();
bool gearDown = true;
bool gearMoving = false;
double gearElapsed = 0;
string gearStatus = "not set up";

void LoadGearState()
{
    gearStorageIni.Clear();
    if (!gearStorageIni.TryParse(Storage))
        return;

    gearDown = gearStorageIni.Get(STORAGE_SECTION_GEAR, "Down").ToBoolean(true);
    var keys = new List&lt;MyIniKey&gt;();
    gearStorageIni.GetKeys(STORAGE_SECTION_GEAR, keys);
    foreach (var key in keys)
    {
        string[] parts = key.Name.Split('.');
        long id;
        if (parts.Length != 2 || !long.TryParse(parts[0], out id))
            continue;
        if (parts[1] == "Side")
        {
            gearDownSides[id] = gearStorageIni.Get(key).ToInt32(0);
        }
        else if (parts[1] == "Limits")
        {
            string[] lim = gearStorageIni.Get(key).ToString("").Split(';');
            double lo, hi;
            if (lim.Length == 2 &amp;&amp; double.TryParse(lim[0], out lo) &amp;&amp; double.TryParse(lim[1], out hi))
                gearOriginalLimits[id] = new Vector2D(lo, hi);
        }
        else if (parts[1] == "Height")
        {
            gearWheelHeights[id] = gearStorageIni.Get(key).ToSingle(0f);
        }
    }
}

void SaveGearState()
{
    gearStorageIni.Clear();
    gearStorageIni.Set(STORAGE_SECTION_GEAR, "Down", gearDown);
    foreach (var pair in gearDownSides)
        gearStorageIni.Set(STORAGE_SECTION_GEAR, pair.Key + ".Side", pair.Value);
    foreach (var pair in gearOriginalLimits)
        gearStorageIni.Set(STORAGE_SECTION_GEAR, pair.Key + ".Limits", pair.Value.X + ";" + pair.Value.Y);
    foreach (var pair in gearWheelHeights)
        gearStorageIni.Set(STORAGE_SECTION_GEAR, pair.Key + ".Height", pair.Value);
    Storage = gearStorageIni.ToString();
}

// Rebuilt on every setup scan, except while the gear is moving.
void GetGearBlocks()
{
    if (gearDisableAirShock)
    {
        foreach (var wheel in wheels)
            if (wheel.AirShockEnabled) wheel.AirShockEnabled = false;
        foreach (var wheel in ignoredWheels)
            if (wheel.AirShockEnabled) wheel.AirShockEnabled = false;
    }

    if (gearMoving)
        return;

    // The group named exactly as set, or else any group whose name ends with it ("Re2000 - Landing Gear").
    gearScratch.Clear();
    var group = GridTerminalSystem.GetBlockGroupWithName(gearGroupName);
    if (group == null)
    {
        gearGroups.Clear();
        GridTerminalSystem.GetBlockGroups(gearGroups);
        foreach (var g in gearGroups)
            if (g.Name.EndsWith(gearGroupName, StringComparison.OrdinalIgnoreCase)) { group = g; break; }
    }
    if (group != null)
    {
        if (gearSameConstruct == null)
            gearSameConstruct = b =&gt; Me.IsSameConstructAs(b);
        group.GetBlocksOfType(gearScratch, gearSameConstruct);
    }

    gearMotors.Clear();
    int unusable = 0;
    foreach (var block in gearScratch)
    {
        if (block.BrakingTorque &lt; block.Torque)
            block.BrakingTorque = block.Torque;

        int side;
        if (!gearDownSides.TryGetValue(block.EntityId, out side))
        {
            int nearest = NearestLimitSide(block);
            side = gearDown ? nearest : -nearest;
            if (side != 0)
                gearDownSides[block.EntityId] = side;
        }
        if (side == 0)
            unusable++;
        GearMotor gm;
        if (!gearMotorCache.TryGetValue(block.EntityId, out gm))
        {
            gm = new GearMotor { Block = block };
            gearMotorCache[block.EntityId] = gm;
        }
        gm.DownSide = side;
        gearMotors.Add(gm);
    }

    if (gearMotors.Count == 0)
        gearStatus = $"no group \"{gearGroupName}\"";
    else
        gearStatus = (gearDown ? "down" : "up") + (unusable &gt; 0 ? $" ({unusable} motor(s) without limits ignored)" : "");
}

void MoveGear(bool down)
{
    if (gearMotors.Count == 0)
        GetGearBlocks();
    if (gearMotors.Count == 0)
        return;

    gearDown = down;
    if (down)
        RestoreWheelHeights();
    else if (gearTuckWheels)
        TuckWheels();
    foreach (var gm in gearMotors)
    {
        if (gm.DownSide == 0 || gm.Block.Closed)
        {
            gm.Done = true;
            continue;
        }
        gm.TargetSide = down ? gm.DownSide : -gm.DownSide;
        float rpm = Math.Abs(gm.Block.TargetVelocityRPM);
        if (rpm &lt; 0.1f)
            rpm = gearDefaultRpm;
        gm.Block.RotorLock = false;
        gm.Block.TargetVelocityRPM = gm.TargetSide * rpm;
        gm.LastAngle = gm.Block.Angle;
        gm.StalledUpdates = 0;
        gm.Done = false;
    }
    gearElapsed = 0;
    gearMoving = true;
    gearStatus = down ? "deploying" : "stowing";
    SaveGearState();
}

void UpdateGear()
{
    if (!gearMoving)
        return;
    gearElapsed += 1.0 / GearUpdateHz;

    int done = 0;
    foreach (var gm in gearMotors)
    {
        if (gm.Done) { done++; continue; }
        var block = gm.Block;
        if (block.Closed || !block.IsAttached) { gm.Done = true; done++; continue; }

        float angle = block.Angle;
        double limit = gm.TargetSide &gt; 0 ? block.UpperLimitRad : block.LowerLimitRad;
        double remaining = Wrap(limit - angle) * gm.TargetSide; // &gt; 0: still short of the target limit
        if (remaining &lt;= GearDoneToleranceRad) { gm.Done = true; done++; continue; }

        // Pressed against an obstruction a motor jitters rather than standing still, so compare with
        // the movement its speed should give instead of looking for zero.
        double expected = Math.Abs(block.TargetVelocityRPM) * (Math.PI / 30.0) / GearUpdateHz;
        double stallBelow = Math.Max(GearStallMinRad, 0.1 * expected);
        gm.StalledUpdates = Math.Abs(Wrap(angle - gm.LastAngle)) &lt; stallBelow ? gm.StalledUpdates + 1 : 0;
        gm.LastAngle = angle;
        if (gearElapsed &gt;= GearMinSeconds &amp;&amp; gm.StalledUpdates &gt;= GearStallUpdates)
        {
            PullLimitShortOfJam(gm, angle, limit, remaining);
            gm.Done = true;
            done++;
        }
    }

    if (done &lt; gearMotors.Count &amp;&amp; gearElapsed &lt; GearTimeoutSeconds)
        return;

    foreach (var gm in gearMotors)
    {
        if (gm.Block.Closed || gm.DownSide == 0)
            continue;
        if (!gm.Done &amp;&amp; gm.Block.IsAttached)
        {
            // Timed out short of its limit: treat where it stopped as the jam point.
            float angle = gm.Block.Angle;
            double limit = gm.TargetSide &gt; 0 ? gm.Block.UpperLimitRad : gm.Block.LowerLimitRad;
            PullLimitShortOfJam(gm, angle, limit, Wrap(limit - angle) * gm.TargetSide);
        }
        gm.Block.RotorLock = true;
    }
    gearMoving = false;
    gearStatus = (gearDown ? "down" : "up") + (gearElapsed &gt;= GearTimeoutSeconds ? " (timed out, locked where it stopped)" : "");
    SaveGearState();
}

// The motor stopped before its limit: something is in the way. Move that limit to just
// short of where it stopped, so it no longer presses against the obstruction.
void PullLimitShortOfJam(GearMotor gm, float angle, double limit, double remaining)
{
    double margin = MathHelper.ToRadians(gearMarginDeg);
    if (remaining &lt;= margin)
        return;

    var block = gm.Block;
    if (!gearOriginalLimits.ContainsKey(block.EntityId))
        gearOriginalLimits[block.EntityId] = new Vector2D(block.LowerLimitRad, block.UpperLimitRad);

    // Computed from the old limit so a rotor's 0..360 angle stays on the same side of its limits.
    double newLimit = limit - gm.TargetSide * (remaining + margin);
    if (gm.TargetSide &gt; 0)
        block.UpperLimitRad = (float)newLimit;
    else
        block.LowerLimitRad = (float)newLimit;
}

// Stowed wheels pressed against the airframe make the plane shake, so pull each subgrid wheel
// up its suspension (minimum height) while stowed and put the old height back on deploy.
void TuckWheels()
{
    TuckList(wheels);
    TuckList(ignoredWheels);
}

void TuckList(List&lt;IMyMotorSuspension&gt; list)
{
    foreach (var wheel in list)
    {
        if (wheel.Closed || wheel.CubeGrid == Me.CubeGrid)
            continue;
        if (suspensionHeightProp == null)
        {
            var p = wheel.GetProperty("Height");
            if (p == null)
                return;
            suspensionHeightProp = p.AsFloat();
        }
        if (!gearWheelHeights.ContainsKey(wheel.EntityId))
            gearWheelHeights[wheel.EntityId] = suspensionHeightProp.GetValue(wheel);
        suspensionHeightProp.SetValue(wheel, suspensionHeightProp.GetMinimum(wheel));
    }
}

void RestoreWheelHeights()
{
    if (gearWheelHeights.Count == 0)
        return;
    RestoreList(wheels);
    RestoreList(ignoredWheels);
    gearWheelHeights.Clear();
}

void RestoreList(List&lt;IMyMotorSuspension&gt; list)
{
    foreach (var wheel in list)
    {
        float height;
        if (wheel.Closed || !gearWheelHeights.TryGetValue(wheel.EntityId, out height))
            continue;
        if (suspensionHeightProp == null)
        {
            var p = wheel.GetProperty("Height");
            if (p == null)
                return;
            suspensionHeightProp = p.AsFloat();
        }
        suspensionHeightProp.SetValue(wheel, height);
    }
}

void RecordGearDown()
{
    gearDownSides.Clear();
    gearDown = true;
    gearMotors.Clear();
    GetGearBlocks();
    SaveGearState();
}

void ResetGearLimits()
{
    foreach (var gm in gearMotors)
    {
        Vector2D limits;
        if (!gearOriginalLimits.TryGetValue(gm.Block.EntityId, out limits))
            continue;
        gm.Block.LowerLimitRad = (float)limits.X;
        gm.Block.UpperLimitRad = (float)limits.Y;
    }
    gearOriginalLimits.Clear();
    SaveGearState();
}

// +1 if the motor sits nearer its upper limit, -1 if nearer its lower limit, 0 if it has no limits.
static int NearestLimitSide(IMyMotorStator block)
{
    double lower = block.LowerLimitRad, upper = block.UpperLimitRad;
    if (double.IsNaN(lower) || double.IsNaN(upper) || Math.Abs(lower) &gt; 100 || Math.Abs(upper) &gt; 100)
        return 0;
    double angle = block.Angle;
    return Math.Abs(Wrap(angle - upper)) &lt;= Math.Abs(Wrap(angle - lower)) ? 1 : -1;
}

// Wraps an angle difference into (-pi, pi], so a rotor's 0..2pi angle compares with its limits.
static double Wrap(double a)
{
    while (a &gt; Math.PI) a -= 2 * Math.PI;
    while (a &lt;= -Math.PI) a += 2 * Math.PI;
    return a;
}
#endregion

#region Gyro cleanup
const string INI_SECTION_FLIGHT_OLD = "WitM Flight Assist";

// Up to 1.6 this script flew the plane with gyro override; the Framework mod does that now. Clear an
// override such a version left on, once at start, and only when nobody is flying the plane.
void ClearLeftoverGyroOverride()
{
    foreach (var c in shipControllers)
        if (c.IsUnderControl)
            return;
    var gyros = new List&lt;IMyGyro&gt;();
    GridTerminalSystem.GetBlocksOfType(gyros, g =&gt; g.CubeGrid == Me.CubeGrid &amp;&amp; g.GyroOverride);
    foreach (var gyro in gyros)
    {
        gyro.Pitch = 0f;
        gyro.Yaw = 0f;
        gyro.Roll = 0f;
        gyro.GyroOverride = false;
    }
}
#endregion

#region Scheduler
/// &lt;summary&gt;
/// Class for scheduling actions to occur at specific frequencies. Actions can be updated in parallel or in sequence (queued).
/// &lt;/summary&gt;
public class Scheduler
{
    public double CurrentTimeSinceLastRun { get; private set; } = 0;
    public long CurrentTicksSinceLastRun { get; private set; } = 0;

    ScheduledAction _currentlyQueuedAction = null;
    bool _firstRun = true;
    bool _inUpdate = false;

    readonly bool _ignoreFirstRun;
    readonly List&lt;ScheduledAction&gt; _actionsToAdd = new List&lt;ScheduledAction&gt;();
    readonly List&lt;ScheduledAction&gt; _scheduledActions = new List&lt;ScheduledAction&gt;();
    readonly List&lt;ScheduledAction&gt; _actionsToDispose = new List&lt;ScheduledAction&gt;();
    readonly Queue&lt;QueuedAction&gt; _queuedActions = new Queue&lt;QueuedAction&gt;();
    readonly Program _program;

    public const long TicksPerSecond = 60;
    public const double TickDurationSeconds = 1.0 / TicksPerSecond;
    const long ClockTicksPerGameTick = 166666L;

    /// &lt;summary&gt;
    /// Constructs a scheduler object with timing based on the runtime of the input program.
    /// &lt;/summary&gt;
    public Scheduler(Program program, bool ignoreFirstRun = false)
    {
        _program = program;
        _ignoreFirstRun = ignoreFirstRun;
    }

    /// &lt;summary&gt;
    /// Updates all ScheduledAcions in the schedule and the queue.
    /// &lt;/summary&gt;
    public void Update()
    {
        _inUpdate = true;
        long deltaTicks = Math.Max(0, _program.Runtime.TimeSinceLastRun.Ticks / ClockTicksPerGameTick);

        if (_firstRun)
        {
            if (_ignoreFirstRun)
            {
                deltaTicks = 0;
            }
            _firstRun = false;
        }

        _actionsToDispose.Clear();
        foreach (ScheduledAction action in _scheduledActions)
        {
            CurrentTicksSinceLastRun = action.TicksSinceLastRun + deltaTicks;
            CurrentTimeSinceLastRun = action.TimeSinceLastRun + deltaTicks * TickDurationSeconds;
            action.Update(deltaTicks);
            if (action.JustRan &amp;&amp; action.DisposeAfterRun)
            {
                _actionsToDispose.Add(action);
            }
        }

        if (_actionsToDispose.Count &gt; 0)
        {
            _scheduledActions.RemoveAll((x) =&gt; _actionsToDispose.Contains(x));
        }

        if (_currentlyQueuedAction == null)
        {
            // If queue is not empty, populate current queued action
            if (_queuedActions.Count != 0)
                _currentlyQueuedAction = _queuedActions.Dequeue();
        }

        // If queued action is populated
        if (_currentlyQueuedAction != null)
        {
            _currentlyQueuedAction.Update(deltaTicks);
            if (_currentlyQueuedAction.JustRan)
            {
                // Set the queued action to null for the next cycle
                _currentlyQueuedAction = null;
            }
        }
        _inUpdate = false;

        if (_actionsToAdd.Count &gt; 0)
        {
            _scheduledActions.AddRange(_actionsToAdd);
            _actionsToAdd.Clear();
        }
    }

    /// &lt;summary&gt;
    /// Adds an Action to the schedule. All actions are updated each update call.
    /// &lt;/summary&gt;
    public void AddScheduledAction(Action action, double updateFrequency, bool disposeAfterRun = false, double timeOffset = 0)
    {
        ScheduledAction scheduledAction = new ScheduledAction(action, updateFrequency, disposeAfterRun, timeOffset);
        if (!_inUpdate)
            _scheduledActions.Add(scheduledAction);
        else
            _actionsToAdd.Add(scheduledAction);
    }

    /// &lt;summary&gt;
    /// Adds a ScheduledAction to the schedule. All actions are updated each update call.
    /// &lt;/summary&gt;
    public void AddScheduledAction(ScheduledAction scheduledAction)
    {
        if (!_inUpdate)
            _scheduledActions.Add(scheduledAction);
        else
            _actionsToAdd.Add(scheduledAction);
    }

    /// &lt;summary&gt;
    /// Adds an Action to the queue. Queue is FIFO.
    /// &lt;/summary&gt;
    public void AddQueuedAction(Action action, double updateInterval)
    {
        if (updateInterval &lt;= 0)
        {
            updateInterval = 0.001; // avoids divide by zero
        }
        QueuedAction scheduledAction = new QueuedAction(action, updateInterval);
        _queuedActions.Enqueue(scheduledAction);
    }

    /// &lt;summary&gt;
    /// Adds a ScheduledAction to the queue. Queue is FIFO.
    /// &lt;/summary&gt;
    public void AddQueuedAction(QueuedAction scheduledAction)
    {
        _queuedActions.Enqueue(scheduledAction);
    }
}

public class QueuedAction : ScheduledAction
{
    public QueuedAction(Action action, double runInterval)
        : base(action, 1.0 / runInterval, removeAfterRun: true, timeOffset: 0)
    { }
}

public class ScheduledAction
{
    public bool JustRan { get; private set; } = false;
    public bool DisposeAfterRun { get; private set; } = false;
    public double TimeSinceLastRun { get { return TicksSinceLastRun * Scheduler.TickDurationSeconds; } }
    public long TicksSinceLastRun { get; private set; } = 0;
    public double RunInterval
    {
        get
        {
            return RunIntervalTicks * Scheduler.TickDurationSeconds;
        }
        set
        {
            RunIntervalTicks = (long)Math.Round(value * Scheduler.TicksPerSecond);
        }
    }
    public long RunIntervalTicks
    {
        get
        {
            return _runIntervalTicks;
        }
        set
        {
            if (value == _runIntervalTicks)
                return;

            _runIntervalTicks = value &lt; 0 ? 0 : value;
            _runFrequency = value == 0 ? double.MaxValue : 1.0 / _runIntervalTicks;
        }
    }

    public double RunFrequency
    {
        get
        {
            return _runFrequency;
        }
        set
        {
            if (value == _runFrequency)
                return;

            if (value == 0)
                RunIntervalTicks = long.MaxValue;
            else
                RunIntervalTicks = (long)Math.Round(Scheduler.TicksPerSecond / value);
        }
    }

    long _runIntervalTicks;
    double _runFrequency;
    readonly Action _action;

    /// &lt;summary&gt;
    /// Class for scheduling an action to occur at a specified frequency (in Hz).
    /// &lt;/summary&gt;
    /// &lt;param name="action"&gt;Action to run&lt;/param&gt;
    /// &lt;param name="runFrequency"&gt;How often to run in Hz&lt;/param&gt;
    public ScheduledAction(Action action, double runFrequency, bool removeAfterRun = false, double timeOffset = 0)
    {
        _action = action;
        RunFrequency = runFrequency; // Implicitly sets RunInterval
        DisposeAfterRun = removeAfterRun;
        TicksSinceLastRun = (long)Math.Round(timeOffset * Scheduler.TicksPerSecond);
    }

    public void Update(long deltaTicks)
    {
        TicksSinceLastRun += deltaTicks;

        if (TicksSinceLastRun &gt;= RunIntervalTicks)
        {
            _action.Invoke();
            TicksSinceLastRun = 0;

            JustRan = true;
        }
        else
        {
            JustRan = false;
        }
    }
}
#endregion

/// &lt;summary&gt;
/// Class that tracks runtime history.
/// &lt;/summary&gt;
public class RuntimeTracker
{
    public int Capacity { get; set; }
    public double Sensitivity { get; set; }
    public double MaxRuntime {get; private set;}
    public double MaxInstructions {get; private set;}
    public double AverageRuntime {get; private set;}
    public double AverageInstructions {get; private set;}
    public double LastRuntime {get; private set;}
    public double LastInstructions {get; private set;}
    
    readonly Queue&lt;double&gt; _runtimes = new Queue&lt;double&gt;();
    readonly Queue&lt;double&gt; _instructions = new Queue&lt;double&gt;();
    readonly StringBuilder _sb = new StringBuilder();
    readonly int _instructionLimit;
    readonly Program _program;
    const double MS_PER_TICK = 16.6666;

    public RuntimeTracker(Program program, int capacity = 100, double sensitivity = 0.005)
    {
        _program = program;
        Capacity = capacity;
        Sensitivity = sensitivity;
        _instructionLimit = _program.Runtime.MaxInstructionCount;
    }

    public void AddRuntime()
    {
        double runtime = _program.Runtime.LastRunTimeMs;
        LastRuntime = runtime;
        AverageRuntime += (Sensitivity * runtime);
        int roundedTicksSinceLastRuntime = (int)Math.Round(_program.Runtime.TimeSinceLastRun.TotalMilliseconds / MS_PER_TICK);
        if (roundedTicksSinceLastRuntime == 1)
        {
            AverageRuntime *= (1 - Sensitivity); 
        }
        else if (roundedTicksSinceLastRuntime &gt; 1)
        {
            AverageRuntime *= Math.Pow((1 - Sensitivity), roundedTicksSinceLastRuntime);
        }

        _runtimes.Enqueue(runtime);
        if (_runtimes.Count == Capacity)
        {
            _runtimes.Dequeue();
        }
        
        MaxRuntime = 0; // WitM: manual max instead of LINQ Max(), which allocates every run
        foreach (double r in _runtimes) if (r &gt; MaxRuntime) MaxRuntime = r;
    }

    public void AddInstructions()
    {
        double instructions = _program.Runtime.CurrentInstructionCount;
        LastInstructions = instructions;
        AverageInstructions = Sensitivity * (instructions - AverageInstructions) + AverageInstructions;
        
        _instructions.Enqueue(instructions);
        if (_instructions.Count == Capacity)
        {
            _instructions.Dequeue();
        }
        
        MaxInstructions = 0;
        foreach (double i in _instructions) if (i &gt; MaxInstructions) MaxInstructions = i;
    }

    public string Write()
    {
        _sb.Clear();
        _sb.AppendLine("General Runtime Info");
        _sb.AppendLine($"  Avg instructions: {AverageInstructions:n2}");
        _sb.AppendLine($"  Last instructions: {LastInstructions:n0}");
        _sb.AppendLine($"  Max instructions: {MaxInstructions:n0}");
        _sb.AppendLine($"  Avg complexity: {MaxInstructions / _instructionLimit:0.000}%");
        _sb.AppendLine($"  Avg runtime: {AverageRuntime:n4} ms");
        _sb.AppendLine($"  Last runtime: {LastRuntime:n4} ms");
        _sb.AppendLine($"  Max runtime: {MaxRuntime:n4} ms");
        return _sb.ToString();
    }
}

public static class StringExtensions
{
    public static bool Contains(string source, string toCheck, StringComparison comp = StringComparison.OrdinalIgnoreCase)
    {
        return source?.IndexOf(toCheck, comp) &gt;= 0;
    }
}

// Static title card on the programmable block's own screen. Drawn once, then redrawn every few
// seconds only so it reappears after the screen is reset (world load, block repaired).
class WitmTitleCard
{
    static readonly Color Background = new Color(18, 24, 34);
    static readonly Color Sand = new Color(222, 200, 150);
    static readonly Color Dim = new Color(150, 135, 100);
    const string Font = "White";

    readonly string _versionText;
    readonly IMyTextSurface _surface;
    bool _toggle;

    public WitmTitleCard(string version, Program program)
    {
        _versionText = "v" + version + "  -  Villanor";
        _surface = program.Me.GetSurface(0);
    }

    public void Draw()
    {
        if (_surface == null)
            return;

        _surface.ContentType = ContentType.SCRIPT;
        _surface.Script = "";
        _surface.ScriptBackgroundColor = Background;

        Vector2 center = _surface.TextureSize * 0.5f;
        Vector2 scaleVec = _surface.SurfaceSize / 512f;
        float scale = Math.Min(scaleVec.X, scaleVec.Y);

        using (var frame = _surface.DrawFrame())
        {
            // Toggling an empty sprite makes the game redraw the frame even though nothing changed.
            _toggle = !_toggle;
            if (_toggle)
                frame.Add(new MySprite());

            Text(frame, "WAR IN THE", new Vector2(0, -215), 1.0f, Dim, center, scale);
            Text(frame, "MEDITERRANEAN", new Vector2(0, -185), 1.7f, Sand, center, scale);
            Box(frame, new Vector2(0, -120), new Vector2(300, 3), Dim, center, scale);

            // Plane seen from above, nose up.
            Vector2 p = new Vector2(0, 15);
            Box(frame, p + new Vector2(0, -98), new Vector2(76, 6), Sand, center, scale);   // propeller
            Circle(frame, p + new Vector2(0, -80), 30, Sand, center, scale);                // nose
            Box(frame, p + new Vector2(0, 0), new Vector2(28, 160), Sand, center, scale);   // fuselage
            Box(frame, p + new Vector2(0, -20), new Vector2(250, 32), Sand, center, scale); // wings
            Circle(frame, p + new Vector2(-125, -20), 32, Sand, center, scale);             // wing tips
            Circle(frame, p + new Vector2(125, -20), 32, Sand, center, scale);
            Box(frame, p + new Vector2(0, 70), new Vector2(104, 16), Sand, center, scale);  // tailplane
            Circle(frame, p + new Vector2(0, 80), 20, Sand, center, scale);                 // tail
            Circle(frame, p + new Vector2(0, -42), 16, Background, center, scale);          // cockpit

            Box(frame, new Vector2(0, 135), new Vector2(300, 3), Dim, center, scale);
            Text(frame, "PLANE CONTROL", new Vector2(0, 150), 1.4f, Sand, center, scale);
            Text(frame, _versionText, new Vector2(0, 200), 0.8f, Dim, center, scale);
        }
    }

    static void Box(MySpriteDrawFrame frame, Vector2 pos, Vector2 size, Color color, Vector2 center, float scale)
    {
        frame.Add(new MySprite(SpriteType.TEXTURE, "SquareSimple", pos * scale + center, size * scale, color, null, TextAlignment.CENTER, 0f));
    }

    static void Circle(MySpriteDrawFrame frame, Vector2 pos, float diameter, Color color, Vector2 center, float scale)
    {
        frame.Add(new MySprite(SpriteType.TEXTURE, "Circle", pos * scale + center, new Vector2(diameter, diameter) * scale, color, null, TextAlignment.CENTER, 0f));
    }

    static void Text(MySpriteDrawFrame frame, string text, Vector2 pos, float size, Color color, Vector2 center, float scale)
    {
        frame.Add(new MySprite(SpriteType.TEXT, text, pos * scale + center, null, color, Font, TextAlignment.CENTER, size * scale));
    }
}

#region BSOD
static class BlueScreenOfDeath 
{
    const int MAX_BSOD_WIDTH = 35;
    const string BSOD_TEMPLATE =
    "{0} - v{1}\n\n"+ 
    "A fatal exception has occured at\n"+
    "{2}. The current\n"+
    "program will be terminated.\n"+
    "\n"+ 
    "EXCEPTION:\n"+
    "{3}\n"+
    "\n"+
    "* Please REPORT this crash message to\n"+ 
    "  Villanor (War in the Mediterranean)\n"+ 
    "\n"+
    "* Press RECOMPILE to restart the program";

    static StringBuilder bsodBuilder = new StringBuilder(256);
    
    public static void Show(IMyTextSurface surface, string scriptName, string version, Exception e)
    {
        if (surface == null) 
        { 
            return;
        }
        surface.ContentType = ContentType.TEXT_AND_IMAGE;
        surface.Alignment = TextAlignment.LEFT;
        float scaleFactor = 512f / (float)Math.Min(surface.TextureSize.X, surface.TextureSize.Y);
        surface.FontSize = scaleFactor * surface.TextureSize.X / (26f * MAX_BSOD_WIDTH);
        surface.FontColor = Color.White;
        surface.BackgroundColor = Color.Blue;
        surface.Font = "Monospace";
        string exceptionStr = e.ToString();
        string[] exceptionLines = exceptionStr.Split('\n');
        bsodBuilder.Clear();
        foreach (string line in exceptionLines)
        {
            if (line.Length &lt;= MAX_BSOD_WIDTH)
            {
                bsodBuilder.Append(line).Append("\n");
            }
            else
            {
                string[] words = line.Split(' ');
                int lineLength = 0;
                foreach (string word in words)
                {
                    lineLength += word.Length;
                    if (lineLength &gt;= MAX_BSOD_WIDTH)
                    {
                        lineLength = 0;
                        bsodBuilder.Append("\n");
                    }
                    bsodBuilder.Append(word).Append(" ");
                }
                bsodBuilder.Append("\n");
            }
        }

        surface.WriteText(string.Format(BSOD_TEMPLATE, 
                                        scriptName.ToUpperInvariant(),
                                        version,
                                        DateTime.Now, 
                                        bsodBuilder));
    }
}
#endregion
