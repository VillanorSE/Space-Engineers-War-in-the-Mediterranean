<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Spawn sequence for carrier escort -->	

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CarrierSpawn-Aquila</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:5000]

			[MaxActions:1]
			[StartsReady:true]
			
			[MaxPlayerReputation:-500]
			
            [Actions:WW2-Action-CarrierSpawn-Aquila]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-CarrierSpawn-Aquila</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-CarrierSpawn-Aquila-A]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-CarrierSpawn-Aquila-C]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-CarrierSpawn-Aquila-D]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-CarrierSpawn-Aquila-B]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-CarrierSpawn-Aquila-A</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:NPC-WW2-Re2001]

			[MinDistance:800]
			[MaxDistance:2000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
