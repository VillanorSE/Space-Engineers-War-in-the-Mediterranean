<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Depot ground units: MES Patrol behavior on hidden NPC thrusters (no wheel driving or road pathing in MES), looping around their spawn point; turrets engage on their own. Ground handling copied from Mike Dude's Land Escorts (2653133286): dampeners off while driving and an AltitudeTolerance far above IdealPlanetAltitude, so MES never fires the up/down thrusters and gravity keeps the wheels down (with dampeners on, the thrusters held the grid up and it flew off downhill slopes). MES only applies DisableInertiaDampeners at spawn, not on profile switches, so stops turn them on with an action. Dampeners go on while a unit waits at a patrol point (BehaviorTriggerA) so it does not roll, and off when it leaves (BehaviorTriggerB). Default player-distance despawn kept: they only matter with players near. Despawn after 30 min; the C# refunds intact patrol units. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-DepotPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:true]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:true]
			[IdealMaxSpeed:10]
			[IdealMinSpeed:4]
			[MaxSpeedTolerance:3]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:true]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:15]
			[WaypointWaitTimeTrigger:20]
			[WaypointAbandonTimeTrigger:300]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[RotationMultiplierPitch:0.1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[HoverUpAngle:30]
			[UseVelocityCollisionEvasion:false]
			[AllowStrafing:false]
			[OffsetPlanetMinTargetAltitude:2]
			[OffsetPlanetMaxTargetAltitude:2]
			[OffsetPlanetMinDistFromTarget:800]
			[OffsetPlanetMaxDistFromTarget:1200]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-DepotDefense</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:true]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:true]
			[IdealMaxSpeed:10]
			[IdealMinSpeed:4]
			[MaxSpeedTolerance:3]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:true]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:15]
			[WaypointWaitTimeTrigger:20]
			[WaypointAbandonTimeTrigger:300]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[RotationMultiplierPitch:0.1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[HoverUpAngle:30]
			[UseVelocityCollisionEvasion:false]
			[AllowStrafing:false]
			[OffsetPlanetMinTargetAltitude:2]
			[OffsetPlanetMaxTargetAltitude:2]
			[OffsetPlanetMinDistFromTarget:300]
			[OffsetPlanetMaxDistFromTarget:700]
			</Description>
		</EntityComponent>
<!-- Road patrol (owner 2026-11-04 trial at Mascara; 2026-11-08 at Mascara, Abruzzo, Benghazi, Tunis, Tobruk, Sirte): Primary drives the road loop like the convoy trucks (no slow-down or wait at points); Secondary is Hunter's approach. Hunter reads its distances and timers from whichever profile is active, so both carry them. AllowStrafing false keeps an engaging unit from sliding sideways on its NPC thrusters. Smoother steering as the convoys (MaxRotationStep, Mike Dude). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-DepotRoadPatrol</SubtypeId>
			</Id>
			<Description>
			[RivalAI Autopilot]
			[UseSurfaceHoverThrustMode:true]
			[IdealPlanetAltitude:2]
			[MinimumPlanetAltitude:-100]
			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:true]
			[IdealMaxSpeed:8]
			[IdealMinSpeed:4]
			[MaxSpeedTolerance:3]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:8]
			[WaypointWaitTimeTrigger:0]
			[WaypointAbandonTimeTrigger:300]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[RotationMultiplierPitch:0.1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[HoverUpAngle:30]
			[UseVelocityCollisionEvasion:false]
			[AllowStrafing:false]
			[OffsetPlanetMinTargetAltitude:2]
			[OffsetPlanetMaxTargetAltitude:2]
			[EngageDistancePlanet:600]
			[DisengageDistancePlanet:800]
			[TimeBetweenNewTargetChecks:5]
			[LostTargetTimerTrigger:30]
			[UseAircraftFlightModel:true]
			[MaxRotationStep:0.5]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-DepotHunt</SubtypeId>
			</Id>
			<Description>
