	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Port-LaSpezia</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[StaticEncounter:true]
			[StaticEncounterUsePlanetDirectionAndAltitude:true]
			[StaticEncounterPlanet:WW2WitM_Mediterranean]
			[StaticEncounterPlanetDirection:{X:0.241848463 Y:-0.902317349 Z:0.356837108}]
			[StaticEncounterPlanetAltitude:0]
			[StaticEncounterForward:{X:-0.578436374664307 Y:-0.427853167057037 Z:-0.69451642036438}]
			[StaticEncounterUp:{X:0.780267298221588 Y:-0.0419028103351593 Z:-0.624041020870209}]
			[ForceExactPositionAndOrientation:true]
			[PlanetWhitelist:WW2WitM_Mediterranean]

			[FactionOwner:GRAY]

			[TriggerRadius:65000]

			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]

		</Description>
	</EntityComponent>

