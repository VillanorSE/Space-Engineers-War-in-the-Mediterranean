<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- 2026-08-23: one profile per Factory plane, each forcing exactly its own plane as the
     store's only offer (MinOfferItems=MaxOfferItems=1, RequiredOffers matching that plane's
     own StoreItemId). Pattern confirmed against GVK-Derelicts' own MES Store profiles
     (Workshop ID 2653133286, Data/Encounters/Store/GVK-Store-StoreProfiles.sbc). Applied to
     an actual Store block via WW2-Store-Behavior-FactoryPlaneSales.sbc, referenced from each
     Factory's own existing Behavior  - see that file's own note for how the two connect. -->
	<EntityComponents>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Re2000</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-Re2000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-Re2001</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-Re2001]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-FC20</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-FC20]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-SM79Bomber</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-SM79Bomber]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-SM79Torpedo</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-SM79Torpedo]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-V156FBomber</SubtypeId>
			</Id>
			<Description>
			[MES Store]
			[FileSource:WW2-Store-StoreItems-FactoryPlanes.xml]
			[MinOfferItems:1]
			[MaxOfferItems:1]
			[ItemsRequireInventory:false]
			[RequiredOffers:WW2-V156FBomber]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Profile-V156FTorpedo</SubtypeId>
