<!-- Shared Grow/Shrink actions + chats -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusGrow-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:Alexandria_Zone]
			[ZoneRadiusChangeType:Add]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Grow-Alexandria]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusShrink-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:Alexandria_Zone]
			[ZoneRadiusChangeType:Subtract]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Shrink-Alexandria]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Grow-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Alexandria Command]
			[Color:Blue]
			[ChatMessages:Alexandria territory has expanded.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Shrink-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Alexandria Command]
			[Color:Blue]
			[ChatMessages:Alexandria territory has contracted.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>

<!-- Counter floor/ceiling -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-PointsFloor-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:WW2-Territory-Action-PointsFloor-Alexandria]
			[Conditions:WW2-Territory-Condition-PointsFloor-Alexandria]
			[ConditionCheckResetsTimer:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-PointsFloor-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:Alexandria_Points]
			[CustomSandboxCountersTargets:-1]
			[SandboxCounterCompareTypes:LessOrEqual]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-PointsFloor-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ResetSandboxCounters:Alexandria_Points]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-PointsCeiling-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:WW2-Territory-Action-PointsCeiling-Alexandria]
			[Conditions:WW2-Territory-Condition-PointsCeiling-Alexandria]
			[ConditionCheckResetsTimer:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-PointsCeiling-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:Alexandria_Points]
			[CustomSandboxCountersTargets:4170]
			[SandboxCounterCompareTypes:Greater]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-PointsCeiling-Alexandria</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[SetSandboxCounters:Alexandria_Points]
