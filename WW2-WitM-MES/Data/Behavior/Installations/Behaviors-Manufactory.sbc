<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>
<!-- Manufactory (NPC-WW2-Manufactory, owner 2026-11-08). Like the ground factories: factory points on kill,
     reputation and retaliation triggers, defense spawn, plus 10 bots (WW2-Trigger-BotCrew-10, player within 800 m,
     once; same trigger as the Battleship and Carrier) and the component store (WW2-Store-Behavior-ManufactorySales.sbc,
     store block "Store-Manufactory"). No factory activation chat (its text is about vehicle factories). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Behavior-Manufactory-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[TriggerGroups:WW2-Points-Group-Gray-Factory]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[TriggerGroups:WW2-TriggerGroup-Retaliation-Tag-Gray]
			[Triggers:WW2-Trigger-BotCrew-10]
			[Triggers:WW2-Trigger-DefenseSpawn-Gray]
			[Triggers:WW2-Store-Trigger-UpdateSales-Manufactory]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Behavior-Manufactory-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]
			[TriggerGroups:WW2-Points-Group-Green-Factory]
			[Triggers:WW2-Trigger-ReputationDamageLight-Green]
			[TriggerGroups:WW2-TriggerGroup-Retaliation-Tag-Green]
			[Triggers:WW2-Trigger-BotCrew-10]
			[Triggers:WW2-Trigger-DefenseSpawn-Green]
			[Triggers:WW2-Store-Trigger-UpdateSales-Manufactory]
			</Description>
		</EntityComponent>
    </EntityComponents>
</Definitions>
