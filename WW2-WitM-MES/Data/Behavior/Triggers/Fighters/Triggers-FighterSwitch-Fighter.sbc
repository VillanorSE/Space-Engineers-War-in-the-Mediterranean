<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>
<!-- Trigger to switch to combat when a target is near. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-FighterSwitch-Fighter-Gray</SubtypeId>
            </Id>
            <Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:6000]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-FighterSwitch-Fighter-Gray]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-FighterSwitch-Fighter-Gray</SubtypeId>
            </Id>
            <Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-FighterSwitch-Fighter-Gray]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:FighterPlane]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-FighterSwitch-Fighter-Gray]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-PatrolSwitch-Fighter-Gray]
			[EnableTriggerNames:WW2-Trigger-FighterRunStart]
			[EnableTriggerNames:WW2-Trigger-FighterRunEnd]
			[EnableTriggerNames:WW2-Trigger-FighterTargetLost-Gray]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-FighterSwitch-Fighter-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:Squadriglia Caccia]
			[Color:Red]
			[ChatMessages: Hostile approaching. Switching to engage.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			[ChatMessages:Deviating from patrol to intercept hostile target.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-FighterSwitch-Fighter-Green</SubtypeId>
            </Id>
            <Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:TargetNear]
			[TargetDistance:6000]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-FighterSwitch-Fighter-Green]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-FighterSwitch-Fighter-Green</SubtypeId>
            </Id>
            <Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-FighterSwitch-Fighter-Green]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:FighterPlane]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Secondary]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-FighterSwitch-Fighter-Green]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-PatrolSwitch-Fighter-Green]
			[EnableTriggerNames:WW2-Trigger-FighterRunStart]
			[EnableTriggerNames:WW2-Trigger-FighterRunEnd]
			[EnableTriggerNames:WW2-Trigger-FighterTargetLost-Green]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-FighterSwitch-Fighter-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:Groupe de Chasse]
			[Color:Red]
			[ChatMessages: Hostile approaching. Switching to engage.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			[ChatMessages:Deviating from patrol to intercept hostile target.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
	<!-- Switches to the FighterPlane combat subclass and the Approach autopilot. -->
	<!-- Broadcasts chat about engaging a target -->
<!-- End Trigger to switch to combat -->
	</EntityComponents>
</Definitions>
