<?xml version="1.0" encoding="utf-8"?>
<!-- WitM G menu tabs. They start empty: Scripts/WW2-WitM/GMenu/GMenuSession.cs fills them from Data/GMenu/GMenuRules.txt
     and hides every other block category when a world loads. The game lists tabs by Name, so the number sets the order;
     Section1_Position0 puts them above Large Blocks / Small Blocks. Three leading spaces in a DisplayName indent the tab
     as a sub-tab, as vanilla does for the character tabs. -->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CategoryClasses>
    <Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
      <Id>
        <TypeId>GuiBlockCategoryDefinition</TypeId>
        <SubtypeId/>
      </Id>
      <DisplayName>Ship Cores</DisplayName>
      <Name>Section1_Position0_WitM01_Cores</Name>
      <ItemIds/>
    </Category>
