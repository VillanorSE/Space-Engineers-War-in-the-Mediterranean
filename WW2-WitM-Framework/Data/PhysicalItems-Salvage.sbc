<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<!-- GVK-inspired salvage/unlock-ingot chain (see GV Deserts of Kharak's own CU/RU system for the
     reference pattern):
     - Battle Wreckage (Ore) - salvaged from destroyed NPC grids, refines into Salvage Alloy.
     - Salvage Alloy (Ingot) - small unlock ingredient for Industrial/Military/Advanced Military
       Components (see Blueprints-Salvage.sbc). Sourced only via refining Battle Wreckage, or
       bought at Port stores.
     - Salvaged Ordnance (Ingot) - looted directly (no ore of its own), from larger NPC kills
       only. Unlock ingredient for the toughest naval gun ammo (see ModAdjuster patch). Sourced
       only via loot or Port stores.
     Icon/Model paths below reuse real vanilla assets (Scrap/Iron ingot/Uranium ingot), same
     asset-reuse pattern used elsewhere in this project - these are not custom models.
     Economy fields (MinimumOfferAmount/MaximumOfferAmount/MinimumOrderAmount/MaximumOrderAmount/
     CanPlayerOffer/MinimumAcquisitionAmount/MaximumAcquisitionAmount, plus MinimalPricePerUnit
     on the Ore) are the full companion set vanilla requires whenever CanPlayerOrder is true; see
     WW2-Reference-ModFileDebug.md for why this set is mandatory. -->

	<PhysicalItems>

		<PhysicalItem>
			<Id>
				<TypeId>Ore</TypeId>
				<SubtypeId>BattleWreckage</SubtypeId>
			</Id>
			<DisplayName>Battle Wreckage</DisplayName>
			<Icon>Textures\GUI\Icons\component\ScrapMetalComponent.dds</Icon>
			<Size>
				<X>0.2</X>
				<Y>0.2</Y>
				<Z>0.1</Z>
			</Size>
			<Mass>1</Mass>
			<Volume>0.254</Volume>
			<Model>Models\Components\ScrapMetalComponent.mwm</Model>
			<PhysicalMaterial>Metal</PhysicalMaterial>
			<MaxIntegrity>1</MaxIntegrity>
			<MinimalPricePerUnit>10</MinimalPricePerUnit>
			<MinimumOfferAmount>1000</MinimumOfferAmount>
			<MaximumOfferAmount>10000</MaximumOfferAmount>
			<MinimumOrderAmount>1000</MinimumOrderAmount>
			<MaximumOrderAmount>20000</MaximumOrderAmount>
			<CanPlayerOrder>true</CanPlayerOrder>
			<CanPlayerOffer>true</CanPlayerOffer>
			<MinimumAcquisitionAmount>100</MinimumAcquisitionAmount>
			<MaximumAcquisitionAmount>500</MaximumAcquisitionAmount>
		</PhysicalItem>

		<PhysicalItem>
			<Id>
				<TypeId>Ingot</TypeId>
				<SubtypeId>SalvageAlloy</SubtypeId>
			</Id>
			<DisplayName>Salvage Alloy</DisplayName>
			<Icon>Textures\GUI\Icons\ingot\iron_ingot.dds</Icon>
			<Size>
				<X>0.05</X>
				<Y>0.05</Y>
				<Z>0.05</Z>
			</Size>
			<Mass>1</Mass>
			<Volume>0.127</Volume>
			<Model>Models\Ingots\iron_ingot.mwm</Model>
			<PhysicalMaterial>Metal</PhysicalMaterial>
			<MaxIntegrity>1</MaxIntegrity>
			<MinimumOfferAmount>1000</MinimumOfferAmount>
			<MaximumOfferAmount>10000</MaximumOfferAmount>
			<MinimumOrderAmount>1000</MinimumOrderAmount>
			<MaximumOrderAmount>20000</MaximumOrderAmount>
			<CanPlayerOrder>true</CanPlayerOrder>
			<CanPlayerOffer>true</CanPlayerOffer>
			<MinimumAcquisitionAmount>30</MinimumAcquisitionAmount>
			<MaximumAcquisitionAmount>300</MaximumAcquisitionAmount>
		</PhysicalItem>

		<PhysicalItem>
			<Id>
				<TypeId>Ingot</TypeId>
				<SubtypeId>SalvagedOrdnance</SubtypeId>
			</Id>
			<DisplayName>Salvaged Ordnance</DisplayName>
			<Icon>Textures\GUI\Icons\ingot\uranium_ingot.dds</Icon>
			<Size>
				<X>0.037</X>
				<Y>0.037</Y>
				<Z>0.037</Z>
			</Size>
			<Mass>1</Mass>
			<Volume>0.052</Volume>
			<Model>Models\Ingots\uranium_ingot.mwm</Model>
			<PhysicalMaterial>Metal</PhysicalMaterial>
			<MaxIntegrity>1</MaxIntegrity>
			<MinimumOfferAmount>200</MinimumOfferAmount>
			<MaximumOfferAmount>2000</MaximumOfferAmount>
			<MinimumOrderAmount>10</MinimumOrderAmount>
			<MaximumOrderAmount>1000</MaximumOrderAmount>
			<CanPlayerOrder>true</CanPlayerOrder>
			<CanPlayerOffer>true</CanPlayerOffer>
			<MinimumAcquisitionAmount>100</MinimumAcquisitionAmount>
			<MaximumAcquisitionAmount>200</MaximumAcquisitionAmount>
		</PhysicalItem>

	</PhysicalItems>
</Definitions>
