<!-- Enable/Disable Actions - toggle the pre-built zone's Active flag, no radius-set needed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-EnableZone10000-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:WW2-Territory-Zone-LaSpezia-10000]
			[ZoneToggleActive:true]
			[ZoneToggleActiveMode:true]
			[SetCustomStrings:true]
			[CustomStrings:TerritoryRadiusKm,10]
			[CustomStrings:TerritoryStatus,expanded]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Status-LaSpezia]

			</Description>
		</EntityComponent>
