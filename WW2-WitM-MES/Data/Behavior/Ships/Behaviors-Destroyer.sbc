	<!-- Weapon Profile, Destroyer -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Weapons-Destroyer</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Weapons]
			
			[UseTurrets:true]
			
			[WeaponMaxAngleFromTarget:6]
			[WeaponMaxBaseDistanceTarget:100]
			
			[UseBarrageFire:true]
			[MaxFireRateForBarrageWeapons:3]
			
			[UseAmmoReplenish:true]
            
			</Description>
		</EntityComponent>
<!-- End Weapon Profile -->

	</EntityComponents>
