	<!-- Weapon Profile, Cruiser -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Weapons-Cruiser</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Weapons]
			
			[UseTurrets:true]
			
			[WeaponMaxAngleFromTarget:6]
			[WeaponMaxBaseDistanceTarget:100]
			
			[UseBarrageFire:true]
			[MaxFireRateForBarrageWeapons:4]
			
			[UseAmmoReplenish:true]
            
			</Description>
		</EntityComponent>
<!-- End Weapon Profile -->

	</EntityComponents>
</Definitions>
