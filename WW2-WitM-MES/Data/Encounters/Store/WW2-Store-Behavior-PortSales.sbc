<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- Port Store-sells-everything feature. Same Trigger/Action mechanism as
     WW2-Store-Behavior-FactoryPlaneSales.sbc.
     Two independent Trigger/Action pairs per location, targeting two separate physical Store
     blocks ("Store-Port-Goods" / "Store-Port-Vehicles"), so a problem with one catalog (e.g. a
     bad StoreProfile edit) can't take out the other on the same block:
     - ONE shared Goods pair (WW2-Store-Trigger/Action-UpdateSales-PortGoods), referenced from
       ALL 7 locations (4 Ports + Valencia) - the goods catalog is identical everywhere.
     - THREE Vehicle pairs (-Gray/-Green/-Valencia), each referenced only by the Behaviors that
       should offer that faction's roster.

     War Level gated (2026-09-22): Gray and Green each split into a -Base pair (always runs, the
     3 guaranteed level-1 items) plus a -Tier2 pair gated by [Conditions:WW2-WarLevel-Condition-
     AtLeast2] (War-Level-Gating.sbc), since exactly one item in each roster (Francesco Crispi /
     Bougainville) is level 2 and everything else there is level 1. Both pairs run every 60s
     independently and re-check their own Condition each cycle, same self-correcting pattern as
     WW2-Store-Behavior-AirfieldSales.sbc. Valencia is untouched - every item it sells is level 1. -->
	<EntityComponents>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-PortGoods</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Store-Action-UpdateSales-PortGoods]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-PortGoods</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-Port-Goods]
			[StoreProfiles:WW2-Store-Profile-PortGoods]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-Vehicles-Gray-Base</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Store-Action-UpdateSales-Vehicles-Gray-Base]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-Vehicles-Gray-Base</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-Port-Vehicles]
			[StoreProfiles:WW2-Store-Profile-Vehicles-Gray-Base]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-Vehicles-Gray-Tier2</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-WarLevel-Condition-AtLeast2]
			[Actions:WW2-Store-Action-UpdateSales-Vehicles-Gray-Tier2]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-Vehicles-Gray-Tier2</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:false]
			[StoreBlocks:Store-Port-Vehicles]
			[StoreProfiles:WW2-Store-Profile-Vehicles-Gray-Tier2]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-Vehicles-Green-Base</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Store-Action-UpdateSales-Vehicles-Green-Base]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-Vehicles-Green-Base</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-Port-Vehicles]
			[StoreProfiles:WW2-Store-Profile-Vehicles-Green-Base]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-Vehicles-Green-Tier2</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-WarLevel-Condition-AtLeast2]
			[Actions:WW2-Store-Action-UpdateSales-Vehicles-Green-Tier2]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-Vehicles-Green-Tier2</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:false]
			[StoreBlocks:Store-Port-Vehicles]
			[StoreProfiles:WW2-Store-Profile-Vehicles-Green-Tier2]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-Vehicles-Valencia</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Store-Action-UpdateSales-Vehicles-Valencia]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-Vehicles-Valencia</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-Port-Vehicles]
			[StoreProfiles:WW2-Store-Profile-Vehicles-Valencia]
			</Description>
		</EntityComponent>

	</EntityComponents>
</Definitions>
