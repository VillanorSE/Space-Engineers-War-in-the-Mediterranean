			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Chat-Defense-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:Comando Deposito]
			[Color:Red]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:3000]

			[ChatMessages:Enemy near the depot. Armour, roll out!]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
<!-- Garage bay (Gray): one of the holder's vehicles parked in the garage, every two hours while a player is near, only if the bay is empty. The check clears GarageBayOccupied and arms GarageBayCheck; a parked bay vehicle pings the depot every 60 s (WitM-GarageBayOccupied), which sets it again, so the check spawns only if no ping came in 90 s. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBay-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:PlayerNear]
			[TargetDistance:1500]
			[MinCooldownMs:7200000]
			[MaxCooldownMs:7200001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Depot-Action-GarageBay-Gray]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-GarageBay-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetBooleansFalse:GarageBayOccupied]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Depot-Trigger-GarageBayCheck-Gray]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Depot-Trigger-GarageBayCheck-Gray]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBayCheck-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:90000]
			[MaxCooldownMs:90001]
			[StartsReady:false]
			[MaxActions:-1]
			[Conditions:WW2-Depot-Condition-GarageBayEmpty]
			[Actions:WW2-Depot-Action-GarageBaySpawn-Gray]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-GarageBaySpawn-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:DepotGarageBay-Gray]
			[ForceManualTriggerActivation:false]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Depot-Trigger-GarageBayCheck-Gray]
			</Description>
		</EntityComponent>
<!-- Garage bay (Gray) by War Level: the band picks the spawn group (WL1 = else of the next band's condition); each group draws one vehicle at random from that War Level and below. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBay-WL1-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
