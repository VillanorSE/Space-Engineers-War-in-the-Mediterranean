			[SpawnEncounter:true]
			[Spawner:WW2-Convoy-Spawn-Raid-Green-Attacker]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-Raid-Wave-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:1000]
			[MinPlayerReputation:500]
			[MinCooldownMs:1080000]
			[MaxCooldownMs:1500000]
			[StartsReady:false]
			[MaxActions:3]
			[Actions:WW2-Convoy-Action-Raid-Wave-Green]
			</Description>
		</EntityComponent>
