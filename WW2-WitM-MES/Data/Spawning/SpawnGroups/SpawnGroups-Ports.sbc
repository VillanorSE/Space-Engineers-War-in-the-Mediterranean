<!-- Valencia (neutral trade post) -->
	<!-- IsPirate:false here (unlike the 4 GRAY/GREEN ports above, which all use IsPirate:true)
	     since Valencia isn't hostile to anyone by design - see Factions.sbc's TRADER faction and
	     Behaviors-Port.sbc's Valencia entry (no reputation-damage or defensive-scramble
	     triggers). -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Port-Valencia</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Port-Valencia]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[GridsAreEditable:false]
		[GridsAreDestructable:false]
		[IgnoreCleanupRules:true]

		[FactionOverride:TRADER]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>false</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Port_Valencia">
				<Position>
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Port-Valencia</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

<!-- End Port Installations -->

	</SpawnGroups>
</Definitions>
