<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Port Installations (Static Encounters)
     2026-08-27: the 4 existing, already-built port installations, set up to spawn once at
     their exact current in-game position/orientation and never again  - see
     SpawnConditions-Ports.sbc for the [StaticEncounter] tags. [GridsAreEditable:false] and
     [GridsAreDestructable:false] are MES Manipulation tags placed directly in the SpawnGroup
     (per MES docs, Manipulation tags are valid inline in SpawnGroup Description, no separate
     Manipulation Profile needed) - makes each port immune to weapon/collision damage and to
     welding/grinding/block edits, on top of MES-Manipulation-RivalAi's usual AI setup.
     Behaviour references one Behavior per port (Behaviors-Port.sbc, e.g. WW2-Behavior-Port-Gray-
     LaSpezia) - split from a single shared per-faction Behavior on 2026-08-30 so each port can
     run its own direction-specific cargo spawn (see Triggers-CargoSpawn-Port.sbc) alongside the
     shared Store-sales and defensive-scramble triggers. -->

	<!-- Gray La Spezia Port -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Port-LaSpezia</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Port-LaSpezia]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[GridsAreEditable:false]
		[GridsAreDestructable:false]

		[FactionOverride:GRAY]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Port_LaSpezia">
				<Position>
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Port-Gray-LaSpezia</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

	<!-- Green Port of Toulon -->
