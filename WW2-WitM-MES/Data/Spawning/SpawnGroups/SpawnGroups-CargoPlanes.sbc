<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Green Cargo Plane -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>NPC-WW2-F222</SubtypeId>
		</Id>
		<Description>
		
		[Modular Encounters SpawnGroup]
	
		[SpawnConditionsProfiles:WW2-SpawnConditions-CargoPlanes]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-Tech-Industrial-Reliable]
		[ManipulationProfiles:WW2-Manipulation-Tech-Military-Reliable]
		[ManipulationProfiles:WW2-Manipulation-Tech-AdvancedMilitary-CargoRare]
		[ManipulationProfiles:WW2-Manipulation-CargoPlanes]
		[FactionOverride:GREEN]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-F222">
				<Position>
					<X>0.0</X>
					<Y>0.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-CargoPlane-Green</Behaviour>
				<Speed>50.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>
<!-- End Green Cargo Plane -->

