<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Gray Torpedo Boats -->
	<SpawnGroup>
		<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>NPC-WW2-Spica</SubtypeId>
		</Id>
		<Description>
		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Ships-Destroyers-WL2]
		[ReplenishSystems:true]
		[PersistentConditions:WW2-SpawnConditions-Territory-Gray]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-Loot-Medium]
		[ManipulationProfiles:WW2-Manipulation-ShipsBasicLoot]
		[FactionOverride:GRAY]

		</Description>
		<Icon>Textures\GUI\Icons\Fake.dds</Icon>
		<Frequency>10.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Spica">
				<Position>
					<X>0.0</X>
					<Y>0.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Destroyer-Gray</Behaviour>
				<Speed>15.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

<!-- Spica escort: spawned only by the Aquila carrier's escort trigger (Triggers-CarrierSpawn.sbc); Ships-Escort conditions are RivalAi-only, so no ambient spawns. -->
