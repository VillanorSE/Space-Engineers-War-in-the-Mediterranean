<!-- ==================== AIR CARGO DELIVERIES ====================
     Airfield-to-airfield cargo planes (Triggers-AirCargo.sbc). Plane side: +50M to its faction bank, fired by
     WW2-Trigger-AirCargo-Unload-{Faction} after the 5-min loiter. Airfield side (below): +20 at the delivering
     faction's anchor nearest that airfield.
     MES quirk: ChangeNpcFactionCredits reads ChangePlayerCreditsAmount, not ChangeNpcFactionCreditsAmount. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-Delivery-AirCargo-Gray</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[SetBooleansTrue:Retired]
			[ChangeNpcFactionCredits:true]
			[ChangeNpcFactionCreditsTag:GRAY]
			[ChangePlayerCreditsAmount:50000000]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-Delivery-AirCargo-Green</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[SetBooleansTrue:Retired]
			[ChangeNpcFactionCredits:true]
			[ChangeNpcFactionCreditsTag:GREEN]
			[ChangePlayerCreditsAmount:50000000]

			</Description>
		</EntityComponent>


<!-- ==================== AIR CARGO - NEAREST ANCHOR ====================
     Run on WW2-Behavior-Airfield. The plane sends AirCargo-Delivered-{GRAY|GREEN} on delivery; the matching
     anchor trigger passes only on the airfield whose {SpawnGroupName}_Near{Faction}_{Anchor} sandbox boolean is set.
     Nearest = smallest angle to the anchor zone center (computed 2026-09-23). New airfield: add its 2 flags below. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-Airfield-NearestAnchorFlags</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-Territory-Action-Airfield-NearestAnchorFlags]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-Airfield-NearestAnchorFlags</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[SetSandboxBooleansTrue:WW2-Airfield-Gibraltar_NearGray_Tripoli]
			[SetSandboxBooleansTrue:WW2-Airfield-Gibraltar_NearGreen_Oran]
			[SetSandboxBooleansTrue:WW2-Airfield-Bizerte_NearGray_Rome]
			[SetSandboxBooleansTrue:WW2-Airfield-Bizerte_NearGreen_Toulon]
			[SetSandboxBooleansTrue:WW2-Airfield-Tripoli_NearGray_Tripoli]
			[SetSandboxBooleansTrue:WW2-Airfield-Tripoli_NearGreen_Alexandria]
			[SetSandboxBooleansTrue:WW2-Airfield-Foggia_NearGray_Rome]
			[SetSandboxBooleansTrue:WW2-Airfield-Foggia_NearGreen_Toulon]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-AirCargoDelivered-Gray-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:AirCargo-Delivered-GRAY]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Territory-Condition-NearGray-LaSpezia]
			[Actions:WW2-Territory-Action-AirCargoPoints-LaSpezia]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-NearGray-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[CheckTrueSandboxBooleans:true]
			[TrueSandboxBooleans:{SpawnGroupName}_NearGray_LaSpezia]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-AirCargoPoints-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[IncreaseSandboxCounters:LaSpezia_Points]
			[IncreaseSandboxCountersAmount:20]

			</Description>
