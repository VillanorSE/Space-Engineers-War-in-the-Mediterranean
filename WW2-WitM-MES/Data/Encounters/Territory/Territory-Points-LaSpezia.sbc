<!-- Shared status chat for all tier changes -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Status-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:La Spezia Command]
			[Color:Blue]
			[ChatMessages:La Spezia territory {TerritoryStatus} to {TerritoryRadiusKm}km.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>

<!-- Counter floor/ceiling - mirrors GVK's TriggerGroup-PointsLimits-Faction.sbc.
     Floor resets to 0 on underflow (no point-debt). Ceiling caps at ~20% above the tier-6
     threshold so overkill contributions don't accumulate indefinitely. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-PointsFloor-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:WW2-Territory-Action-PointsFloor-LaSpezia]
			[Conditions:WW2-Territory-Condition-PointsFloor-LaSpezia]
			[ConditionCheckResetsTimer:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-PointsFloor-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:LaSpezia_Points]
			[CustomSandboxCountersTargets:-1]
			[SandboxCounterCompareTypes:LessOrEqual]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-PointsFloor-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ResetSandboxCounters:LaSpezia_Points]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-PointsCeiling-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:WW2-Territory-Action-PointsCeiling-LaSpezia]
			[Conditions:WW2-Territory-Condition-PointsCeiling-LaSpezia]
			[ConditionCheckResetsTimer:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-PointsCeiling-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:LaSpezia_Points]
			[CustomSandboxCountersTargets:6850]
			[SandboxCounterCompareTypes:Greater]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-PointsCeiling-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[SetSandboxCounters:LaSpezia_Points]
			[SetSandboxCountersValues:6850]

			</Description>
		</EntityComponent>

	</EntityComponents>
</Definitions>
