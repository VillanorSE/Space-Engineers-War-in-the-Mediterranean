<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Base strikes and retaliation (D-036). Routine: static player threat band within 2 km, player rep <= -1000 within 4 km,
     faction cooldown bool, exact WarLevel tier (unset WarLevel = WL1, so WL1 has no counter check). Retaliation: tagged player within 10 km. -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-BaseStrike-Gray-Small-WL2</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]

			[PlanetaryCargoShip:true]
			[SkipAirDensityCheck:true]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[SandboxVariables:WW2-StoryLive]
			[FalseSandboxVariables:WW2-BaseStrike-Cooldown-Gray]

			[UseThreatLevelCheck:true]
			[ThreatLevelCheckRange:2000]
			[ThreatScoreGridConfiguration:Static]
			[ThreatScoreMinimum:150]
			[ThreatScoreMaximum:499]

			[UsePlayerFactionReputation:true]
			[PlayerReputationCheckRadius:4000]
			[MaximumReputation:-1000]

			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:2]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:3]
			[SandboxCounterCompareTypes:Less]
			</Description>
		</EntityComponent>

