<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Offense Factory Re2000 Spawn sequence -->
	<!--Triggers every 30-45 minutes once a player has first come in range of the factory-->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-OffenseSpawn-Factory-Plane-Re2000</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:Timer]
			
			[MinCooldownMs:1800000]
			[MaxCooldownMs:2700000]			
			[StartsReady:false]
			
			[MaxActions:-1]
            [Actions:WW2-Action-OffenseSpawn-Factory-Plane-Re2000]
			
			</Description>
        </EntityComponent>

	<!-- Calls a fighter spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-OffenseSpawn-Factory-Plane-Re2000</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-OffenseSpawn-Factory-Plane-Re2000]
			
			</Description>
        </EntityComponent>

	<!-- Spawns an Re2000 fighter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-OffenseSpawn-Factory-Plane-Re2000</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Spawn]
			
			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:NPC-WW2-Re2000]
			
			[MinDistance:400]
			[MaxDistance:1000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]
			
			</Description>
        </EntityComponent>
<!-- End Offense Factory Re2000 Spawn sequence -->

