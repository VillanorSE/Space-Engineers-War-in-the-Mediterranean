<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

		<!-- ToolSubtypeId: SETB SMLE Mk III (owner 2026-11-08). Without it AiEnabled gives soldiers vanilla's
		     RapidFireAutomaticRifleItem, which WitM restricts for players (handweapons.xml), and they drop it. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-BotSpawnProfile-CombatBot</SubtypeId>
            </Id>
            <Description>
			
			[MES Bot Spawn]
			
			[BotDisplayName:Soldier]
			[Color:{X:100 Y:100 Z:100}]
			
			[BotType:Target_Dummy]
			[BotBehavior:SOLDIER]
			[UseAiEnabled:true]
			[ToolSubtypeId:BoltAction]
			
			[CanUseLadders:true]
			[CanUseSeats:true]
			
			[IgnoreCombatPhase:true]
			
			</Description>
        </EntityComponent>

	</EntityComponents>
</Definitions>