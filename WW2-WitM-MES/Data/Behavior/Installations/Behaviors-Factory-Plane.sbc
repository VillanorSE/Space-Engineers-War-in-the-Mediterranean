<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- 2026-08-23: earlier this session, [Triggers:WW2-Trigger-ProjectorBuild-Factory] was
     wrongly removed from every Behavior below on the claim that no Projector block exists in
     either Factory shell  - that search was wrong (searched for the literal string
     "ProjectorBase" instead of the real xsi:type MyObjectBuilder_Projector; both shells do
     have a LargeProjector, "Factory - Projector"). Restored per direct correction: this
     trigger is intentional  - it builds valuable large blocks from the projector after a
     cargo plane's delivery succeeds. Do not remove it again. -->

<!-- Gray Factory Behaviors -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Factory-Plane-Re2000</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Trigger-ReputationDamage-Gray]
			[Triggers:WW2-Trigger-Announcement-Factory]

			[Triggers:WW2-Trigger-DeliverySpawn-Factory-Plane-Gray]
			[Triggers:WW2-Trigger-CallCargoPlane]
			[Triggers:WW2-Trigger-Recirculate-Factory-Plane]
			[Triggers:WW2-Trigger-ProjectorBuild-Factory]

			[Triggers:WW2-Trigger-Activation-Factory-Plane-Gray]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-DefenseSpawn-Factory-Plane-Gray]
			[Triggers:WW2-Trigger-OffenseSpawn-Factory-Plane-Re2000]
			[Triggers:WW2-Store-Trigger-UpdateSales-Re2000]

			</Description>
        </EntityComponent>
		
