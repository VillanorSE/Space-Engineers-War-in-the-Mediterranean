			[AltitudeTolerance:50]
			[HoverPathStepDistance:30]
			[FlyLevelWithGravity:false]
			[LevelWithGravityWhenIdle:true]
			[DisableInertiaDampeners:true]
			[IdealMaxSpeed:10]
			[IdealMinSpeed:4]
			[MaxSpeedTolerance:3]
			[MaxVelocityAngleForSpeedControl:180]
			[SlowDownOnWaypointApproach:true]
			[ExtraSlowDownDistance:40]
			[WaypointTolerance:15]
			[WaypointWaitTimeTrigger:3]
			[WaypointAbandonTimeTrigger:30]
			[AngleAllowedForForwardThrust:35]
			[RotationMultiplier:1]
			[RotationMultiplierPitch:0.1]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.3]
			[HoverUpAngle:30]
			[UseVelocityCollisionEvasion:false]
			[AllowStrafing:false]
			[OffsetPlanetMinTargetAltitude:2]
			[OffsetPlanetMaxTargetAltitude:2]
			[OffsetPlanetMinDistFromTarget:150]
			[OffsetPlanetMaxDistFromTarget:250]
			[MaxRotationStep:0.5]
			</Description>
		</EntityComponent>
<!-- Depot unit targeting (road patrol / Hunter): enemy players and powered enemy grids within 1.5 km, never the invulnerable sites (same names as WW2-Targeting-ShipMain) or UNOWNED grids. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Targeting-DepotUnit</SubtypeId>
			</Id>
			<Description>
			[RivalAI Target]
			[UseCustomTargeting:true]
			[Target:PlayerAndGrid]
			[MaxDistance:1500]
			[TimeUntilTargetAcquisition:5]
			[TimeUntilNextEvaluation:3]
			[UseTargetRefresh:true]
			[TimeUntilNextRefresh:30]
			[MatchAllFilters:OutsideOfSafezone]
			[MatchAllFilters:Owner]
			[MatchAllFilters:Relation]
			[MatchAllFilters:Powered]
			[MatchNoneFilters:Name]
			[UsePartialNameMatching:false]
			[Names:Port - La Spezia]
			[Names:Port - Toulon]
			[Names:Port - Oran]
			[Names:Port - Alexandria]
			[Names:Port - Tripoli]
			[Names:Port - Valencia]
			[Names:Port - Civitavecchia]
			[Names:Port - La Spezia - Rotor]
			[Names:Port - Toulon - Rotor]
			[Names:Port - Oran - Rotor]
			[Names:Port - Alexandria - Rotor]
			[Names:Port - Tripoli - Rotor]
			[Names:Port - Valencia - Rotor]
			[Names:Port - Civitavecchia - Rotor]
			[Names:Airfield - Gibraltar]
			[Names:Airfield - Bizerte]
			[Names:Airfield - Tripoli]
			[Names:Airfield - Foggia]
			[Names:Airfield - Casablanca]
			[Names:Airfield - Benghazi]
			[Names:Airfield - Tobruk]
			[Names:Vehicle Depot - Benghazi]
			[Names:Vehicle Depot - Tunis]
			[Names:Vehicle Depot - Tobruk]
			[Names:Vehicle Depot - Abruzzo]
			[Names:Vehicle Depot - Mascara]
			[Names:Vehicle Depot - Sirte]
			[Names:NPC Trader]
			[MatchNoneFilters:Faction]
			[FactionTargets:UNOWNED]
			[Owners:Player]
			[Owners:NPC]
			[Relations:Enemy]
			[GetTargetBy:ClosestDistance]
			</Description>
		</EntityComponent>
