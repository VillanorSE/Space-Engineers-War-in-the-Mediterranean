	</Description>
	<Frequency>1.0</Frequency>
	<IsPirate>true</IsPirate>
	<Prefabs>
		<Prefab SubtypeId="NPC-WW2-V-156-F_Torpedo">
			<Position>
				<X>0.0</X>
				<Y>0.0</Y>
				<Z>0.0</Z>
			</Position>
			<Behaviour>WW2-Behavior-Fighter-Green</Behaviour>
			<Speed>55.0</Speed>
