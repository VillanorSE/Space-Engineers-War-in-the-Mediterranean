<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- War Level points - the single global WarActivity counter and the WarLevel (1-5) it drives. GENERATED from Territory-WarLevel-Design.md section 2. -->

<!-- ==================== SHARED CONDITIONS / RETIRE ====================
     Per-grid booleans (stored on the grid own Remote Control, so every NPC tracks its own):
       Attacked - set by the first-damage trigger; that grid War Activity has been counted once already.
       Retired  - the grid left the war cleanly (despawned, delivered, or already counted as killed).
     Retire triggers exist so a grid that despawns or finishes a delivery is never scored as a kill when its Remote
     Control closes. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Points-Condition-NotRetired</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:Retired]
			[AllowAnyFalseBoolean:false]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Points-Condition-NotRetiredNotAttacked</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:Retired]
			[FalseBooleans:Attacked]
			[AllowAnyFalseBoolean:false]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Points-Action-Retire</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[SetBooleansTrue:Retired]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Points-Trigger-Retire-Despawn</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Despawn]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-Points-Action-Retire]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Points-Trigger-Retire-DespawnMES</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:DespawnMES]
			[DespawnTypeFromSpawner:Any]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-Points-Action-Retire]

			</Description>
		</EntityComponent>

<!-- ==================== WAR ACTIVITY BY GRID TYPE ====================
     WarActivity only goes UP (one-way): when an NPC is FIRST attacked (once per grid) or destroyed without ever
     having been attacked. Same value table as Territory (design 2.3). Nothing subtracts it (no clean-despawn or
     delivery decrease); it only drops if the counter is edited by hand for testing. Not per faction - the war is
     global - so these are shared by both factions groups. Types with value 0 (armored car) are deliberately
     absent: an Increase amount of 0 would RESET the counter instead of doing nothing. -->

<!-- Carrier (100) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Trigger-Attacked-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Damage]
			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Deformation]
			[ExcludedDamageTypes:Weld]
			[MinCooldownMs:1000]
			[MaxCooldownMs:1001]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-WarLevel-Action-Attacked-Carrier]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Action-Attacked-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[IncreaseSandboxCounters:WarActivity]
			[IncreaseSandboxCountersAmount:100]
			[SetBooleansTrue:Attacked]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Trigger-Kill-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Compromised]
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-WarLevel-Action-Kill-Carrier]
			[Conditions:WW2-Points-Condition-NotRetiredNotAttacked]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-WarLevel-Action-Kill-Carrier</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[IncreaseSandboxCounters:WarActivity]
			[IncreaseSandboxCountersAmount:100]
			[SetBooleansTrue:Retired]

			</Description>
		</EntityComponent>

