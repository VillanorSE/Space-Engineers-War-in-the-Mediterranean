<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Convoy-raid warships: spawned only by the WW2-Spawn-ConvoyRaid-* behavior spawners (Triggers-ConvoyRaid.sbc); Raid conditions are RivalAi-only, no territory gate, so no ambient spawns. Mirrors the ambient groups of the same ship. -->
	<SpawnGroup>
		<Id>
				<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>NPC-WW2-La_Malouine-Raid</SubtypeId>
		</Id>
		<Description>
		[Modular Encounters SpawnGroup]
	
		[SpawnConditionsProfiles:WW2-SpawnConditions-Ships-Raid-Corvettes]
		[ReplenishSystems:true]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-Loot-Medium]
		[ManipulationProfiles:WW2-Manipulation-ShipsBasicLoot]
		[FactionOverride:GREEN]

		</Description>
		<Icon>Textures\GUI\Icons\Fake.dds</Icon>
		<Frequency>10.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-La_Malouine">
				<Position>
					<X>0.0</X>
					<Y>0.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Corvette-Green</Behaviour>
				<Speed>5.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

