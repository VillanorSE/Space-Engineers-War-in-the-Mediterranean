			[Conditions:WW2-Condition-Airfield-GrayTerritoryOnly]
			[Actions:WW2-Action-Depot-Unowned-BecomeGray]
			</Description>
		</EntityComponent>
<!-- /witm refresh re-applies a depot's old owner while that owner's territory still covers it (RefreshSession DepotOwnerCode). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-Unowned-CommandGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:CommandReceived]
			[CommandReceiveCode:WitM-DepotOwner-Gray]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Condition-Airfield-InGrayTerritory]
			[Actions:WW2-Action-Depot-Unowned-BecomeGray]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
