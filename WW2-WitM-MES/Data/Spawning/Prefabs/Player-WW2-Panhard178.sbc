                    <TypeId>MyModStorageComponent</TypeId>
                    <Component xsi:type="MyObjectBuilder_ModStorageComponent">
                      <Storage>
                        <dictionary>
                          <item>
                            <Key>74de02b3-27f9-4960-b1c4-27351f2b06d1</Key>
                            <Value>groupNameTag = Panhard - MART
elevationRotorNameTag = Elevation
azimuthRotorNameTag = Azimuth
azimuthSpeedModifier = 0.25
elevationSpeedModifier = -0.25
controlSeatRelativeMouseControl = True
fireWeaponsOnCrouch = True
stabilizeAzimuth = True
stabilizeElevation = True
returnToRestPosition = True
</Value>
                          </item>
                        </dictionary>
                      </Storage>
