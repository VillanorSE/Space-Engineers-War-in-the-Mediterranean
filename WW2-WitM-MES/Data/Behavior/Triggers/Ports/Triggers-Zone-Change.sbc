<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Territory Zone-Change Triggers - all 6 anchors
     Single resizing zone per anchor (WW2-Territory-Zone-{Anchor}, defined in Territory-Zones.sbc)
     driven by that anchor's own CustomSandboxCounter ({Anchor}_Points). Every tier transition at an
     anchor shares the SAME two actions (RadiusGrow/RadiusShrink).

     Per anchor: 6 Grow/Shrink trigger+condition pairs (one per tier boundary, each pair mutually exclusive via
     ToggleWithTriggerProfile so crossing a threshold is a one-shot +/-5000m radius change, not a
     repeat-every-10s runaway (RivalAI has no event-driven "counter crossed X" trigger type -
     confirmed via TriggerChecks.cs - so a polling Timer+Condition is the only mechanism
     available, and the toggle pair is what makes it one-shot rather than continuous).

     Cumulative thresholds (same for every anchor): 100 / 325 / 725 / 1350 / 2250 / 3475.
     Floor 0 (reset on underflow), Ceiling ~4170 (20% headroom above tier 7). -->

<!-- ==================== LA SPEZIA (Gray) ==================== -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-TriggerGroup-ZoneSize-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI TriggerGroup]

			[Triggers:WW2-Territory-Trigger-Grow1-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Shrink1-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Grow2-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Shrink2-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Grow3-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Shrink3-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Grow4-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Shrink4-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Grow5-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Shrink5-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Grow6-LaSpezia]
			[Triggers:WW2-Territory-Trigger-Shrink6-LaSpezia]
			[Triggers:WW2-Territory-Trigger-PointsFloor-LaSpezia]
			[Triggers:WW2-Territory-Trigger-PointsCeiling-LaSpezia]

			</Description>
		</EntityComponent>

<!-- Tier 1->2 @ 100 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-Grow1-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:WW2-Territory-Action-RadiusGrow-LaSpezia]
			[Conditions:WW2-Territory-Condition-Grow1-LaSpezia]
			[ConditionCheckResetsTimer:true]
			[ToggleWithTriggerProfile:WW2-Territory-Trigger-Shrink1-LaSpezia]
			[ToggledProfileResetsCooldown:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-Grow1-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:LaSpezia_Points]
			[CustomSandboxCountersTargets:100]
			[SandboxCounterCompareTypes:GreaterOrEqual]

			</Description>
		</EntityComponent>
