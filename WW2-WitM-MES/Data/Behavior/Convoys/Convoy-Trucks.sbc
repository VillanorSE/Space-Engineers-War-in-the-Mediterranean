<!-- Escort credit (lead truck): a tick every 30 s while a friendly player (rep >= 500) is within 1000 m, kept in the truck's own EscortTicks counter. 60 s after arrival every friendly player within 1500 m is paid each tier reached (cumulative); a recalled truck despawns first and pays nothing. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-EscortTick</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:1000]
			[MinPlayerReputation:500]
			[MinCooldownMs:30000]
			[MaxCooldownMs:30001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Convoy-Action-EscortTick]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Action-EscortTick</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[IncreaseCounters:EscortTicks]
