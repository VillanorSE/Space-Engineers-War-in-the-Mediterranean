<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Garage Spawns -->

<!-- Gray AB 41 Garage 1 (barn, one gate). Vehicle offset is an unverified estimate. -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Garage-Gray-AB41-1</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[PlanetaryInstallationType:Medium]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[FactionOverride:GRAY]
		[SpawnRandomCargo:true]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Garage1">
				<Position>
					<X>2.0</X>
					<Y>2.5</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-HangarGarage-Gray</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-AB41">
				<Position>
					<X>0</X>
					<Y>4.0</Y>
					<Z>12.5</Z>
				</Position>
				<Behaviour>WW2-Behavior-GarageVehicle-AB41</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

<!-- Gray AB 41 Garage 2 (concrete, two bays). Vehicle offset is an unverified estimate. -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Garage-Gray-AB41-2</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[PlanetaryInstallationType:Medium]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[FactionOverride:GRAY]
		[SpawnRandomCargo:true]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Garage2">
				<Position>
					<X>-2.0</X>
					<Y>2.5</Y>
					<Z>-12.5</Z>
				</Position>
				<Behaviour>WW2-Behavior-HangarGarage-Gray</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-AB41">
				<Position>
					<X>0</X>
					<Y>4</Y>
					<Z>0</Z>
				</Position>
				<Behaviour>WW2-Behavior-GarageVehicle-AB41</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<!-- Fiat 626 in the second bay: placeholder offset, tune in game -->
			<Prefab SubtypeId="Player-WW2-Fiat626">
				<Position>
					<X>8</X>
					<Y>4</Y>
					<Z>0</Z>
				</Position>
				<Behaviour>WW2-Behavior-GarageVehicle-Fiat626</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

<!-- End Garage Spawns -->

	</SpawnGroups>
</Definitions>
