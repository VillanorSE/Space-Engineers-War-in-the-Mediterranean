			[AutopilotData:WW2-Autopilot-CargoShip]
			[TargetData:WW2-Targeting-ShipMain]

			[WeaponSystem:WW2-Weapons-CargoShip]

			[CustomWaypoints:-3313.06:20680.14:21624.19,-3660.24:20482.92:21751.4,3562.77:8725.65:28586.94,3347.94:-1599.76:29871.67,9335.38:-20832.01:19618.71,9243.59:-23021.01:17047.34,7219.22:-27130.26:10854.68]

			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-CargoDamage]
			[Triggers:WW2-Trigger-FriendlyNear-Cargo]
			[Triggers:WW2-Trigger-HostileNear-Cargo]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-Ship-Gray]
			[Triggers:WW2-Territory-Trigger-CargoShip-RouteArrived]
			[Triggers:WW2-Territory-Trigger-CargoShip-UnloadTimer]

			</Description>
        </EntityComponent>
	<!-- End La Spezia <-> Tripoli -->

