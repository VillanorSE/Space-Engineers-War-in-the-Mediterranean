			[CustomWaypoints:16818.41:-23976.79:6939.93,17450.09:-23219.82:7887.05,21422.12:-6790.95:20020.47,6747.3:-3130.82:29163.38,2819.58:6347.49:29285.04,-23414.39:18515.49:-3859.76,-7142.42:25873.42:-13622.89]

			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-CargoDamage]
			[Triggers:WW2-Trigger-FriendlyNear-Cargo]
			[Triggers:WW2-Trigger-HostileNear-Cargo]
