<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<!-- Salvage economy loot pools, restructured to match GVK's own real CU/RU mechanism: a small
     set of generic, grid-size-tiered pools (Small/Medium/Large/Huge) rather than a bespoke pool
     per ship class. Each pool mixes Battle Wreckage (Ore) and, from Medium tier up, Salvaged
     Ordnance (Ingot) together with independent per-item Frequency rolls - confirmed against
     GVK-Derelicts' own GVK-ContainerTypes.sbc, where GVK_CUs appears starting at their Small
     tier and GVK_RUs only from Medium tier up, never at Small. Battle Wreckage still needs
     refining into Salvage Alloy (see Blueprints-Salvage.sbc) - that part of our design is
     unchanged from GVK, which loots CU/RU as already-finished ingots with no ore step at all. -->

	<ContainerTypes>

		<ContainerType CountMin="1" CountMax="1">
			<Id>
				<TypeId>ContainerTypeDefinition</TypeId>
				<SubtypeId>WW2-ContainerTypes-Loot-Small</SubtypeId>
			</Id>
			<Items>
				<Item AmountMin="3" AmountMax="8">
					<Frequency>0.5</Frequency>
					<Id>
						<TypeId>Ore</TypeId>
						<SubtypeId>BattleWreckage</SubtypeId>
					</Id>
				</Item>
			</Items>
		</ContainerType>

		<ContainerType CountMin="1" CountMax="1">
			<Id>
				<TypeId>ContainerTypeDefinition</TypeId>
				<SubtypeId>WW2-ContainerTypes-Loot-Medium</SubtypeId>
			</Id>
			<Items>
				<Item AmountMin="5" AmountMax="12">
					<Frequency>0.5</Frequency>
					<Id>
						<TypeId>Ore</TypeId>
						<SubtypeId>BattleWreckage</SubtypeId>
					</Id>
				</Item>
				<Item AmountMin="1" AmountMax="2">
					<Frequency>0.25</Frequency>
					<Id>
						<TypeId>Ingot</TypeId>
						<SubtypeId>SalvagedOrdnance</SubtypeId>
					</Id>
				</Item>
			</Items>
		</ContainerType>

		<ContainerType CountMin="1" CountMax="1">
			<Id>
				<TypeId>ContainerTypeDefinition</TypeId>
				<SubtypeId>WW2-ContainerTypes-Loot-Large</SubtypeId>
			</Id>
			<Items>
				<Item AmountMin="8" AmountMax="15">
					<Frequency>0.5</Frequency>
					<Id>
						<TypeId>Ore</TypeId>
						<SubtypeId>BattleWreckage</SubtypeId>
					</Id>
				</Item>
				<Item AmountMin="1" AmountMax="3">
					<Frequency>0.5</Frequency>
					<Id>
						<TypeId>Ingot</TypeId>
						<SubtypeId>SalvagedOrdnance</SubtypeId>
					</Id>
				</Item>
			</Items>
		</ContainerType>

		<ContainerType CountMin="1" CountMax="1">
			<Id>
				<TypeId>ContainerTypeDefinition</TypeId>
				<SubtypeId>WW2-ContainerTypes-Loot-Huge</SubtypeId>
			</Id>
			<Items>
				<Item AmountMin="10" AmountMax="20">
					<Frequency>0.5</Frequency>
					<Id>
						<TypeId>Ore</TypeId>
						<SubtypeId>BattleWreckage</SubtypeId>
					</Id>
				</Item>
				<Item AmountMin="2" AmountMax="4">
					<Frequency>0.75</Frequency>
					<Id>
						<TypeId>Ingot</TypeId>
						<SubtypeId>SalvagedOrdnance</SubtypeId>
					</Id>
				</Item>
			</Items>
		</ContainerType>

	</ContainerTypes>
</Definitions>
