<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

	<!-- Destroyer Behaviors -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Destroyer-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Behavior]
			[BehaviorName:Nautical]
			
			[AutopilotData:WW2-Autopilot-Destroyer-Gray]
			[SecondaryAutopilotData:WW2-Autopilot-Destroyer-GrayB]
			[TargetData:WW2-Targeting-ShipMain]
			
			[WeaponSystem:WW2-Weapons-Destroyer]
			
			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-AggressionSwitch-Destroyer]
			[Triggers:WW2-Trigger-PassiveSwitch-Destroyer]
			[Triggers:WW2-Trigger-PassiveSwitchNoTarget-Destroyer]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-MilitaryShip-Gray]
			
			[TriggerGroups:WW2-TriggerGroup-Broadside]
			
			</Description>
        </EntityComponent>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Destroyer-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Behavior]
			[BehaviorName:Nautical]
			
			[AutopilotData:WW2-Autopilot-Destroyer-Green]
			[SecondaryAutopilotData:WW2-Autopilot-Destroyer-GreenB]
			[TargetData:WW2-Targeting-ShipMain]
			
			[WeaponSystem:WW2-Weapons-Destroyer]
			
			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-AggressionSwitch-Destroyer]
			[Triggers:WW2-Trigger-PassiveSwitch-Destroyer]
			[Triggers:WW2-Trigger-PassiveSwitchNoTarget-Destroyer]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-ReputationDamageLight-Green]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-MilitaryShip-Green]
			
			[TriggerGroups:WW2-TriggerGroup-Broadside]
			
			</Description>
        </EntityComponent>
	<!-- End Destroyer Behaviors -->

	<!-- Destroyer Autopilots -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-Destroyer-Gray</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[DisableInertiaDampeners:false]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:0]
			[FlyLevelWithGravity:true]
			[AllowStrafing:false]
			[WaypointTolerance:50]
			[IdealMinSpeed:10]
			[IdealMaxSpeed:15]
			
			[RotationMultiplier:0.4]
			[AngleAllowedForForwardThrust:180]
			
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[WaypointWaitTimeTrigger:15]
			
			[EngageDistancePlanet:2000]
			[DisengageDistancePlanet:3000]
			
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-Destroyer-GrayB</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[DisableInertiaDampeners:false]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:0]
			[FlyLevelWithGravity:true]
			[AllowStrafing:false]
			[WaypointTolerance:50]
			[IdealMinSpeed:18]
			[IdealMaxSpeed:24.5]
			
			[RotationMultiplier:0.4]
			[AngleAllowedForForwardThrust:180]
			
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[WaypointWaitTimeTrigger:0]
			
			[EngageDistancePlanet:2000]
			[DisengageDistancePlanet:3000]
			
			</Description>
		</EntityComponent>
		
