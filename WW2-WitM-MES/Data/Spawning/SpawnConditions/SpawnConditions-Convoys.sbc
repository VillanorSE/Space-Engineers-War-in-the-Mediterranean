<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Supply convoy trucks, spawned only by the port convoy triggers (Triggers-Convoy-Port.sbc). Slots 3-5 gate on WarLevel >= 3/4/5, so level 1 (seeded) and 2 fail them, as intended. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-Convoy</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiSpawn:true]
			[SkipVoxelSpawnChecks:true]
			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-Convoy-WL3</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiSpawn:true]
			[SkipVoxelSpawnChecks:true]
			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:3]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-Convoy-WL4</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiSpawn:true]
			[SkipVoxelSpawnChecks:true]
			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:4]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-Convoy-WL5</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[RivalAiSpawn:true]
			[SkipVoxelSpawnChecks:true]
			[RotateFirstCockpitToForward:true]
			[DisableDampeners:false]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:5]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
