<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>
<!-- Supply convoy trucks: one group per route and slot (1 = lead). Prefabs NPC-WW2-Fiat626-Convoy / NPC-WW2-RenaultAHN-Convoy are the owner's cargo trucks (Remote Control, no survival kit, MES NPC atmospheric thrusters). The C# reads the route from the group name WW2-Convoy-{Port}-{Destination}-{slot}. -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Convoy-Civitavecchia-Foggia-1</SubtypeId>
		</Id>
		<Description>
		[Modular Encounters SpawnGroup]
		[SpawnConditionsProfiles:WW2-SpawnConditions-Convoy]
		[ReplenishSystems:true]
		[IgnoreCleanupRules:true]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-ConvoyTruck]
		[ManipulationProfiles:WW2-Manipulation-Loot-Medium-Cargo]
		[FactionOverride:GRAY]
		</Description>
		<Icon>Textures\GUI\Icons\Fake.dds</Icon>
		<Frequency>10.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Fiat626-Convoy">
				<Position>
					<X>0.0</X>
					<Y>2.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Convoy-Civitavecchia-Foggia-Lead</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>
