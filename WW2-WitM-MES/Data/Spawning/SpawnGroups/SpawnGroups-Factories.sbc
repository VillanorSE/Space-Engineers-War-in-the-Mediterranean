<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Plane Factory Spawns -->

	<!-- Gray Re. 2000 Factory -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Factory-Gray-Re2000</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations-Medium]
		[PersistentConditions:WW2-SpawnConditions-Territory-Gray]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-FactoryBuildState-66pct]
		[ManipulationProfiles:WW2-Manipulation-FactoryBuildState-33pct]

		[FactionOverride:GRAY]
		[SpawnRandomCargo:true]

		[UseContainerTypeAssignment:true]
		[ContainerTypeAssignBlockName:Small Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-SmallCargo]

		[ContainerTypeAssignBlockName:Medium Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-MediumCargo]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Factory-Plane-Gray">
				<Position>
					<X>0.0</X>
					<Y>-24.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Factory-Plane-Re2000</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-Re2000">
				<Position>
					<X>6.5</X>
					<Y>3.5</Y>
					<Z>10.0</Z>
				</Position>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-Re2000">
				<Position>
					<X>6.5</X>
					<Y>3.5</Y>
					<Z>30.0</Z>
				</Position>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-Re2000">
				<Position>
					<X>6.5</X>
					<Y>3.5</Y>
					<Z>50.0</Z>
				</Position>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

