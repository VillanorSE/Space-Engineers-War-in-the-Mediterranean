<!-- Shared Grow/Shrink actions + chats -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusGrow-Rome</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:Rome_Zone]
			[ZoneRadiusChangeType:Add]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Grow-Rome]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusShrink-Rome</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:Rome_Zone]
			[ZoneRadiusChangeType:Subtract]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Shrink-Rome]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Grow-Rome</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Rome Command]
			[Color:Blue]
			[ChatMessages:Rome territory has expanded.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Shrink-Rome</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Rome Command]
			[Color:Blue]
			[ChatMessages:Rome territory has contracted.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>

