<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

	<!-- Torpedo Boat: the behavior was merged into Destroyer/Corvette (Spica -> WW2-Behavior-Destroyer-Gray, Gabbiano -> WW2-Behavior-Corvette-Gray). The autopilot/weapons profiles below are currently unreferenced. -->

	

	<!-- Torpedo Boat Autopilots -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-TorpedoBoat</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[DisableInertiaDampeners:false]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:0]
			[FlyLevelWithGravity:true]
			[AllowStrafing:false]
			[WaypointTolerance:50]
			[IdealMinSpeed:10]
			[IdealMaxSpeed:15]
			
			[RotationMultiplier:0.4]
			[AngleAllowedForForwardThrust:180]
			
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[WaypointWaitTimeTrigger:15]
			
			[EngageDistancePlanet:500]
			[DisengageDistancePlanet:1000]
			
			</Description>
		</EntityComponent>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-TorpedoBoat-B</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[DisableInertiaDampeners:false]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:0]
			[FlyLevelWithGravity:true]
			[AllowStrafing:false]
			[WaypointTolerance:50]
			[IdealMinSpeed:20]
			[IdealMaxSpeed:27.5]
			
			[RotationMultiplier:0.4]
			[AngleAllowedForForwardThrust:180]
			
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[WaypointWaitTimeTrigger:0]
			
			[EngageDistancePlanet:500]
			[DisengageDistancePlanet:1000]
			
			</Description>
		</EntityComponent>
	<!-- End Torpedo Boat Autopilots -->

	<!-- Weapon Profile, TorpedoBoat -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Weapons-TorpedoBoat</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Weapons]
			
			[UseTurrets:true]
			
			[WeaponMaxAngleFromTarget:6]
			[WeaponMaxBaseDistanceTarget:100]
			
			[UseBarrageFire:true]
			[MaxFireRateForBarrageWeapons:3]
			
			[UseAmmoReplenish:true]
            
			</Description>
		</EntityComponent>
<!-- End Weapon Profile -->

	</EntityComponents>
</Definitions>