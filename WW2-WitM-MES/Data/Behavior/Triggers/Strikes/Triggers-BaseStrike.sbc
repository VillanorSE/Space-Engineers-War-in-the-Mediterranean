			[CheckTrueBooleans:true]
			[TrueBooleans:WW2-BaseStrike-Cooldown-Gray]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Event-BaseStrike-CooldownStart-Gray</SubtypeId>
			</Id>
			<Description>
			[MES Event]
			[UseEvent:false]
			[UniqueEvent:false]
			[Tags:WW2-BaseStrike-CooldownStart-Gray]
			[ActionIds:WW2-EventAction-BaseStrike-CooldownStart-Gray]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-EventAction-BaseStrike-CooldownStart-Gray</SubtypeId>
			</Id>
			<Description>
			[MES Event Action]
			[ResetCooldownTimeOfEvents:true]
			[ResetEventCooldownIds:WW2-Event-BaseStrike-CooldownEnd-Gray]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-EventAction-BaseStrike-CooldownEnd-Gray</SubtypeId>
			</Id>
			<Description>
			[MES Event Action]
			[ChangeBooleans:true]
			[SetBooleansFalse:WW2-BaseStrike-Cooldown-Gray]
			</Description>
		</EntityComponent>

