<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<!-- Routes the 4 Blueprints in Blueprints-Salvage.sbc into vanilla's own "CommonMetals"
     (Refinery) and "Components" (Assembler) BlueprintClasses, so they show up on any Refinery/
     Assembler players already have - no custom production block needed.
     This is a plain SBC file, NOT a Mod Adjuster patch: Mod Adjuster's BlueprintClassEntries
     patch clears a class's entire existing entry list on first write (would wipe every vanilla
     recipe in that class). A normal SBC <Entry> list merges additively across mods instead,
     matching how vanilla's own BlueprintClasses.sbc structures this same list.
     <Entry> takes Class/BlueprintSubtypeId as XML ATTRIBUTES, not nested child elements - using
     nested elements leaves both fields null and crashes the whole mod's definition loading
     (NullReferenceException in BlueprintClassEntry.GetHashCode()). -->

	<BlueprintClassEntries>
		<Entry Class="CommonMetals" BlueprintSubtypeId="WW2-Blueprint-BattleWreckageToSalvageAlloy" />
		<Entry Class="Components" BlueprintSubtypeId="WW2-Blueprint-IndustrialComponents" />
		<Entry Class="Components" BlueprintSubtypeId="WW2-Blueprint-MilitaryComponents" />
		<Entry Class="Components" BlueprintSubtypeId="WW2-Blueprint-AdvancedMilitaryComponents" />
	</BlueprintClassEntries>
</Definitions>
