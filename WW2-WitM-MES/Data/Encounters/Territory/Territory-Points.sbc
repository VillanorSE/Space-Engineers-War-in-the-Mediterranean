<!-- ==================== CARGO SHIP DELIVERIES ====================
     Fixed-route ships (Paths-Nautical.sbc): on reaching the final waypoint (BehaviorTriggerD, the same event that starts
     the unload wait) BOTH endpoint anchors of the route get +100, one-sided (no loss to the rival), and the ship is
     marked Retired so being sunk while unloading is not scored as a kill. Civitavecchia scores for the Rome anchor. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-Delivery-Gray-LaSpezia-Tripoli</SubtypeId>
			</Id>
			<Description>

