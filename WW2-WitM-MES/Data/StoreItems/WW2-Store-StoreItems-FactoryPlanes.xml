<?xml version="1.0" encoding="utf-8"?>
<StoreItemsContainer xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<!-- One StoreItem per Factory-roster plane, ItemType=Prefab (this is what makes a grid, not a
     component, sellable at an NPC store). ItemSubtypeId references the CLEAN 100%-built
     Player-tier blueprint, not the _66pct/_33pct display copies - selling an unfinished plane
     doesn't make sense. MinAmount/MaxAmount are both 1 (a factory has exactly one of its own
     plane for sale, not a restockable batch).
     Prices are a real raw-material component-cost calculation (sum of each block's build BOM,
     converted to ingot-kg via vanilla Blueprints.sbc, priced at this project's own Port ingot
     rates), rounded up to the nearest 5,000 (nearest 25,000 at/above 100k) so every price sits
     above its computed material cost. -->
	<StoreItems>
		<StoreItem>
			<StoreItemId>WW2-Re2000</StoreItemId>
			<ItemType>Prefab</ItemType>
			<ItemSubtypeId>Player-WW2-Re2000</ItemSubtypeId>
			<Offer>
				<CustomPrice>30000</CustomPrice>
				<MinPriceMultiplier>100</MinPriceMultiplier>
				<MaxPriceMultiplier>100</MaxPriceMultiplier>
				<MinAmount>1</MinAmount>
				<MaxAmount>1</MaxAmount>
			</Offer>
		</StoreItem>
