<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>
<!-- Trigger to switch back to patrol when the target is far. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-PatrolSwitch-Fighter</SubtypeId>
            </Id>
            <Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:TargetFar]
			[TargetDistance:15000]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-PatrolSwitch-Fighter]
			</Description>
        </EntityComponent>
	<!-- Switches to the Patrol subclass and the patrol autopilot. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-PatrolSwitch-Fighter</SubtypeId>
            </Id>
            <Description>
			[RivalAI Action]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-PatrolSwitch-Fighter]
			[UseCurrentPositionAsPatrolReference:true]
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Patrol]
			[ChangeAutopilotProfile:true]
			[AutopilotProfile:Primary]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-PatrolSwitch-Fighter]
			[DisableTriggerNames:WW2-Trigger-FighterRunStart]
			[DisableTriggerNames:WW2-Trigger-FighterRunEnd]
			[DisableTriggerNames:WW2-Trigger-FighterTargetLost]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-FighterSwitch-Fighter]
			</Description>
        </EntityComponent>
	<!-- Trigger to switch back to patrol when the target is lost. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-FighterTargetLost</SubtypeId>
            </Id>
            <Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:LostTarget]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-PatrolSwitch-Fighter]
			</Description>
        </EntityComponent>
	<!-- Broadcasts chats about patrolling -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-PatrolSwitch-Fighter</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:Fighter]
			[Color:Red]
			[ChatMessages: Returning to patrol pattern.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			[ChatMessages:Target lost, beginning patrol.]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
	<!-- Trigger that measures the next patrol waypoint from the plane's current position. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-PatrolNextFromLast</SubtypeId>
            </Id>
            <Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:BehaviorTriggerA]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Action-PatrolNextFromLast]
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-PatrolNextFromLast</SubtypeId>
            </Id>
            <Description>
			[RivalAI Action]
			[UseCurrentPositionAsPatrolReference:true]
			</Description>
        </EntityComponent>
<!-- End Trigger to switch to patrol -->
	</EntityComponents>
</Definitions>
