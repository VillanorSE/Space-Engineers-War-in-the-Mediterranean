<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Spawn Conditions for basic installations -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Installations</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[PlanetaryInstallation:true]
			[RivalAiPlanetaryInstallation:true]

			[InstallationSpawnsOnDryLand:true]

			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]

			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:2.7]

		</Description>
	</EntityComponent>

	<!-- Shallow-water wrecks (Golo hulks, etc.): spawns in/against water instead of dry land.
	     MinWaterDepth is confirmed real (enforced in MES's PathPlacements.cs, not the dead/commented
	     coarse gate in SpawnConditions.cs). There is still no MaxWaterDepth anywhere in MES (a PR
	     adding one was in progress with MeridiusIX/Enenra as of 2026-09-14) - the placeholder line
	     below is intentionally plain text, NOT a real [MaxWaterDepth:7.5] tag and NOT wrapped in an
	     XML comment (an XML comment nested inside Description breaks SE's XmlSerializer entirely -
	     confirmed from the actual SpaceEngineers.log). Restore it as a real tag once that MES update
	     ships. MinWaterCoverage/MaxWaterCoverage bias toward close-to-shore water (measured via
	     /MES.Info.GetDiagnostics: harbor mouth 0.438, good open coast up to 0.59, open ocean 1.0).
	     7.5m covers the Utility/Corvette/Destroyer-tier wrecks; a future Cruiser+ wreck should get
	     its own profile with [MaxWaterDepth:12] once that tag is live. -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Wreck-ShallowWater</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[PlanetaryInstallation:true]
			[RivalAiPlanetaryInstallation:true]

			[InstallationSpawnsOnDryLand:false]
			[InstallationSpawnsUnderwater:true]
			[MinWaterDepth:1]
			PLACEHOLDER MaxWaterDepth:7.5 disabled - not live in MES yet, see comment above; restore as a real [MaxWaterDepth:7.5] tag once Enenra's update ships
			[MinWaterCoverage:0.15]
			[MaxWaterCoverage:0.42]
			[AlignToSurface:true]

			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]

			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:2.7]

		</Description>
	</EntityComponent>

<!-- Secondary installations (airfields, vehicle depots, garrisons). Unlike the 6 primary Port
     anchors, these spawn UNOWNED and their FactionOverride/ownership/flag color is reassigned at
     runtime by the installation's own Behavior once territory ownership claims it (see
     Behaviors-Airfield.sbc). 20km TriggerRadius. -->

	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Airfield-Gibraltar</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[StaticEncounter:true]
			[StaticEncounterUsePlanetDirectionAndAltitude:true]
			[StaticEncounterPlanet:WW2WitM_Mediterranean]
			[StaticEncounterPlanetDirection:{X:0.405268480561213 Y:0.29884657438491 Z:-0.863972328053399}]
			[StaticEncounterPlanetAltitude:2.38300709220857]
			[StaticEncounterForward:{X:0.00652439688258167 Y:-0.946255479313512 Z:-0.323354295030196}]
			[StaticEncounterUp:{X:-0.405303655162405 Y:-0.298112118204742 Z:0.864209530201719}]
			[ForceExactPositionAndOrientation:true]
			[PlanetWhitelist:WW2WitM_Mediterranean]

			[FactionOwner:UNOWNED]

			[TriggerRadius:20000]

			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]

		</Description>
	</EntityComponent>

