<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <PlanetGeneratorDefinitions>
    <PlanetGeneratorDefinition>
      <Id>
        <TypeId>PlanetGeneratorDefinition</TypeId>
        <SubtypeId>WW2WitM_Mediterranean</SubtypeId>
      </Id>

      <DisplayName>Mediterranean</DisplayName>

      <!-- Matches Data/PlanetDataFiles/WW2Mediterranean/ where the 6 heightmap
           faces (front/back/left/right/up/down) currently live. -->
      <FolderName>WW2Mediterranean</FolderName>

      <!-- Material = red channel (hemisphere/region split), Biome = green
           channel (environment item placement, see EnvironmentItems below
           for the full Biome=1/2/3/4 legend), Ores = blue channel. -->
      <PlanetMaps Material="true" Biome="true" Ores="true" />

      <!-- MesherPostprocessing: LOD-based mesh decimation tuning (how
           aggressively the voxel mesher simplifies terrain geometry at
           each LOD level) - FeatureAngle/EdgeThreshold/PlaneThreshold
           tightening from LOD0->2 means less simplification (more
           geometric detail kept) at closer LODs.
           SurfaceDetail: blends a detail-normal texture
           (Data/PlanetDataFiles/Extra/material_detail_1, a real base-game
           asset referenced by path, not bundled) onto slopes 20-90
           degrees, adding fine rock/surface texture without adding new
           geometry.
           DistortionTable: a Perlin noise distortion applied directly to
           the voxel mesh surface at generation time (separate from the
           heightmap itself), adding small-scale surface roughness the
           heightmap's own resolution can't represent. -->
      <MesherPostprocessing xsi:type="MyObjectBuilder_VoxelMesherComponentDefinition">
        <PostprocessingSteps>
          <Step xsi:type="MyObjectBuilder_VoxelPostprocessingDecimate" ForPhysics="true">
            <LodSettings>
              <Settings FromLod="0">
                <FeatureAngle>15</FeatureAngle>
                <EdgeThreshold>.04</EdgeThreshold>
                <PlaneThreshold>.02</PlaneThreshold>
              </Settings>
              <Settings FromLod="1">
                <FeatureAngle>15</FeatureAngle>
                <EdgeThreshold>.04</EdgeThreshold>
                <PlaneThreshold>.04</PlaneThreshold>
              </Settings>
              <Settings FromLod="2">
                <FeatureAngle>15</FeatureAngle>
                <EdgeThreshold>.06</EdgeThreshold>
                <PlaneThreshold>.06</PlaneThreshold>
              </Settings>
            </LodSettings>
          </Step>
        </PostprocessingSteps>
      </MesherPostprocessing>

      <SurfaceDetail>
        <Texture>Data/PlanetDataFiles/Extra/material_detail_1</Texture>
        <Size>384</Size>
        <Scale>5</Scale>
        <Slope Min="20" Max="90" />
        <Transition>7.5</Transition>
      </SurfaceDetail>

      <DistortionTable>
        <Distortion Type="Perlin" Value="92" Frequency="10" Height="4" LayerCount="6"/>
      </DistortionTable>

      <!-- Cube-face geometry mapping (must stay consistent for any future
           texture that must align with the heightmap: ore maps, future
           material/biome maps, anything else):
           Side faces (front/right/back/left): standard gnomonic projection
           with the Y component negated relative to the naive formula.
           front=lon 0, right=lon 90, back=lon 180 (~Italy), left=lon 270,
           going eastward with increasing longitude.
           Pole faces: the north-pole-computed data (+Z, geometrically)
           goes into down.png, and the south-pole-computed data (-Z) goes
           into up.png (north/south are SWAPPED relative to the naive
           assignment), and BOTH poles additionally get a left-right mirror
           flip (np.fliplr) on top of that swap. -->
      <OreMappings>
        <!-- Value matches the blue channel of *_mat.png. Ore proportions
             are based on real EarthLike ore-coverage citations (see the
             reference doc), weighted toward the coast and away from the
             exact poles, plus extra enrichment near the road network's POI
             locations except the confirmed territory hubs (excluded so
             they don't incentivize building near the permanent NPC bases
             there). Percentile-based thresholding keeps each ore's total
             land-coverage percentage exactly at target regardless of the
             spatial weighting; the weighting only reorders where within
             that budget the ore lands. -->
        <Ore Value="50"  Type="Silicon_01"   Start="4"  Depth="7" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="90"  Type="Magnesium_01" Start="6"  Depth="6" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="130" Type="Iron_02"      Start="3"  Depth="8" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="160" Type="Cobalt_01"    Start="8"  Depth="6" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="190" Type="Nickel_01"    Start="5"  Depth="8" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="210" Type="Gold_01"      Start="12" Depth="4" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="225" Type="Silver_01"    Start="10" Depth="5" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="240" Type="Platinum_01"  Start="15" Depth="4" TargetColor="#616c83" ColorInfluence="15"/>
        <Ore Value="250" Type="Uraninite_01" Start="18" Depth="3" TargetColor="#616c83" ColorInfluence="15"/>
      </OreMappings>

      <!-- Real elevation range -835.75m to +508.38m, planet radius 30,000m.
           SE's water is a fixed-radius sphere from planet center, not a
           mesh that follows terrain, so any inland area below 0m floods
           regardless of connectivity to the ocean; disconnected
           below-sea-level pockets are infilled from surrounding real
           terrain rather than left as holes. Natural coastlines are
           deliberately NOT floored to a minimum height above sea level;
           gentle real slopes through Water Mod's wave range are accepted
           as more natural-looking than a hard clamp/shelf. -->
      <!-- Weather generators are keyed by VoxelMaterial SubtypeId. Most
           reference real vanilla WeatherEffectDefinition SubtypeIds
           directly (FogLight/RainLight/RainHeavy/Hailstorm/SnowLight/
           SnowHeavy/Dust/SandStormLight/SandStormHeavy - all zero-damage
           already, no local copy needed). The three vanilla types that DO
           carry Lightning Damage="80" (FogHeavy, ThunderstormLight,
           ThunderstormHeavy) are instead referenced as our own
           WWM_-prefixed zero-damage copies from
           WW2-WitM-Planet/Data/WeatherEffects.sbc. -->
      <WeatherFrequencyMin>600</WeatherFrequencyMin>
      <WeatherFrequencyMax>5400</WeatherFrequencyMax>
      <WeatherGenerators>
        <!-- Temperate lowland (coastal + inland N) -->
        <WeatherGenerator>
          <Voxel>OrcusGrass</Voxel>
          <Weathers>
            <Weather><Name>FogLight</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>WWM_FogHeavy</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>RainLight</Name><Weight>3</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>RainHeavy</Name><Weight>2</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>WWM_ThunderstormLight</Name><Weight>2</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>WWM_ThunderstormHeavy</Name><Weight>1</Weight><MinLength>600</MinLength><MaxLength>1800</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
          </Weathers>
        </WeatherGenerator>

        <!-- Temperate highland (Rocks_grass, used across the highland/peak
             bands of the temperate MaterialGroups) - same mix, lighter -->
        <WeatherGenerator>
          <Voxel>Rocks_grass</Voxel>
          <Weathers>
            <Weather><Name>FogLight</Name><Weight>2</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>WWM_FogHeavy</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>RainLight</Name><Weight>2</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
            <Weather><Name>WWM_ThunderstormLight</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength><SpawnOffset>2000</SpawnOffset></Weather>
          </Weathers>
        </WeatherGenerator>

        <!-- Arid lowland (coastal + inland S), mirrors Planet 26's Egypt generator -->
        <WeatherGenerator>
          <Voxel>CrackedSoil</Voxel>
          <Weathers>
            <Weather><Name>FogLight</Name><Weight>3</Weight><MinLength>300</MinLength><MaxLength>600</MaxLength></Weather>
            <Weather><Name>RainLight</Name><Weight>4</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength></Weather>
            <Weather><Name>WWM_FogHeavy</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength></Weather>
            <Weather><Name>SandStormLight</Name><Weight>3</Weight><MinLength>300</MinLength><MaxLength>1800</MaxLength></Weather>
            <Weather><Name>SandStormHeavy</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>3600</MaxLength></Weather>
            <Weather><Name>Dust</Name><Weight>5</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength></Weather>
          </Weathers>
        </WeatherGenerator>

        <!-- Arid highland/scrub (DustyRocks), mirrors Planet 26's Sand generator -->
        <WeatherGenerator>
          <Voxel>DustyRocks</Voxel>
          <Weathers>
            <Weather><Name>SandStormLight</Name><Weight>4</Weight><MinLength>300</MinLength><MaxLength>1800</MaxLength></Weather>
            <Weather><Name>SandStormHeavy</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>3600</MaxLength></Weather>
            <Weather><Name>Dust</Name><Weight>2</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength></Weather>
          </Weathers>
        </WeatherGenerator>

        <!-- Semi-arid transition lowland (OrcusGrass2) - blend of temperate/arid -->
        <WeatherGenerator>
          <Voxel>OrcusGrass2</Voxel>
          <Weathers>
            <Weather><Name>FogLight</Name><Weight>2</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength></Weather>
            <Weather><Name>RainLight</Name><Weight>3</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength></Weather>
            <Weather><Name>Dust</Name><Weight>2</Weight><MinLength>300</MinLength><MaxLength>1200</MaxLength></Weather>
            <Weather><Name>SandStormLight</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>1800</MaxLength></Weather>
          </Weathers>
        </WeatherGenerator>

        <!-- Alpine peak band (Snow), mirrors Planet 26's Iceland/Snow generator -->
        <WeatherGenerator>
          <Voxel>Snow</Voxel>
          <Weathers>
            <Weather><Name>SnowLight</Name><Weight>5</Weight><MinLength>600</MinLength><MaxLength>1800</MaxLength></Weather>
            <Weather><Name>SnowHeavy</Name><Weight>2</Weight><MinLength>600</MinLength><MaxLength>2400</MaxLength></Weather>
            <Weather><Name>FogLight</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength></Weather>
            <Weather><Name>WWM_FogHeavy</Name><Weight>1</Weight><MinLength>300</MinLength><MaxLength>900</MaxLength></Weather>
          </Weathers>
        </WeatherGenerator>
      </WeatherGenerators>

      <HillParams Min="-0.027858" Max="0.020196" />

      <!-- Height-graduated surface materials for basic visual orientation.
           All material SubtypeIds below are copied verbatim from the real
           vanilla PlanetGeneratorDefinitions.sbc (Pertam/EarthLike blocks).
           Height values are normalized 0-1 against this planet's own
           HillParams range; sea level (real elevation 0m) sits at
           normalized height ~0.622 given the Min/Max above. Latitude-based
           rules are deliberately avoided: our wrap design puts land in the
           two outer thirds near both poles and water in the middle third,
           so SE's Latitude filter doesn't correspond to "Europe vs Africa"
           the way it would on a conventional planet; Height and Slope are
           what's actually meaningful here. -->
      <!-- Water level sits at normalized height ~0.622 (see above); the
           ice/sand boundary is set explicitly at water_level - 5m so ice
           stays submerged through normal wave fluctuation, while the other
           thresholds (sand/beach, beach/grass, grass/highland,
           highland/peak) are shifted proportionally from the same
           water-level anchor. If /wradius is tuned again (see
           WaterConfig.xml at this mod's top level, not nested in Data/),
           these thresholds need recalculating the same way. -->
      <ComplexMaterials>
        <MaterialGroup Name="MediterraneanDefault" Value="0">
          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.0" Max="0.5755"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Shallow coastal shelf: natural sandy seafloor near shore -->
          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.5755" Max="0.5790"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Beach / immediate coastline (real elevation ~0-24m), gentle
               slope only - the steep case (cliff into the water) is
               split off below. -->
          <Rule>
            <Layers>
              <Layer Material="PertamSand" Depth="15"/>
            </Layers>
            <Height Min="0.5790" Max="0.5960"/>
            <Slope Min="0" Max="20"/>
          </Rule>

          <!-- Beach-height but steep (cliff straight into the water). Limestone
               (see VoxelMaterials_ME.sbc) instead of Rocks_grass: real
               Mediterranean shoreline cliffs read as karst, not grass-blended
               rock. -->
          <Rule>
            <Layers>
              <Layer Material="Limestone" Depth="5"/>
            </Layers>
            <Height Min="0.5790" Max="0.5960"/>
            <Slope Min="20" Max="90"/>
          </Rule>

          <!-- Coastal plains / lowland, gentle slope (real ~24-172m) -->
          <Rule>
            <Layers>
              <Layer Material="OrcusGrass" Depth="10"/>
            </Layers>
            <Height Min="0.5960" Max="0.6331"/>
            <Slope Min="0" Max="25"/>
          </Rule>

          <!-- Coastal plains but steep (cliffs, gullies) -->
          <Rule>
            <Layers>
              <Layer Material="Rocks_grass" Depth="5"/>
            </Layers>
            <Height Min="0.5960" Max="0.6331"/>
            <Slope Min="25" Max="90"/>
          </Rule>

          <!-- Highland starts at real ~150m (13.4% of land, height 0.6331);
               Peaks at real ~250m (2.4% of land, height 0.6972). Thresholds
               are calibrated against real elevation percentiles so a
               meaningful fraction of tall terrain actually reaches bare
               rock, rather than staying grass-blended. Applied identically
               across all four land MaterialGroups
               (Default/South/PlainsNorth/PlainsSouth). -->
          <Rule>
            <Layers>
              <Layer Material="Rocks_grass" Depth="5"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="0" Max="30"/>
          </Rule>

          <!-- Highland, steep -->
          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="30"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="30" Max="90"/>
          </Rule>

          <!-- Peaks (real >250m - see Highland comment above) -->
          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.6972" Max="0.85"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Alpine: thin Snow layer over the same Stone base, tallest
               ~15% of the height range only - snow-capped mountain tips,
               not a full snow biome. -->
          <Rule>
            <Layers>
              <Layer Material="Snow" Depth="3"/>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.85" Max="1.0"/>
            <Slope Min="0" Max="90"/>
          </Rule>

        </MaterialGroup>

        <!-- South (Africa-side) palette: land in our design's southern
             outer third originated from the real North African/Saharan
             portion of the source data (see the strip-space hemisphere
             split noted below). Water/beach rules are identical to the
             north group (visually the same Mediterranean either side);
             only the dry-land materials change to arid equivalents, using
             real vanilla names ("DesertRocks" is copied from vanilla's own
             actual "Desert" MaterialGroup pattern). -->
        <MaterialGroup Name="MediterraneanSouth" Value="1">

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.0" Max="0.5755"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.5755" Max="0.5790"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Beach, same as north; gentle slope only -->
          <Rule>
            <Layers>
              <Layer Material="PertamSand" Depth="15"/>
            </Layers>
            <Height Min="0.5790" Max="0.5960"/>
            <Slope Min="0" Max="20"/>
          </Rule>

          <!-- Beach-height but steep, arid. Limestone (see VoxelMaterials_ME.sbc)
               instead of DesertRocks: same karst-cliff reasoning as the north
               group's beach-steep rule. -->
          <Rule>
            <Layers>
              <Layer Material="Limestone" Depth="5"/>
            </Layers>
            <Height Min="0.5790" Max="0.5960"/>
            <Slope Min="20" Max="90"/>
          </Rule>

          <!-- Coastal plains, arid: CrackedSoil instead of Grass -->
          <Rule>
            <Layers>
              <Layer Material="CrackedSoil" Depth="10"/>
            </Layers>
            <Height Min="0.5960" Max="0.6331"/>
            <Slope Min="0" Max="25"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="DesertRocks" Depth="5"/>
            </Layers>
            <Height Min="0.5960" Max="0.6331"/>
            <Slope Min="25" Max="90"/>
          </Rule>

          <!-- Highland, arid: DustyRocks instead of Rocks_grass -->
          <Rule>
            <Layers>
              <Layer Material="DustyRocks" Depth="5"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="0" Max="30"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="30"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="30" Max="90"/>
          </Rule>

          <!-- Peaks, same as north -->
          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.6972" Max="0.85"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Alpine: thin Snow layer over the same Stone base, tallest
               ~15% of the height range only - snow-capped mountain tips,
               not a full snow biome. -->
          <Rule>
            <Layers>
              <Layer Material="Snow" Depth="3"/>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.85" Max="1.0"/>
            <Slope Min="0" Max="90"/>
          </Rule>

        </MaterialGroup>

        <!-- POI landing pads are purely a terrain-grading effect (see
             flatten_zone()) with no separate material tag; they keep their
             normal hemisphere grass/desert material, same as surrounding
             terrain. Value=2 is deliberately left unused (a retired
             FlattenPad material group). -->

        <!-- Road material: the terrain GRADING corridor (carve_road's
             ROAD_WIDTH_M) is wider than the visible material STRIPE, which
             follows the actual routed centerline at 1 strip pixel. Value=3
             takes priority over Value=2 where a road overlaps a landing
             pad (drawn last in the strip data), so the road stays visible
             through pad centers. -->
        <MaterialGroup Name="Road" Value="3">
          <Rule>
            <Layers>
              <Layer Material="Soil" Depth="10"/>
            </Layers>
            <Height Min="0.0" Max="1.0"/>
            <Slope Min="0" Max="90"/>
          </Rule>
        </MaterialGroup>

        <!-- Coastal vs. Plains split: MediterraneanDefault (0) and
             MediterraneanSouth (1) mean "coastal" (land within a set
             distance of the nearest coastline); these two groups (4, 5)
             are their inland "Plains" counterparts, painted via real
             distance-to-coastline rather than height/slope alone (height
             can't distinguish immediate beach from any other low, flat
             inland area). Road (Value=3) pixels are untouched by the
             split. Only the dry-land bands differ from the Coastal
             groups: no separate beach step, AquaticSand straight to
             grass/soil. Peaks/highland bands are identical to the Coastal
             groups. -->
        <MaterialGroup Name="MediterraneanPlainsNorth" Value="4">

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.0" Max="0.5755"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.5755" Max="0.5790"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- No beach step: straight to grass from the water's edge -->
          <Rule>
            <Layers>
              <Layer Material="OrcusGrass" Depth="10"/>
            </Layers>
            <Height Min="0.5790" Max="0.6331"/>
            <Slope Min="0" Max="25"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Rocks_grass" Depth="5"/>
            </Layers>
            <Height Min="0.5790" Max="0.6331"/>
            <Slope Min="25" Max="90"/>
          </Rule>

          <!-- Highland/peaks, identical to MediterraneanDefault -->
          <Rule>
            <Layers>
              <Layer Material="Rocks_grass" Depth="5"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="0" Max="30"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="30"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="30" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.6972" Max="0.85"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Alpine: thin Snow layer over the same Stone base, tallest
               ~15% of the height range only - snow-capped mountain tips,
               not a full snow biome. -->
          <Rule>
            <Layers>
              <Layer Material="Snow" Depth="3"/>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.85" Max="1.0"/>
            <Slope Min="0" Max="90"/>
          </Rule>

        </MaterialGroup>

        <MaterialGroup Name="MediterraneanPlainsSouth" Value="5">

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.0" Max="0.5755"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.5755" Max="0.5790"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- No beach step: straight to CrackedSoil from the water's edge -->
          <Rule>
            <Layers>
              <Layer Material="CrackedSoil" Depth="10"/>
            </Layers>
            <Height Min="0.5790" Max="0.6331"/>
            <Slope Min="0" Max="25"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="DesertRocks" Depth="5"/>
            </Layers>
            <Height Min="0.5790" Max="0.6331"/>
            <Slope Min="25" Max="90"/>
          </Rule>

          <!-- Highland/peaks, identical to MediterraneanSouth -->
          <Rule>
            <Layers>
              <Layer Material="DustyRocks" Depth="5"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="0" Max="30"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="30"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="30" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.6972" Max="0.85"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Alpine: thin Snow layer over the same Stone base, tallest
               ~15% of the height range only - snow-capped mountain tips,
               not a full snow biome. -->
          <Rule>
            <Layers>
              <Layer Material="Snow" Depth="3"/>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.85" Max="1.0"/>
            <Slope Min="0" Max="90"/>
          </Rule>

        </MaterialGroup>

        <!-- Transition groups: identical to MediterraneanSouth/
             MediterraneanPlainsSouth except the lowland band uses
             OrcusGrass2 (a muted, dry/patchy grass texture - genuinely
             between vibrant green and desert) instead of CrackedSoil, for
             real-climate regions where the full vibrant North palette
             would read too intense next to the arid South. Painted by real
             elevation (which lowland areas actually exist), not a fixed
             coastal distance, so the shape follows real terrain rather
             than reading as a painted stripe - same philosophy as the
             Plains/Coastal split above. Beach, highland, and peaks bands
             are untouched, so the transition stays visibly semi-arid away
             from the immediate lowland. -->
        <MaterialGroup Name="MediterraneanTransition" Value="6">

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.0" Max="0.5755"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.5755" Max="0.5790"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="PertamSand" Depth="15"/>
            </Layers>
            <Height Min="0.5790" Max="0.5960"/>
            <Slope Min="0" Max="20"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Limestone" Depth="5"/>
            </Layers>
            <Height Min="0.5790" Max="0.5960"/>
            <Slope Min="20" Max="90"/>
          </Rule>

          <!-- The actual change: OrcusGrass2 instead of CrackedSoil -->
          <Rule>
            <Layers>
              <Layer Material="OrcusGrass2" Depth="10"/>
            </Layers>
            <Height Min="0.5960" Max="0.6331"/>
            <Slope Min="0" Max="25"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="DesertRocks" Depth="5"/>
            </Layers>
            <Height Min="0.5960" Max="0.6331"/>
            <Slope Min="25" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="DustyRocks" Depth="5"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="0" Max="30"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="30"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="30" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.6972" Max="0.85"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Alpine: thin Snow layer over the same Stone base, tallest
               ~15% of the height range only - snow-capped mountain tips,
               not a full snow biome. -->
          <Rule>
            <Layers>
              <Layer Material="Snow" Depth="3"/>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.85" Max="1.0"/>
            <Slope Min="0" Max="90"/>
          </Rule>

        </MaterialGroup>

        <MaterialGroup Name="MediterraneanPlainsTransition" Value="7">

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.0" Max="0.5755"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="AquaticSand" Depth="20"/>
            </Layers>
            <Height Min="0.5755" Max="0.5790"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- No beach step, matching MediterraneanPlainsSouth's own convention;
               OrcusGrass2 instead of CrackedSoil is the actual change -->
          <Rule>
            <Layers>
              <Layer Material="OrcusGrass2" Depth="10"/>
            </Layers>
            <Height Min="0.5790" Max="0.6331"/>
            <Slope Min="0" Max="25"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="DesertRocks" Depth="5"/>
            </Layers>
            <Height Min="0.5790" Max="0.6331"/>
            <Slope Min="25" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="DustyRocks" Depth="5"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="0" Max="30"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="30"/>
            </Layers>
            <Height Min="0.6331" Max="0.6972"/>
            <Slope Min="30" Max="90"/>
          </Rule>

          <Rule>
            <Layers>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.6972" Max="0.85"/>
            <Slope Min="0" Max="90"/>
          </Rule>

          <!-- Alpine: thin Snow layer over the same Stone base, tallest
               ~15% of the height range only - snow-capped mountain tips,
               not a full snow biome. -->
          <Rule>
            <Layers>
              <Layer Material="Snow" Depth="3"/>
              <Layer Material="Stone" Depth="50"/>
            </Layers>
            <Height Min="0.85" Max="1.0"/>
            <Slope Min="0" Max="90"/>
          </Rule>

        </MaterialGroup>
      </ComplexMaterials>

      <!-- Hemisphere/region split for the four land MaterialGroups above:
           red channel of each *_mat.png is 0 (MediterraneanDefault,
           coastal) or 4 (MediterraneanPlainsNorth, inland) for points whose
           real-world source data came from the northern half of our pulled
           strip (Europe-adjacent), and 1 (MediterraneanSouth, coastal) or 5
           (MediterraneanPlainsSouth, inland) for the southern half
           (Africa-adjacent). up.png reads uniformly 1 or 5 (south content,
           per the pole swap above), down.png uniformly 0 or 4.

           front.png also carries a small hand-painted patch of
           MediterraneanTransition/PlainsTransition (6/7) on a stretch of
           Spanish east coastline, via the paint-layer PNG workflow (see
           [[biome_foliage_system]] memory). That same stretch of front.png's
           heightmap is locally raised right at the waterline, since Water
           Mod's real surface excursion there is WaveHeight + TideHeight +
           WaveScale combined, well above a single wave-height's range. -->



      <!-- Fallback material if no Rule above matches a given point. -->
      <DefaultSurfaceMaterial Material="Stone" MaxDepth="10.0" />
      <DefaultSubSurfaceMaterial Material="Stone" />

      <!-- LimitAltitude relates to real altitude via the game's own formula
           (MyPlanet.cs): AtmosphereAltitude = MaxHillHeight *
           Atmosphere.LimitAltitude. MaxHillHeight for this planet (current
           HillParams.Max=0.020196) = 0.020196 * 30000 = 605.88m, so
           LimitAltitude=18.0 gives ~10.9km of breathable altitude. If
           HillParams changes again, LimitAltitude needs recalculating to
           hold the same real-altitude target (divide the desired altitude
           by the new MaxHillHeight). Density and MaxWindSpeed match vanilla
           EarthLike's own values as reasonable defaults, not independently
           tuned. -->
      <HasAtmosphere>true</HasAtmosphere>
      <MaximumOxygen>1</MaximumOxygen>
      <Atmosphere>
        <Breathable>true</Breathable>
        <OxygenDensity>1.0</OxygenDensity>
        <Density>2</Density>
        <LimitAltitude>18.0</LimitAltitude>
        <MaxWindSpeed>80</MaxWindSpeed>
      </Atmosphere>

      <!-- AtmosphereTopModifier is a multiplier of planet radius, so it
           does not transfer as a raw number between planets of different
           radius if the goal is a specific real altitude: Orcus/EarthLike
           are ~60km-radius planets, where their 1.1 gives ~6km of altitude
           above the surface before the atmosphere fades ((1.1-1) x
           60,000m). This planet's actual radius is ~30,101.5m (per the
           live save entity, not the theoretical 30,000m) - at 1.1 that's
           only ~3km. 1.25 restores ~7.5km of usable flight altitude
           ((1.25-1) x 30,101.5). Editing this field alone does not update
           an already-spawned planet - its AtmosphereRadius is cached in
           the save file's planet entity and needs updating there too. -->
      <AtmosphereSettings>
        <RayleighScattering>
          <X>100</X>
          <Y>84</Y>
          <Z>63</Z>
        </RayleighScattering>
        <MieScattering>50</MieScattering>
        <MieColorScattering>
          <X>44</X>
          <Y>62</Y>
          <Z>150</Z>
        </MieColorScattering>
        <RayleighHeight>25</RayleighHeight>
        <RayleighHeightSpace>5</RayleighHeightSpace>
        <RayleighTransitionModifier>0.415</RayleighTransitionModifier>
        <MieHeight>200</MieHeight>
        <MieG>0.999832332</MieG>
        <Intensity>20</Intensity>
        <SeaLevelModifier>0.982</SeaLevelModifier>
        <AtmosphereTopModifier>1.25</AtmosphereTopModifier>
        <FogIntensity>0.3</FogIntensity>
        <Scale>1</Scale>
        <SunColor>
          <X>1</X>
          <Y>1</Y>
          <Z>1</Z>
        </SunColor>
        <SunSpecularColor>
          <X>1</X>
          <Y>0.984</Y>
          <Z>0.843</Z>
        </SunSpecularColor>
      </AtmosphereSettings>

      <CloudLayers>
        <CloudLayer>
          <!-- Far layer -->
          <Model>Models/Environment/Sky/CloudSphere.mwm</Model>
          <Textures>
            <Texture>Textures/Models/Environment/Sky/EarthFarClouds.dds</Texture>
          </Textures>
          <Color>
            <X>1</X>
            <Y>1</Y>
            <Z>1</Z>
            <W>0.1</W>
          </Color>
          <RelativeAltitude>0.9</RelativeAltitude>
          <RotationAxis>
            <X>-0.2</X>
            <Y>1</Y>
            <Z>0.2</Z>
          </RotationAxis>
          <AngularVelocity>0.0002</AngularVelocity>
          <InitialRotation>1.2</InitialRotation>
          <ScalingEnabled>false</ScalingEnabled>
          <FadeOutRelativeAltitudeStart>2.0</FadeOutRelativeAltitudeStart>
          <FadeOutRelativeAltitudeEnd>1.4</FadeOutRelativeAltitudeEnd>
          <ApplyFogRelativeDistance>0.3</ApplyFogRelativeDistance>
        </CloudLayer>

        <!-- Near layers -->
        <CloudLayer>
          <Model>Models/Environment/Sky/CloudSphere.mwm</Model>
          <Textures>
            <Texture>Textures/Models/Environment/Sky/Landsky_texture.dds</Texture>
          </Textures>
          <Color>
            <X>1.1</X>
            <Y>1.1</Y>
            <Z>1.1</Z>
            <W>1.6</W>
          </Color>
          <RelativeAltitude>1.0</RelativeAltitude>
          <RotationAxis>
            <X>0</X>
            <Y>1</Y>
            <Z>0</Z>
          </RotationAxis>
          <AngularVelocity>0.0006</AngularVelocity>
          <InitialRotation>0.15</InitialRotation>
          <ScalingEnabled>false</ScalingEnabled>
          <FadeOutRelativeAltitudeStart>-3.0</FadeOutRelativeAltitudeStart>
          <FadeOutRelativeAltitudeEnd>0.05</FadeOutRelativeAltitudeEnd>
          <ApplyFogRelativeDistance>0.3</ApplyFogRelativeDistance>
        </CloudLayer>

        <CloudLayer>
          <Model>Models/Environment/Sky/CloudSphere.mwm</Model>
          <Textures>
            <Texture>Textures/Models/Environment/Sky/Landsky_texture.dds</Texture>
          </Textures>
          <Color>
            <X>1.1</X>
            <Y>1.1</Y>
            <Z>1.1</Z>
            <W>1.6</W>
          </Color>
          <RelativeAltitude>2.0</RelativeAltitude>
          <RotationAxis>
            <X>0.2</X>
            <Y>1</Y>
            <Z>-0.2</Z>
          </RotationAxis>
          <AngularVelocity>0.0006</AngularVelocity>
          <InitialRotation>0.5</InitialRotation>
          <ScalingEnabled>false</ScalingEnabled>
          <FadeOutRelativeAltitudeStart>0.7</FadeOutRelativeAltitudeStart>
          <FadeOutRelativeAltitudeEnd>1.5</FadeOutRelativeAltitudeEnd>
        </CloudLayer>

        <CloudLayer>
          <Model>Models/Environment/Sky/CloudSphere.mwm</Model>
          <Textures>
            <Texture>Textures/Models/Environment/Sky/Landsky_texture.dds</Texture>
          </Textures>
          <Color>
            <X>1.1</X>
            <Y>1.1</Y>
            <Z>1.1</Z>
            <W>1.6</W>
          </Color>
          <RelativeAltitude>3.0</RelativeAltitude>
          <RotationAxis>
            <X>-0.2</X>
            <Y>1</Y>
            <Z>0.2</Z>
          </RotationAxis>
          <AngularVelocity>0.0006</AngularVelocity>
          <InitialRotation>1.2</InitialRotation>
          <ScalingEnabled>false</ScalingEnabled>
          <FadeOutRelativeAltitudeStart>0.8</FadeOutRelativeAltitudeStart>
          <FadeOutRelativeAltitudeEnd>1.4</FadeOutRelativeAltitudeEnd>
        </CloudLayer>

        <!-- Stacked-haze layer, extending the pattern above with one more
             Landsky_texture pass at a slightly higher altitude/different
             rotation, matching Orcus's multiple overlapping tinted layers. -->
        <CloudLayer>
          <Model>Models/Environment/Sky/CloudSphere.mwm</Model>
          <Textures>
            <Texture>Textures/Models/Environment/Sky/Landsky_texture.dds</Texture>
          </Textures>
          <Color>
            <X>1.1</X>
            <Y>1.1</Y>
            <Z>1.1</Z>
            <W>1.6</W>
          </Color>
          <RelativeAltitude>3.4</RelativeAltitude>
          <RotationAxis>
            <X>0.15</X>
            <Y>1</Y>
            <Z>-0.15</Z>
          </RotationAxis>
          <AngularVelocity>0.0006</AngularVelocity>
          <InitialRotation>2.0</InitialRotation>
          <ScalingEnabled>false</ScalingEnabled>
          <FadeOutRelativeAltitudeStart>0.9</FadeOutRelativeAltitudeStart>
          <FadeOutRelativeAltitudeEnd>1.6</FadeOutRelativeAltitudeEnd>
        </CloudLayer>

        <!-- Low weather layer using Orcus's own custom "clouds.dds" texture
             (bundled directly, not vanilla). Wide fade range + fog blending
             matches Orcus's low-cloud technique so ground-level cover
             doesn't pop in/out. -->
        <CloudLayer>
          <Model>Models/Environment/Sky/CloudSphere.mwm</Model>
          <Textures>
            <Texture>Textures/Models/Environment/Sky/clouds.dds</Texture>
          </Textures>
          <Color>
            <X>1</X>
            <Y>1</Y>
            <Z>1</Z>
            <W>1</W>
          </Color>
          <RelativeAltitude>1.5</RelativeAltitude>
          <RotationAxis>
            <X>0.1</X>
            <Y>1</Y>
            <Z>-0.1</Z>
          </RotationAxis>
          <AngularVelocity>0.0005</AngularVelocity>
          <InitialRotation>0.8</InitialRotation>
          <ScalingEnabled>false</ScalingEnabled>
          <FadeOutRelativeAltitudeStart>-3.0</FadeOutRelativeAltitudeStart>
          <FadeOutRelativeAltitudeEnd>0.05</FadeOutRelativeAltitudeEnd>
          <ApplyFogRelativeDistance>0.4</ApplyFogRelativeDistance>
        </CloudLayer>
      </CloudLayers>
      <!-- DefaultSurfaceTemperature is a named enum (MyTemperatureLevel),
           not a free-form 0.0-1.0 float. -->
      <DefaultSurfaceTemperature>Cozy</DefaultSurfaceTemperature>

      <!-- EnvironmentItems (grass/bush/tree foliage). All TypeId/SubtypeId
           values below are copied verbatim from the real vanilla
           PlanetGeneratorDefinitions.sbc EnvironmentItems blocks. <Biomes>
           is required on every Item entry: Biome=1 for the temperate zone
           (north mainland + all islands), Biome=2 for the arid zone (south
           mainland only). <Materials> filters are also included on each
           Item, cross-checking against the ComplexMaterials surface types
           for extra precision; <Latitude> is left permissive (0-90) since
           hemisphere distinction is already handled via the Biome channel,
           not Latitude (which can't distinguish north pole from south pole
           on this planet's wrap design).

           The biome channel further distinguishes "forest patch" (Biome
           3=temperate, 4=arid) from plain open land (1=temperate,
           2=arid) via a clustered-noise spatial mask (same technique as
           ore hotspot placement), so trees appear as genuine clumps with
           real gaps between them rather than a uniform scatter. Forest-
           patch coverage: 20% of temperate land, 12% of arid land
           (deliberately sparser, matching a drier climate).
           Grass/undergrowth/bush foliage reference BOTH the plain and
           forest-patch biome values (so ground cover reads continuously),
           while every TREE entry references ONLY the forest-patch biome. -->
      <EnvironmentItems>

        <!-- Temperate: grass foliage, both plain (1) and forest-patch (3) -->
        <Item>
          <Biomes>
            <Biome>1</Biome>
            <Biome>3</Biome>
          </Biomes>
          <Materials>
            <Material>OrcusGrass</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_DestroyableItems" SubtypeId="GrassFoliage" Density="0.2"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.75"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="30"/>
          </Rule>
        </Item>

        <!-- Temperate forest patches only (Biome=3): vanilla forest-edge trees -->
        <Item>
          <Biomes>
            <Biome>3</Biome>
          </Biomes>
          <Materials>
            <Material>OrcusGrass</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="GrassForestEdge" Density="0.2"/>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="GrassOldForestEdge" Density="0.08"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.70"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="25"/>
          </Rule>
        </Item>

        <!-- Temperate forest patches only (Biome=3), highland: denser forest -->
        <Item>
          <Biomes>
            <Biome>3</Biome>
          </Biomes>
          <Materials>
            <Material>Rocks_grass</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="GrassForestMedium" Density="0.4"/>
            <Item TypeId="MyObjectBuilder_VoxelMapStorageDefinition" SubtypeId="stone_mediumstone" Density="0.05"/>
          </Items>
          <Rule>
            <Height Min="0.70" Max="0.80"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="20"/>
          </Rule>
        </Item>

        <!-- Temperate forest patches only (Biome=3), low/flat interior: dense
             "Large" tier, sitting below the Edge (boundary, above) and
             Medium (highland, above) tiers so forest patches read as
             Edge -> dense interior -> thinning highland instead of just
             two density steps. -->
        <Item>
          <Biomes>
            <Biome>3</Biome>
          </Biomes>
          <Materials>
            <Material>OrcusGrass</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="GrassForestLarge" Density="0.5"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.66"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="15"/>
          </Rule>
        </Item>

        <!-- Temperate forest patches only (Biome=3): fern/mushroom/root undergrowth -->
        <Item>
          <Biomes>
            <Biome>3</Biome>
          </Biomes>
          <Materials>
            <Material>OrcusGrass</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_DestroyableItems" SubtypeId="Fern" Density="0.2"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.70"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="25"/>
          </Rule>
        </Item>

        <!-- Arid: sparse Pertam-native desert bush, both plain (2) and forest-patch (4) -->
        <Item>
          <Biomes>
            <Biome>2</Biome>
            <Biome>4</Biome>
          </Biomes>
          <Materials>
            <Material>CrackedSoil</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_DestroyableItems" SubtypeId="PertamSandBushFoliage" Density="0.06"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.75"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="30"/>
          </Rule>
        </Item>

        <!-- Arid forest patches only (Biome=4): vanilla sparse tree cover -->
        <Item>
          <Biomes>
            <Biome>4</Biome>
          </Biomes>
          <Materials>
            <Material>CrackedSoil</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="SandForestEdge" Density="0.06"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.68"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="20"/>
          </Rule>
        </Item>

        <!-- Arid forest patches only (Biome=4), low/flat interior: mid-density
             "Medium" tier between the sparse Edge above (0.06) and the
             highland desert scrub below, matching the same Edge -> denser
             interior structure used by the temperate forest. -->
        <Item>
          <Biomes>
            <Biome>4</Biome>
          </Biomes>
          <Materials>
            <Material>CrackedSoil</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="SandForestMedium" Density="0.18"/>
          </Items>
          <Rule>
            <Height Min="0.60" Max="0.66"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="15"/>
          </Rule>
        </Item>

        <!-- Arid forest patches only (Biome=4): coastal palm groves -->
        <Item>
          <Biomes>
            <Biome>4</Biome>
          </Biomes>
          <Materials>
            <Material>CrackedSoil</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="Palmbomen" Density="0.12"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.65"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="20"/>
          </Rule>
        </Item>

        <!-- Arid forest patches only (Biome=4): desert scrub -->
        <Item>
          <Biomes>
            <Biome>4</Biome>
          </Biomes>
          <Materials>
            <Material>DustyRocks</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="DesertTree" Density="0.05"/>
            <Item TypeId="MyObjectBuilder_DestroyableItems" SubtypeId="CactusPatch" Density="0.08"/>
            <Item TypeId="MyObjectBuilder_VoxelMapStorageDefinition" SubtypeId="desertrocks_largestone" Density="0.05"/>
          </Items>
          <Rule>
            <Height Min="0.65" Max="0.75"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="25"/>

          </Rule>
        </Item>

        <!-- Savanna: no new biome value, reuses the already-painted
             semi-arid Transition MaterialGroups' lowland material
             (OrcusGrass2, MaterialGroup 6/7) - a foliage entry riding on
             existing painted geography, not a repaint. Sparse tree cover
             over tall grass, distinct from both the vibrant temperate
             forest and the bare arid desert scrub. Biomes 2/4 (arid
             plain/forest) cover both plain and forest-patch land under
             this material, matching the "Arid: ... both plain (2) and
             forest-patch (4)" convention above. -->
        <Item>
          <Biomes>
            <Biome>2</Biome>
            <Biome>4</Biome>
          </Biomes>
          <Materials>
            <Material>OrcusGrass2</Material>
          </Materials>
          <Items>
            <Item TypeId="MyObjectBuilder_Trees" SubtypeId="SandForestEdge" Density="0.04"/>
            <Item TypeId="MyObjectBuilder_DestroyableItems" SubtypeId="GrassFoliage" Density="0.15"/>
          </Items>
          <Rule>
            <Height Min="0.58" Max="0.6331"/>
            <Latitude Min="0" Max="90"/>
            <Slope Min="0" Max="25"/>
          </Rule>
        </Item>

      </EnvironmentItems>

    </PlanetGeneratorDefinition>
  </PlanetGeneratorDefinitions>
</Definitions>
