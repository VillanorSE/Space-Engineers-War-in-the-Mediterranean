<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Gray Defense Spawns -->
	<!-- Triggers max 1 time when hostile player within 500m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DefenseSpawn1-Gray</SubtypeId>
            </Id>
            <Description> 

			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:500]
			[StartsReady:true]

			[MaxActions:1]
			[MaxPlayerReputation:-500]

            [Actions:WW2-Action-DefenseSpawn1-Gray]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DefenseSpawn1-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DefenseSpawn1-Gray]

			</Description>
        </EntityComponent>

	<!-- Spawns a Re2000 fighter near the grid -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DefenseSpawn1-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]
			
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]

			[SpawnGroups:NPC-WW2-Re2000]
			[SpawnGroups:NPC-WW2-Re2001]
			
			[UseRelativeSpawnPosition:false]
			[MinDistance:800]
			[MaxDistance:2000]
			[MinAltitude:200]
			[MaxAltitude:1000]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Gray Defense Spawns -->

<!-- Green Defense Spawns -->
	<!-- Triggers max 1 time when hostile player within 500m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DefenseSpawn1-Green</SubtypeId>
            </Id>
            <Description> 

			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:500]
			[StartsReady:true]

			[MaxActions:1]
			[MaxPlayerReputation:-500]

            [Actions:WW2-Action-DefenseSpawn1-Green]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DefenseSpawn1-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DefenseSpawn1-Green]

			</Description>
        </EntityComponent>

	<!-- Spawns a Green MS406 fighter near the grid -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DefenseSpawn1-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]
			
			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]

			[SpawnGroups:NPC-WW2-MS406]
			
			[UseRelativeSpawnPosition:false]
			[MinDistance:800]
			[MaxDistance:2000]
			[MinAltitude:200]
			[MaxAltitude:1000]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Green Defense Spawns -->

	</EntityComponents>
</Definitions>