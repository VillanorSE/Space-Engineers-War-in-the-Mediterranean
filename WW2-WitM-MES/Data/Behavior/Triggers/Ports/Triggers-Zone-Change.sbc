<!-- Shared Grow/Shrink actions + chats -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusGrow-Toulon</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:Toulon_Zone]
			[ZoneRadiusChangeType:Add]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Grow-Toulon]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Action-RadiusShrink-Toulon</SubtypeId>
			</Id>
			<Description>

			[RivalAI Action]
			[ChangeZoneAtPosition:true]
			[ZoneName:Toulon_Zone]
			[ZoneRadiusChangeType:Subtract]
			[ZoneRadiusChangeAmount:5000]
			[ChangeZoneOnlyByName:true]
			[UseChatBroadcast:true]
			[ChatData:WW2-Territory-Chat-Shrink-Toulon]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Grow-Toulon</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Toulon Command]
			[Color:Blue]
			[ChatMessages:Toulon territory has expanded.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Chat-Shrink-Toulon</SubtypeId>
			</Id>
			<Description>

			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Toulon Command]
			[Color:Blue]
			[ChatMessages:Toulon territory has contracted.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:true]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]

			</Description>
		</EntityComponent>

<!-- Counter floor/ceiling -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
