<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Airfield offense spawns: ONE trigger per faction, every 30-45 minutes, spawning ONE plane picked at
     random from that faction's roster (the spawn profile's [SpawnGroups:] list is a pool - MES picks one
     from it, the same way WW2-Spawn-DefenseSpawn-Gray picks one of its three).
     An earlier version had a separate trigger/action/spawn per plane type on the Behavior, which made
     every airfield spawn its whole roster at once (5 planes Gray, 3 Green) every cycle and again on every
     ownership flip. The triggers start disabled ([UseTrigger:false]) and are enabled/disabled by the
     ownership flip actions in Triggers-Airfield-Ownership.sbc. -->
<!-- War Level 4+: the trigger runs the -WL4 pool (no single fighters, 3-fighter flights); below that ElseActions run the original pool. -->

<!-- Offense Gray spawn sequence -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-OffenseSpawn-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:Timer]

			[MinCooldownMs:1800000]
			[MaxCooldownMs:2700000]
			[StartsReady:true]

			[MaxActions:-1]
			[Conditions:WW2-WarLevel-Condition-AtLeast4]
			[Actions:WW2-Action-OffenseSpawn-Gray-WL4]
			[UseElseActions:true]
			[ElseActions:WW2-Action-OffenseSpawn-Gray]

			</Description>
        </EntityComponent>

	<!-- Calls the Gray offense spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-OffenseSpawn-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-OffenseSpawn-Gray]

			</Description>
        </EntityComponent>

	<!-- Spawns one random Gray plane: Re.2000, Re.2001, FC.20, Ba.65 or SM.79 Bomber -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-OffenseSpawn-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:NPC-WW2-Re2000]
			[SpawnGroups:NPC-WW2-Re2001]
			[SpawnGroups:NPC-WW2-FC20]
			[SpawnGroups:NPC-WW2-Ba65]
			[SpawnGroups:NPC-WW2-SM79Bomber]

			[MinDistance:400]
			[MaxDistance:1000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
	<!-- War Level 4+: calls the Gray offense spawner with 3-fighter flights -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-OffenseSpawn-Gray-WL4</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-OffenseSpawn-Gray-WL4]

			</Description>
        </EntityComponent>

	<!-- Spawns one random Gray group: FC.20, a Ba.65 pair, SM.79 Bomber, or a flight of three Re.2000 or Re.2001 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-OffenseSpawn-Gray-WL4</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:NPC-WW2-FC20]
			[SpawnGroups:NPC-WW2-Ba65-Pair]
			[SpawnGroups:NPC-WW2-SM79Bomber]
			[SpawnGroups:NPC-WW2-Re2000-Flight]
			[SpawnGroups:NPC-WW2-Re2001-Flight]

			[MinDistance:400]
			[MaxDistance:1000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Offense Gray spawn sequence -->

<!-- Offense Green spawn sequence -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-OffenseSpawn-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:Timer]

			[MinCooldownMs:1800000]
			[MaxCooldownMs:2700000]
			[StartsReady:true]

			[MaxActions:-1]
			[Conditions:WW2-WarLevel-Condition-AtLeast4]
			[Actions:WW2-Action-OffenseSpawn-Green-WL4]
			[UseElseActions:true]
			[ElseActions:WW2-Action-OffenseSpawn-Green]

			</Description>
        </EntityComponent>

	<!-- Calls the Green offense spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-OffenseSpawn-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-OffenseSpawn-Green]

			</Description>
        </EntityComponent>

	<!-- Spawns one random Green plane: MS.406, Potez 630 or V-156-F Bomber -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-OffenseSpawn-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:NPC-WW2-MS406]
			[SpawnGroups:NPC-WW2-Potez630]
			[SpawnGroups:NPC-WW2-V-156-F_Bomber]

			[MinDistance:400]
			[MaxDistance:1000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
	<!-- War Level 4+: calls the Green offense spawner with 3-fighter flights -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-OffenseSpawn-Green-WL4</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-OffenseSpawn-Green-WL4]

			</Description>
        </EntityComponent>

	<!-- Spawns one random Green group: Potez 630, V-156-F Bomber, or a flight of three MS.406 -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-OffenseSpawn-Green-WL4</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[RivalAiSpawn:true]

			[SpawnGroups:NPC-WW2-Potez630]
			[SpawnGroups:NPC-WW2-V-156-F_Bomber]
			[SpawnGroups:NPC-WW2-MS406-Flight]

			[MinDistance:400]
			[MaxDistance:1000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Offense Green spawn sequence -->

	</EntityComponents>
</Definitions>
