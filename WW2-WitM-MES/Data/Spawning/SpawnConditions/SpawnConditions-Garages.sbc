			[InstallationTerrainValidation:true]
			[DisallowedTerrainTypes:SoilDry]
			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:2.7]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:2]
			[SandboxCounterCompareTypes:Equal]
			[PrefabSpawningMode:RandomSelectedIndexes]
			[PrefabIndexGroupNames:Building,Vehicle,Vehicle,Truck]
			[PrefabIndexGroupValues:0,1,2,3]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-Garage1-WL3</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[InstallationSpawnsOnDryLand:true]
			[MaxWaterCoverage:0.6]
			[InstallationTerrainValidation:true]
			[DisallowedTerrainTypes:SoilDry]
			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:2.7]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:3]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			[PrefabSpawningMode:RandomSelectedIndexes]
			[PrefabIndexGroupNames:Building,Vehicle,Vehicle,Vehicle]
			[PrefabIndexGroupValues:0,1,2,3]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-SpawnConditions-Garage2-WL3</SubtypeId>
			</Id>
			<Description>
			[MES Spawn Conditions]
			[PlanetaryInstallation:true]
			[InstallationSpawnsOnDryLand:true]
			[MaxWaterCoverage:0.6]
			[InstallationTerrainValidation:true]
			[DisallowedTerrainTypes:SoilDry]
			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]
			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:2.7]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:WarLevel]
			[CustomSandboxCountersTargets:3]
			[SandboxCounterCompareTypes:GreaterOrEqual]
			[PrefabSpawningMode:RandomSelectedIndexes]
			[PrefabIndexGroupNames:Building,Vehicle,Vehicle,Vehicle,Truck]
			[PrefabIndexGroupValues:0,1,2,3,4]
			</Description>
		</EntityComponent>
	</EntityComponents>
</Definitions>
