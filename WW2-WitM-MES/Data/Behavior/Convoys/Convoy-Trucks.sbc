			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-Raid-High-Gray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:TruckRaid-Gray]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-WarLevel-Condition-AtLeast4]
