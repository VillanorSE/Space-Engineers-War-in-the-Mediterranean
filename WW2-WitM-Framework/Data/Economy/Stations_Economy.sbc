<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- Overrides vanilla's Stations_Economy.sbc (same 3 Ids: OrbitalStations, Outposts,
     SpaceStations). <StationNames> is emptied so vanilla's world-gen auto-spawn pass has
     nothing to place - everything WW2-WitM sells/trades goes through hand-placed installations
     via MES StaticEncounter instead of vanilla's own station generator.
     <StationPrefabsFactionTypes> is kept at vanilla's own full values (not emptied): this data
     is used independently of world-gen spawning, and leaving it empty caused every Store Block
     in the world - including ones with no connection to any WW2-WitM content - to crash on
     interact (NullReferenceException in MyMarketWatchViewModel). -->

    <Definition xsi:type="MyObjectBuilder_StationsListDefinition">
        <Id Type="MyObjectBuilder_StationsListDefinition" Subtype="OrbitalStations" />
        <StationNames>
        </StationNames>
        <SpawnDistance>20000</SpawnDistance>
        <GeneratedItemsContainerType>
            <TypeId>ContainerTypeDefinition</TypeId>
            <SubtypeId>StationContainerType</SubtypeId>
        </GeneratedItemsContainerType>
        <StationPrefabsFactionTypes>
            <FactionTypePrefabs>
                <FactionType>Miner</FactionType>
                <PrefabNames>
                    <PrefabName>Economy_SpaceStation_10</PrefabName>
                    <PrefabName>Economy_SpaceStation_11</PrefabName>
                    <PrefabName>Economy_SpaceStation_12</PrefabName>
                    <PrefabName>Economy_SpaceStation_13</PrefabName>
                    <PrefabName>Economy_SpaceStation_14</PrefabName>
                    <PrefabName>Economy_SpaceStation_15</PrefabName>
                </PrefabNames>
            </FactionTypePrefabs>
            <FactionTypePrefabs>
                <FactionType>Trader</FactionType>
                <PrefabNames>
                    <PrefabName>Economy_SpaceStation_10</PrefabName>
                    <PrefabName>Economy_SpaceStation_11</PrefabName>
                    <PrefabName>Economy_SpaceStation_12</PrefabName>
                    <PrefabName>Economy_SpaceStation_13</PrefabName>
                    <PrefabName>Economy_SpaceStation_14</PrefabName>
                    <PrefabName>Economy_SpaceStation_15</PrefabName>
                </PrefabNames>
            </FactionTypePrefabs>
            <FactionTypePrefabs>
                <FactionType>Builder</FactionType>
                <PrefabNames>
                    <PrefabName>Economy_SpaceStation_10</PrefabName>
                    <PrefabName>Economy_SpaceStation_11</PrefabName>
                    <PrefabName>Economy_SpaceStation_12</PrefabName>
                    <PrefabName>Economy_SpaceStation_13</PrefabName>
                    <PrefabName>Economy_SpaceStation_14</PrefabName>
                    <PrefabName>Economy_SpaceStation_15</PrefabName>
                </PrefabNames>
            </FactionTypePrefabs>
            <FactionTypePrefabs>
                <FactionType>Pirate</FactionType>
                <PrefabNames>
                    <PrefabName>Economy_SpaceStation_11_Pirate</PrefabName>
                    <PrefabName>Economy_SpaceStation_14_Pirate</PrefabName>
                    <PrefabName>Economy_SpaceStation_15_Pirate</PrefabName>
                </PrefabNames>
            </FactionTypePrefabs>
            <FactionTypePrefabs>
                <FactionType>Military</FactionType>
                <PrefabNames>
                    <PrefabName>Economy_SpaceStation_10</PrefabName>
                    <PrefabName>Economy_SpaceStation_11</PrefabName>
                    <PrefabName>Economy_SpaceStation_12</PrefabName>
                    <PrefabName>Economy_SpaceStation_13</PrefabName>
                    <PrefabName>Economy_SpaceStation_14</PrefabName>
                    <PrefabName>Economy_SpaceStation_15</PrefabName>
                </PrefabNames>
            </FactionTypePrefabs>
        </StationPrefabsFactionTypes>
    </Definition>

