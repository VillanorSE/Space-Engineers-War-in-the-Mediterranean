              <ShowInInventory>true</ShowInInventory>
              <NumberInGrid>2</NumberInGrid>
              <Enabled>false</Enabled>
              <Program>/*
/ //// / Villanor's Suspension Assist / //// /
War in the Mediterranean (WW2-WitM). Questions and bug reports: Villanor.

Driving aid for wheeled vehicles (armored cars, trucks). It keeps changing each wheel's suspension
Strength so the springs stay soft without bottoming out:

- Ride height: each wheel is stiffened or softened until the vehicle sits a little below the
  suspension's Height (offset): by default 25% of the way from the offset to the point where the
  suspension bottoms out. Every wheel finds its own strength, so a heavy engine or turret is
  carried level instead of dragging one end down.
- Load: when the vehicle's mass changes (cargo, ammo, crew), every wheel's strength is scaled with
  it at once, then fine-tuned the next time the vehicle stands still or drives smoothly.
- Bumps: a wheel pushed deep into its travel gets stiffer the closer it comes to the end (a
  progressive bump stop), and a wheel springing back out fast is softened, so the spring doesn't
  throw the vehicle into the air.
- Turns: as the body leans, the outer wheels stiffen and the inner wheels soften, like an
  anti-roll bar. The outer springs take the lean progressively instead of letting the body roll.
- Speed: the tyres grip harder when slow (climbing, pulling away) and less when fast, so a hard
  turn makes the tyres slide instead of tipping the vehicle over; and the steering angle narrows
  at speed. The game already narrows steering a little as speed rises; this adds to it. While
  nobody drives, or after "off", each suspension's own Friction and Max steer angle are put back.

Setup:
1.) Put the programmable block on the vehicle's body, with at least one seat (or remote control)
    on the body facing forward.
2.) Optional: put the suspensions in a block group named "Suspension Assist" (name in Custom Data).
    Without the group the script uses every suspension on the vehicle.
3.) Set each suspension's Height (offset) to the ride height you want; the script never changes
    it. The Strength you set is only the starting point; "off" and "reset" put it back.
4.) Calibration: the script has to learn where each wheel sits in its travel. The first time the
    vehicle stands still on the ground with a driver it puts the handbrake on, lowers the vehicle onto
    its suspension stops for about two seconds, measures, raises it back and sets the handbrake as it
    was. Level ground is not needed. It does this again after a wheel is replaced, or after
    "calibrate". After 3 failed tries in a row it waits until the vehicle has driven; the readout
    keeps the reason of the last failed try. It also waits while the vehicle is static (a station).
5.) It only works while someone drives: a player in a seat that controls the vehicle, or at its
    remote control. With nobody driving it checks for a driver about every 1.7 seconds and does
    nothing else (the springs keep their base strengths), so parked vehicles cost the server
    almost nothing.

Don't run it together with Tank Drive's load balancing: both set Strength.

Arguments:
  calibrate  measure the wheels again the next time the vehicle stands still
  off        stop, and put every Strength back to what it was when the script first saw the wheel
  on         start again after "off"
  reset      put every Strength back, forget what was learned (strengths, calibration) and start
             again from the current settings
*/

const string VERSION = "1.4";
const string DATE = "2026/11/07";
const string SECTION = "WitM Suspension Assist";

// Custom Data settings (defaults)
string groupName = "Suspension Assist";
bool rideHeight = true, followMass = true, speedFriction = true, speedSteering = true;
float sagPct = 25f, bumpStartPct = 60f, bumpStiffPct = 300f, reboundSoftPct = 25f, rollStiffPct = 100f;
float minStrength = 2f, maxStrength = 100f;
// Friction % (terminal scale). The game turns it into tyre grip on a steep curve (decompiled
// MyMotorSuspension, 2026-11-07): 30% -&gt; 2.9, 40% -&gt; 8.1, 50% -&gt; 17.5. The owner found 30% stops the
// armored cars tipping over in turns.
float slowFriction = 40f, fastFriction = 30f, fastFrictionSpeed = 10f;
float fastSteerPct = 50f, fullSteerSpeed = 5f, fastSteerSpeed = 20f;

const string STORE_V1 = "v1";
const int CYCLE = 3;                 // control runs on 1 tick of every 3 (20 per second)
const double DT = CYCLE / 60.0;
const double QUIET_RATE = 0.1;       // m/s: wheels moving slower than this count as settled
const double REBOUND_RATE = 0.5;     // m/s of extension that gets the full rebound softening
const double MEAN_TIME = 2;          // s: sag is averaged this long before the ride height is corrected
const double ADAPT_TIME = 4;         // s: time constant of the ride-height correction
const double MIN_MULT = 0.3, MAX_MULT = 4;   // limits on the moment-to-moment stiffness change
const int CAL_MIN_STEPS = 30, CAL_MAX_STEPS = 400, CAL_STEADY_STEPS = 10;
// During calibration a wheel counts as steady below QUIET_RATE (1.2 asked for 1 mm per step, about
// 2 cm/s, which uneven or sloped ground rarely gave).
const int CAL_TRIES = 3;            // failed calibrations in a row before it waits for the vehicle to drive
const double DRIVE_SPEED = 3;        // m/s: driving this fast allows new calibration tries
const int ECHO_TIME = 10;            // s: the readout's numbers are rewritten at most this often

// Engine facts (decompiled MyMotorSuspension, 2026-10-24): the spring strength the physics gets is
// (Strength/100) squared, so the script works in that "stiffness" K and writes Strength = 100 * sqrt(K).
// The spring's rest point is Height along the block's Forward axis, and the wheel can travel from
// MinHeight to MaxHeight along that same axis. So the wheel's position along Forward is C + h, where
// C is a constant of the block and wheel models that a script can't read; calibration measures it
// with the rest point set to the end of the travel, where the wheel sits exactly on the stop.

class Wheel {
  public IMyMotorSuspension S;
  public long TopId;
  public double C = double.NaN, Sign, StopH;   // calibration; Sign +1 when the block's Forward points up
  public double K, Orig;                        // base stiffness, Strength when first seen (%)
  public double OrigF = double.NaN, OrigSteer = double.NaN;   // own Friction (%) and Max steer angle (rad)
  public double Sag, Travel, Rate, Mean;        // m below the rest point, m from rest point to the stop, m/s
  public double Side;                           // +1 left of the centre of mass, -1 right
  public bool Ok, HavePrev, Failed;
  public double CalH, X0, PrevX;                // during calibration
}

readonly MyIni ini = new MyIni();
readonly Dictionary&lt;long, Wheel&gt; known = new Dictionary&lt;long, Wheel&gt;();
readonly Dictionary&lt;long, float&gt; pendingHeight = new Dictionary&lt;long, float&gt;();
readonly List&lt;Wheel&gt; wheels = new List&lt;Wheel&gt;(), calWheels = new List&lt;Wheel&gt;(), sorted = new List&lt;Wheel&gt;();
readonly List&lt;IMyMotorSuspension&gt; tmpSusp = new List&lt;IMyMotorSuspension&gt;();
readonly List&lt;IMyShipController&gt; ctrls = new List&lt;IMyShipController&gt;();
readonly HashSet&lt;long&gt; seen = new HashSet&lt;long&gt;();
readonly List&lt;long&gt; stale = new List&lt;long&gt;();
readonly StringBuilder echo = new StringBuilder();
string statusText = "Starting", warnText = "", calFailText = "", lastCustomData, lastEcho, lastEchoHead;
long lastEchoTick;
// Speed settings last written (friction %, steering % of each wheel's own angle); -1 = own values.
double frictionNow = -1, steerNow = -1, flatSpeed;
// True while the blocks may hold script-set Friction / Max steer angle (so their own values must not be re-read).
bool speedApplied = true, restoreSpeed;
IMyShipController ctrl, calCtrl;
bool running = true, rescan, idle, calBrake;
long tick;
int steps, stillSteps, quietSteps, calStep = -1, calSteady, calFails;
double massRef, mass, aLat;

public Program() {
  ReadIni();
  LoadStorage();
  Setup();
  Runtime.UpdateFrequency = running ? UpdateFrequency.Update1 : UpdateFrequency.None;
}

public void Save() {
  var sb = new StringBuilder();
  // Numbers are stored as whole millionths so they read back the same in any language setting.
  sb.Append(STORE_V1).Append('|').Append(Fixed(massRef)).Append('|').Append(running ? '1' : '0').Append('|');
  foreach (var kv in known) {
    var w = kv.Value;
    sb.Append(kv.Key).Append(',').Append(w.TopId).Append(',')
      .Append(double.IsNaN(w.C) ? "n" : Fixed(w.C).ToString()).Append(',').Append(Fixed(w.Sign)).Append(',')
      .Append(Fixed(w.StopH)).Append(',').Append(Fixed(w.K)).Append(',').Append(Fixed(w.Orig)).Append(',')
      .Append(double.IsNaN(w.OrigF) ? "n" : Fixed(w.OrigF).ToString()).Append(',')
      .Append(double.IsNaN(w.OrigSteer) ? "n" : Fixed(w.OrigSteer).ToString()).Append(';'); }
  sb.Append('|');
  // Mid-calibration the Heights sit at the stops: keep the real ones so a reload puts them back.
  if (calStep &gt;= 0) foreach (var w in calWheels) sb.Append(w.S.EntityId).Append('=').Append(Fixed(w.CalH)).Append(';');
  Storage = sb.ToString();
}

long Fixed(double v) { return (long)Math.Round(v * 1e6); }

bool Unfixed(string text, out double v) {
  long n; v = 0;
  if (!long.TryParse(text, out n)) return false;
  v = n / 1e6; return true;
}

void LoadStorage() {
  var parts = (Storage ?? "").Split('|');
  if (parts.Length &lt; 4 || parts[0] != STORE_V1) return;
  double d; long id, top;
  if (Unfixed(parts[1], out d)) massRef = d;
  running = parts[2] != "0";
  foreach (var item in parts[3].Split(';')) {
    var f = item.Split(',');
    // 1.3 stored 7 fields; 1.4 adds the wheel's own Friction and Max steer angle.
    if ((f.Length != 7 &amp;&amp; f.Length != 9) || !long.TryParse(f[0], out id) || !long.TryParse(f[1], out top)) continue;
    var w = new Wheel { TopId = top };
    if (f[2] != "n" &amp;&amp; Unfixed(f[2], out d)) w.C = d;
    if (Unfixed(f[3], out d)) w.Sign = d;
    if (Unfixed(f[4], out d)) w.StopH = d;
    if (Unfixed(f[5], out d)) w.K = d;
    if (Unfixed(f[6], out d)) w.Orig = d;
    if (f.Length == 9) {
      if (f[7] != "n" &amp;&amp; Unfixed(f[7], out d)) w.OrigF = d;
      if (f[8] != "n" &amp;&amp; Unfixed(f[8], out d)) w.OrigSteer = d; }
    if (w.K &gt; 0) known[id] = w; }
  if (parts.Length &gt; 4)
    foreach (var item in parts[4].Split(';')) {
      var kv = item.Split('=');
      if (kv.Length == 2 &amp;&amp; long.TryParse(kv[0], out id) &amp;&amp; Unfixed(kv[1], out d)) pendingHeight[id] = (float)d; }
}

void ReadIni() {
  if (Me.CustomData == lastCustomData) return;
  var oldGroup = groupName;
  ini.Clear();
  if (ini.TryParse(Me.CustomData)) {
    groupName = ini.Get(SECTION, "Group name").ToString(groupName);
    rideHeight = ini.Get(SECTION, "Ride height control").ToBoolean(rideHeight);
    sagPct = ini.Get(SECTION, "Sag below the offset (% of travel)").ToSingle(sagPct);
    followMass = ini.Get(SECTION, "Follow mass changes").ToBoolean(followMass);
    bumpStartPct = ini.Get(SECTION, "Bump stop starts at (% of travel)").ToSingle(bumpStartPct);
    bumpStiffPct = ini.Get(SECTION, "Bump stop extra stiffness at the end (%)").ToSingle(bumpStiffPct);
    reboundSoftPct = ini.Get(SECTION, "Rebound softening (%)").ToSingle(reboundSoftPct);
    rollStiffPct = ini.Get(SECTION, "Anti-roll in turns (%)").ToSingle(rollStiffPct);
    minStrength = ini.Get(SECTION, "Min strength (%)").ToSingle(minStrength);
    maxStrength = ini.Get(SECTION, "Max strength (%)").ToSingle(maxStrength);
    speedFriction = ini.Get(SECTION, "Speed-based friction").ToBoolean(speedFriction);
    slowFriction = ini.Get(SECTION, "Friction when stopped (%)").ToSingle(slowFriction);
    fastFriction = ini.Get(SECTION, "Friction when fast (%)").ToSingle(fastFriction);
    fastFrictionSpeed = ini.Get(SECTION, "Friction is fast from (m/s)").ToSingle(fastFrictionSpeed);
    speedSteering = ini.Get(SECTION, "Speed-based steering").ToBoolean(speedSteering);
    fastSteerPct = ini.Get(SECTION, "Steering when fast (% of max steer angle)").ToSingle(fastSteerPct);
    fullSteerSpeed = ini.Get(SECTION, "Full steering up to (m/s)").ToSingle(fullSteerSpeed);
    fastSteerSpeed = ini.Get(SECTION, "Steering is fast from (m/s)").ToSingle(fastSteerSpeed);
  }
  else if (!string.IsNullOrWhiteSpace(Me.CustomData)) ini.EndContent = Me.CustomData;
  sagPct = MathHelper.Clamp(sagPct, 1f, 90f);
  bumpStartPct = MathHelper.Clamp(bumpStartPct, 10f, 95f);
  reboundSoftPct = MathHelper.Clamp(reboundSoftPct, 0f, 70f);
  minStrength = MathHelper.Clamp(minStrength, 0.5f, 100f);
  maxStrength = MathHelper.Clamp(maxStrength, minStrength, 100f);
  slowFriction = MathHelper.Clamp(slowFriction, 0f, 100f);
  fastFriction = MathHelper.Clamp(fastFriction, 0f, 100f);
  fastFrictionSpeed = MathHelper.Clamp(fastFrictionSpeed, 0.5f, 200f);
  fastSteerPct = MathHelper.Clamp(fastSteerPct, 5f, 100f);
  fullSteerSpeed = MathHelper.Clamp(fullSteerSpeed, 0f, 200f);
  fastSteerSpeed = MathHelper.Clamp(fastSteerSpeed, fullSteerSpeed + 0.5f, 200f);
  ini.Set(SECTION, "Group name", groupName);
  ini.Set(SECTION, "Ride height control", rideHeight);
  ini.Set(SECTION, "Sag below the offset (% of travel)", sagPct);
  ini.Set(SECTION, "Follow mass changes", followMass);
  ini.Set(SECTION, "Bump stop starts at (% of travel)", bumpStartPct);
  ini.Set(SECTION, "Bump stop extra stiffness at the end (%)", bumpStiffPct);
  ini.Set(SECTION, "Rebound softening (%)", reboundSoftPct);
  ini.Set(SECTION, "Anti-roll in turns (%)", rollStiffPct);
  ini.Set(SECTION, "Min strength (%)", minStrength);
  ini.Set(SECTION, "Max strength (%)", maxStrength);
  ini.Set(SECTION, "Speed-based friction", speedFriction);
  ini.Set(SECTION, "Friction when stopped (%)", slowFriction);
  ini.Set(SECTION, "Friction when fast (%)", fastFriction);
  ini.Set(SECTION, "Friction is fast from (m/s)", fastFrictionSpeed);
  ini.Set(SECTION, "Speed-based steering", speedSteering);
  ini.Set(SECTION, "Steering when fast (% of max steer angle)", fastSteerPct);
  ini.Set(SECTION, "Full steering up to (m/s)", fullSteerSpeed);
  ini.Set(SECTION, "Steering is fast from (m/s)", fastSteerSpeed);
  Me.CustomData = lastCustomData = ini.ToString();
  restoreSpeed = true;   // settings may have changed: own values back, then the speed settings again
  if (groupName != oldGroup) rescan = true;
}

void Setup() {
  rescan = false;
  tmpSusp.Clear(); ctrls.Clear(); wheels.Clear(); seen.Clear();
  var group = GridTerminalSystem.GetBlockGroupWithName(groupName);
  if (group != null) group.GetBlocksOfType(tmpSusp);
  else GridTerminalSystem.GetBlocksOfType(tmpSusp, s =&gt; s.IsSameConstructAs(Me));
  GridTerminalSystem.GetBlocksOfType(ctrls, c =&gt; c.CubeGrid == Me.CubeGrid);
  foreach (var s in tmpSusp) {
    Wheel w;
    if (!known.TryGetValue(s.EntityId, out w)) {
      w = new Wheel { Orig = s.Strength, K = Square(s.Strength / 100.0) };
      known[s.EntityId] = w; }
    // Own Friction / Max steer angle: read while the script hasn't changed them, so a player's own
    // terminal change (made while nobody drives) becomes the new value to put back.
    if (double.IsNaN(w.OrigF) || !speedApplied) { w.OrigF = s.Friction; w.OrigSteer = s.MaxSteerAngle; }
    w.S = s; wheels.Add(w); seen.Add(s.EntityId);
    float h; if (pendingHeight.TryGetValue(s.EntityId, out h)) s.Height = h; }
  pendingHeight.Clear();
  stale.Clear();
  foreach (var id in known.Keys) if (!seen.Contains(id)) stale.Add(id);
  foreach (var id in stale) known.Remove(id);
  frictionNow = steerNow = -1;   // a new or replaced wheel gets the speed settings too
}

public void Main(string argument, UpdateType updateSource) {
  var arg = (argument ?? "").Trim().ToLowerInvariant();
  if (arg != "") Command(arg);
  if ((updateSource &amp; UpdateType.Update100) != 0) { if (running &amp;&amp; idle &amp;&amp; Driven()) Wake(); }
  else if ((updateSource &amp; UpdateType.Update1) == 0) Report();
  else if (++tick % CYCLE == 0) { Step(); if (++steps % 10 == 0) Report(); }
  // The game clears the K menu's info text at the start of every run (decompiled MyProgrammableBlock,
  // 2026-10-28), so a run without an Echo blanks it and the panel (and Build Info's section) jumps.
  // Echo the same text every run.
  Echo(lastEcho ?? "");
}

void Command(string arg) {
  if (arg == "calibrate") {
    foreach (var w in known.Values) { w.C = double.NaN; w.Failed = false; }
    calFails = 0; calFailText = "";
    statusText = "Calibration requested: stop the vehicle on the ground."; }
  else if (arg == "off") {
    StopCalibration(); Restore(); running = false; idle = false;
    Runtime.UpdateFrequency = UpdateFrequency.None;
    statusText = "Off: strengths restored. Run \"on\" to start again."; Save(); }
  else if (arg == "on") {
    running = true; idle = false; Runtime.UpdateFrequency = UpdateFrequency.Update1; rescan = true;
    statusText = "Starting"; }
  else if (arg == "reset") {
    StopCalibration(); Restore(); known.Clear(); massRef = 0; quietSteps = 0; calFails = 0; calFailText = "";
    running = true; idle = false; Runtime.UpdateFrequency = UpdateFrequency.Update1; Setup();
    statusText = "Reset: strengths restored, calibration and learned strengths forgotten."; Save(); }
  else statusText = "Unknown argument \"" + arg + "\". Use calibrate, off, on or reset.";
}

void Step() {
  ReadIni();
  if (restoreSpeed) { restoreSpeed = false; RestoreOwn(); }
  if (rescan || tick % 600 == 0) Setup();
  ctrl = PickController();
  if (ctrl == null) { StopCalibration(); statusText = "No working seat or remote control on the vehicle's body."; Hold(); return; }
  if (!(ctrl.IsUnderControl &amp;&amp; ctrl.CanControlShip)) { Sleep(); return; }
  if (Me.CubeGrid.IsStatic) { StopCalibration(); stillSteps = 0; statusText = "Vehicle is static (a station): waiting."; Hold(); return; }
  var grav = ctrl.GetNaturalGravity();
  if (grav.LengthSquared() &lt; 0.01) { StopCalibration(); statusText = "No gravity: waiting."; Hold(); return; }
  var down = Vector3D.Normalize(grav);
  var vel = ctrl.GetShipVelocities();
  var flat = vel.LinearVelocity - Vector3D.Dot(vel.LinearVelocity, down) * down;
  bool still = vel.LinearVelocity.Length() &lt; 0.2 &amp;&amp; vel.AngularVelocity.Length() &lt; 0.05;
  stillSteps = still ? stillSteps + 1 : 0;
  if (flat.Length() &gt; DRIVE_SPEED) calFails = 0;

  if (calStep &gt;= 0) { Calibrate(flat.Length()); return; }

  // Where each wheel sits: Sag is how far it is pushed in from the spring's rest point.
  var com = ctrl.CenterOfMass;
  var right = ctrl.WorldMatrix.Right;
  var up = Vector3D.Zero;
  int n = 0; bool needCal = false;
  warnText = "";
  foreach (var w in wheels) {
    w.Ok = false;
    var s = w.S;
    if (s.Closed || !s.IsAttached || s.Top == null) { w.HavePrev = false; continue; }
    w.Side = Vector3D.Dot(s.GetPosition() - com, right) &lt; 0 ? 1 : -1;
    if (s.Top.EntityId != w.TopId) { w.C = double.NaN; w.Failed = false; w.TopId = s.Top.EntityId; calFails = 0; }
    if (double.IsNaN(w.C)) { if (!w.Failed) needCal = true; w.HavePrev = false; continue; }
    double sag = w.Sign * (X(w) - w.C - s.Height);
    w.Travel = Math.Max(0.01, w.Sign * (w.StopH - s.Height));
    if (w.Travel &lt; 0.05) warnText = "Some wheels' Height is at the compressed end of the travel: move it toward the other end to give them room.";
    w.Rate = w.HavePrev ? 0.5 * (w.Rate + (sag - w.Sag) / DT) : 0;
    w.Sag = sag; w.HavePrev = true; w.Ok = true;
    up += w.Sign * s.WorldMatrix.Forward; n++; }

  bool gaveUp = calFails &gt;= CAL_TRIES;
  if (needCal &amp;&amp; !gaveUp &amp;&amp; stillSteps &gt;= 20) { StartCalibration(down); return; }
  if (n == 0) {
    statusText = !needCal ? "No calibrated wheels."
      : gaveUp ? "Calibration failed " + CAL_TRIES + " times: it tries again after the vehicle drives, or run \"calibrate\"."
      : "Waiting to calibrate: stop the vehicle on the ground.";
    return; }
  statusText = needCal ? "Running; some wheels wait for calibration (stop on the ground)." : "Running";
  double tilt = Math.Acos(MathHelper.Clamp(Vector3D.Dot(Vector3D.Normalize(up), -down), -1, 1));
  if (tilt &gt; MathHelper.ToRadians(50)) { statusText = "Tipped over: holding the base strengths."; Hold(); return; }
  SpeedAdjust(flat.Length());

  // Mass changes: the load on every wheel changes with it, and so must the spring stiffness.
  mass = ctrl.CalculateShipMass().PhysicalMass;
  if (massRef &lt;= 0) massRef = mass;
  else if (Math.Abs(mass / massRef - 1) &gt; 0.01) {
    if (followMass) foreach (var w in wheels) w.K = ClampK(w.K * mass / massRef);
    massRef = mass; }

  // Body roll: half the difference in sag between the left and right wheels (+ = left side lower).
  aLat = Vector3D.Dot(Vector3D.Cross(vel.AngularVelocity, vel.LinearVelocity), right);
  double sumL = 0, sumR = 0; int nL = 0, nR = 0;
  foreach (var w in wheels) if (w.Ok) { if (w.Side &gt; 0) { sumL += w.Sag; nL++; } else { sumR += w.Sag; nR++; } }
  double roll = nL &gt; 0 &amp;&amp; nR &gt; 0 ? (sumL / nL - sumR / nR) / 2 : 0;
  // Centripetal acceleration to the right means a right turn, so the left wheels are on the outside.
  double outer = aLat &gt; 0 ? 1 : -1;
  double turn = MathHelper.Clamp((Math.Abs(aLat) - 0.5) / 2, 0, 1);
  if (roll * outer &lt;= 0) turn = 0;

  // Ride height: while the wheels are settled, steer each wheel's average sag to the target.
  double sagFrac = sagPct / 100.0;
  bool quiet = Math.Abs(aLat) &lt; 1 &amp;&amp; tilt &lt; MathHelper.ToRadians(10);
  foreach (var w in wheels) if (w.Ok &amp;&amp; (Math.Abs(w.Rate) &gt; QUIET_RATE || w.Sag &lt;= 0)) quiet = false;
  if (!quiet) quietSteps = 0;
  else {
    foreach (var w in wheels) if (w.Ok) w.Mean = quietSteps == 0 ? w.Sag : w.Mean + (w.Sag - w.Mean) * DT / MEAN_TIME;
    quietSteps++;
    if (rideHeight &amp;&amp; quietSteps * DT &gt;= MEAN_TIME)
      foreach (var w in wheels) {
        if (!w.Ok) continue;
        // At a fixed load the sag scales with 1/K, so K * (sag / target) is the stiffness that hits the target.
        double ratio = MathHelper.Clamp(w.Mean / (sagFrac * w.Travel), 0.67, 1.5);
        w.K = ClampK(w.K * Math.Pow(ratio, DT / ADAPT_TIME));
        if (ratio &gt; 1.2 &amp;&amp; w.K &gt;= Square(maxStrength / 100.0) * 0.999) warnText = "Too heavy: some wheels sag deep at max strength."; } }

  // Moment to moment: bump stop, rebound softening and anti-roll, as multipliers on each base stiffness.
  double bumpStart = bumpStartPct / 100.0, bumpGain = bumpStiffPct / 100.0;
  double soft = reboundSoftPct / 100.0, rollGain = rollStiffPct / 100.0;
  foreach (var w in wheels) {
    if (!w.Ok) continue;
    double m = 1, frac = w.Sag / w.Travel;
    if (frac &gt; bumpStart) { double u = Math.Min(1, (frac - bumpStart) / (1 - bumpStart)); m += bumpGain * u * u; }
    if (w.Rate &lt; 0) m *= 1 - soft * Math.Min(1, -w.Rate / REBOUND_RATE);
    // Anti-roll bar: add force on the low side and take it off the high side, in proportion to the
    // lean. As a stiffness that is K * roll / sag, with the sag floored so a light inner wheel can't blow it up.
    if (turn &gt; 0 &amp;&amp; w.Sag &gt; 0)
      m += w.Side * rollGain * turn * roll / Math.Max(w.Sag, 0.25 * sagFrac * w.Travel);
    SetStrength(w, 100 * Math.Sqrt(w.K * MathHelper.Clamp(m, MIN_MULT, MAX_MULT))); }
}

double X(Wheel w) { return Vector3D.Dot(w.S.Top.GetPosition() - w.S.GetPosition(), w.S.WorldMatrix.Forward); }

double Square(double v) { return v * v; }

double ClampK(double k) { return MathHelper.Clamp(k, Square(minStrength / 100.0), Square(maxStrength / 100.0)); }

void SetStrength(Wheel w, double v) {
  // Every Strength change is synced over the network, so small changes are left unwritten.
  float target = MathHelper.Clamp((float)v, minStrength, maxStrength), cur = w.S.Strength;
  if (Math.Abs(target - cur) &gt;= Math.Max(0.2f, 0.02f * cur)) w.S.Strength = target;
}

// Nobody drives: base strengths, then only a cheap check for a driver every 100 ticks.
void Sleep() {
  StopCalibration(); Hold(); stillSteps = 0; quietSteps = 0;
  idle = true; Runtime.UpdateFrequency = UpdateFrequency.Update100;
  statusText = "Nobody driving: waiting.";
  Report();
}

void Wake() {
  idle = false; rescan = true; Runtime.UpdateFrequency = UpdateFrequency.Update1;
  statusText = "Starting";
}

bool Driven() {
  // The block list is read again each time, so a seat rebuilt while parked is found.
  GridTerminalSystem.GetBlocksOfType(ctrls, c =&gt; c.CubeGrid == Me.CubeGrid);
  foreach (var c in ctrls) if (!c.Closed &amp;&amp; c.IsFunctional &amp;&amp; c.IsUnderControl &amp;&amp; c.CanControlShip) return true;
  return false;
}

IMyShipController PickController() {
  IMyShipController best = null;
  foreach (var c in ctrls) {
    if (c.Closed || !c.IsFunctional) continue;
    if (c.IsUnderControl &amp;&amp; c.CanControlShip) return c;
    if (best == null || c.IsMainCockpit) best = c; }
  return best;
}

// Base strengths, without the moment-to-moment changes; each wheel's own Friction and steer angle.
void Hold() {
  foreach (var w in wheels) if (!w.S.Closed &amp;&amp; w.S.IsAttached) SetStrength(w, 100 * Math.Sqrt(w.K));
  RestoreOwn();
}

void Restore() {
  foreach (var w in wheels) if (!w.S.Closed) w.S.Strength = (float)w.Orig;
  RestoreOwn();
}

// Speed: friction from "stopped" to "fast" over 0..fastFrictionSpeed; steering from the full angle
// to fastSteerPct of it between fullSteerSpeed and fastSteerSpeed. Both move in whole-percent steps
// with some hysteresis, so speed noise doesn't rewrite the blocks (every change is network-synced):
// at a steady speed nothing is written, while speeding up it is a few writes per second at most.
void SpeedAdjust(double speed) {
  flatSpeed = speed;
  bool fCh = false, sCh = false;
  if (speedFriction) {
    double f = slowFriction + (fastFriction - slowFriction) * MathHelper.Clamp(speed / fastFrictionSpeed, 0, 1);
    if (frictionNow &lt; 0 || Math.Abs(f - frictionNow) &gt;= 0.75) { frictionNow = Math.Round(f); fCh = true; } }
  if (speedSteering) {
    double st = 100 + (fastSteerPct - 100) * MathHelper.Clamp((speed - fullSteerSpeed) / (fastSteerSpeed - fullSteerSpeed), 0, 1);
    if (steerNow &lt; 0 || Math.Abs(st - steerNow) &gt;= 0.75) { steerNow = Math.Round(st); sCh = true; } }
  if (!fCh &amp;&amp; !sCh) return;
  speedApplied = true;
  foreach (var w in wheels) {
    var s = w.S;
    if (s.Closed || double.IsNaN(w.OrigF)) continue;
    if (fCh &amp;&amp; Math.Abs(s.Friction - frictionNow) &gt; 0.1) s.Friction = (float)frictionNow;
    if (sCh &amp;&amp; s.Steering) {
      float a = (float)(w.OrigSteer * steerNow / 100);
      if (Math.Abs(s.MaxSteerAngle - a) &gt; 0.001f) s.MaxSteerAngle = a; } }
}

// Each wheel's own Friction and Max steer angle back (nobody driving, off, settings changed).
void RestoreOwn() {
  if (speedApplied)
    foreach (var w in wheels) {
      var s = w.S;
      if (s.Closed || double.IsNaN(w.OrigF)) continue;
      if (Math.Abs(s.Friction - w.OrigF) &gt; 0.1) s.Friction = (float)w.OrigF;
      if (Math.Abs(s.MaxSteerAngle - w.OrigSteer) &gt; 0.001) s.MaxSteerAngle = (float)w.OrigSteer; }
  speedApplied = false; frictionNow = steerNow = -1;
}

void StartCalibration(Vector3D down) {
  calWheels.Clear();
  foreach (var w in wheels) {
    var s = w.S;
    if (s.Closed || !s.IsAttached || s.Top == null) continue;
    double dot = Vector3D.Dot(s.WorldMatrix.Forward, -down);
    if (Math.Abs(dot) &lt; 0.7) { w.Failed = true; continue; }   // suspension not upright on the vehicle
    w.Sign = Math.Sign(dot); w.CalH = s.Height; w.X0 = w.PrevX = X(w);
    // The rest point goes to the end of the travel on the compressed side (the setter clamps), so the
    // load and the spring both hold the wheel on that stop.
    s.Height = w.Sign &gt; 0 ? 1000f : -1000f;
    w.StopH = s.Height;
    s.Strength = 100f;
    calWheels.Add(w); }
  if (calWheels.Count == 0) { statusText = "No upright suspensions to calibrate."; return; }
  // The handbrake keeps the vehicle from creeping on a slope while it sits on its stops.
  calCtrl = ctrl; calBrake = ctrl.HandBrake; ctrl.HandBrake = true;
  calStep = 0; calSteady = 0;
  statusText = "Calibrating: lowering the vehicle onto its suspension stops...";
  Save();
}

void Calibrate(double flatSpeed) {
  foreach (var w in calWheels)
    if (w.S.Closed || !w.S.IsAttached || w.S.Top == null) { StopCalibration(); statusText = "Calibration stopped: a wheel came off."; return; }
  if (flatSpeed &gt; 1) { CalFailed("the vehicle moved"); return; }
  calStep++;
  bool steady = true;
  foreach (var w in calWheels) { double x = X(w); if (Math.Abs(x - w.PrevX) &gt; QUIET_RATE * DT) steady = false; w.PrevX = x; }
  calSteady = steady ? calSteady + 1 : 0;
  if (calStep &gt;= CAL_MAX_STEPS) { CalFailed("the wheels didn't settle"); return; }
  if (calStep &lt; CAL_MIN_STEPS || calSteady &lt; CAL_STEADY_STEPS) return;

  int bad = 0;
  foreach (var w in calWheels) {
    double x = X(w);
    w.C = x - w.StopH; w.TopId = w.S.Top.EntityId;
    // Checks: lowering the rest point can only push the wheel in, and at the real offset the wheel
    // must have sat inside its travel. Anything else means the stop wasn't where expected.
    double moved = w.Sign * (x - w.X0);
    double sagBefore = w.Sign * (w.X0 - w.C - w.CalH), travel = w.Sign * (w.StopH - w.CalH);
    if (moved &lt; -0.01 || sagBefore &lt; -0.05 || sagBefore &gt; travel + 0.05) { w.C = double.NaN; w.Failed = true; bad++; }
    w.HavePrev = false; }
  StopCalibration(); calFails = 0;
  calFailText = bad == 0 ? "" : "Last calibration: " + bad + " wheel(s) failed the checks.";
  statusText = bad == 0 ? "Calibrated." : "Calibration failed on " + bad + " wheel(s); they are left alone. Run \"calibrate\" to retry.";
  Save();
}

// A failed try: the reason stays on the readout until a calibration succeeds.
void CalFailed(string reason) {
  StopCalibration(); calFails++;
  calFailText = "Last calibration try failed (" + calFails + " of " + CAL_TRIES + "): " + reason + ".";
  statusText = "Calibration stopped: " + reason + ". It retries when the vehicle stands still.";
}

void StopCalibration() {
  if (calStep &lt; 0) return;
  foreach (var w in calWheels)
    if (!w.S.Closed) { w.S.Height = (float)w.CalH; w.S.Strength = MathHelper.Clamp((float)(100 * Math.Sqrt(w.K)), minStrength, maxStrength); }
  if (calCtrl != null &amp;&amp; !calCtrl.Closed) calCtrl.HandBrake = calBrake;
  calCtrl = null;
  calStep = -1; calWheels.Clear(); stillSteps = 0;
}

void Report() {
  echo.Clear();
  echo.Append("Villanor's Suspension Assist ").Append(VERSION).Append(" (").Append(DATE).Append(")\n");
  echo.Append(statusText).Append('\n');
  if (calFailText != "") echo.Append(calFailText).Append('\n');
  if (warnText != "") echo.Append(warnText).Append('\n');
  if (ctrl != null &amp;&amp; running) {
    echo.Append("Mass ").Append(mass.ToString("N0")).Append(" kg, sideways ").Append(aLat.ToString("0.0")).Append(" m/s2\n");
    if (speedApplied)
      echo.Append("Speed ").Append(flatSpeed.ToString("0.0")).Append(" m/s: friction ")
        .Append(frictionNow &lt; 0 ? "own" : frictionNow.ToString("0") + "%").Append(", steering ")
        .Append(steerNow &lt; 0 ? "own" : steerNow.ToString("0") + "% of max").Append('\n');
    sorted.Clear(); sorted.AddRange(wheels);
    var fwd = ctrl.WorldMatrix.Forward; var com = ctrl.CenterOfMass;
    sorted.Sort((a, b) =&gt; Vector3D.Dot(b.S.GetPosition() - com, fwd).CompareTo(Vector3D.Dot(a.S.GetPosition() - com, fwd)));
    echo.Append("Wheel, front first: strength, sag / target\n");
    foreach (var w in sorted) {
      echo.Append(w.Side &gt; 0 ? "Left  " : "Right ").Append(w.S.Strength.ToString("0.0")).Append("%  ");
      if (w.Ok) echo.Append(w.Sag.ToString("0.00")).Append(" / ").Append((sagPct / 100.0 * w.Travel).ToString("0.00")).Append(" m");
      else echo.Append(w.Failed ? "calibration failed" : "not calibrated");
      echo.Append('\n'); } }
  // The numbers change all the time; a status change shows at once, the numbers at most every ECHO_TIME seconds.
  var head = statusText + calFailText + warnText + running;
  if (head == lastEchoHead &amp;&amp; tick - lastEchoTick &lt; ECHO_TIME * 60) return;
  lastEcho = echo.ToString(); lastEchoHead = head; lastEchoTick = tick;
}
</Program>
