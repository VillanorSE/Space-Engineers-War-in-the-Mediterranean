<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Conditions for basic installations.
     2026-08-21: removed [ReplenishSystems:true] per user request  - prefabs
     are built with full fuel tanks already, Hangar has its own wind turbine,
     so replenishing on spawn isn't needed. This was also the likely cause of
     FC20's engine re-enabling despite being saved Enabled=false in its
     blueprint (see WW2-Behavior-HangarPlane-FC20 for the still-useful
     belt-and-suspenders fix, which stays regardless of this removal).
     Also added [CutVoxelsAtAirtightCells]/[CutVoxelSize]: clears voxel
     terrain from inside airtight interiors (e.g. the Hangar bay) so
     grass/ground doesn't spawn inside the building. Per MES wiki, this tag
     is explicitly flagged experimental/"not completely functional in some
     cases"  - shared across all installations using this profile (Hangar,
     Factory), so a fix here benefits both.
     IMPORTANT: MES reads Description as a plain string (ReadElementString)  -
     it cannot contain embedded XML comments/nodes, only [Key:Value] lines
     and blank lines. Put explanatory comments here, outside the
     EntityComponent, not inside <Description>. -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Installations</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[PlanetaryInstallation:true]
			[RivalAiPlanetaryInstallation:true]

			[InstallationSpawnsOnDryLand:true]

			[MaxSpawnFromPlanetSurface:5000]
			[PlanetRequiresAtmo:true]
			[UsePlayerCountCheck:true]
			[MinimumPlayers:1]
			[IgnoreCombatPhase:true]

			[CutVoxelsAtAirtightCells:true]
			[CutVoxelSize:2.7]

		</Description>
	</EntityComponent>

	</EntityComponents>
</Definitions>

