<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!-- 2026-08-23: added for the Factory Store-sells-the-plane feature. Pattern confirmed
     against a real working example, GVK-Derelicts (Workshop ID 2653133286,
     Data/Encounters/Store/GVK-Store-Behavior-RoverSales-Advanced.sbc)  - a Store block's
     inventory is NOT preconfigured by editing the block itself; it's assigned at runtime by
     a Trigger/Action pair, same [Key:Value] system as everything else in this mod. Each
     Trigger below is referenced from its matching plane's WW2-Behavior-Factory-Plane-<Plane>
     (Behaviors-Factory-Plane.sbc) so only that Factory's own plane gets offered, not the
     whole Factory-roster.

     REQUIRES A STORE BLOCK  - this is the one piece that still needs an in-game action: add a
     Store block (vanilla StoreBlock) to each Factory shell (NPC-WW2-Factory-Plane-Gray.sbc /
     -Green.sbc) and give it the exact CustomName "Store-FactoryPlane", then re-export both
     shells. One shared name is fine even though the shell is reused across multiple
     factories  - each spawned instance runs its own independent Behavior/Trigger, so a Gray
     shell spawned as the Re2000 Factory only ever applies the Re2000 profile to its own
     Store block, never another factory's. Until the Store block exists, these
     triggers/actions are harmless no-ops (same situation the old ProjectorBuild trigger was
     in before this session's cleanup)  - nothing here is destructive to add ahead of time. -->
	<EntityComponents>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-Re2000</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Store-Action-UpdateSales-Re2000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-Re2000</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-FactoryPlane]
			[StoreProfiles:WW2-Store-Profile-Re2000]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Trigger-UpdateSales-Re2001</SubtypeId>
			</Id>
			<Description>
			[MES AI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:60000]
			[MaxCooldownMs:60001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Store-Action-UpdateSales-Re2001]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Store-Action-UpdateSales-Re2001</SubtypeId>
			</Id>
			<Description>
			[MES AI Action]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-FactoryPlane]
			[StoreProfiles:WW2-Store-Profile-Re2001]
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
