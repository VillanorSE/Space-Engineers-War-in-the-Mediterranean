<!-- SWITCHED TO FIXED RELATIVE OFFSET (see La Spezia's comment block above for the full
     explanation of why). Computed from user-placed GPS point (GPS:Cargo Spawn -
     Alexandria:-5988.31:25908.17:-14106.12), projected into Alexandria's local frame using
     SpawnConditions-Ports.sbc's StaticEncounterForward/Up vectors. Note: for Alexandria, unlike
     La Spezia, StaticEncounterUp itself is directly aligned with the planet's true radial "up"
     (dot product ~1.0, confirmed against the direction vector) - the two prefabs are NOT
     oriented the same way relative to their own Forward/Up axes, so this can't be assumed
     universal per anchor and was re-verified per port. IgnoreSafetyChecks left true until
     confirmed working. -->

<!-- Civitavecchia Cargo Spawn (-> La Spezia) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-CargoSpawn-Port-Civitavecchia</SubtypeId>
