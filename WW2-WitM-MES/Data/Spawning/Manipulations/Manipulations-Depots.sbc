<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Depot ground units: MES NPC thrusters drive them; restricted once a player owns the grid. Prefabs built with vanilla small-grid small ion thrusters get them swapped for MES NPC ion at spawn (force x25, owner 2026-10-30). -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-DepotUnit</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[UseBlockReplacer:true]
			[ReplaceBlockOld:MyObjectBuilder_Thrust/SmallBlockSmallThrust]
			[ReplaceBlockNew:MyObjectBuilder_Thrust/MES-NPC-Thrust-Ion-SmallGrid-Small]
			[ConfigureSpecialNpcThrusters:true]
			[RestrictNpcAtmoThrust:true]
			[NpcAtmoThrustForceMultiply:1]
			[NpcAtmoThrustPowerMultiply:0.0001]
			[RestrictNpcIonThrust:true]
			[NpcIonThrustForceMultiply:25]
			[NpcIonThrustPowerMultiply:0.0001]
			</Description>
		</EntityComponent>
<!-- Depot beacon text '<Site> Depot' (owner 2026-10-30), set at spawn: the name generator takes the literal pattern and writes it to the HUD text of the beacon whose name contains 'Depot Block'; the grid keeps its name. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-Name-Depot-Benghazi</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[GridsAreDestructable:false]
			[GridsAreEditable:false]
			[UseRandomNameGenerator:true]
			[RandomGridNamePattern:Benghazi Depot]
			[RenameGrid:false]
			[ReplaceBeaconNameWithRandomizedName:Depot Block]
			[ReplaceBeaconHudTextInsteadOfName:true]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
