<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Crash Actions -->
	<!-- Compromised Crash Actions, trigger when remote disabled -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Compromised-Air</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:Compromised]
			
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-Action-Crash-Air]
			
			</Description>
        </EntityComponent>
	
	<!-- Damage Crash Actions, trigger when grid health below a threshold -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Crash-Air</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:true]
			[Type:HealthPercentage]
			
			[MinCooldownMs:250]
			[MaxCooldownMs:500]
			
			[PercentageOfHealthRemaining:94]
			[UseFailCondition:true]
			
			[StartsReady:true]
			[MaxActions:1]
			[Actions:WW2-Action-Crash-Air]
			[Actions:WW2-Action-Crash-Air-DebugChat]
			
			</Description>
        </EntityComponent>

	<!-- Turns off thrust and sets plane to spin from gyro -->	
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Crash-Air</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[Chance:100]
			
			[ChangeBehaviorSubclass:true]
			[NewBehaviorSubclass:Passive]
			
			[RandomGyroRotation:true]
			[StopAllThrust:true]

			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-StopCrash-Air]
			
			
			</Description>
        </EntityComponent>

	<!-- Debug confirmation - broadcasts WW2-Chat-Test so you can see in-game the moment this actually fires. Safe to strip out later. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-Crash-Air-DebugChat</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Action]
			
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Test]
			
			</Description>
        </EntityComponent>
<!-- End Crash Actions -->

<!-- Stop Crash, triggers when grid below 100m altitude after Crash trigger passed -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-StopCrash-Air</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:Timer]
			
			[MinCooldownMs:3000]
			[MaxCooldownMs:3001]
			[StartsReady:false]
			
			[MaxActions:1]
			
			[Conditions:WW2-Condition-StopCrash-Air]
			[ConditionCheckResetsTimer:true]
            [Actions:WW2-Action-StopCrash-Air]

			</Description>
        </EntityComponent>

	<!-- True when altitude below 100m -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Condition-StopCrash-Air</SubtypeId>
            </Id>
            <Description>

			[RivalAI Condition]
			
			[AltitudeCheck:true]
			[MaxAltitude:100]
			
			</Description>
        </EntityComponent>

	<!-- Terminates behaviour and turns off gyro override -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-StopCrash-Air</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]
			
			[StopAllRotation:true]
			[TerminateBehavior:True]
			
			</Description>
        </EntityComponent>
<!-- End Stop Crash -->

	</EntityComponents>
</Definitions>