<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<!-- Salvage economy Manipulation Profiles, one per grid-size tier - see
     ContainerTypes-TechComponents.sbc for the full rationale. ManipulationChance:100 on all
     five (matching GVK's own GVK-Universal-Loot.sbc, which uses a flat Chance:100 on every
     tier) - rarity lives in each item's own Frequency inside the ContainerType, not in a
     per-tier manipulation-level gate.

     IMPORTANT ORDERING NOTE for whoever wires these into a SpawnGroup: list the tier tag BEFORE
     the SpawnGroup's existing base loot profile (WW2-Manipulation-ShipsBasicLoot / -CargoPlanes
     / -CombatPlanes). Manipulation Profiles process in the order they're listed, and MES Loot
     Profiles skip any cargo block that already has a ContainerType assigned - if the base loot
     profile runs first, a grid with few containers could have nothing left for this to claim.

     Tier assignment per SpawnGroup file (see each file's own Behaviour tags):
       Small        - SpawnGroups-Planes-Fighters.sbc
       Medium       - SpawnGroups-Planes-Attackers.sbc, SpawnGroups-Ships.sbc (combat - mixes
                      in ammo, see Loot-TechComponents.sbc)
       Medium-Cargo - SpawnGroups-CargoPlanes.sbc, SpawnGroups-CargoShips-Nautical.sbc (cargo -
                      mixes in general components instead of ammo)
       Large        - SpawnGroups-Ships-Cruisers.sbc
       Huge         - SpawnGroups-Ships-Carriers.sbc -->

	<EntityComponents>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-Loot-Small</SubtypeId>
			</Id>
			<Description>

			[MES Manipulation]
			[ManipulationChance:100]

			[UseLootProfiles:true]
			[LootProfiles:WW2-Loot-Small]

			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-Loot-Medium</SubtypeId>
			</Id>
			<Description>

			[MES Manipulation]
			[ManipulationChance:100]

			[UseLootProfiles:true]
			[LootProfiles:WW2-Loot-Medium]

			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-Loot-Medium-Cargo</SubtypeId>
			</Id>
			<Description>

			[MES Manipulation]
			[ManipulationChance:100]

			[UseLootProfiles:true]
			[LootProfiles:WW2-Loot-Medium-Cargo]

			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-Loot-Large</SubtypeId>
			</Id>
			<Description>

			[MES Manipulation]
			[ManipulationChance:100]

			[UseLootProfiles:true]
			[LootProfiles:WW2-Loot-Large]

			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-Loot-Huge</SubtypeId>
			</Id>
			<Description>

			[MES Manipulation]
			[ManipulationChance:100]

			[UseLootProfiles:true]
			[LootProfiles:WW2-Loot-Huge]

			</Description>
		</EntityComponent>

	</EntityComponents>
</Definitions>
