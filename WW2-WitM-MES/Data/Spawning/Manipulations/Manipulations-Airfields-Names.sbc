<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Airfield beacon text '<Site> Airfield' (owner 2026-10-30), set at spawn like the depots' (WW2-Tool-GenDepots.py): the literal pattern goes to the HUD text of the beacon whose name contains 'Airfield Block'; the grid keeps its name. The airfield prefab beacons broadcast 2 km. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Manipulation-Name-Airfield-Gibraltar</SubtypeId>
			</Id>
			<Description>
			[MES Manipulation]
			[ManipulationChance:100]
			[UseRandomNameGenerator:true]
			[RandomGridNamePattern:Gibraltar Airfield]
			[RenameGrid:false]
			[ReplaceBeaconNameWithRandomizedName:Airfield Block]
			[ReplaceBeaconHudTextInsteadOfName:true]
			</Description>
		</EntityComponent>
