			[DisableTriggerNames:WW2-Trigger-Airfield-RequestCargoPlane-Gray]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoSpawn-Gray]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoDest-Gray]
						[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Clear]
			[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier2]
			[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier3]
			[SetCustomStrings:true]
			[CustomStrings:NewOwner,The Green]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Airfield-Captured]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-Airfield-Gray-BecomeUnowned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RecolorGrid:true]
			[OldBlockColors:{X:0 Y:-0.75 Z:0}]
			[NewBlockColors:{X:0 Y:0 Z:0.9}]
			[SetCustomStrings:true]
			[CustomStrings:OldOwner,The Gray]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Airfield-Abandoned]
			[ChangeBlockOwnership:true]
			[OwnershipBlockNames:Airfield Block]
			[OwnershipBlockFactions:UNOWNED]
			[OwnershipBlockNames:Store-Airport-Vehicles]
			[OwnershipBlockFactions:UNOWNED]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-Airfield-Unowned-CheckGreen]
			[EnableTriggerNames:WW2-Trigger-Airfield-Unowned-CheckGray]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gray-CheckGreen]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gray-CheckUnowned]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Gray]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gated-DefenseSpawn-Gray]
			[DisableTriggerNames:WW2-Trigger-OffenseSpawn-Gray]
			[DisableTriggerNames:WW2-Trigger-Airfield-RequestCargoPlane-Gray]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoSpawn-Gray]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoDest-Gray]
						[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Clear]
			[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier2]
			[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier3]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-Airport-Vehicles]
			[StoreProfiles:WW2-Store-Profile-Airfield-Empty]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-Airfield-Green-BecomeGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RecolorGrid:true]
			[OldBlockColors:{X:0.25555557 Y:-0.41 Z:-0.3}]
			[NewBlockColors:{X:0 Y:-0.75 Z:0}]
			[ChangeBlockOwnership:true]
			[OwnershipBlockNames:Airfield Block]
			[OwnershipBlockFactions:GRAY]
			[OwnershipBlockNames:Store-Airport-Vehicles]
			[OwnershipBlockFactions:GRAY]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Trigger-Airfield-AirCargoSpawn-Gray]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gray-CheckGreen]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gray-CheckUnowned]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-DefenseSpawn-Gray]
			[EnableTriggerNames:WW2-Trigger-OffenseSpawn-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-RequestCargoPlane-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-AirCargoSpawn-Gray]
			[EnableTriggerNames:WW2-Trigger-Airfield-AirCargoDest-Gray]
						[EnableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Clear]
			[EnableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier2]
			[EnableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Gray-Tier3]
			[EnableTriggerNames:WW2-Trigger-Airfield-Gated-BotCrew-3]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-Airfield-Green-CheckGray]
			[DisableTriggerNames:WW2-Trigger-Airfield-Green-CheckUnowned]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gated-DefenseSpawn-Green]
			[DisableTriggerNames:WW2-Trigger-OffenseSpawn-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-RequestCargoPlane-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoSpawn-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoDest-Green]
						[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Green-Clear]
			[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Green-Tier3]
			[SetCustomStrings:true]
			[CustomStrings:NewOwner,The Gray]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Airfield-Captured]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-Airfield-Green-BecomeUnowned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RecolorGrid:true]
			[OldBlockColors:{X:0.25555557 Y:-0.41 Z:-0.3}]
			[NewBlockColors:{X:0 Y:0 Z:0.9}]
			[SetCustomStrings:true]
			[CustomStrings:OldOwner,The Green]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-Airfield-Abandoned]
			[ChangeBlockOwnership:true]
			[OwnershipBlockNames:Airfield Block]
			[OwnershipBlockFactions:UNOWNED]
			[OwnershipBlockNames:Store-Airport-Vehicles]
			[OwnershipBlockFactions:UNOWNED]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Trigger-Airfield-Unowned-CheckGreen]
			[EnableTriggerNames:WW2-Trigger-Airfield-Unowned-CheckGray]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Trigger-Airfield-Green-CheckGray]
			[DisableTriggerNames:WW2-Trigger-Airfield-Green-CheckUnowned]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gated-ReputationDamageLight-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-Gated-DefenseSpawn-Green]
			[DisableTriggerNames:WW2-Trigger-OffenseSpawn-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-RequestCargoPlane-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoSpawn-Green]
			[DisableTriggerNames:WW2-Trigger-Airfield-AirCargoDest-Green]
						[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Green-Clear]
			[DisableTriggerNames:WW2-Store-Trigger-UpdateSales-Airfield-Vehicles-Green-Tier3]
			[ApplyStoreProfiles:true]
			[ClearStoreContentsFirst:true]
			[StoreBlocks:Store-Airport-Vehicles]
			[StoreProfiles:WW2-Store-Profile-Airfield-Empty]
			</Description>
		</EntityComponent>

<!-- Unowned state: check Green first, then Gray -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Unowned-CheckGreen</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Condition-Airfield-InGreenTerritory]
			[MatchAnyCondition:false]
			[Actions:WW2-Action-Airfield-Unowned-BecomeGreen]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Unowned-CheckGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Condition-Airfield-GrayTerritoryOnly]
			[Actions:WW2-Action-Airfield-Unowned-BecomeGray]
			</Description>
		</EntityComponent>

<!-- Gray state: stay if still in gray zone, else check green, else revert to unowned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Gray-CheckGreen</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Condition-Airfield-GreenTerritoryOnly]
			[Actions:WW2-Action-Airfield-Gray-BecomeGreen]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Gray-CheckUnowned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Condition-Airfield-NoTerritory]
			[Actions:WW2-Action-Airfield-Gray-BecomeUnowned]
			</Description>
		</EntityComponent>

<!-- Green state: stay if still in green zone, else check gray, else revert to unowned -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Green-CheckGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Condition-Airfield-GrayTerritoryOnly]
			[Actions:WW2-Action-Airfield-Green-BecomeGray]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Trigger-Airfield-Green-CheckUnowned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-Condition-Airfield-NoTerritory]
			[Actions:WW2-Action-Airfield-Green-BecomeUnowned]
			</Description>
		</EntityComponent>

<!-- Combined territory conditions. A Trigger's [Conditions:] field holds exactly ONE condition
     profile (TriggerProfile.Conditions is a single ConditionProfile, confirmed from MES source) -
     writing two [Conditions:] lines just makes the LAST one win, and [MatchAnyCondition:] does
     not exist on triggers at all. The earlier decision triggers listed e.g. InGrayTerritory +
     NotInGreenTerritory, which silently became just NotInGreenTerritory: that passes for any
     airfield outside Green territory, so every airfield went Gray the moment it spawned.
     A single condition profile CAN hold several checks (each check counts toward
     satisfiedConditions and all must pass when MatchAnyCondition is false), so each combined
     decision is one profile with a true-check and/or a false-check. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Condition-Airfield-GrayTerritoryOnly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:InGray_LaSpezia]
			[TrueBooleans:InGray_Tripoli]
			[TrueBooleans:InGray_Rome]
			[AllowAnyTrueBoolean:true]
			[CheckFalseBooleans:true]
			[FalseBooleans:InGreen_Toulon]
			[FalseBooleans:InGreen_Oran]
			[FalseBooleans:InGreen_Alexandria]
			[AllowAnyFalseBoolean:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Condition-Airfield-GreenTerritoryOnly</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckTrueBooleans:true]
			[TrueBooleans:InGreen_Toulon]
			[TrueBooleans:InGreen_Oran]
			[TrueBooleans:InGreen_Alexandria]
			[AllowAnyTrueBoolean:true]
			[CheckFalseBooleans:true]
			[FalseBooleans:InGray_LaSpezia]
			[FalseBooleans:InGray_Tripoli]
			[FalseBooleans:InGray_Rome]
			[AllowAnyFalseBoolean:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Condition-Airfield-NoTerritory</SubtypeId>
			</Id>
			<Description>
			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckFalseBooleans:true]
			[FalseBooleans:InGray_LaSpezia]
			[FalseBooleans:InGray_Tripoli]
			[FalseBooleans:InGray_Rome]
			[FalseBooleans:InGreen_Toulon]
			[FalseBooleans:InGreen_Oran]
			[FalseBooleans:InGreen_Alexandria]
			[AllowAnyFalseBoolean:false]
			</Description>
		</EntityComponent>

<!-- Airfield-owned copies of the shared reputation / bot-crew / defence triggers. They start disabled
     ([UseTrigger:false]) and are switched on/off by the flip actions below, exactly like the
     offense, cargo-request and store triggers. Same Actions as the originals, which are left
     untouched for the factories and ports. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-Gated-ReputationDamageLight-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:Damage]

			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Deformation]

			[Conditions:WW2-Condition-ReputationDamage]

			[MinCooldownMs:900000]
			[MaxCooldownMs:900000]
			[StartsReady:true]
			[MaxActions:-1]
            [Actions:WW2-Action-ReputationDamageLight-Gray]

			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-Gated-ReputationDamageLight-Green</SubtypeId>
            </Id>
			<!-- Damage excluding; environment and deformation. 15 minute cooldown. -->
            <Description>

			[RivalAI Trigger]

			[UseTrigger:false]
			[Type:Damage]

			[DamageTypes:Any]
			[ExcludedDamageTypes:Environment]
			[ExcludedDamageTypes:Deformation]

			[Conditions:WW2-Condition-ReputationDamage]

			[MinCooldownMs:900000]
			[MaxCooldownMs:900000]
			[StartsReady:true]
			[MaxActions:-1]
            [Actions:WW2-Action-ReputationDamageLight-Green]

			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-Gated-BotCrew-3</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:PlayerNear]

			[TargetDistance:800]
			
			[StartsReady:false]
			[MaxActions:1]
			
			[Actions:WW2-Action-BotCrew-3]
			
			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-Gated-DefenseSpawn-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:PlayerNear]
			[TargetDistance:1200]

			[MinCooldownMs:600000]
			[MaxCooldownMs:1800000]
			[StartsReady:true]
			
			[MaxPlayerReputation:-500]
			
            [Actions:WW2-Action-DefenseSpawn-Gray]

			</Description>
        </EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-Airfield-Gated-DefenseSpawn-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Trigger]
			
			[UseTrigger:false]
			[Type:PlayerNear]
			[TargetDistance:1200]

			[MinCooldownMs:600000]
			[MaxCooldownMs:1800000]
			[StartsReady:true]
			
			[MaxPlayerReputation:-500]
			
            [Actions:WW2-Action-DefenseSpawn-Green]

			</Description>
        </EntityComponent>

<!-- Ownership-change announcements. {NewOwner}/{OldOwner} are custom strings set by each state
     action (SetCustomStrings) - NOT the built-in {Faction} token, which resolves to the NPC's
     InitialFaction (UNOWNED for every airfield) and would print "UNOWNED" every time. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-Airfield-Captured</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Airfield Command]
			[Color:Blue]
			[ChatMessages:{NewOwner} has taken control of an airfield.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Chat-Airfield-Abandoned</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[Chance:100]
			[MaxChats:-1]
			[BroadcastRandomly:false]
			[Author:Airfield Command]
			[Color:Blue]
			[ChatMessages:{OldOwner} has lost control of an airfield.]
			[ChatAudio:ArcHudGPSNotification2]
			[BroadcastChatType:Both]
			[SendToAllOnlinePlayers:false]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:100000]
			</Description>
		</EntityComponent>

	</EntityComponents>
</Definitions>
