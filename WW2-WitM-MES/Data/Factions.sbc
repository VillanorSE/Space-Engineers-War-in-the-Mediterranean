<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Factions>
  
    <Faction Tag="GRAY" Founder="The Dictator">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Gray</SubtypeId>
      </Id>
      <DisplayName>The Gray</DisplayName>
	  <Description>The Gray are an alliance of several entities intent on expanding their territory for the exclusive benefit of their people. Their methods are often violent however not all factions have been drawn into their wars yet.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Enemies</DefaultRelation>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>

    </Faction>
	
	<Faction Tag="GREEN" Founder="The Statesman">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Green</SubtypeId>
      </Id>
      <DisplayName>The Green</DisplayName>
	  <Description>The Green are an alliance of numerous entities intent on containing The Gray. They are prepared to fight any who fight them.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Enemies</DefaultRelation>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
	  
    </Faction>

	<!-- 2026-09-10: Valencia neutral trade post owner. DefaultRelation:Neutral (not Friends) so it
	     matches vanilla's actual Neutral behavior - no automatic turret hostility toward either
	     faction, and critically, reputation with this faction is never touched by any
	     WW2-Trigger-ReputationDamage* trigger anywhere in this mod (those are only ever attached
	     to Gray/Green assets), so a player's standing here can only ever sit at the vanilla
	     default (0, Neutral) or better - it can never go Hostile, satisfying "no standing
	     requirement" without needing a scripted floor. -->
	<Faction Tag="TRADER" Founder="The Trader">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Trader</SubtypeId>
      </Id>
      <DisplayName>Traders</DisplayName>
	  <Description>An independent merchant consortium, unaligned with either Gray or Green, running a neutral trade post open to all comers.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Neutral</DefaultRelation>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>

    </Faction>

  </Factions>
</Definitions>