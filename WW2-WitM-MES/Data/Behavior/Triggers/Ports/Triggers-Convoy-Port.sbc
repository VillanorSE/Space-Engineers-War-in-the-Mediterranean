<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>
<!-- Supply convoy departures. Each supply port's behavior (Behaviors-Port.sbc) carries [TriggerGroups:WW2-Convoy-TriggerGroup-Port-{Port}]. A route's timer (150-210 min) runs only while the C# sets WitM-ConvoyOpen-{Route} (route filled in, destination held, port Onward can load the column); it fires as soon as the route opens if its cooldown has passed. Slots 1-2 always spawn, 3-5 only from War Level 3/4/5 (SpawnConditions-Convoys.sbc), so the column is 2/2/3/4/5 trucks. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-TriggerGroup-Port-Civitavecchia</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:WW2-Convoy-Trigger-Civitavecchia-Foggia]
			[Triggers:WW2-Convoy-Trigger-Civitavecchia-AbruzzoDepot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-TriggerGroup-Port-Tripoli</SubtypeId>
			</Id>
			<Description>
			[RivalAI TriggerGroup]
			[Triggers:WW2-Convoy-Trigger-Tripoli-Bizerte]
			[Triggers:WW2-Convoy-Trigger-Tripoli-Benghazi]
			[Triggers:WW2-Convoy-Trigger-Tripoli-Tobruk]
			[Triggers:WW2-Convoy-Trigger-Tripoli-BenghaziDepot]
			[Triggers:WW2-Convoy-Trigger-Tripoli-TunisDepot]
			[Triggers:WW2-Convoy-Trigger-Tripoli-TobrukDepot]
			[Triggers:WW2-Convoy-Trigger-Tripoli-SirteDepot]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
