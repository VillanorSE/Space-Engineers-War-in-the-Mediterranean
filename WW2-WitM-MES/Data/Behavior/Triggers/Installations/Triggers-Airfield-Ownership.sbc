		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Action-Airfield-Unowned-BecomeGray</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[RecolorGrid:true]
			[OldBlockColors:{X:0 Y:0 Z:0.9}]
			[NewBlockColors:{X:0 Y:-0.75 Z:0}]
			[ChangeBlockOwnership:true]
			[OwnershipBlockNames:FlagPole]
			[OwnershipBlockNames:Store-Airport-Vehicles]
			[OwnershipBlockFactions:GRAY]
			[SwitchToBehavior:true]
			[NewBehavior:WW2-Behavior-Airfield-Gray]
			</Description>
		</EntityComponent>
