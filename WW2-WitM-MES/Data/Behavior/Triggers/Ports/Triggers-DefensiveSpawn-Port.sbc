<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- 2026-08-28: Port defensive spawn, same pattern as Triggers-DefensiveSpawn.sbc (Factory_Planes)
     - hostile player near, low cooldown-gated plane scramble. Separate Trigger/Action/Spawner
     SubtypeIds from the Factory versions (kept per-installation-type for clarity in debug logs)
     but reuses the same shared WW2-Chat-DefenseSpawn-Factory-Plane chat profile - the message
     itself ("Scrambling air support") isn't Factory-specific. Green spawner list drops F4F
     (pulled from the roster per Roadmap, 2026-08-21) unlike the Factory version, which still
     references it. -->

<!-- Defensive Gray Port Spawn sequence -->
	<!-- Triggers when a hostile player is within 1200m with a 10-30 minute cooldown -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DefenseSpawn-Port-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:1200]

			[MinCooldownMs:600000]
			[MaxCooldownMs:1800000]
			[StartsReady:true]

			[MaxPlayerReputation:-500]

            [Actions:WW2-Action-DefenseSpawn-Port-Gray]

			</Description>
        </EntityComponent>

	<!-- Calls a chat notice and fighter spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DefenseSpawn-Port-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-DefenseSpawn-Factory-Plane]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DefenseSpawn-Port-Gray]

			</Description>
        </EntityComponent>

	<!-- Spawns a random Gray fighter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DefenseSpawn-Port-Gray</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]

			[SpawnGroups:NPC-WW2-Re2000]
			[SpawnGroups:NPC-WW2-Re2001]
			[SpawnGroups:NPC-WW2-FC20]

			[MinDistance:800]
			[MaxDistance:2000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Defensive Gray Port Spawn sequence -->

<!-- Defensive Green Port Spawn sequence -->
	<!-- Triggers when a hostile player is within 1200m with a 10-30 minute cooldown -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Trigger-DefenseSpawn-Port-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Trigger]

			[UseTrigger:true]
			[Type:PlayerNear]
			[TargetDistance:1200]

			[MinCooldownMs:600000]
			[MaxCooldownMs:1800000]
			[StartsReady:true]

			[MaxPlayerReputation:-500]

            [Actions:WW2-Action-DefenseSpawn-Port-Green]

			</Description>
        </EntityComponent>

	<!-- Calls a chat notice and fighter spawner -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Action-DefenseSpawn-Port-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Action]

			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-DefenseSpawn-Factory-Plane]

			[SpawnEncounter:true]
			[Spawner:WW2-Spawn-DefenseSpawn-Port-Green]

			</Description>
        </EntityComponent>

<!-- Spawns a random Green fighter -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Spawn-DefenseSpawn-Port-Green</SubtypeId>
            </Id>
            <Description>

			[RivalAI Spawn]

			[UseSpawn:true]
			[SpawningType:CustomSpawn]
			[StartsReady:true]

			[SpawnGroups:NPC-WW2-MS406]
			[SpawnGroups:NPC-WW2-Potez630]

			[MinDistance:800]
			[MaxDistance:2000]
			[MinAltitude:200]
			[MaxAltitude:800]
			[IgnoreSafetyChecks:false]
			[InheritNpcAltitude:false]

			</Description>
        </EntityComponent>
<!-- End Defensive Green Port Spawn sequence -->

	</EntityComponents>
</Definitions>
