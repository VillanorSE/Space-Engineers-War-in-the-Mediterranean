                    <Component xsi:type="MyObjectBuilder_ModStorageComponent">
                      <Storage>
                        <dictionary>
                          <item>
                            <Key>74de02b3-27f9-4960-b1c4-27351f2b06d1</Key>
                            <Value>[WitM Tank Drive]
Group name=Tank Drive
Wheel friction - Driving (%)=100
Wheel friction - Turning (%)=50
Friction ramp, turning to driving (s)=1
Adaptive turn friction=true
Adaptive turn friction max angle (deg)=45
Turn rate (deg per s)=30
Pivot turn rate (deg per s), 0 for full power=0
Turn start rate (deg per s)=5
Turn ramp-up time (s)=1
Anti-roll in turns (%)=100
Hold heading when driving straight=true
Steering gain=1
Invert steer when reversing=false
Gyro power - Turning (%)=100
Gyro power - Driving (%)=10
Traction control=true
Allowed wheel slip (%)=15
Wheel radius (m), 0 to learn it=0
Load balancing=true
Load balancing step (%)=2
Load balancing min strength (%)=10
Load balancing max strength (%)=100
Load balancing max hull drop (m)=0.15
</Value>
                          </item>
                        </dictionary>
                      </Storage>
                    </Component>
                  </ComponentData>
                </Components>
              </ComponentContainer>
              <CustomName>PB - Skid Steering</CustomName>
              <ShowOnHUD>false</ShowOnHUD>
              <ShowInTerminal>true</ShowInTerminal>
              <ShowInToolbarConfig>true</ShowInToolbarConfig>
              <ShowInInventory>true</ShowInInventory>
              <NumberInGrid>2</NumberInGrid>
              <Enabled>false</Enabled>
              <Program>
/*
/ //// / Villanor's Tank Drive Script / //// /
War in the Mediterranean (WW2-WitM). Questions and bug reports: Villanor.

Skid steering with traction control and load balancing for tracked or many-wheeled vehicles.

Setup:
1.) Put the vehicle's wheels (suspensions), the gyros that should help it turn, and its seats
    in a block group named "Tank Drive" (name in Custom Data). Without the group the script
    uses every suspension on the vehicle and the gyros on the PB's own grid.
2.) Only suspensions with Propulsion on are driven. Power is the throttle (100% = full).
3.) Set each suspension's Speed Limit as a loose safety cap (about 150 km/h); traction control
    does the real limiting.
4.) The first time the tank sits still, the script records the hull's ride height (used by load
    balancing). Do that on level ground. To record it again later, park level and run "record".
5.) Seats: the driver's seat must be on the hull and have Control wheels on. Gunner or
    commander seats on the hull without wheel control, and seats on the turret, are ignored.

Gyros (optional) help the turns. The rest of the time they hold zero rotation at a low power,
so mouse aiming (e.g. MART turret control) doesn't tip the hull. If you stop using the script,
turn Override off on the gyros.

Steering: A/D with W or S turn at a set rate (Custom Data, degrees per second); the script
measures how fast the hull is really turning and splits power between the sides to match.
The rate builds up while A/D are held: it starts at the start rate and reaches the full rate
after the ramp-up time, so a tap nudges the heading and holding A/D turns at the full rate.
A/D alone never drive the tank forward: nearly stopped they pivot in place at full power (or at
their own set rate); while rolling the sides work against each other to turn at the set rate,
which also slows the tank.
W/S alone hold the heading the tank had when the last turn ended.

Anti-roll: in a turn the outer wheels stiffen and the inner wheels soften with the sideways
pull, like an anti-roll bar, so the hull leans less. Strengths go back when the turn ends.

Traction control: each wheel's spin is compared with the ground speed under it. A wheel
spinning more than the allowed slip ahead of the ground has its drive cut until it grips.
The wheel radius is learned while driving straight (or set it in Custom Data) and kept with
the world.

Load balancing: while driving straight, wheels that keep losing grip carry too little weight.
The script first softens the wheels that grip (that corner sinks and the light wheels press
down), and only stiffens the light wheels if the hull has already dropped the allowed amount.
It acts only after 3 seconds in a row of the same slipping, changes Strength in small steps,
and eases wheels back toward their original Strength while all wheels grip.

The script also keeps vanilla wheel Steering and Invert propulsion off on its wheels.

Arguments:
  reset     put every Strength back to what it was when the script first ran, forget the
            learned radius and ride height (it records the ride height again when parked)
  record    record the ride height again the next time the tank sits still
*/

const string VERSION = "1.13";
const string DATE = "2026/10/28";
const string SECTION = "WitM Tank Drive";

// Custom Data settings (defaults)
string groupName = "Tank Drive";
float driveFriction = 100f, turnFriction = 50f, frictionRampTime = 1f, adaptiveAngleDeg = 45f;
bool adaptiveFriction = true, invertSteerReversing = false;
float turnRateDeg = 30f, turnStartDeg = 5f, turnRampTime = 1f, pivotRateDeg = 0f, steerGain = 1f; bool straightHold = true;
float rollStiffPct = 100f;
float gyroTurnPower = 100f, gyroDrivePower = 10f;
bool tractionControl = true; float allowedSlip = 15f, radiusSetting = 0f;
bool loadBalancing = true; float lbStep = 2f, lbMinStrength = 10f, lbMaxStrength = 100f, lbMaxDrop = 0.15f;

static readonly char[] STORE_CHARS = { '|', ';', '=' };
const string STORE_V2 = "v2";
const int CYCLE = 6;               // control runs on 1 tick of every 6 (10 per second)
const double DT = 1.0 / 60.0;      // spin is measured over one tick
const double MIN_EXCESS = 0.7;     // m/s of rim speed ahead of the ground always allowed
const double GAIN_MIN = 0.1, GAIN_CUT = 0.6, GAIN_RECOVER = 0.08;
const double STEER_P = 3, STEER_I = 3;   // side split per rad/s of turn-rate error, and per rad of its integral
const double PIVOT_MAX_SPEED = 2;       // m/s: below this, A/D alone pivot at full power
const double STRAIGHT_MAX = 0.5;         // most a straight-line correction slows one side
const double HEADING_GAIN = 2;           // rad/s of correction per rad of heading drift

class Wheel {
  public IMyMotorSuspension S;
  public bool Left, Driven;
  public double Sign, CmdSign, Geo, Gain = 1, GainSum, Omega;
  public int GainN, FlipVotes;
  public bool UseRight, HavePrev, Flipped;
  public Vector3D Prev;
  public float LastOverride = float.NaN, LastFriction = float.NaN;
  public float RollBase = float.NaN;   // Strength before anti-roll changed it (NaN = not changed)
  public string Type;
}

readonly MyIni ini = new MyIni();
readonly List&lt;Wheel&gt; wheels = new List&lt;Wheel&gt;();
readonly List&lt;IMyGyro&gt; gyros = new List&lt;IMyGyro&gt;();
readonly List&lt;IMyShipController&gt; seats = new List&lt;IMyShipController&gt;();
readonly List&lt;IMyMotorSuspension&gt; tmpSusp = new List&lt;IMyMotorSuspension&gt;();
readonly Dictionary&lt;string, double&gt; radius = new Dictionary&lt;string, double&gt;();
readonly Dictionary&lt;long, float&gt; origStrength = new Dictionary&lt;long, float&gt;();
readonly Dictionary&lt;string, List&lt;double&gt;&gt; ratios = new Dictionary&lt;string, List&lt;double&gt;&gt;();
readonly List&lt;Wheel&gt; light = new List&lt;Wheel&gt;(), loaded = new List&lt;Wheel&gt;();
readonly StringBuilder echo = new StringBuilder();
string statusText = "Starting", lastCustomData;
bool rescan;
IMyShipController ctrl, geoCtrl;
IMyCubeGrid hull;
long tick;
int steps, idleSteps, lbSteps, lbStreak;
bool idle, wasActive = true, lbWasStraight;
double steerI, yawTarget; bool wasTurning, holdValid; Vector3D holdFwd;
double turnRatio, turnTime, rideBase = double.NaN, elevSum, parkSum; int elevN, parkN;
bool rollActive;
readonly Dictionary&lt;long, float&gt; pendingRoll = new Dictionary&lt;long, float&gt;();
double avgMs, maxMs; string lbLast = "-";

public Program() {
  LoadStorage();
  Setup();
  Runtime.UpdateFrequency = UpdateFrequency.Update1;
}

public void Save() {
  var sb = new StringBuilder();
  // Numbers are stored as whole millionths so they read back the same in any language setting.
  sb.Append(STORE_V2).Append('|');
  if (!double.IsNaN(rideBase)) sb.Append(Fixed(rideBase));
  sb.Append('|');
  foreach (var kv in origStrength) sb.Append(kv.Key).Append('=').Append(Fixed(kv.Value)).Append(';');
  sb.Append('|');
  foreach (var kv in radius)
    if (kv.Key.IndexOfAny(STORE_CHARS) &lt; 0) sb.Append(kv.Key).Append('=').Append(Fixed(kv.Value)).Append(';');
  sb.Append('|');
  // Mid-turn the anti-roll has changed the Strengths: keep the real ones so a reload puts them back.
  foreach (var w in wheels) if (!float.IsNaN(w.RollBase)) sb.Append(w.S.EntityId).Append('=').Append(Fixed(w.RollBase)).Append(';');
  Storage = sb.ToString();
}

long Fixed(double v) { return (long)Math.Round(v * 1e6); }

bool Unfixed(string text, out double v) {
  long n; v = 0;
  if (!long.TryParse(text, out n)) return false;
  v = n / 1e6; return true;
}

void LoadStorage() {
  var parts = (Storage ?? "").Split('|');
  double d;
  if (parts.Length &gt; 0 &amp;&amp; parts[0] == STORE_V2) {
    if (parts.Length &gt; 1 &amp;&amp; Unfixed(parts[1], out d)) rideBase = d;
    if (parts.Length &gt; 2)
      foreach (var item in parts[2].Split(';')) {
        var kv = item.Split('='); long id;
        if (kv.Length == 2 &amp;&amp; long.TryParse(kv[0], out id) &amp;&amp; Unfixed(kv[1], out d)) origStrength[id] = (float)d; }
    if (parts.Length &gt; 3)
      foreach (var item in parts[3].Split(';')) {
        var kv = item.Split('=');
        if (kv.Length == 2 &amp;&amp; Unfixed(kv[1], out d) &amp;&amp; d &gt; 0) radius[kv[0]] = d; }
    if (parts.Length &gt; 4)
      foreach (var item in parts[4].Split(';')) {
        var kv = item.Split('='); long id;
        if (kv.Length == 2 &amp;&amp; long.TryParse(kv[0], out id) &amp;&amp; Unfixed(kv[1], out d)) pendingRoll[id] = (float)d; }
    return; }
  // Format of v1.0-1.8: plain numbers, written on this same machine.
  if (parts.Length &gt; 0 &amp;&amp; double.TryParse(parts[0], out d)) rideBase = d;
  if (parts.Length &gt; 1)
    foreach (var item in parts[1].Split(';')) {
      var kv = item.Split('='); long id; float v;
      if (kv.Length == 2 &amp;&amp; long.TryParse(kv[0], out id) &amp;&amp; float.TryParse(kv[1], out v)) origStrength[id] = v; }
}

void ReadIni() {
  if (Me.CustomData == lastCustomData) return;
  ini.Clear();
  if (ini.TryParse(Me.CustomData)) {
    groupName = ini.Get(SECTION, "Group name").ToString(groupName);
    driveFriction = ini.Get(SECTION, "Wheel friction - Driving (%)").ToSingle(driveFriction);
    turnFriction = ini.Get(SECTION, "Wheel friction - Turning (%)").ToSingle(turnFriction);
    frictionRampTime = ini.Get(SECTION, "Friction ramp, turning to driving (s)").ToSingle(frictionRampTime);
    adaptiveFriction = ini.Get(SECTION, "Adaptive turn friction").ToBoolean(adaptiveFriction);
    adaptiveAngleDeg = ini.Get(SECTION, "Adaptive turn friction max angle (deg)").ToSingle(adaptiveAngleDeg);
    turnRateDeg = ini.Get(SECTION, "Turn rate (deg per s)").ToSingle(turnRateDeg);
    pivotRateDeg = ini.Get(SECTION, "Pivot turn rate (deg per s), 0 for full power").ToSingle(pivotRateDeg);
    turnStartDeg = ini.Get(SECTION, "Turn start rate (deg per s)").ToSingle(turnStartDeg);
    turnRampTime = ini.Get(SECTION, "Turn ramp-up time (s)").ToSingle(turnRampTime);
    rollStiffPct = ini.Get(SECTION, "Anti-roll in turns (%)").ToSingle(rollStiffPct);
    straightHold = ini.Get(SECTION, "Hold heading when driving straight").ToBoolean(straightHold);
    steerGain = ini.Get(SECTION, "Steering gain").ToSingle(steerGain);
    invertSteerReversing = ini.Get(SECTION, "Invert steer when reversing").ToBoolean(invertSteerReversing);
    gyroTurnPower = ini.Get(SECTION, "Gyro power - Turning (%)").ToSingle(gyroTurnPower);
    gyroDrivePower = ini.Get(SECTION, "Gyro power - Driving (%)").ToSingle(gyroDrivePower);
    tractionControl = ini.Get(SECTION, "Traction control").ToBoolean(tractionControl);
    allowedSlip = ini.Get(SECTION, "Allowed wheel slip (%)").ToSingle(allowedSlip);
    radiusSetting = ini.Get(SECTION, "Wheel radius (m), 0 to learn it").ToSingle(radiusSetting);
    loadBalancing = ini.Get(SECTION, "Load balancing").ToBoolean(loadBalancing);
    lbStep = ini.Get(SECTION, "Load balancing step (%)").ToSingle(lbStep);
    lbMinStrength = ini.Get(SECTION, "Load balancing min strength (%)").ToSingle(lbMinStrength);
    lbMaxStrength = ini.Get(SECTION, "Load balancing max strength (%)").ToSingle(lbMaxStrength);
    lbMaxDrop = ini.Get(SECTION, "Load balancing max hull drop (m)").ToSingle(lbMaxDrop);
  }
  else if (!string.IsNullOrWhiteSpace(Me.CustomData)) ini.EndContent = Me.CustomData;
  ini.Delete(SECTION, "Max sideways acceleration in turns (m per s2)");   // setting of v1.12 and older
  ini.Set(SECTION, "Group name", groupName);
  ini.Set(SECTION, "Wheel friction - Driving (%)", driveFriction);
  ini.Set(SECTION, "Wheel friction - Turning (%)", turnFriction);
  ini.Set(SECTION, "Friction ramp, turning to driving (s)", frictionRampTime);
  ini.Set(SECTION, "Adaptive turn friction", adaptiveFriction);
  ini.Set(SECTION, "Adaptive turn friction max angle (deg)", adaptiveAngleDeg);
  ini.Set(SECTION, "Turn rate (deg per s)", turnRateDeg);
  ini.Set(SECTION, "Pivot turn rate (deg per s), 0 for full power", pivotRateDeg);
  ini.Set(SECTION, "Turn start rate (deg per s)", turnStartDeg);
  ini.Set(SECTION, "Turn ramp-up time (s)", turnRampTime);
  ini.Set(SECTION, "Anti-roll in turns (%)", rollStiffPct);
  ini.Set(SECTION, "Hold heading when driving straight", straightHold);
  ini.Set(SECTION, "Steering gain", steerGain);
  ini.Set(SECTION, "Invert steer when reversing", invertSteerReversing);
  ini.Set(SECTION, "Gyro power - Turning (%)", gyroTurnPower);
  ini.Set(SECTION, "Gyro power - Driving (%)", gyroDrivePower);
  ini.Set(SECTION, "Traction control", tractionControl);
  ini.Set(SECTION, "Allowed wheel slip (%)", allowedSlip);
  ini.Set(SECTION, "Wheel radius (m), 0 to learn it", radiusSetting);
  ini.Set(SECTION, "Load balancing", loadBalancing);
  ini.Set(SECTION, "Load balancing step (%)", lbStep);
  ini.Set(SECTION, "Load balancing min strength (%)", lbMinStrength);
  ini.Set(SECTION, "Load balancing max strength (%)", lbMaxStrength);
  ini.Set(SECTION, "Load balancing max hull drop (m)", lbMaxDrop);
  string output = ini.ToString();
  if (output != Me.CustomData) Me.CustomData = output;
  lastCustomData = Me.CustomData;
}

void Setup() {
  ReadIni();
  var old = new Dictionary&lt;long, Wheel&gt;();
  foreach (var w in wheels) old[w.S.EntityId] = w;
  wheels.Clear(); gyros.Clear(); seats.Clear(); tmpSusp.Clear();
  var g = GridTerminalSystem.GetBlockGroupWithName(groupName);
  if (g != null) {
    g.GetBlocksOfType(tmpSusp);
    g.GetBlocksOfType(gyros);
    g.GetBlocksOfType(seats, x =&gt; x.CanControlShip);
  }
  if (tmpSusp.Count == 0) GridTerminalSystem.GetBlocksOfType(tmpSusp, x =&gt; x.IsSameConstructAs(Me));
  // The hull is the grid the suspensions sit on. Turret gyros would turn the turret, and turret or
  // gunner seats would steal the drive: only hull gyros, and hull seats that control wheels.
  hull = tmpSusp.Count &gt; 0 ? tmpSusp[0].CubeGrid : Me.CubeGrid;
  if (g == null) GridTerminalSystem.GetBlocksOfType(gyros, x =&gt; x.CubeGrid == hull);
  else gyros.RemoveAll(x =&gt; x.CubeGrid != hull);
  seats.RemoveAll(x =&gt; x.CubeGrid != hull || !x.ControlWheels);
  if (seats.Count == 0) GridTerminalSystem.GetBlocksOfType(seats, x =&gt; x.CubeGrid == hull &amp;&amp; x.CanControlShip &amp;&amp; x.ControlWheels);
  if (seats.Count == 0) GridTerminalSystem.GetBlocksOfType(seats, x =&gt; x.CubeGrid == hull &amp;&amp; x.CanControlShip);
  foreach (var s in tmpSusp) {
    Wheel w;
    if (!old.TryGetValue(s.EntityId, out w)) w = new Wheel { S = s };
    float base_; if (pendingRoll.TryGetValue(s.EntityId, out base_)) s.Strength = base_;
    if (!origStrength.ContainsKey(s.EntityId)) origStrength[s.EntityId] = s.Strength;
    wheels.Add(w); }
  pendingRoll.Clear();
  geoCtrl = null;
}

// Wheel geometry depends on which seat is in use (left/right, forward direction).
void Geometry() {
  geoCtrl = ctrl;
  var m = ctrl.WorldMatrix;
  var inv = MatrixD.Transpose(m);
  Vector3D center = Vector3D.Zero; int n = 0;
  foreach (var w in wheels) if (w.S.IsAttached) { center += w.S.GetPosition(); n++; }
  if (n &gt; 0) center /= n;
  double cosMax = Math.Cos(MathHelper.ToRadians(MathHelper.Clamp(adaptiveAngleDeg, 0, 90)));
  foreach (var w in wheels) {
    var rel = w.S.GetPosition() - center;
    w.Left = Vector3D.TransformNormal(w.S.GetPosition() - ctrl.GetPosition(), inv).X &lt; 0;
    w.Sign = Math.Sign(Vector3D.Dot(w.S.WorldMatrix.Up, m.Left));
    if (w.Sign == 0) w.Sign = 1;
    w.CmdSign = w.Flipped ? -w.Sign : w.Sign;
    double geo = rel.LengthSquared() &gt; 1e-4 ? Math.Abs(Vector3D.Dot(Vector3D.Normalize(rel), w.S.WorldMatrix.Up)) : 1;
    w.Geo = geo &lt; cosMax ? 0 : geo;
    w.HavePrev = false;
    var top = w.S.Top;
    if (top != null) {
      w.Type = top.BlockDefinition.SubtypeId;
      var invS = MatrixD.Transpose(w.S.WorldMatrix);
      var f = Vector3D.TransformNormal(top.WorldMatrix.Forward, invS);
      var r = Vector3D.TransformNormal(top.WorldMatrix.Right, invS);
      w.UseRight = Math.Abs(r.Y) &lt; Math.Abs(f.Y);
      if (!radius.ContainsKey(w.Type)) {
        var size = top.Max - top.Min + Vector3I.One;
        radius[w.Type] = 0.75 * Math.Max(size.X, Math.Max(size.Y, size.Z)) * top.CubeGrid.GridSize * 0.5; } } }
}

// A vector fixed on the wheel, in the suspension's frame (X = Right, Z = Backward), flattened onto
// the plane of rotation (the axle is the suspension's Up).
Vector3D WheelVector(Wheel w) {
  var tm = w.S.Top.WorldMatrix;
  var v = w.UseRight ? tm.Right : tm.Forward;
  var sm = w.S.WorldMatrix;
  return new Vector3D(Vector3D.Dot(v, sm.Right), 0, Vector3D.Dot(v, sm.Backward));
}

public void Main(string arg, UpdateType src) {
  try {
    if (arg == "reset") Reset();
    if (arg == "record") { rideBase = double.NaN; parkN = 0; parkSum = 0; statusText = "Ride height will be recorded when the tank sits still."; }
    Echo(statusText);
    if (arg == "reset" || arg == "record") return;
    // LastRunTimeMs is the previous run. Skip the start-up runs (compile, first scan); the peak
    // fades (half-life about 20 s) so it shows recent spikes, not the all-time record.
    // The average is per game tick: a run every 10 ticks (parked) spreads its cost over those ticks.
    if (tick &gt; 10) {
      double ms = Runtime.LastRunTimeMs;
      int k = Math.Max(1, (int)Math.Round(Runtime.TimeSinceLastRun.TotalMilliseconds * 0.06));
      double keep = Math.Pow(0.995, k);
      avgMs = avgMs * keep + ms / k * (1 - keep);
      maxMs = Math.Max(ms, maxMs * Math.Pow(0.9995, k)); }
    tick++;
    long phase = tick % CYCLE;
    if (!idle &amp;&amp; phase == CYCLE - 1) { Snapshot(); return; }
    if (!idle &amp;&amp; phase != 0) return;
    if (rescan) { rescan = false; Setup(); }
    Control();
  } catch (Exception e) { statusText = "Error: " + e.Message; Echo(statusText); }
}

// The driver: a seat giving movement input, else the main cockpit, else the last driver, else any.
IMyShipController PickSeat() {
  IMyShipController main = null, any = null;
  foreach (var s in seats) {
    if (!s.IsFunctional || !s.IsUnderControl) continue;
    if (s.MoveIndicator.LengthSquared() &gt; 1e-4) return s;
    if (s.IsMainCockpit) main = s;
    if (any == null) any = s; }
  if (main != null) return main;
  if (ctrl != null &amp;&amp; ctrl.IsUnderControl &amp;&amp; seats.Contains(ctrl)) return ctrl;
  return any;
}

void Snapshot() {
  if (ctrl == null || geoCtrl != ctrl) return;
  foreach (var w in wheels) {
    if (w.S.Closed || !w.S.Propulsion || !w.S.IsAttached || w.S.Top == null) { w.HavePrev = false; continue; }
    w.Prev = WheelVector(w); w.HavePrev = true; }
}

void Control() {
  var seat = PickSeat();
  if (seat == null) {
    if (wasActive) Release();
    wasActive = false; idleSteps = 0;
    SetIdle(true, UpdateFrequency.Update10);   // check the seats 6 times a second
    Status("No driver"); return; }
  if (seat != ctrl) { ctrl = seat; }
  if (geoCtrl != ctrl) Geometry();

  var vel = ctrl.GetShipVelocities();
  var m = ctrl.WorldMatrix;
  var com = ctrl.CenterOfMass;
  var move = ctrl.MoveIndicator;
  double speed = vel.LinearVelocity.Length();
  bool turning = Math.Abs(move.X) &gt; 1e-3;
  double fwd = -Math.Sign(move.Z), turn = Math.Sign(move.X);

  // Idle when parked with no input: run rarely, record ride height.
  bool active = fwd != 0 || turning || speed &gt; 0.5;
  if (!active) {
    if (wasActive) Release();
    idleSteps++;
    double e; if (ctrl.TryGetPlanetElevation(MyPlanetElevation.Surface, out e) &amp;&amp; speed &lt; 0.3) {
      parkSum += e; parkN++;
      if (double.IsNaN(rideBase) &amp;&amp; parkN &gt;= 10) { rideBase = parkSum / parkN; Save(); } }
    if (idleSteps &gt; 30) SetIdle(true, UpdateFrequency.Update10);
    wasActive = false;
    if (idleSteps % 60 == 0) Setup();   // about every 10 s while parked
    Status("Parked");
    return; }
  idleSteps = 0; parkSum = 0; parkN = 0; wasActive = true;
  if (idle) { SetIdle(false, UpdateFrequency.Update1); foreach (var w in wheels) w.HavePrev = false; }

  // Skid steering by turn rate. Yaw is measured about the seat's Up (negative = nose turning right).
  // A/D ask for the set turn rate, moving or pivoting; W/S alone hold the heading they started on.
  // The side split c &gt; 0 puts the left side ahead of the right side (nose right).
  double yawRate = Vector3D.Dot(vel.AngularVelocity, m.Up);
  if (turning != wasTurning) { steerI = 0; holdValid = false; wasTurning = turning; }
  // A/D alone never drives the tank forward: the sides only work against each other. Nearly
  // stopped that is a full-power pivot; rolling it is a turn at the set (speed-capped) rate.
  double vFwd = Math.Abs(Vector3D.Dot(vel.LinearVelocity, m.Forward));
  bool pivoting = turning &amp;&amp; fwd == 0 &amp;&amp; vFwd &lt; PIVOT_MAX_SPEED;
  bool fullPivot = pivoting &amp;&amp; pivotRateDeg &lt;= 0;
  turnTime = turning ? turnTime + CYCLE / 60.0 : 0;
  if (turning) {
    double dir = fwd &lt; 0 &amp;&amp; invertSteerReversing ? -turn : turn;
    // Full-power pivot: gyros get a high target so they help instead of holding the pivot back.
    double full = fullPivot ? 90 : pivoting ? pivotRateDeg : turnRateDeg;
    // A/D are only on or off: the rate builds from the start rate to the full rate while they are held,
    // so a tap corrects the heading a little and holding them turns at the full rate.
    if (!fullPivot) {
      double start = Math.Min(turnStartDeg, full);
      full = start + (full - start) * Math.Min(1, turnTime / Math.Max(turnRampTime, 1e-3)); }
    yawTarget = -dir * MathHelper.ToRadians(full); }
  else if (fwd != 0 &amp;&amp; straightHold) {
    // Take the heading once the last turn has stopped, then steer back to it.
    if (!holdValid &amp;&amp; Math.Abs(yawRate) &lt; 0.03) { holdFwd = m.Forward; holdValid = true; }
    yawTarget = holdValid ? -HEADING_GAIN * Math.Atan2(Vector3D.Dot(Vector3D.Cross(holdFwd, m.Forward), m.Up), Vector3D.Dot(holdFwd, m.Forward)) : 0; }
  else { yawTarget = 0; holdValid = false; }
  double c = 0;
  if (fullPivot) { c = 2 * turn; steerI = 0; }   // both sides full power, opposite ways
  else if ((turning || fwd != 0) &amp;&amp; !ctrl.HandBrake) {
    double err = yawRate - yawTarget;
    double cMax = turning ? 2 : STRAIGHT_MAX;   // turning: up to 2, so the inner side can reverse
    double raw = steerGain * STEER_P * err + steerI;
    // Integrate only while the split can still act, or when the error unwinds it (a tank held by a
    // wall or the handbrake must not build up a lurch for when it is freed).
    if (Math.Abs(raw) &lt; cMax || Math.Sign(err) != Math.Sign(steerI))
      steerI = MathHelper.Clamp(steerI + steerGain * STEER_I * err * (CYCLE / 60.0), -cMax, cMax);
    c = MathHelper.Clamp(steerGain * STEER_P * err + steerI, -cMax, cMax); }
  else steerI = 0;
  double left, right;
  if (turning) {
    left = fwd + c; right = fwd - c;
    double big = Math.Max(Math.Abs(left), Math.Abs(right));
    if (big &gt; 1) { left /= big; right /= big; } }
  else {
    // Straight: only ever slow one side, by at most half, so a turn that is ending or a drift
    // is eased out without braking the tank.
    // c &gt; 0 needs the left side ahead: slow the right side going forward, the left side reversing.
    bool slowRight = c * fwd &gt; 0;
    left = slowRight ? fwd : fwd * (1 - Math.Abs(c));
    right = slowRight ? fwd * (1 - Math.Abs(c)) : fwd; }

  // Friction: drive value, ramping to the turn value (adaptive: less at the ends) while turning.
  double rampStep = (CYCLE / 60.0) / Math.Max(frictionRampTime, 1e-3);
  turnRatio = turning ? 1 : Math.Max(0, turnRatio - rampStep);

  bool straight = !turning &amp;&amp; fwd != 0 &amp;&amp; speed &gt; 3;
  bool learn = !turning &amp;&amp; fwd != 0 &amp;&amp; speed &gt; 1 &amp;&amp; radiusSetting &lt;= 0;
  foreach (var kv in ratios) kv.Value.Clear();

  foreach (var w in wheels) {
    var s = w.S;
    if (s.Closed) { rescan = true; continue; }
    if (!s.IsAttached || s.Top == null) continue;
    if (w.Type == null) { geoCtrl = null; continue; }
    double turnF = adaptiveFriction ? w.Geo * turnFriction : turnFriction;
    SetFriction(w, (float)(driveFriction + (turnF - driveFriction) * turnRatio));
    if (s.Steering) s.Steering = false;   // skid steering: no vanilla wheel steering angles
    w.Driven = s.Propulsion;
    if (!w.Driven) continue;
    if (s.InvertPropulsion) s.InvertPropulsion = false;   // the script handles each wheel's direction

    double u = w.Left ? left : right;
    double d = Math.Sign(u);
    var pos = s.GetPosition();
    var vAt = vel.LinearVelocity + Vector3D.Cross(vel.AngularVelocity, pos - com);
    double vF = Vector3D.Dot(vAt, m.Forward);

    // Spin over the last tick, forward-rolling positive.
    bool spin = false;
    if (w.HavePrev) {
      var cur = WheelVector(w);
      double cy = w.Prev.Z * cur.X - w.Prev.X * cur.Z;
      double dot = Vector3D.Dot(w.Prev, cur);
      if (w.Prev.LengthSquared() &gt; 1e-6 &amp;&amp; cur.LengthSquared() &gt; 1e-6) {
        w.Omega = w.Sign * Math.Atan2(cy, dot) / DT; spin = true; } }
    w.HavePrev = false;

    double R = radiusSetting &gt; 0 ? radiusSetting : radius[w.Type];
    if (spin &amp;&amp; d != 0) {
      double excess = d * (w.Omega * R - vF);
      if (tractionControl &amp;&amp; excess &gt; Math.Max(allowedSlip / 100.0 * Math.Abs(vF), MIN_EXCESS))
        w.Gain = Math.Max(GAIN_MIN, w.Gain * GAIN_CUT);
      else w.Gain = Math.Min(1, w.Gain + GAIN_RECOVER);
      // Rim running backwards against the ground for a second while driving straight from slow:
      // this wheel's propulsion is reversed (braking with S leaves the rim rolling with the ground).
      if (!turning &amp;&amp; Math.Abs(vF) &lt; 2 &amp;&amp; excess &lt; -2) {
        if (++w.FlipVotes &gt;= 10) { w.Flipped = !w.Flipped; w.CmdSign = -w.CmdSign; w.FlipVotes = 0; } }
      else w.FlipVotes = 0;
      // Each wheel's ground speed / spin, if plausible for the current radius (a dragging or
      // airborne wheel is left out on its own instead of skewing the rest).
      if (learn &amp;&amp; w.Omega * d &gt; 1) {
        double ratio = vF / w.Omega;
        if (ratio &gt; 0.5 * R &amp;&amp; ratio &lt; 2 * R) {
          List&lt;double&gt; list;
          if (!ratios.TryGetValue(w.Type, out list)) ratios[w.Type] = list = new List&lt;double&gt;();
          list.Add(ratio); } }
    }
    else if (d == 0) w.Gain = 1;
    if (straight) { w.GainSum += w.Gain; w.GainN++; }

    SetOverride(w, (float)(w.CmdSign * u * (tractionControl ? w.Gain : 1) * s.Power * 0.01));
  }

  // Learn the rolling radius per wheel type from its least-slipping wheels: the upper quartile of
  // the plausible ratios (slipping wheels read low), eased in slowly; saved with the world.
  foreach (var kv in ratios) {
    var list = kv.Value;
    if (list.Count &lt; 2) continue;
    list.Sort();
    double q = list[(list.Count * 3) / 4];
    radius[kv.Key] = radius[kv.Key] + 0.05 * (q - radius[kv.Key]);
    }

  Gyros(turning);
  AntiRoll(vel, m);
  if (loadBalancing) LoadBalance(straight &amp;&amp; !rollActive);
  Status(turning ? "Turning" : fwd != 0 ? "Driving" : "Coasting");
}

// Gyros stay on override all the time, as in Whip's script: an override ignores the seat's mouse
// input (turret aiming through MART would otherwise tip the hull). Turning: they chase the same
// turn-rate target as the wheels at turn power. Otherwise: zero rotation at driving power, a light
// damping (0% = no effect). Gyro yaw override: positive = nose right.
void Gyros(bool turning) {
  if (gyros.Count == 0) return;
  double yaw = ctrl == null ? 0 : -yawTarget;
  var world = yaw == 0 ? Vector3D.Zero : Vector3D.TransformNormal(new Vector3D(0, yaw, 0), ctrl.WorldMatrix);
  float power = (float)((turning ? gyroTurnPower : gyroDrivePower) * 0.01);
  foreach (var g in gyros) {
    if (g.Closed) { rescan = true; continue; }
    var l = Vector3D.TransformNormal(world, MatrixD.Transpose(g.WorldMatrix));
    if (Math.Abs(g.Pitch - l.X) &gt; 1e-3) g.Pitch = (float)l.X;
    if (Math.Abs(g.Yaw - l.Y) &gt; 1e-3) g.Yaw = (float)l.Y;
    if (Math.Abs(g.Roll - l.Z) &gt; 1e-3) g.Roll = (float)l.Z;
    if (Math.Abs(g.GyroPower - power) &gt; 1e-3f) g.GyroPower = power;
    if (!g.GyroOverride) g.GyroOverride = true; }
}

// Anti-roll bar: in a turn the sideways pull moves weight from the inner wheels to the outer ones.
// Each wheel's stiffness is scaled with its share of that load, so both sides keep their sag and the hull
// stays level. Load moved = sideways pull / gravity x (centre-of-mass height / half the track width);
// 100% takes that ratio as 1. Stiffness is (Strength/100) squared (decompiled MyMotorSuspension,
// 2026-10-24), so Strength scales with the square root. Load balancing waits while this is active.
void AntiRoll(MyShipVelocities vel, MatrixD m) {
  double share = 0, aLat = 0;
  double g = ctrl.GetNaturalGravity().Length();
  if (rollStiffPct &gt; 0 &amp;&amp; g &gt; 0.1) {
    aLat = Vector3D.Dot(Vector3D.Cross(vel.AngularVelocity, vel.LinearVelocity), m.Right);
    share = MathHelper.Clamp(rollStiffPct / 100.0 * Math.Abs(aLat) / g, 0, 0.8);
    if (share &lt; 0.03) share = 0; }
  // Centripetal acceleration to the right means a right turn, so the left wheels are on the outside.
  bool leftOuter = aLat &gt; 0;
  rollActive = false;
  foreach (var w in wheels) {
    var s = w.S;
    if (s.Closed || !s.IsAttached) continue;
    if (share == 0) { RollRestore(w); continue; }
    if (float.IsNaN(w.RollBase)) w.RollBase = s.Strength;
    float target = MathHelper.Clamp((float)(w.RollBase * Math.Sqrt(1 + (w.Left == leftOuter ? share : -share))), 1f, 100f);
    // Every Strength change is synced over the network, so small changes are left unwritten.
    if (Math.Abs(target - s.Strength) &gt;= Math.Max(0.2f, 0.02f * s.Strength)) s.Strength = target;
    rollActive = true; }
}

void RollRestore(Wheel w) {
  if (float.IsNaN(w.RollBase)) return;
  if (!w.S.Closed) w.S.Strength = w.RollBase;
  w.RollBase = float.NaN;
}

// Once a second of straight driving: soften wheels that grip (if the hull may still drop),
// otherwise stiffen wheels that keep losing grip.
void LoadBalance(bool straight) {
  if (!straight) {
    // Start each straight stretch from scratch.
    if (lbWasStraight) {
      lbSteps = 0; lbStreak = 0; elevSum = 0; elevN = 0;
      foreach (var w in wheels) { w.GainSum = 0; w.GainN = 0; } }
    lbWasStraight = false;
    return; }
  lbWasStraight = true;
  double e; if (ctrl.TryGetPlanetElevation(MyPlanetElevation.Surface, out e)) { elevSum += e; elevN++; }
  if (++lbSteps &lt; 10) return;
  lbSteps = 0;
  light.Clear(); loaded.Clear();
  foreach (var w in wheels) {
    if (!w.Driven || w.GainN == 0) continue;
    double avg = w.GainSum / w.GainN;
    if (avg &lt; 0.75) light.Add(w); else if (avg &gt; 0.95) loaded.Add(w);
    w.GainSum = 0; w.GainN = 0; }
  double drop = double.IsNaN(rideBase) || elevN == 0 ? 0 : rideBase - elevSum / elevN;
  elevSum = 0; elevN = 0;
  if (light.Count == 0 || loaded.Count == 0) {
    lbStreak = 0;
    if (light.Count == 0) {
      // Balanced: ease every driven wheel a quarter step back toward its original Strength, so
      // softening done for one slippery patch doesn't stay forever.
      int back = 0;
      foreach (var w in wheels) {
        float orig;
        if (!w.Driven || !origStrength.TryGetValue(w.S.EntityId, out orig)) continue;
        float cur = w.S.Strength, step = lbStep * 0.25f;
        if (Math.Abs(orig - cur) &gt; 0.01f) back += Nudge(w, MathHelper.Clamp(orig - cur, -step, step)); }
      lbLast = back &gt; 0 ? "balanced, easing back toward original strength" : "balanced"; }
    else lbLast = "all wheels slipping";
    return; }
  // Act only after 3 seconds in a row with the same picture (bumps and one-off slips are ignored).
  if (++lbStreak &lt; 3) { lbLast = "watching (" + lbStreak + " s)"; return; }
  int changed = 0;
  if (drop &lt; lbMaxDrop) {
    foreach (var w in loaded) changed += Nudge(w, -lbStep);
    lbLast = "softened " + changed + " gripping wheels"; }
  if (changed == 0) {
    foreach (var w in light) changed += Nudge(w, lbStep);
    lbLast = "stiffened " + changed + " light wheels (hull drop " + drop.ToString("0.00") + " m)"; }
}

int Nudge(Wheel w, float step) {
  float cur = w.S.Strength, next = MathHelper.Clamp(cur + step, lbMinStrength, lbMaxStrength);
  if (Math.Abs(next - cur) &lt; 0.01f) return 0;
  w.S.Strength = next; return 1;
}

void SetOverride(Wheel w, float v) {
  // Skip tiny changes, but always write an exact 0: a wheel left on a small override loses its
  // rolling friction.
  if (!float.IsNaN(w.LastOverride) &amp;&amp; Math.Abs(v - w.LastOverride) &lt; 0.01f &amp;&amp; (v != 0 || w.LastOverride == 0)) return;
  w.S.PropulsionOverride = v; w.LastOverride = v;
}

void SetFriction(Wheel w, float v) {
  if (!float.IsNaN(w.LastFriction) &amp;&amp; Math.Abs(v - w.LastFriction) &lt; 0.5f) return;
  w.S.Friction = v; w.LastFriction = v;
}

void Release() {
  foreach (var w in wheels) { if (w.Driven || w.S.PropulsionOverride != 0) SetOverride(w, 0); w.Gain = 1; RollRestore(w); }
  rollActive = false; yawTarget = 0;
  Gyros(false);
}

void SetIdle(bool on, UpdateFrequency f) {
  idle = on;
  if (Runtime.UpdateFrequency != f) Runtime.UpdateFrequency = f;
}

void Reset() {
  foreach (var w in wheels) { w.RollBase = float.NaN; float v; if (origStrength.TryGetValue(w.S.EntityId, out v)) w.S.Strength = v; }
  origStrength.Clear(); radius.Clear(); rideBase = double.NaN; geoCtrl = null;
  foreach (var w in wheels) origStrength[w.S.EntityId] = w.S.Strength;
  Save();
  lbLast = "reset";
  statusText = "Reset: strengths restored, radius and ride height forgotten.\nPark on level ground to record the ride height.";
}

void Status(string state) {
  if (steps++ % 10 != 0) return;
  echo.Clear();
  echo.Append("WitM Tank Drive v").Append(VERSION).Append(" (").Append(DATE).Append(")\n");
  echo.Append(state).Append(" | ").Append(wheels.Count).Append(" wheels, ").Append(gyros.Count).Append(" gyros\n");
  if (ctrl != null) echo.Append("Seat: ").Append(ctrl.CustomName).Append('\n');
  echo.Append("Ride height: ").Append(double.IsNaN(rideBase) ? "not recorded (park on level ground)" : rideBase.ToString("0.00") + " m").Append('\n');
  foreach (var kv in radius) echo.Append("Radius ").Append(kv.Key).Append(": ").Append(kv.Value.ToString("0.000")).Append(" m\n");
  int cut = 0; foreach (var w in wheels) if (w.Driven &amp;&amp; w.Gain &lt; 0.95) cut++;
  echo.Append("Traction: ").Append(tractionControl ? cut + " wheels held back" : "off").Append('\n');
  echo.Append("Load balancing: ").Append(loadBalancing ? lbLast : "off").Append('\n');
  echo.Append("Runtime per tick: avg ").Append(avgMs.ToString("0.0000")).Append(" ms, recent peak ").Append(maxMs.ToString("0.000")).Append(" ms\n");
  statusText = echo.ToString();
}
