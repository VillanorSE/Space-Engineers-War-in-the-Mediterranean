			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Zone-LaSpezia-6000</SubtypeId>
			</Id>
			<Description>
			[MES Zone]
			[PublicName:LaSpezia_Zone_6000]
			[Active:true]
			[Persistent:true]
			[Strict:false]
			[Coordinates:{X:7280.0 Y:-27161.11 Z:10741.33}]
			[NoSpawnZone:false]
			[Radius:6000]
			[UseZoneAnnounce:true]
			[ZoneEnterAnnounce:Entering LaSpezia Territory (6km)]
			[ZoneLeaveAnnounce:Leaving LaSpezia Territory (6km)]
			</Description>
