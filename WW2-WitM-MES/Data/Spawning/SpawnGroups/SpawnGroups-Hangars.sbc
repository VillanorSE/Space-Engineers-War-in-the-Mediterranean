<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Hangar Spawns -->
<!-- 2026-08-22: replaced the four old combined-blueprint Hangar SpawnGroups (Re2001, FC20,
     MS406, Potez630 — each its own single baked-together Hangar+Plane grid) with the
     consolidated one-shell mechanism proven working for FC20 below. Position/Behaviour for
     Re2001/MS406/Potez630 below are a first-pass copy of FC20's own final tuned values (Hangar
     unchanged at X=-7.5,Y=3.0,Z=0.0; plane at X=-7.714599609375,Y=4.885345458984375,
     Z=12.576156616210938), NOT independently verified for these planes — FC20's own position
     took 7 correction passes of in-game testing to get right, and these are physically different
     aircraft, so expect the same iterative testing/tuning to be needed here too, not a one-shot
     fix. The four old combined prefab files (NPC-WW2-Hangar-Re2001/FC20/MS406/Potez630.sbc) are
     now unused and have been deleted. -->

	<!-- Gray Re. 2001 Hangar -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Hangar-Gray-Re2001</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[PlanetaryInstallationType:Medium]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[FactionOverride:GRAY]
		[SpawnRandomCargo:true]

		[UseContainerTypeAssignment:true]
		[ContainerTypeAssignBlockName:Small Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-SmallCargo]

		[ContainerTypeAssignBlockName:Medium Cargo Container]
		[ContainerTypeAssignSubtypeId:WW2-MediumCargo]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Hangar">
				<Position>
					<X>-7.5</X>
					<Y>3.0</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Hangar-Gray</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-Re2001">
				<Position>
					<X>-7.714599609375</X>
					<Y>4.885345458984375</Y>
					<Z>12.576156616210938</Z>
				</Position>
				<Behaviour>WW2-Behavior-HangarPlane-Re2001</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

