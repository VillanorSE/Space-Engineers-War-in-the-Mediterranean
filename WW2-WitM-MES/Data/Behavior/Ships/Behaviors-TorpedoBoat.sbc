<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

	<!-- Torpedo Boat Behaviors -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-TorpedoBoat-Gray</SubtypeId>
            </Id>
			<!-- Basic Gray Cargo Ship Behavior -->
            <Description>
			
			[RivalAI Behavior]
			[BehaviorName:Nautical]
			
			[AutopilotData:WW2-Autopilot-TorpedoBoat]
			[SecondaryAutopilotData:WW2-Autopilot-TorpedoBoat-B]
			[TargetData:WW2-Targeting-ShipMain]
			
			[WeaponSystem:WW2-Weapons-TorpedoBoat]
			
			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-AggressionSwitch-Destroyer]
			[Triggers:WW2-Trigger-PassiveSwitch-Destroyer]
			[Triggers:WW2-Trigger-PassiveSwitchNoTarget-Destroyer]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-MilitaryShip-Gray]
			
			[TriggerGroups:WW2-TriggerGroup-Broadside]
			
			</Description>
        </EntityComponent>
	<!-- End Torpedo Boat Behaviors -->

	<!-- Torpedo Boat Autopilots -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-TorpedoBoat</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[DisableInertiaDampeners:false]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:0]
			[FlyLevelWithGravity:true]
			[AllowStrafing:false]
			[WaypointTolerance:50]
			[IdealMinSpeed:10]
			[IdealMaxSpeed:15]
			
			[RotationMultiplier:0.4]
			[AngleAllowedForForwardThrust:180]
			
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[WaypointWaitTimeTrigger:15]
			
			[EngageDistancePlanet:1000]
			[DisengageDistancePlanet:1500]
			
			</Description>
		</EntityComponent>
		
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-TorpedoBoat-B</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[DisableInertiaDampeners:false]
			[SlowDownOnWaypointApproach:false]
			[ExtraSlowDownDistance:0]
			[FlyLevelWithGravity:true]
			[AllowStrafing:false]
			[WaypointTolerance:50]
			[IdealMinSpeed:20]
			[IdealMaxSpeed:27.5]
			
			[RotationMultiplier:0.4]
			[AngleAllowedForForwardThrust:180]
			
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[WaypointWaitTimeTrigger:0]
			
			[EngageDistancePlanet:1000]
			[DisengageDistancePlanet:1500]
			
			</Description>
		</EntityComponent>
	<!-- End Torpedo Boat Autopilots -->

	<!-- Weapon Profile, TorpedoBoat -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Weapons-TorpedoBoat</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Weapons]
			
            [UseStaticGuns:true]
			[UseTurrets:true]
			
			[MaxStaticWeaponRange:1800]
			[WeaponMaxAngleFromTarget:6]
			[WeaponMaxBaseDistanceTarget:100]
			
			[UseBarrageFire:true]
			[MaxFireRateForBarrageWeapons:3]
			
			[UseAmmoReplenish:true]
            
			</Description>
		</EntityComponent>
<!-- End Weapon Profile -->

	</EntityComponents>
</Definitions>