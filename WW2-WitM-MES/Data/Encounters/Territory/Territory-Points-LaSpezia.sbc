<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- La Spezia Territory - Tier Thresholds
     Adapted from GVK Deserts of Kharak's Alliance TriggerGroup-ZoneSize-Faction pattern
     (Workshop 2653133286, Data/Encounters/Alliance/GVK-Alliance-TriggerGroup-ZoneSize-Faction.sbc):
     one CustomSandboxCounter (LaSpezia_Points) drives 5 Enable/Disable Timer-trigger pairs,
     one per tier above the always-active tier 1 (6km). Each pair is linked via
     ToggleWithTriggerProfile so only one side is armed at a time; the Enable side's Condition
     is GreaterOrEqual the cumulative threshold, the Disable side's is Less the same threshold.
     Cumulative thresholds locked in WW2-WitM-Territory-Design.md (200/650/1532/3100/5692),
     derived from cost(N->N+1) = 0.8 x 90 x [Area(tier N+1)/Area(tier 1)].

     Unlike GVK (which resizes one shared zone via ZoneRadiusChangeType:Set), this project has
     all 6 radii pre-built as separate always-defined [MES Zone] entities per anchor
     (Territory-Zones.sbc), so the enable/disable Actions only need ZoneToggleActiveMode - no
     radius-set required.

     TriggerGroup must be added to WW2-Behavior-Port-Gray-LaSpezia's [Triggers:...] list
     (Behaviors-Port.sbc) to actually run - see that file's edit alongside this one. -->

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-TriggerGroup-ZoneSize-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI TriggerGroup]

			[Triggers:WW2-Territory-Trigger-EnableZone10000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-DisableZone10000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-EnableZone15000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-DisableZone15000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-EnableZone21000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-DisableZone21000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-EnableZone28000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-DisableZone28000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-EnableZone36000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-DisableZone36000-LaSpezia]
			[Triggers:WW2-Territory-Trigger-PointsFloor-LaSpezia]
			[Triggers:WW2-Territory-Trigger-PointsCeiling-LaSpezia]

			</Description>
		</EntityComponent>

<!-- Tier 2 - 10km @ 200 points -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-EnableZone10000-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:WW2-Territory-Action-EnableZone10000-LaSpezia]
			[Conditions:WW2-Territory-Condition-EnableZone10000-LaSpezia]
			[ConditionCheckResetsTimer:true]
			[ToggleWithTriggerProfile:WW2-Territory-Trigger-DisableZone10000-LaSpezia]
			[ToggledProfileResetsCooldown:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-EnableZone10000-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:LaSpezia_Points]
			[CustomSandboxCountersTargets:200]
			[SandboxCounterCompareTypes:GreaterOrEqual]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Trigger-DisableZone10000-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:10000]
			[MaxCooldownMs:10001]
			[StartsReady:false]
			[MaxActions:-1]
			[Actions:WW2-Territory-Action-DisableZone10000-LaSpezia]
			[Conditions:WW2-Territory-Condition-DisableZone10000-LaSpezia]
			[ConditionCheckResetsTimer:true]
			[ToggleWithTriggerProfile:WW2-Territory-Trigger-EnableZone10000-LaSpezia]
			[ToggledProfileResetsCooldown:true]

			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Condition-DisableZone10000-LaSpezia</SubtypeId>
			</Id>
			<Description>

			[RivalAI Condition]
			[UseConditions:true]
			[MatchAnyCondition:false]
			[CheckCustomSandboxCounters:true]
			[CustomSandboxCounters:LaSpezia_Points]
			[CustomSandboxCountersTargets:200]
			[SandboxCounterCompareTypes:Less]

			</Description>
		</EntityComponent>

