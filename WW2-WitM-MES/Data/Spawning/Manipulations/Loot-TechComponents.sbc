<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<!-- Loot Profiles for the size-tiered salvage pools (see ContainerTypes-TechComponents.sbc),
     each paired with a role-appropriate secondary pool: combat tiers (Small/Medium-Combat/
     Large/Huge) mix in ammo (WW2-ContainerTypes-BasicAmmo-1/2/3, already built for
     WW2-Loot-BasicContainers/-AmmoDepot but not previously used here), while the cargo variant
     (Medium-Cargo, for CargoPlanes/CargoShips-Nautical) mixes in general components
     (WW2-SmallCargo/WW2-MediumCargo, already built for Hangars/Factories but not previously used
     on actual cargo grids despite ContainerTypes-BasicCargo.sbc's own header comment saying they
     were meant for Cargo Planes).
     Each tier's own salvage ContainerType is listed twice against the secondary pool's one
     listing, so salvage stays the more likely of the two per claimed slot without the secondary
     pool being vanishingly rare; MinBlocks/MaxBlocks raised to 2-3 (from the old flat 1) so both
     kinds of content have a real chance of showing up together, not just one or the other.
     Same additive-layer pattern as before - list before the SpawnGroup's own base loot profile. -->

	<EntityComponents>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Loot-Small</SubtypeId>
			</Id>
			<Description>

			[MES Loot]

			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]

			[ContainerTypes:WW2-ContainerTypes-Loot-Small]
			[ContainerTypes:WW2-ContainerTypes-Loot-Small]
			[ContainerTypes:WW2-ContainerTypes-BasicAmmo-1]

			[MinBlocks:2]
			[MaxBlocks:3]

			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Loot-Medium</SubtypeId>
			</Id>
			<Description>

			[MES Loot]

			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]

			[ContainerTypes:WW2-ContainerTypes-Loot-Medium]
			[ContainerTypes:WW2-ContainerTypes-Loot-Medium]
			[ContainerTypes:WW2-ContainerTypes-BasicAmmo-2]

			[MinBlocks:2]
			[MaxBlocks:3]

			</Description>
		</EntityComponent>

		<!-- Cargo-flavored Medium tier: same salvage pool as combat Medium, but general
		     components instead of ammo - CargoPlanes/CargoShips-Nautical use this instead of
		     the combat WW2-Loot-Medium above. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Loot-Medium-Cargo</SubtypeId>
			</Id>
			<Description>

			[MES Loot]

			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]

			[ContainerTypes:WW2-ContainerTypes-Loot-Medium]
			[ContainerTypes:WW2-ContainerTypes-Loot-Medium]
			[ContainerTypes:WW2-SmallCargo]
			[ContainerTypes:WW2-MediumCargo]

			[MinBlocks:2]
			[MaxBlocks:4]

			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Loot-Large</SubtypeId>
			</Id>
			<Description>

			[MES Loot]

			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]

			[ContainerTypes:WW2-ContainerTypes-Loot-Large]
			[ContainerTypes:WW2-ContainerTypes-Loot-Large]
			[ContainerTypes:WW2-ContainerTypes-BasicAmmo-2]
			[ContainerTypes:WW2-ContainerTypes-BasicAmmo-3]

			[MinBlocks:2]
			[MaxBlocks:4]

			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Loot-Huge</SubtypeId>
			</Id>
			<Description>

			[MES Loot]

			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockMediumContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/SmallBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockSmallContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeContainer]
			[ContainerBlockTypes:MyObjectBuilder_CargoContainer/LargeBlockLargeIndustrialContainer]

			[ContainerTypes:WW2-ContainerTypes-Loot-Huge]
			[ContainerTypes:WW2-ContainerTypes-Loot-Huge]
			[ContainerTypes:WW2-ContainerTypes-BasicAmmo-3]
			[ContainerTypes:WW2-ContainerTypes-BasicAmmo-3]

			[MinBlocks:3]
			[MaxBlocks:5]

			</Description>
		</EntityComponent>

	</EntityComponents>
</Definitions>
