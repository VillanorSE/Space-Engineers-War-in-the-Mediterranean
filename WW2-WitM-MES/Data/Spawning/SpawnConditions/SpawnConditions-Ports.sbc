	<!-- 2026-09-10: Valencia, neutral trade post (TRADER faction, no combat). Real placement
	     vectors below, captured via MES's own grid-info chat command once the prefab was built
	     and placed in-game (StaticEncounterPlanetDirection/Altitude for the dynamic-planet mode,
	     matching the 4 real ports' own convention; Forward/Up shared with the raw-coords form). -->
	<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
		<Id>
			<TypeId>Inventory</TypeId>
			<SubtypeId>WW2-SpawnConditions-Port-Valencia</SubtypeId>
		</Id>
		<Description>
			[MES Spawn Conditions]

			[StaticEncounter:true]
			[StaticEncounterUsePlanetDirectionAndAltitude:true]
			[StaticEncounterPlanet:WW2WitM_Mediterranean]
