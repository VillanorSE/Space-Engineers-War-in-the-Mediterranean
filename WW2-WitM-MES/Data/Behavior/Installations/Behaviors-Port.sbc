<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Port installations are static, invulnerable, uneditable buildings (see SpawnGroups-Ports.sbc)
     - they don't patrol or produce anything, so unlike the Factory behaviors these only run the
     Store-sales triggers plus a defensive plane scramble.
     One Behavior per port (not one shared Behavior per faction): each port also runs its own
     Triggers-CargoSpawn-Port.sbc trigger, and paired ports (La Spezia/Tripoli, Oran/Toulon) need
     DIFFERENT one-directional cargo routes, which a shared Behavior can't hold.
     Each port runs TWO Store-sales triggers targeting two separate physical Store blocks: a
     shared WW2-Store-Trigger-UpdateSales-PortGoods (identical everywhere, targets the
     "Store-Port-Goods" block) plus a faction-specific WW2-Store-Trigger-UpdateSales-Vehicles-
     Gray/Green (targets the "Store-Port-Vehicles" block). See WW2-Store-Behavior-PortSales.sbc
     and Triggers-DefensiveSpawn-Port.sbc for the trigger/action pairs. -->

<!-- Gray -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Port-Gray-LaSpezia</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Store-Trigger-UpdateSales-PortGoods]
			[Triggers:WW2-Store-Trigger-UpdateSales-Vehicles-Gray]
			[Triggers:WW2-Trigger-DefenseSpawn-Port-Gray]
			[Triggers:WW2-Trigger-CargoSpawn-Port-LaSpezia]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Port-Gray-Tripoli</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Store-Trigger-UpdateSales-PortGoods]
			[Triggers:WW2-Store-Trigger-UpdateSales-Vehicles-Gray]
			[Triggers:WW2-Trigger-DefenseSpawn-Port-Gray]
			[Triggers:WW2-Trigger-CargoSpawn-Port-Tripoli]

			</Description>
        </EntityComponent>

<!-- Green -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Port-Green-Oran</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Store-Trigger-UpdateSales-PortGoods]
			[Triggers:WW2-Store-Trigger-UpdateSales-Vehicles-Green]
			[Triggers:WW2-Trigger-DefenseSpawn-Port-Green]
			[Triggers:WW2-Trigger-CargoSpawn-Port-Oran]

			</Description>
        </EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Port-Green-Toulon</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Store-Trigger-UpdateSales-PortGoods]
			[Triggers:WW2-Store-Trigger-UpdateSales-Vehicles-Green]
			[Triggers:WW2-Trigger-DefenseSpawn-Port-Green]
			[Triggers:WW2-Trigger-CargoSpawn-Port-Toulon]

			</Description>
        </EntityComponent>

<!-- Valencia (neutral, TRADER faction) - deliberately NO reputation-damage trigger and NO
     defensive-scramble trigger, unlike every Gray/Green port above. This is what actually
     guarantees standing here can never go hostile (see Factions.sbc's own note) and keeps the
     post genuinely non-combative - it just sells. No cargo-spawn trigger either since Valencia
     doesn't run a cargo-ship route to another port. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-Port-Valencia</SubtypeId>
            </Id>
            <Description>
			[RivalAI Behavior]
			[BehaviorName:Passive]

			[Triggers:WW2-Store-Trigger-UpdateSales-PortGoods]
			[Triggers:WW2-Store-Trigger-UpdateSales-Vehicles-Valencia]

			</Description>
        </EntityComponent>

	</EntityComponents>
</Definitions>
