			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:TruckRaid-Green]
			[ForceManualTriggerActivation:false]
			[UseChatBroadcast:true]
			[ChatData:WW2-Chat-ConvoyRaid]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Convoy-Trigger-Raid-Low-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:TruckRaid-Green]
			[StartsReady:true]
