<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Territory gate: dynamic SpawnGroups add [PersistentConditions:WW2-SpawnConditions-Territory-{Gray|Green}]. -->
