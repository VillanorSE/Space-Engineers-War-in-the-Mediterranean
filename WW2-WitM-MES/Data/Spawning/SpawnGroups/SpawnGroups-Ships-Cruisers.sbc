				</Position>
				<Behaviour>WW2-Behavior-Cruiser-Green</Behaviour>
				<Speed>12.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>
<!-- End Green Algerie Heavy Cruiser -->

	</SpawnGroups>
</Definitions>
