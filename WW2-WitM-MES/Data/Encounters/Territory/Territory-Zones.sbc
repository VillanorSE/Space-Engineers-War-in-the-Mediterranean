<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<EntityComponents>

<!-- Territory zones for the 6 primary domain anchors.
     One resizable [MES Zone] per anchor (not 6 nested rings) - confirmed via MES source
     (Helpers/Enums.cs, ModifierEnum: None/Set/Add/Subtract/Multiply/Divide) that a live zone's
     radius can be grown/shrunk in place via ZoneRadiusChangeType:Add/Subtract, so a single zone
     per anchor is sufficient. Starts at tier 1 (5km), grows in 5km steps up to tier 7 (35km) via
     the Grow/Shrink triggers in Triggers-Zone-Change.sbc (WW2-WitM-MES/Data/Behavior/Triggers/
     Ports/), driven by each anchor's own CustomSandboxCounter. Math and thresholds locked in
     WW2-WitM-Territory-WarLevel-Design.md.

     Anchor coordinates: La Spezia/Toulon/Oran/Tripoli/Alexandria are real GPS, derived from
     each port's own SpawnConditions-Ports.sbc StaticEncounterPlanetDirection/Altitude
     (direction * (30101.5 + altitude), matching build_territory_layer.py's confirmed real
     deployed planet radius). Rome's coordinate WAS derived from the same real-world-city
     lat/lon estimate (41.9028, 12.4964) used throughout the rest of this project's city
     placements, on the assumption that projection would land it near Civitavecchia (its real
     port) - it didn't: that math put it ~33.3km from Civitavecchia on a planet only ~60km in
     diameter, meaning the lat/lon-to-planet-position conversion used for Rome disagrees badly
     with the StaticEncounterPlanetDirection system the real ports use. Confirmed wrong and
     replaced with an in-game-verified GPS point (~3.6km from Civitavecchia, matching the real
     Rome/Civitavecchia relationship) instead of re-deriving from lat/lon. If any other city
     placement in this project used the same lat/lon conversion as Rome originally did, it's
     worth spot-checking those too. -->

<!-- La Spezia (Gray) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Territory-Zone-LaSpezia</SubtypeId>
			</Id>
			<Description>
			[MES Zone]
			[PublicName:LaSpezia_Zone]
			[Active:true]
			[Persistent:true]
			[Strict:false]
			[Coordinates:{X:7280.0 Y:-27161.11 Z:10741.33}]
			[NoSpawnZone:false]
			[Radius:5000]
			[UseZoneAnnounce:true]
			[ZoneEnterAnnounce:Entering La Spezia Territory]
			[ZoneLeaveAnnounce:Leaving La Spezia Territory]
			</Description>
		</EntityComponent>

