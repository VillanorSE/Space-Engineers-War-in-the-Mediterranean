<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Factions>

<!-- GRAY/GREEN StaticReputation true to prevent basic damaging mechanics from changing reputation.
	 Reputation should be further changed by combat-triggered reputation system (see WW2-WitM-Roadmap.md's
	 Reputation section). TRADER sets StaticReputation:true + StartingReputation:500 so it stays 
	 permanently Friendly/neutral-safe. FactionIcon paths below are vanilla Builder-icon placeholders; 
	 swap for the Italian flag (GRAY), French flag (GREEN), and Spanish flag (TRADER) once real art exists. -->

    <Faction Tag="GRAY" Founder="The Dictator">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Gray</SubtypeId>
      </Id>
      <DisplayName>The Gray</DisplayName>
	  <Description>The Gray are an alliance of several entities intent on expanding their territory even if that means violence.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Enemies</DefaultRelation>
	  <DefaultRelationToPlayers>Neutral</DefaultRelationToPlayers>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
	  <StartingBalance>1000000000</StartingBalance>
	  <Type>Builder</Type>
	  <DiscoveredByDefault>true</DiscoveredByDefault>
	  <StaticReputation>true</StaticReputation>
	  <EnableFriendlyFire>false</EnableFriendlyFire>
	  <StartingReputation>-600</StartingReputation>
	  <FactionIcon>Textures\FactionLogo\Builders\BuilderIcon_1.dds</FactionIcon>
	  <BackgroundColor R="0" G="0" B="0" />
	  <IconColor R="255" G="255" B="255" />

    </Faction>

	<Faction Tag="GREEN" Founder="The Statesman">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Green</SubtypeId>
      </Id>
      <DisplayName>The Green</DisplayName>
	  <Description>The Green are an alliance of numerous entities intent on containing The Gray. They are prepared to fight any who fight them.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Enemies</DefaultRelation>
	  <DefaultRelationToPlayers>Neutral</DefaultRelationToPlayers>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
	  <StartingBalance>1000000000</StartingBalance>
	  <Type>Builder</Type>
	  <DiscoveredByDefault>true</DiscoveredByDefault>
	  <StaticReputation>true</StaticReputation>
	  <EnableFriendlyFire>false</EnableFriendlyFire>
	  <StartingReputation>-600</StartingReputation>
	  <FactionIcon>Textures\FactionLogo\Builders\BuilderIcon_2.dds</FactionIcon>
	  <BackgroundColor R="0" G="0" B="0" />
	  <IconColor R="255" G="255" B="255" />

    </Faction>

<!-- Neutral trade post faction, represented by the port of Valencia in game. DefaultRelation:Neutral 
	 (not Friends) so it matches vanilla's actual Neutral behavior and won't have automatic turret
	 hostility toward either primary faction, and reputation with this faction is never touched 
	 by any WW2-Trigger-ReputationDamage* trigger anywhere in this mod (those are only ever attached
	 to Gray/Green assets). -->
	<Faction Tag="TRADER" Founder="The Trader">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Trader</SubtypeId>
      </Id>
      <DisplayName>Traders</DisplayName>
	  <Description>A neutral tred group, not aligned with either Gray or Green, running a neutral trade post open to all comers.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Neutral</DefaultRelation>
	  <DefaultRelationToPlayers>Neutral</DefaultRelationToPlayers>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
	  <StartingBalance>1000000000000</StartingBalance>
	  <Type>Trader</Type>
	  <DiscoveredByDefault>true</DiscoveredByDefault>
	  <StaticReputation>true</StaticReputation>
	  <EnableFriendlyFire>false</EnableFriendlyFire>
	  <StartingReputation>500</StartingReputation>
	  <FactionIcon>Textures\FactionLogo\Builders\BuilderIcon_3.dds</FactionIcon>
	  <BackgroundColor R="0" G="0" B="0" />
	  <IconColor R="255" G="255" B="255" />

    </Faction>

<!-- Unowned secondary-installation faction. Same neutral/passive pattern as TRADER
	 (DefaultRelation:Neutral, StaticReputation:true so it can never be dragged into
	 hostility by a reputation-damage trigger.) Used for secondary installations (airfields,
     vehicle depots, garrisons) before territory ownership has claimed them. Once ownership
     logic reassigns a grid to GRAY or GREEN, its FactionOverride changes away from this. -->
	<Faction Tag="UNOWNED" Founder="Unclaimed">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>WW2-Unowned</SubtypeId>
      </Id>
      <DisplayName>Unowned</DisplayName>
	  <Description>Secondary installations not yet claimed by either faction's territory. Passive, no reputation stake, no automatic hostility.</Description>
      <IsDefault>true</IsDefault>
	  <DefaultRelation>Neutral</DefaultRelation>
	  <DefaultRelationToPlayers>Neutral</DefaultRelationToPlayers>
	  <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
	  <StartingBalance>1000000000</StartingBalance>
	  <Type>Builder</Type>
	  <DiscoveredByDefault>true</DiscoveredByDefault>
	  <StaticReputation>true</StaticReputation>
	  <EnableFriendlyFire>false</EnableFriendlyFire>
	  <StartingReputation>500</StartingReputation>
	  <FactionIcon>Textures\FactionLogo\Builders\BuilderIcon_1.dds</FactionIcon>
	  <BackgroundColor R="0" G="0" B="0" />
	  <IconColor R="255" G="255" B="255" />

    </Faction>

  
<!-- Vanilla factions overridden so they are not created in the scenario (IsDefault false, not discovered).
     Same pattern as the GVK server's factions.sbc. -->
	<Faction Tag="SPRT" Founder="Space Pirates">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>SpacePirates</SubtypeId>
      </Id>
      <DisplayName>DisplayName_Faction_SpacePirates</DisplayName>
      <IsDefault>false</IsDefault>
      <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
      <StartingBalance>100000000</StartingBalance>
      <DiscoveredByDefault>false</DiscoveredByDefault>
      <Type>Pirate</Type>
      <FactionIcon>Textures\FactionLogo\PirateIcon.dds</FactionIcon>
      <Description>Description_Faction_Pirate</Description>
    </Faction>

	<Faction Tag="FCTM" Founder="The Factorum">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>Factorum</SubtypeId>
      </Id>
      <DisplayName>DisplayName_Faction_Factorum</DisplayName>
      <IsDefault>false</IsDefault>
      <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
      <StartingBalance>0</StartingBalance>
      <Type>None</Type>
      <DiscoveredByDefault>false</DiscoveredByDefault>
      <FactionIcon>Textures\FactionLogo\Factorum.dds</FactionIcon>
      <StaticReputation>true</StaticReputation>
      <StartingReputation>-1500</StartingReputation>
      <Description>Description_Faction_Factorum</Description>
      <BackgroundColor R="0" G="0" B="0" />
      <IconColor R="255" G="255" B="255" />
    </Faction>

	<!-- Not in Mike's list; added because the scenario should only have GRAY, GREEN, TRADER and UNOWNED. Remove if the game objects. -->
	<Faction Tag="UNKN" Founder="Unknown">
      <Id>
        <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
        <SubtypeId>Unknown</SubtypeId>
      </Id>
      <DisplayName>DisplayName_Faction_Unknown</DisplayName>
      <IsDefault>false</IsDefault>
      <AcceptHumans>false</AcceptHumans>
      <AutoAcceptMember>false</AutoAcceptMember>
      <StartingBalance>0</StartingBalance>
      <Type>None</Type>
      <DiscoveredByDefault>false</DiscoveredByDefault>
      <FactionIcon>Textures\FactionLogo\Unknown.dds</FactionIcon>
      <StaticReputation>true</StaticReputation>
      <StartingReputation>0</StartingReputation>
      <Description>Description_Faction_Unknown</Description>
      <BackgroundColor R="0" G="0" B="0" />
      <IconColor R="255" G="255" B="255" />
    </Faction>

  </Factions>
</Definitions>
