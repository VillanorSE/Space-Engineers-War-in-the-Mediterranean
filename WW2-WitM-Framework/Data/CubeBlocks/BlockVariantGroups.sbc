<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <!--
         WW2 Encounters: scroll-wheel variant groups for the Ship Core blocks,
         matching how vanilla armor blocks let you cycle between Cube, Slope,
         Corner, etc. without reopening the G-menu.

         Grouped by domain (Naval, Air, Ground, Installations), matching how the
         Roadmap organizes the roster tables. This is an organizational choice,
         not a mechanical requirement. Confirmed via Arcane Cores' own file that
         a single group can mix Large and Small grid blocks (their "Warship
         Cores" group has both), so a different grouping such as civilian versus
         military across domains would work exactly as well if preferred.

         Block Type values are "MyObjectBuilder_" plus the block's own TypeId
         from CubeBlocks_ShipCores.sbc (FunctionalBlock), confirmed against
         Arcane Cores' own BlockVariantGroups.sbc using the same pattern for
         their FunctionalBlock cores.

         Icons are placeholder reuse of the RC icon pending final art, same
         caveat as the block definitions themselves.
    -->
    <BlockVariantGroups>
        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="WW2-Core-Naval" />
            <Icon>Textures\GUI\Icons\Cubes\RemoteControl.dds</Icon>
            <DisplayName>Naval Cores</DisplayName>
            <Description>Ship Cores for Naval hulls: Civilian, Corvette, and Destroyer tier.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Naval-Utility" />
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Naval-Corvette" />
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Naval-Destroyer" />
            </Blocks>
        </BlockVariantGroup>

        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="WW2-Core-Air" />
            <Icon>Textures\GUI\Icons\Cubes\RemoteControl.dds</Icon>
            <DisplayName>Air Cores</DisplayName>
            <Description>Ship Cores for aircraft: Civilian, Fighter, Attacker, and Bomber tier.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Air-Utility" />
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Air-Fighter" />
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Air-Attacker" />
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Air-Bomber" />
            </Blocks>
        </BlockVariantGroup>

        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="WW2-Core-Wheeled" />
            <Icon>Textures\GUI\Icons\Cubes\RemoteControl.dds</Icon>
            <DisplayName>Ground Cores</DisplayName>
            <Description>Ship Cores for ground vehicles: Civilian and Armored Car tier.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Wheeled-Utility" />
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Wheeled-ArmoredCar" />
            </Blocks>
        </BlockVariantGroup>

        <BlockVariantGroup>
            <Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="WW2-Core-Installations" />
            <Icon>Textures\GUI\Icons\Cubes\RemoteControl.dds</Icon>
            <DisplayName>Installation Cores</DisplayName>
            <Description>Ship Cores for static installations: Base and Outpost.</Description>
            <Blocks>
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Base" />
                <Block Type="MyObjectBuilder_FunctionalBlock" Subtype="WW2-Core-Outpost" />
            </Blocks>
        </BlockVariantGroup>
    </BlockVariantGroups>
</Definitions>
