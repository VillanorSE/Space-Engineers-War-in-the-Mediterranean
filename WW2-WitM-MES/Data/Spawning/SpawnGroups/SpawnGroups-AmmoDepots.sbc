<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Ammo Depo Spawns -->
	<!-- Gray Ammo Depot -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>NPC-WW2-Ammo-Depot-Gray</SubtypeId>
		</Id>
		<Description>
		
		[Modular Encounters SpawnGroup]
	
		[PlanetaryInstallationType:Medium]
		
		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-AmmoDepots]
		
		[FactionOverride:GRAY]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Ammo-Depot">
 				<Position>
					<X>0.0</X>
					<Y>7.5</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Ammo-Depot-Gray</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

	
	<!-- Green Ammo Depot -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>NPC-WW2-Ammo-Depot-Green</SubtypeId>
		</Id>
		<Description>
		
		[Modular Encounters SpawnGroup]
	
		[PlanetaryInstallationType:Medium]
		
		[SpawnConditionsProfiles:WW2-SpawnConditions-Installations]
		[ManipulationProfiles:MES-Manipulation-RivalAi]
		[ManipulationProfiles:WW2-Manipulation-AmmoDepots]
		
		
		[FactionOverride:GREEN]
		
		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Ammo-Depot">
 				<Position>
					<X>0.0</X>
					<Y>7.5</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Ammo-Depot-Green</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

<!-- End Ammo Depot Spawns -->

	</SpawnGroups>
</Definitions>

