<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Garage Spawns. Standard placement (D-064): each building's floor top is 1.0 m above its ground point (building Y 2.45);
     a vehicle's Y is 1.0 + its height above the floor (box centre + at least 0.5 m, 0.5 steps): AB41 4.0, AB43 2.5,
     M13/40 2.0, Panhard 2.0, R35 2.5, Somua 3.0, Fiat 626 4.0, Renault AHN 4.0. X/Z put each vehicle's box centre on the slot
     (it turns about its driver seat). Each faction's garages weigh 0.5 + 0.5 = 1.0 in every War Level band. -->

<!-- Gray Garage 1 (barn, one gate), War Level 1: one of AB41. -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Garage1-Gray-WL1</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Garage1-WL1]
		[PersistentConditions:WW2-SpawnConditions-Territory-Gray]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[FactionOverride:GRAY]
		[SpawnRandomCargo:true]

		</Description>
		<Frequency>0.5</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Garage1">
				<Position>
					<X>2.0</X>
					<Y>2.45</Y>
					<Z>0.0</Z>
				</Position>
				<Behaviour>WW2-Behavior-HangarGarage-Gray</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
			<Prefab SubtypeId="Player-WW2-AB41">
				<Position>
					<X>0.0</X>
					<Y>5.0</Y>
					<Z>12.5</Z>
				</Position>
				<Behaviour>WW2-Behavior-GarageVehicle-AB41</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>
