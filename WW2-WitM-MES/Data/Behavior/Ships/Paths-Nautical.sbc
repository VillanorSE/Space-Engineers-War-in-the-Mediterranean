<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

	<!-- Nautical Paths - CargoShip
	     Fixed point-to-point routes for CargoShip ("Nautical") behavior NPCs, using MES's
	     native [CustomWaypoints:X:Y:Z,X:Y:Z,...] Behavior tag (RivalAI CargoShip subclass).
	     This seeds the ship's full ordered waypoint queue at spawn - it flies each point in
	     order, then despawns after the last one. It replaces (does not add to) the default
	     "AddWaypoints on DestinationReached" random-destination pattern used by the plain
	     WW2-Behavior-CargoShip-Gray/Green behaviors, so a ship using one of these Behaviors
	     is committed to this route only.

	     Bi-directional = two separate Behaviors, one per direction (the waypoint list simply
	     reversed) - CustomWaypoints has no native "loop back" once the queue is emptied. -->

	<!-- La Spezia -> Tripoli -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-CargoShip-Gray-LaSpezia-Tripoli</SubtypeId>
            </Id>
            <Description>

			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			[TriggerGroups:WW2-Points-Group-Gray-UtilityNaval]
			[Triggers:WW2-Territory-Trigger-Delivery-Gray-LaSpezia-Tripoli]

			[AutopilotData:WW2-Autopilot-CargoShip]
			[TargetData:WW2-Targeting-ShipMain]

			[WeaponSystem:WW2-Weapons-CargoShip]

			[CustomWaypoints:7219.22:-27130.26:10854.68,9243.59:-23021.01:17047.34,9335.38:-20832.01:19618.71,3347.94:-1599.76:29871.67,3562.77:8725.65:28586.94,-3660.24:20482.92:21751.4,-3313.06:20680.14:21624.19]

			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-CargoDamage]
			[Triggers:WW2-Trigger-FriendlyNear-Cargo]
			[Triggers:WW2-Trigger-HostileNear-Cargo]
			[Triggers:WW2-Trigger-BotCrew-3]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-Ship-Gray]
			[Triggers:WW2-Territory-Trigger-CargoShip-RouteArrived]
			[Triggers:WW2-Territory-Trigger-CargoShip-UnloadTimer]

			</Description>
        </EntityComponent>

	<!-- Tripoli -> La Spezia -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
