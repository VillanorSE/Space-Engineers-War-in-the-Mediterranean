				<SubtypeId>WW2-Depot-Spawn-Patrol-WL5-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Spawn]
			[UseSpawn:true]
			[StartsReady:true]
			[SpawningType:CustomSpawn]
			[SpawnGroups:WW2-DepotUnit-Patrol-WL5-Green]
			[UseRelativeSpawnPosition:true]
			[RelativeSpawnOffset:{X:0 Y:4.5 Z:-60}]
			[IgnoreSafetyChecks:false]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Chat-Defense-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Chat]
			[UseChat:true]
			[StartsReady:true]
			[MaxChats:-1]
			[BroadcastRandomly:true]
			[Author:Commandement du Dépôt]
			[Color:Red]
			[IgnoreAntennaRequirement:true]
			[IgnoredAntennaRangeOverride:3000]

			[ChatMessages:Enemy near the depot. Armour, roll out!]
			[ChatAudio:ArcHudGPSNotification1]
			[BroadcastChatType:Chat]
			</Description>
		</EntityComponent>
<!-- Garage bay (Green): one of the holder's vehicles parked in the garage, every two hours while a player is near, only if the bay is empty. The check clears GarageBayOccupied and arms GarageBayCheck; a parked bay vehicle pings the depot every 60 s (WitM-GarageBayOccupied), which sets it again, so the check spawns only if no ping came in 90 s. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBay-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:PlayerNear]
			[TargetDistance:1500]
			[MinCooldownMs:7200000]
			[MaxCooldownMs:7200001]
			[StartsReady:true]
			[MaxActions:-1]
			[Actions:WW2-Depot-Action-GarageBay-Green]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-GarageBay-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[SetBooleansFalse:GarageBayOccupied]
			[EnableTriggers:true]
			[EnableTriggerNames:WW2-Depot-Trigger-GarageBayCheck-Green]
			[ResetCooldownTimeOfTriggers:true]
			[ResetTriggerCooldownNames:WW2-Depot-Trigger-GarageBayCheck-Green]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBayCheck-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:false]
			[Type:Timer]
			[MinCooldownMs:90000]
			[MaxCooldownMs:90001]
			[StartsReady:false]
			[MaxActions:-1]
			[Conditions:WW2-Depot-Condition-GarageBayEmpty]
			[Actions:WW2-Depot-Action-GarageBaySpawn-Green]
			</Description>
		</EntityComponent>
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Action-GarageBaySpawn-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Action]
			[ManuallyActivateTrigger:true]
			[ManuallyActivatedTriggerTags:DepotGarageBay-Green]
			[ForceManualTriggerActivation:false]
			[DisableTriggers:true]
			[DisableTriggerNames:WW2-Depot-Trigger-GarageBayCheck-Green]
			</Description>
		</EntityComponent>
<!-- Garage bay (Green) by War Level: the band picks the spawn group (WL1 = else of the next band's condition); each group draws one vehicle at random from that War Level and below. -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Depot-Trigger-GarageBay-WL1-Green</SubtypeId>
			</Id>
			<Description>
			[RivalAI Trigger]
			[UseTrigger:true]
			[Type:Manual]
			[Tags:DepotGarageBay-Green]
			[StartsReady:true]
			[MaxActions:-1]
			[Conditions:WW2-WarLevel-Condition-AtLeast2]
			[UseElseActions:true]
			[ElseActions:WW2-Depot-Action-GarageBay-WL1-Green]
