<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<SpawnGroups>

<!-- Port Installations (Static Encounters)
     The 5 port installations spawn once at their exact current in-game position/orientation and
     never again - see SpawnConditions-Ports.sbc for the [StaticEncounter] tags.
     [GridsAreEditable:false] and [GridsAreDestructable:false] are MES Manipulation tags placed
     directly in the SpawnGroup (Manipulation tags are valid inline in SpawnGroup Description, no
     separate Manipulation Profile needed) - makes each port immune to weapon/collision damage
     and to welding/grinding/block edits, on top of MES-Manipulation-RivalAi's usual AI setup.
     Behaviour references one Behavior per port (Behaviors-Port.sbc, e.g. WW2-Behavior-Port-Gray-
     LaSpezia), not a single shared per-faction Behavior, so each port can run its own
     direction-specific cargo spawn (see Triggers-CargoSpawn-Port.sbc) alongside the
     shared Store-sales and defensive-scramble triggers.

     2026-09-07: briefly swapped to [InitializeStoreBlocks:true] on a wrong diagnosis that MES's
     ApplyStoreProfiles action was itself crashing the client on Store Block interact. Reverted -
     the real crash (confirmed via log: NullReferenceException in
     Sandbox.Game.Screens.ViewModels.MyMarketWatchViewModel, thrown the instant any Store Block
     UI opens) is caused by <EnableEconomy>false</EnableEconomy> in this world's
     Sandbox_config.sbc, unrelated to MES entirely. Confirmed by reading GV Deserts of Kharak's
     own GVK-Derelicts mod (Workshop 2653133286): it uses this exact ApplyStoreProfiles/
     RequiredOffers mechanism successfully on a fully custom, MES-heavy planet with Economy
     enabled - see WW2-Store-Behavior-PortSales.sbc, restored to its original working form. Real
     fix in progress: enabling Economy properly on this world needs BOTH <EnableEconomy> in
     Sandbox_config.sbc AND <GenerateFactionsOnStart> in Sandbox.sbc's SessionComponentEconomy
     block for an EXISTING save (per the MES Economy-Stations-FAQ) - only the first flag was
     tested so far and hung on load; untested with both flags set together. -->

	<!-- Gray La Spezia Port -->
	<SpawnGroup>
		<Id>
			<TypeId>SpawnGroupDefinition</TypeId>
			<SubtypeId>WW2-Port-LaSpezia</SubtypeId>
		</Id>
		<Description>

		[Modular Encounters SpawnGroup]

		[SpawnConditionsProfiles:WW2-SpawnConditions-Port-LaSpezia]
		[ManipulationProfiles:MES-Manipulation-RivalAi]

		[GridsAreEditable:false]
		[GridsAreDestructable:false]
		[IgnoreCleanupRules:true]

		[FactionOverride:GRAY]

		</Description>
		<Frequency>1.0</Frequency>
		<IsPirate>true</IsPirate>
		<Prefabs>
			<Prefab SubtypeId="NPC-WW2-Port_LaSpezia">
				<Position>
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
				</Position>
				<Behaviour>WW2-Behavior-Port-Gray-LaSpezia</Behaviour>
				<Speed>0.0</Speed>
			</Prefab>
		</Prefabs>
	</SpawnGroup>

