<?xml version="1.0" encoding="utf-8" ?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <EntityComponents>

<!-- Cargo Plane Behaviors -->
	<!-- Basic Gray Cargo Plane Behavior, has slots for two escorts (unused) -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-CargoPlane-Gray</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			
			[AutopilotData:WW2-Autopilot-CargoPlane-Cruising]
			[SecondaryAutopilotData:WW2-Autopilot-CargoPlane-Destination]
			
			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-ProcessEscortRequest]

			[Triggers:WW2-Trigger-CargoDamage]
			[Triggers:WW2-Trigger-ReputationDamageLight-Gray]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-Plane-Gray]
			
			[Triggers:WW2-Trigger-CargoPlane-Recirculate]
			[Triggers:WW2-Trigger-CargoPlane-LoiterTimer]
			[Triggers:WW2-Trigger-CargoPlane-DespawnCheck]
			[Triggers:WW2-Trigger-CargoPlane-EngagedByPlayer]
			[Triggers:WW2-Trigger-CargoPlane-EngagementCooldown]
			
			[Triggers:WW2-Trigger-CargoPlane-Destination]
			[Triggers:WW2-Trigger-CargoPlane-DestinationReached]
			[Triggers:WW2-Trigger-FriendlyNear-Cargo]
			[Triggers:WW2-Trigger-HostileNear-Cargo]
			[Triggers:WW2-Trigger-DefenseSpawn1-Gray]
			
			[Triggers:WW2-Trigger-Crash-Air]
			[Triggers:WW2-Trigger-Compromised-Air]
			[Triggers:WW2-Trigger-StopCrash-Air]
			
			[EscortOffsets:{X:-100 Y:0 Z:0}]
			[EscortOffsets:{X:100 Y:0 Z:0}]
			
			</Description>
        </EntityComponent>

	<!-- Basic Green Cargo Plane Behavior, has slots for two escorts (unused) -->
        <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
            <Id>
                <TypeId>Inventory</TypeId>
                <SubtypeId>WW2-Behavior-CargoPlane-Green</SubtypeId>
            </Id>
            <Description>
			
			[RivalAI Behavior]
			[BehaviorName:CargoShip]
			
			[AutopilotData:WW2-Autopilot-CargoPlane-Cruising]
			[SecondaryAutopilotData:WW2-Autopilot-CargoPlane-Destination]
			
			[Triggers:WW2-Trigger-UnStatic]
			[Triggers:WW2-Trigger-ProcessEscortRequest]
			
			[Triggers:WW2-Trigger-CargoDamage]
			[Triggers:WW2-Trigger-ReputationDamageLight-Green]
			[Triggers:WW2-Trigger-ReputationDamageHeavy-Plane-Green]
			
			[Triggers:WW2-Trigger-CargoPlane-Recirculate]
			[Triggers:WW2-Trigger-CargoPlane-LoiterTimer]
			[Triggers:WW2-Trigger-CargoPlane-DespawnCheck]
			[Triggers:WW2-Trigger-CargoPlane-EngagedByPlayer]
			[Triggers:WW2-Trigger-CargoPlane-EngagementCooldown]
			
			[Triggers:WW2-Trigger-CargoPlane-Destination]
			[Triggers:WW2-Trigger-CargoPlane-DestinationReached]
			
			[Triggers:WW2-Trigger-FriendlyNear-Cargo]
			[Triggers:WW2-Trigger-HostileNear-Cargo]
			[Triggers:WW2-Trigger-DefenseSpawn1-Green]
			
			[Triggers:WW2-Trigger-Crash-Air]
			[Triggers:WW2-Trigger-Compromised-Air]
			[Triggers:WW2-Trigger-StopCrash-Air]
			
			</Description>
        </EntityComponent>
<!-- End Cargo Plane Behaviors -->

<!-- Cargo Plane Autopilots -->
		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-CargoPlane-Cruising</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[FlyLevelWithGravity:false]
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[CollisionEvasionResumeDistance:50]

			[AngleAllowedForForwardThrust:180]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.2]

			[IdealPlanetAltitude:600]
			[MinimumPlanetAltitude:400]
			[AltitudeTolerance:50]
			[WaypointTolerance:50]

			[IdealMaxSpeed:60]
			[IdealMinSpeed:50]
			[MaxSpeedTolerance:3]  
			
			</Description>
		</EntityComponent>

		<EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
			<Id>
				<TypeId>Inventory</TypeId>
				<SubtypeId>WW2-Autopilot-CargoPlane-Destination</SubtypeId>
			</Id>
			<Description>
			
			[RivalAI Autopilot]

			[FlyLevelWithGravity:false]
			[UseVelocityCollisionEvasion:true]
			[CollisionEvasionWaypointDistance:100]
			[CollisionEvasionResumeDistance:50]

			[SlowDownOnWaypointApproach:true]
			[ExtraSlowDownDistance:150]

			[AngleAllowedForForwardThrust:180]
			[LimitRotationSpeed:true]
			[MaxRotationMagnitude:0.2]

			[IdealPlanetAltitude:500]
			[MinimumPlanetAltitude:120]
			[AltitudeTolerance:300]
			[WaypointTolerance:50]
			
			[IdealMaxSpeed:60]
			[IdealMinSpeed:40]
			[MaxSpeedTolerance:3]

			[MinAngleForLeveledDescent:60]
			[MaxAngleForLeveledAscent:90]
			
			</Description>
		</EntityComponent>	
<!-- End Cargo Plane Autopilots -->

	</EntityComponents>
</Definitions>